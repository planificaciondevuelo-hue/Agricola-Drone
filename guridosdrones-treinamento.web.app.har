          "content": {
            "size": 71100,
            "mimeType": "text/html",
            "text": "<!DOCTYPE html>\n<html data-idioma-automatico lang=\"pt-BR\">\n<head>\n<script src=\"/treinamento/js/manutencao.js?v=1\"></script>\n<meta charset=\"utf-8\">\n<!-- TPD-IDiomas -->\n<script src=\"../js/idiomas/catalogo.js?v=2d3e70494816\"></script>\n<script src=\"../js/idiomas/idiomas.js?v=0311010058d7\"></script>\n\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Controle T25 / T50</title>\n<link rel=\"stylesheet\" href=\"estilo.css?v=18d9482600ee\">\n<link rel=\"stylesheet\" href=\"configuracoes.css?v=4ccdf19ac002\">\n<link rel=\"stylesheet\" href=\"telas_extra.css?v=333335990d36\">\n<link rel=\"stylesheet\" href=\"telas_gravadas.css?v=1cc42e2c3ff5\">\n<link rel=\"stylesheet\" href=\"telas_drone.css?v=12137158ec12\">\n</head>\n<body class=\"desligado\">\n\n<!-- ================= ÍCONES ================= -->\n<svg class=\"biblioteca-icones\" aria-hidden=\"true\">\n  <defs>\n    <symbol id=\"ic-perfil\" viewBox=\"0 0 24 24\">\n      <circle cx=\"12\" cy=\"8.2\" r=\"3.6\"/><path d=\"M4.8 20c0-3.6 3.2-6 7.2-6s7.2 2.4 7.2 6z\"/>\n    </symbol>\n    <symbol id=\"ic-sino\" viewBox=\"0 0 24 24\">\n      <path d=\"M12 2.6c-3.4 0-5.9 2.6-5.9 6v3.6l-1.7 3.1c-.3.5.1 1.2.7 1.2h13.8c.6 0 1-.7.7-1.2l-1.7-3.1V8.6c0-3.4-2.5-6-5.9-6z\"/>\n      <path d=\"M9.6 18.4a2.5 2.5 0 0 0 4.8 0z\"/>\n    </symbol>\n    <symbol id=\"ic-hexagono\" viewBox=\"0 0 24 24\">\n      <path d=\"M12 2.4 20.4 7v10L12 21.6 3.6 17V7z\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.1\" stroke-linejoin=\"round\"/>\n      <circle cx=\"12\" cy=\"12\" r=\"3.1\"/>\n    </symbol>\n    <symbol id=\"ic-pasta\" viewBox=\"0 0 24 24\">\n      <path d=\"M2 6.2c0-.8.6-1.4 1.4-1.4h4.3c.5 0 .9.2 1.2.6l1 1.3h10.7c.8 0 1.4.6 1.4 1.4v9.7c0 .8-.6 1.4-1.4 1.4H3.4c-.8 0-1.4-.6-1.4-1.4z\"/>\n    </symbol>\n    <symbol id=\"ic-documento\" viewBox=\"0 0 24 24\">\n      <path d=\"M5.5 3h9.2L19.5 8v13H5.5z\" opacity=\".5\"/>\n      <rect x=\"8\" y=\"10\" width=\"9\" height=\"1.7\" rx=\".8\"/><rect x=\"8\" y=\"13.6\" width=\"9\" height=\"1.7\" rx=\".8\"/><rect x=\"8\" y=\"17.2\" width=\"6\" height=\"1.7\" rx=\".8\"/>\n    </symbol>\n    <symbol id=\"ic-cubo\" viewBox=\"0 0 24 24\">\n      <path d=\"M12 2.2 21.4 7v10L12 21.8 2.6 17V7z\" opacity=\".45\"/><path d=\"M12 2.2 21.4 7 12 11.9 2.6 7z\" opacity=\".8\"/>\n    </symbol>\n    <symbol id=\"ic-elo\" viewBox=\"0 0 24 24\">\n      <path d=\"M9.6 14.4 6.9 17a3.2 3.2 0 0 1-4.5-4.5l2.6-2.6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.1\" stroke-linecap=\"round\"/>\n      <path d=\"M14.4 9.6 17 7a3.2 3.2 0 0 1 4.5 4.5L19 14.1\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.1\" stroke-linecap=\"round\"/>\n      <path d=\"M3.4 3.4 20.6 20.6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.1\" stroke-linecap=\"round\"/>\n    </symbol>\n    <symbol id=\"ic-transferir\" viewBox=\"0 0 24 24\">\n      <rect x=\"2.6\" y=\"2.6\" width=\"18.8\" height=\"18.8\" rx=\"4\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.9\"/>\n      <path d=\"M7 9.6h8.2l-2.4-2.4M17 14.4H8.8l2.4 2.4\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.9\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n    </symbol>\n    <symbol id=\"ic-engrenagem\" viewBox=\"0 0 24 24\">\n      <path d=\"M12 8.1a3.9 3.9 0 1 0 0 7.8 3.9 3.9 0 0 0 0-7.8zm9.1 5.3V10.6l-2.3-.4a7 7 0 0 0-.8-1.9l1.3-1.9-2-2-1.9 1.3a7 7 0 0 0-1.9-.8l-.4-2.3h-2.8l-.4 2.3a7 7 0 0 0-1.9.8L6.1 4.4l-2 2 1.3 1.9a7 7 0 0 0-.8 1.9l-2.3.4v2.8l2.3.4c.2.7.4 1.3.8 1.9l-1.3 1.9 2 2 1.9-1.3c.6.3 1.2.6 1.9.8l.4 2.3h2.8l.4-2.3c.7-.2 1.3-.4 1.9-.8l1.9 1.3 2-2-1.3-1.9c.3-.6.6-1.2.8-1.9z\"/>\n    </symbol>\n    <symbol id=\"ic-rc\" viewBox=\"0 0 24 24\">\n      <rect x=\"2.4\" y=\"6.4\" width=\"19.2\" height=\"13.4\" rx=\"2.6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"/>\n      <circle cx=\"7.4\" cy=\"10.8\" r=\"1.6\"/><circle cx=\"16.6\" cy=\"10.8\" r=\"1.6\"/>\n      <path d=\"M6.6 6.4 4.4 2.8M17.4 6.4l2.2-3.6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"/>\n    </symbol>\n    <symbol id=\"ic-mais\" viewBox=\"0 0 24 24\">\n      <path d=\"M12 4.6v14.8M4.6 12h14.8\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\"/>\n    </symbol>\n    <symbol id=\"ic-pasta-mais\" viewBox=\"0 0 24 24\">\n      <path d=\"M3 5.4h6.4l1.4 1.8H21c.6 0 1 .4 1 1v10.4c0 .6-.4 1-1 1H3c-.6 0-1-.4-1-1V6.4c0-.6.4-1 1-1z\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.9\" stroke-linejoin=\"round\"/>\n      <path d=\"M12 10.4v6M9 13.4h6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.9\" stroke-linecap=\"round\"/>\n    </symbol>\n    <symbol id=\"ic-regua\" viewBox=\"0 0 24 24\">\n      <path d=\"M4 3.4v17.2M20 3.4v17.2\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.9\" stroke-linecap=\"round\"/>\n      <rect x=\"8.4\" y=\"5.4\" width=\"7.2\" height=\"13.2\" rx=\"1.2\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.9\"/>\n      <path d=\"M8.4 9h3M8.4 12h4.4M8.4 15h3\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\"/>\n    </symbol>\n    <symbol id=\"ic-borracha\" viewBox=\"0 0 24 24\">\n      <path d=\"M13.6 3.4 3.4 13.6c-.8.8-.8 2 0 2.8l4.2 4.2h6.2L21 13.4c.8-.8.8-2 0-2.8l-4.6-4.6z\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.9\" stroke-linejoin=\"round\"/>\n      <path d=\"M8.6 8.4 15.6 15.4\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.9\"/>\n    </symbol>\n    <symbol id=\"ic-trator\" viewBox=\"0 0 24 24\">\n      <circle cx=\"6.4\" cy=\"16.4\" r=\"4.2\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.9\"/>\n      <circle cx=\"17.8\" cy=\"17.6\" r=\"3\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.9\"/>\n      <path d=\"M4.2 11.6V7.4h5.2l1.8 4.6h5.4v3.4\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.9\" stroke-linejoin=\"round\"/>\n      <circle cx=\"6.4\" cy=\"16.4\" r=\"1.3\"/>\n    </symbol>\n    <symbol id=\"ic-camadas\" viewBox=\"0 0 24 24\">\n      <path d=\"M12 2.8 22 8.2 12 13.6 2 8.2z\"/>\n      <path d=\"m3.6 12 8.4 4.5 8.4-4.5\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.9\" stroke-linejoin=\"round\"/>\n      <path d=\"m3.6 16.2 8.4 4.5 8.4-4.5\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.9\" stroke-linejoin=\"round\"/>\n    </symbol>\n    <symbol id=\"ic-selecao\" viewBox=\"0 0 24 24\">\n      <path d=\"M3.4 8V4.8c0-.8.6-1.4 1.4-1.4H8M16 3.4h3.2c.8 0 1.4.6 1.4 1.4V8M20.6 16v3.2c0 .8-.6 1.4-1.4 1.4H16M8 20.6H4.8c-.8 0-1.4-.6-1.4-1.4V16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.1\" stroke-linecap=\"round\"/>\n      <circle cx=\"8.4\" cy=\"8.4\" r=\"1.7\"/><circle cx=\"15.6\" cy=\"8.4\" r=\"1.7\"/><circle cx=\"15.6\" cy=\"15.6\" r=\"1.7\"/>\n      <path d=\"M6.7 17.3 10 14v3.3z\"/>\n    </symbol>\n    <symbol id=\"ic-reticulo\" viewBox=\"0 0 24 24\">\n      <path d=\"M12 4.6v5M12 14.4v5M4.6 12h5M14.4 12h5\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.1\" stroke-linecap=\"round\"/>\n      <path d=\"M3.4 17.6v3h3\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.1\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n    </symbol>\n    <symbol id=\"ic-lapis\" viewBox=\"0 0 24 24\">\n      <path d=\"M3.6 17.1 15.4 5.3l3.3 3.3L6.9 20.4H3.6z\"/>\n      <path d=\"M16.8 3.9 18 2.7a1.4 1.4 0 0 1 2 0l1.3 1.3a1.4 1.4 0 0 1 0 2l-1.2 1.2z\"/>\n    </symbol>\n    <symbol id=\"ic-check\" viewBox=\"0 0 24 24\">\n      <path d=\"m4.4 12.6 5 5L19.6 7.4\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n    </symbol>\n    <symbol id=\"ic-sair\" viewBox=\"0 0 24 24\">\n      <path d=\"M13.4 3.4H5.4c-1.1 0-2 .9-2 2v13.2c0 1.1.9 2 2 2h8\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"/>\n      <path d=\"M16.4 8.2 20.6 12l-4.2 3.8M9.6 12h10.6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n    </symbol>\n    <symbol id=\"ic-lupa\" viewBox=\"0 0 24 24\">\n      <circle cx=\"10.6\" cy=\"10.6\" r=\"6.6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.1\"/>\n      <path d=\"m15.6 15.6 4.6 4.6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.1\" stroke-linecap=\"round\"/>\n    </symbol>\n    <symbol id=\"ic-ordenar\" viewBox=\"0 0 24 24\">\n      <path d=\"M9.4 6h11M9.4 12h8M9.4 18h5\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.1\" stroke-linecap=\"round\"/>\n      <path d=\"M4.6 4.6v14.8M4.6 19.4 2.4 16.8M4.6 19.4l2.2-2.6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.1\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n    </symbol>\n    <symbol id=\"ic-pin\" viewBox=\"0 0 24 24\">\n      <path d=\"M12 2.4c-3.6 0-6.5 2.9-6.5 6.5 0 4.9 6.5 12.7 6.5 12.7s6.5-7.8 6.5-12.7c0-3.6-2.9-6.5-6.5-6.5zm0 9a2.6 2.6 0 1 1 0-5.2 2.6 2.6 0 0 1 0 5.2z\"/>\n    </symbol>\n    <symbol id=\"ic-x\" viewBox=\"0 0 24 24\">\n      <path d=\"M5.4 5.4 18.6 18.6M18.6 5.4 5.4 18.6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.3\" stroke-linecap=\"round\"/>\n    </symbol>\n    <symbol id=\"ic-dividir\" viewBox=\"0 0 24 24\">\n      <path d=\"M4.4 4.4h6v6h-6zM13.6 13.6h6v6h-6z\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.9\"/>\n      <path d=\"M3.4 20.6 20.6 3.4\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.9\" stroke-linecap=\"round\"/>\n    </symbol>\n    <symbol id=\"ic-check-circulo\" viewBox=\"0 0 24 24\">\n      <circle cx=\"12\" cy=\"12\" r=\"9.4\"/>\n      <path d=\"m7.8 12.4 3 3 5.4-6\" fill=\"none\" stroke=\"#fff\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n    </symbol>\n    <symbol id=\"ic-alvo\" viewBox=\"0 0 24 24\">\n      <circle cx=\"12\" cy=\"12\" r=\"8.6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"/>\n      <circle cx=\"12\" cy=\"12\" r=\"3\"/><path d=\"M12 1.4v3.6M12 19v3.6M1.4 12H5M19 12h3.6\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"/>\n    </symbol>\n    <symbol id=\"ic-decolar\" viewBox=\"0 0 24 24\">\n      <path d=\"M12 3.4 7.4 9.4h3v6.2h3.2V9.4h3z\"/>\n      <path d=\"M4.6 19.6h14.8\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\"/>\n    </symbol>\n    <symbol id=\"ic-renomear\" viewBox=\"0 0 24 24\">\n      <rect x=\"6.4\" y=\"7.6\" width=\"11.2\" height=\"8.8\" rx=\"1.4\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.9\"/>\n      <path d=\"M3.4 5.4v13.2M20.6 5.4v13.2\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.9\" stroke-linecap=\"round\"/>\n    </symbol>\n    <symbol id=\"ic-lixeira\" viewBox=\"0 0 24 24\">\n      <path d=\"M5.4 6.6h13.2l-1.1 13.2a1.6 1.6 0 0 1-1.6 1.4H8.1a1.6 1.6 0 0 1-1.6-1.4z\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.9\" stroke-linejoin=\"round\"/>\n      <path d=\"M3.4 6.6h17.2M9.4 6.6V4.2c0-.6.5-1 1-1h3.2c.6 0 1 .4 1 1v2.4\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.9\" stroke-linecap=\"round\"/>\n    </symbol>\n    <symbol id=\"ic-linha-onda\" viewBox=\"0 0 24 24\">\n      <path d=\"M2.6 14c3-6 5.4-6 8.4 0s5.4 6 10.4-2\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.1\" stroke-linecap=\"round\"/>\n    </symbol>\n    <symbol id=\"ic-somente-rota\" viewBox=\"0 0 24 24\">\n      <path d=\"M4 6.4h16M4 12h16M4 17.6h16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\"/>\n    </symbol>\n    <symbol id=\"ic-rota-fronteira\" viewBox=\"0 0 24 24\">\n      <rect x=\"3\" y=\"4\" width=\"18\" height=\"16\" rx=\"2\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"/>\n      <path d=\"M7 9h10M7 12.6h10M7 16.2h6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\"/>\n    </symbol>\n    <symbol id=\"ic-somente-fronteira\" viewBox=\"0 0 24 24\">\n      <rect x=\"3.4\" y=\"4.4\" width=\"17.2\" height=\"15.2\" rx=\"2\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"/>\n    </symbol>\n    <symbol id=\"ic-info\" viewBox=\"0 0 24 24\">\n      <circle cx=\"12\" cy=\"12\" r=\"9\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\"/>\n      <path d=\"M12 10.6v6.2\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.9\" stroke-linecap=\"round\"/>\n      <circle cx=\"12\" cy=\"7.6\" r=\"1.2\"/>\n    </symbol>\n    <symbol id=\"ic-aeronave\" viewBox=\"0 0 24 24\">\n      <path d=\"M3.4 12.6 20.6 4.6 12.6 20.6l-2-7z\"/>\n    </symbol>\n\n    <linearGradient id=\"g-terra\" x1=\"0\" y1=\"0\" x2=\"1\" y2=\"1\">\n      <stop offset=\"0\" stop-color=\"#b4a898\"/><stop offset=\".5\" stop-color=\"#c9b9a4\"/><stop offset=\"1\" stop-color=\"#9c9083\"/>\n    </linearGradient>\n    <linearGradient id=\"g-talhao\" x1=\".2\" y1=\"0\" x2=\".8\" y2=\"1\">\n      <stop offset=\"0\" stop-color=\"#c85e28\"/><stop offset=\".45\" stop-color=\"#d9702f\"/><stop offset=\"1\" stop-color=\"#b95424\"/>\n    </linearGradient>\n    <!-- terreno reaproveitado nas duas telas de mapa -->\n    <symbol id=\"terreno\" viewBox=\"0 0 1920 1200\">\n      <rect width=\"1920\" height=\"1200\" fill=\"url(#g-terra)\"/>\n      <g opacity=\".5\">\n        <path d=\"M-200 250 L700 -200 L1000 -60 L100 400 Z\" fill=\"#8d8175\"/>\n        <path d=\"M1100 -120 L1750 -400 L2100 -120 L1450 160 Z\" fill=\"#7f776d\"/>\n        <path d=\"M1500 120 L2100 -160 L2200 200 L1600 420 Z\" fill=\"#938878\"/>\n        <path d=\"M-200 820 L500 560 L760 760 L60 1040 Z\" fill=\"#8a7f72\"/>\n        <path d=\"M1450 700 L2000 480 L2200 800 L1650 1020 Z\" fill=\"#877d70\"/>\n      </g>\n      <g opacity=\".26\" stroke=\"#6f6459\" stroke-width=\"3\">\n        <path d=\"M-100 300 L900 -160\"/><path d=\"M-60 340 L940 -120\"/><path d=\"M-20 380 L980 -80\"/>\n        <path d=\"M1200 60 L1900 -260\"/><path d=\"M1240 110 L1940 -210\"/>\n        <path d=\"M-120 880 L620 600\"/><path d=\"M-80 930 L660 650\"/>\n        <path d=\"M1520 780 L2100 540\"/><path d=\"M1560 830 L2140 590\"/>\n      </g>\n      <path d=\"M300 600 L560 300 L980 190 L1400 240 L1620 420 L1560 720 L1300 980 L860 1080 L480 960 L300 780 Z\" fill=\"url(#g-talhao)\"/>\n      <g opacity=\".2\" stroke=\"#8a3e17\" stroke-width=\"4\">\n        <path d=\"M330 650 L1560 430\"/><path d=\"M340 710 L1540 500\"/><path d=\"M370 770 L1520 570\"/>\n        <path d=\"M420 840 L1470 640\"/><path d=\"M500 920 L1420 720\"/><path d=\"M620 1000 L1360 840\"/>\n      </g>\n      <path d=\"M1380 760 L1620 700 L1700 900 L1460 980 Z\" fill=\"#cbb43c\" opacity=\".8\"/>\n      <path d=\"M470 880 L700 790 L930 880 L990 1060 L840 1180 L560 1150 L440 1020 Z\" fill=\"#7d8a3a\"/>\n      <g fill=\"#4f6a2a\" opacity=\".85\">\n        <circle cx=\"560\" cy=\"930\" r=\"34\"/><circle cx=\"640\" cy=\"900\" r=\"28\"/><circle cx=\"880\" cy=\"960\" r=\"30\"/>\n        <circle cx=\"930\" cy=\"1050\" r=\"26\"/><circle cx=\"520\" cy=\"1040\" r=\"30\"/><circle cx=\"760\" cy=\"1140\" r=\"28\"/>\n      </g>\n      <g>\n        <rect x=\"620\" y=\"930\" width=\"130\" height=\"72\" fill=\"#cfd6d8\" transform=\"rotate(-8 620 930)\"/>\n        <rect x=\"780\" y=\"1000\" width=\"96\" height=\"58\" fill=\"#b9553a\" transform=\"rotate(-8 780 1000)\"/>\n        <rect x=\"560\" y=\"1030\" width=\"84\" height=\"52\" fill=\"#c9cfd0\" transform=\"rotate(-8 560 1030)\"/>\n      </g>\n      <path d=\"M300 1020 L520 1180 L980 1200 L1240 1080\" fill=\"none\" stroke=\"#6b7a86\" stroke-width=\"16\" opacity=\".5\"/>\n      <path d=\"M1480 1010 L1700 1200\" fill=\"none\" stroke=\"#4e6e86\" stroke-width=\"20\" opacity=\".4\"/>\n    </symbol>\n  </defs>\n</svg>\n\n<header class=\"cabecalho\">\n  <h1>Controle remoto — T25 / T50</h1>\n  <p>Toque uma vez no botão inferior direito para acender as luzes; depois, pressione e segure por 3 segundos para ligar o controle. Em seguida, ligue o drone abaixo. A conexão acontecerá automaticamente na simulação.</p>\n  <div class=\"simulador-drone\" role=\"group\" aria-label=\"Alimentação do drone simulado\">\n    <span class=\"indicador-drone\" id=\"indicador-drone\">Drone T50 desligado</span>\n    <button id=\"botao-drone\" type=\"button\" aria-pressed=\"false\">Ligar drone</button>\n    <small>Simulação visual: não se conecta a um drone físico.</small>\n  </div>\n</header>\n\n<div class=\"palco\">\n<div class=\"controle\">\n\n  <!-- antenas dobradas nos cantos de cima -->\n  <i class=\"antena esquerda\"></i>\n  <i class=\"antena direita\"></i>\n\n  <!-- canto superior esquerdo: botão de vínculo -->\n  <button class=\"tecla redonda t-emergencia\" title=\"Parada de emergência\">\n    <svg viewBox=\"0 0 24 24\"><path d=\"M12 9.6a2.4 2.4 0 1 0 0 4.8 2.4 2.4 0 0 0 0-4.8z\"/>\n      <path d=\"M11 9 4.6 6.4 3.6 8.4 10 11zM13 9l6.4-2.6 1 2L14 11zM11 15l-6.4 2.6 1 2L12 16.6zM13 15l6.4 2.6-1 2L12 16.6z\"/></svg>\n  </button>\n\n  <!-- canto superior direito: freio de emergência -->\n  <button class=\"tecla redonda t-pausa\" title=\"Freio de emergência\">\n    <svg viewBox=\"0 0 24 24\"><rect x=\"7.4\" y=\"5.6\" width=\"3.6\" height=\"12.8\" rx=\"1\"/><rect x=\"13\" y=\"5.6\" width=\"3.6\" height=\"12.8\" rx=\"1\"/></svg>\n  </button>\n\n  <!-- manches -->\n  <div class=\"manche esquerdo\"><span class=\"base\"></span><span class=\"haste\"></span></div>\n  <div class=\"manche direito\"><span class=\"base\"></span><span class=\"haste\"></span></div>\n\n  <!-- teclas redondas -->\n  <button class=\"tecla redonda t-voltar\" type=\"button\" title=\"Voltar\" aria-label=\"Voltar\">\n    <svg viewBox=\"0 0 24 24\"><path d=\"M14.8 4.6 7.4 12l7.4 7.4\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n  </button>\n  <button class=\"tecla redonda t-home\" title=\"Botão HOME\">\n    <svg viewBox=\"0 0 24 24\"><path d=\"M5.6 6.4h12.8M12 6.4v11.2M8.4 17.6h7.2\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\"/></svg>\n  </button>\n  <button class=\"tecla redonda t-power\" type=\"button\" title=\"Toque uma vez, depois segure por 3 segundos\" aria-label=\"Acender luzes do controle\">\n    <svg viewBox=\"0 0 24 24\"><path d=\"M12 3.4v8.2\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\"/>\n      <path d=\"M7.2 6.6a6.6 6.6 0 1 0 9.6 0\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\"/></svg>\n  </button>\n  <div class=\"dial-lateral\"></div>\n\n  <!-- colunas L e R -->\n  <div class=\"coluna-teclas esquerda\">\n    <div class=\"botao-lateral\">L1</div><i class=\"risco\"></i>\n    <div class=\"botao-lateral\">L2</div><i class=\"risco\"></i>\n    <div class=\"botao-lateral\">L3</div>\n  </div>\n  <div class=\"coluna-teclas direita\">\n    <div class=\"botao-lateral\">R1</div><i class=\"risco\"></i>\n    <div class=\"botao-lateral\">R2</div><i class=\"risco\"></i>\n    <div class=\"botao-lateral\">R3</div>\n  </div>\n\n  <!-- bateria com o logo -->\n  <div class=\"bateria\">\n    <i class=\"furos\"></i>\n    <span class=\"marca\"></span>\n    <i class=\"furos\"></i>\n  </div>\n  <div class=\"pe-controle\"></div>\n\n  <div class=\"contatos\"></div>\n\n    <div class=\"moldura-tela\">\n    <div class=\"tela\" id=\"tela\">\n\n      <!-- Inicialização do controle. A aeronave continua desconectada após o carregamento. -->\n      <div class=\"tela-energia\" id=\"tela-energia\" role=\"status\" aria-live=\"polite\">\n        <div class=\"etapa-inicializacao etapa-logo\" aria-hidden=\"true\"><span style=\"font-size:6cqw;font-style:normal;letter-spacing:0;font-weight:600\">Guri dos Drones</span></div>\n        <div class=\"etapa-inicializacao etapa-aeronave\" aria-hidden=\"true\">\n          <svg viewBox=\"0 0 440 230\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n            <path d=\"M206 97 92 52M234 97l114-45M206 128 92 174m142-46 114 46\" stroke=\"#555d61\" stroke-width=\"12\" stroke-linecap=\"round\"/>\n            <rect x=\"185\" y=\"83\" width=\"70\" height=\"66\" rx=\"19\" fill=\"#e0e5e5\" stroke=\"#969f9e\" stroke-width=\"6\"/>\n            <path d=\"M97 55 75 34m25 140-25 22m266-141 23-21m-22 140 22 22\" stroke=\"#555d61\" stroke-width=\"7\"/>\n            <circle cx=\"80\" cy=\"46\" r=\"27\" stroke=\"#b4c0bf\" stroke-width=\"5\"/>\n            <circle cx=\"80\" cy=\"184\" r=\"27\" stroke=\"#b4c0bf\" stroke-width=\"5\"/>\n            <circle cx=\"360\" cy=\"46\" r=\"27\" stroke=\"#b4c0bf\" stroke-width=\"5\"/>\n            <circle cx=\"360\" cy=\"184\" r=\"27\" stroke=\"#b4c0bf\" stroke-width=\"5\"/>\n            <path d=\"M201 147 185 187m54-40 16 40m-77 0h32m21 0h32\" stroke=\"#555d61\" stroke-width=\"7\" stroke-linecap=\"round\"/>\n          </svg>\n          <span>Iniciando o assistente agrícola…</span>\n        </div>\n        <div class=\"etapa-inicializacao etapa-carregando\" aria-hidden=\"true\"><span class=\"icone-carregando\">▣</span><span>Carregando aplicativo…</span></div>\n      </div>\n      <div class=\"mensagem-conexao\" id=\"mensagem-conexao\" role=\"status\" aria-live=\"polite\" hidden>Conectando à aeronave…</div>\n\n      <section class=\"tela-app tela-sistema\" data-tela=\"sistema\" aria-label=\"Tela de aplicativos do controle\">\n        <div id=\"papel-sistema\" aria-hidden=\"true\"></div>\n        <div class=\"status-sistema\">Controle remoto <span>Wi-Fi · 65%</span></div>\n        <div class=\"apps-sistema\">\n          <button class=\"app-agras\" type=\"button\" data-ir=\"inicial\"><span>AG</span>Agras</button>\n        </div>\n      </section>\n      <!-- ============ TELA INICIAL ============ -->\n      <section class=\"tela-app ativa\" data-tela=\"inicial\">\n        <div class=\"capa\">\n          <svg class=\"arte-capa\" viewBox=\"0 0 1920 880\" preserveAspectRatio=\"xMidYMid slice\">\n            <defs>\n              <linearGradient id=\"g-ceu\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\">\n                <stop offset=\"0\" stop-color=\"#6db9e0\"/><stop offset=\".45\" stop-color=\"#a8d6e8\"/><stop offset=\"1\" stop-color=\"#dcecea\"/>\n              </linearGradient>\n              <linearGradient id=\"g-colina1\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\"><stop offset=\"0\" stop-color=\"#b9c98a\"/><stop offset=\"1\" stop-color=\"#8fae6a\"/></linearGradient>\n              <linearGradient id=\"g-colina2\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\"><stop offset=\"0\" stop-color=\"#d9d472\"/><stop offset=\"1\" stop-color=\"#a8b957\"/></linearGradient>\n              <linearGradient id=\"g-colina3\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\"><stop offset=\"0\" stop-color=\"#e2d868\"/><stop offset=\"1\" stop-color=\"#b6bb4f\"/></linearGradient>\n              <linearGradient id=\"g-colina4\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\"><stop offset=\"0\" stop-color=\"#cfc95f\"/><stop offset=\"1\" stop-color=\"#9aa845\"/></linearGradient>\n              <radialGradient id=\"g-spray\" cx=\".5\" cy=\"0\" r=\"1\">\n                <stop offset=\"0\" stop-color=\"#fff\" stop-opacity=\".85\"/><stop offset=\"1\" stop-color=\"#fff\" stop-opacity=\"0\"/>\n              </radialGradient>\n              <linearGradient id=\"g-helice\" x1=\"0\" y1=\"0\" x2=\"1\" y2=\"0\">\n                <stop offset=\"0\" stop-color=\"#2f3336\" stop-opacity=\"0\"/><stop offset=\".35\" stop-color=\"#2f3336\" stop-opacity=\".55\"/>\n                <stop offset=\".65\" stop-color=\"#2f3336\" stop-opacity=\".55\"/><stop offset=\"1\" stop-color=\"#2f3336\" stop-opacity=\"0\"/>\n              </linearGradient>\n              <clipPath id=\"c-colina2\"><path d=\"M0 470 C 260 400 520 392 760 432 C 1030 478 1290 500 1560 470 C 1700 454 1830 430 1920 408 L1920 880 L0 880 Z\"/></clipPath>\n              <clipPath id=\"c-colina3\"><path d=\"M0 596 C 240 540 470 520 700 546 C 980 578 1240 606 1500 588 C 1680 576 1820 552 1920 528 L1920 880 L0 880 Z\"/></clipPath>\n              <clipPath id=\"c-colina4\"><path d=\"M0 722 C 280 660 540 640 800 668 C 1090 700 1360 726 1620 706 C 1750 696 1850 678 1920 660 L1920 880 L0 880 Z\"/></clipPath>\n            </defs>\n            <rect width=\"1920\" height=\"880\" fill=\"url(#g-ceu)\"/>\n            <path d=\"M0 330 L150 268 L300 322 L470 246 L640 320 L800 272 L980 330 L1150 262 L1320 324 L1500 268 L1700 326 L1920 280 L1920 430 L0 430 Z\" fill=\"#8fb4bd\" opacity=\".5\"/>\n            <path d=\"M0 372 L180 320 L360 372 L540 306 L740 380 L920 330 L1100 384 L1300 322 L1480 380 L1700 330 L1920 376 L1920 470 L0 470 Z\" fill=\"#7fa6a6\" opacity=\".55\"/>\n            <g fill=\"#4b6a4a\" opacity=\".9\">\n              <path d=\"M40 432 l34 -96 34 96z\"/><path d=\"M96 452 l30 -110 30 110z\"/><path d=\"M150 428 l38 -120 38 120z\"/>\n              <path d=\"M214 452 l28 -92 28 92z\"/><path d=\"M262 436 l34 -104 34 104z\"/><path d=\"M0 446 l30 -88 30 88z\"/>\n            </g>\n            <rect x=\"0\" y=\"420\" width=\"330\" height=\"60\" fill=\"#4b6a4a\" opacity=\".55\"/>\n            <path d=\"M0 470 C 260 400 520 392 760 432 C 1030 478 1290 500 1560 470 C 1700 454 1830 430 1920 408 L1920 880 L0 880 Z\" fill=\"url(#g-colina1)\"/>\n            <g clip-path=\"url(#c-colina2)\" opacity=\".5\" fill=\"none\" stroke=\"#6f8f4f\" stroke-width=\"5\">\n              <path d=\"M-40 500 C 260 434 520 426 780 466 C 1040 506 1300 530 1960 438\"/>\n              <path d=\"M-40 528 C 260 462 520 454 780 494 C 1040 534 1300 558 1960 466\"/>\n              <path d=\"M-40 556 C 260 490 520 482 780 522 C 1040 562 1300 586 1960 494\"/>\n              <path d=\"M-40 584 C 260 518 520 510 780 550 C 1040 590 1300 614 1960 522\"/>\n            </g>\n            <path d=\"M0 596 C 240 540 470 520 700 546 C 980 578 1240 606 1500 588 C 1680 576 1820 552 1920 528 L1920 880 L0 880 Z\" fill=\"url(#g-colina2)\"/>\n            <g clip-path=\"url(#c-colina3)\" opacity=\".42\" fill=\"none\" stroke=\"#8a9a3f\" stroke-width=\"6\">\n              <path d=\"M-40 624 C 240 566 470 548 700 574 C 980 606 1240 634 1960 556\"/>\n              <path d=\"M-40 656 C 240 598 470 580 700 606 C 980 638 1240 666 1960 588\"/>\n              <path d=\"M-40 688 C 240 630 470 612 700 638 C 980 670 1240 698 1960 620\"/>\n              <path d=\"M-40 720 C 240 662 470 644 700 670 C 980 702 1240 730 1960 652\"/>\n            </g>\n            <path d=\"M0 722 C 280 660 540 640 800 668 C 1090 700 1360 726 1620 706 C 1750 696 1850 678 1920 660 L1920 880 L0 880 Z\" fill=\"url(#g-colina3)\"/>\n            <g clip-path=\"url(#c-colina4)\" opacity=\".38\" fill=\"none\" stroke=\"#8d9a3a\" stroke-width=\"7\">\n              <path d=\"M-40 752 C 280 690 540 670 800 698 C 1090 730 1360 756 1960 688\"/>\n              <path d=\"M-40 790 C 280 728 540 708 800 736 C 1090 768 1360 794 1960 726\"/>\n              <path d=\"M-40 828 C 280 766 540 746 800 774 C 1090 806 1360 832 1960 764\"/>\n              <path d=\"M-40 866 C 280 804 540 784 800 812 C 1090 844 1360 870 1960 802\"/>\n            </g>\n            <path d=\"M0 830 C 300 780 620 768 900 790 C 1220 816 1520 836 1920 806 L1920 880 L0 880 Z\" fill=\"url(#g-colina4)\" opacity=\".9\"/>\n            <path d=\"M880 470 L820 880 L1040 880 L960 470 Z\" fill=\"url(#g-spray)\"/>\n            <path d=\"M1300 470 L1250 880 L1460 880 L1380 470 Z\" fill=\"url(#g-spray)\"/>\n            <path d=\"M560 650 L520 880 L690 880 L640 650 Z\" fill=\"url(#g-spray)\" opacity=\".8\"/>\n            <g transform=\"translate(1160 330) scale(1.05)\">\n              <g stroke=\"#3a3f42\" stroke-width=\"13\" stroke-linecap=\"round\">\n                <path d=\"M-30 6 L-225 -30\"/><path d=\"M30 6 L225 -30\"/><path d=\"M-26 22 L-200 66\"/><path d=\"M26 22 L200 66\"/>\n              </g>\n              <g transform=\"translate(-232 -34)\"><ellipse rx=\"112\" ry=\"9\" fill=\"url(#g-helice)\"/><rect x=\"-13\" y=\"-22\" width=\"26\" height=\"30\" rx=\"6\" fill=\"#33383b\"/><rect x=\"-7\" y=\"-34\" width=\"14\" height=\"16\" rx=\"4\" fill=\"#2a2e31\"/><circle cy=\"-38\" r=\"5\" fill=\"#49e06a\"/></g>\n              <g transform=\"translate(232 -34)\"><ellipse rx=\"112\" ry=\"9\" fill=\"url(#g-helice)\"/><rect x=\"-13\" y=\"-22\" width=\"26\" height=\"30\" rx=\"6\" fill=\"#33383b\"/><rect x=\"-7\" y=\"-34\" width=\"14\" height=\"16\" rx=\"4\" fill=\"#2a2e31\"/><circle cy=\"-38\" r=\"5\" fill=\"#49e06a\"/></g>\n              <g transform=\"translate(-206 62)\"><ellipse rx=\"104\" ry=\"8\" fill=\"url(#g-helice)\"/><rect x=\"-12\" y=\"-20\" width=\"24\" height=\"28\" rx=\"6\" fill=\"#33383b\"/><circle cy=\"-30\" r=\"5\" fill=\"#ff4b3f\"/></g>\n              <g transform=\"translate(206 62)\"><ellipse rx=\"104\" ry=\"8\" fill=\"url(#g-helice)\"/><rect x=\"-12\" y=\"-20\" width=\"24\" height=\"28\" rx=\"6\" fill=\"#33383b\"/><circle cy=\"-30\" r=\"5\" fill=\"#ff4b3f\"/></g>\n              <rect x=\"-72\" y=\"-34\" width=\"144\" height=\"36\" rx=\"10\" fill=\"#e9e6df\"/>\n              <rect x=\"-58\" y=\"-56\" width=\"80\" height=\"26\" rx=\"8\" fill=\"#d8d4cb\"/>\n              <rect x=\"-66\" y=\"0\" width=\"132\" height=\"44\" rx=\"12\" fill=\"#f0a63a\"/>\n              <rect x=\"-66\" y=\"0\" width=\"132\" height=\"12\" rx=\"6\" fill=\"#fff\" opacity=\".35\"/>\n              <path d=\"M-170 66 L-170 96 M170 66 L170 96\" stroke=\"#3a3f42\" stroke-width=\"7\" stroke-linecap=\"round\"/>\n              <path d=\"M-52 44 L-86 128 M52 44 L86 128 M-30 44 L-46 128 M30 44 L46 128\" stroke=\"#3f4447\" stroke-width=\"9\" stroke-linecap=\"round\" fill=\"none\"/>\n              <path d=\"M-96 130 L-34 130 M34 130 L96 130\" stroke=\"#3f4447\" stroke-width=\"11\" stroke-linecap=\"round\"/>\n            </g>\n            <g transform=\"translate(640 580) scale(.52)\">\n              <g stroke=\"#3a3f42\" stroke-width=\"13\" stroke-linecap=\"round\">\n                <path d=\"M-30 6 L-225 -26\"/><path d=\"M30 6 L225 -26\"/><path d=\"M-26 22 L-200 62\"/><path d=\"M26 22 L200 62\"/>\n              </g>\n              <g transform=\"translate(-232 -30)\"><ellipse rx=\"110\" ry=\"9\" fill=\"url(#g-helice)\"/><rect x=\"-13\" y=\"-22\" width=\"26\" height=\"30\" rx=\"6\" fill=\"#33383b\"/></g>\n              <g transform=\"translate(232 -30)\"><ellipse rx=\"110\" ry=\"9\" fill=\"url(#g-helice)\"/><rect x=\"-13\" y=\"-22\" width=\"26\" height=\"30\" rx=\"6\" fill=\"#33383b\"/></g>\n              <g transform=\"translate(-206 58)\"><ellipse rx=\"102\" ry=\"8\" fill=\"url(#g-helice)\"/><rect x=\"-12\" y=\"-20\" width=\"24\" height=\"28\" rx=\"6\" fill=\"#33383b\"/></g>\n              <g transform=\"translate(206 58)\"><ellipse rx=\"102\" ry=\"8\" fill=\"url(#g-helice)\"/><rect x=\"-12\" y=\"-20\" width=\"24\" height=\"28\" rx=\"6\" fill=\"#33383b\"/></g>\n              <rect x=\"-72\" y=\"-34\" width=\"144\" height=\"36\" rx=\"10\" fill=\"#eceae4\"/>\n              <rect x=\"-66\" y=\"0\" width=\"132\" height=\"44\" rx=\"12\" fill=\"#dedbd3\"/>\n              <path d=\"M-52 44 L-86 126 M52 44 L86 126 M-30 44 L-46 126 M30 44 L46 126\" stroke=\"#3f4447\" stroke-width=\"9\" stroke-linecap=\"round\" fill=\"none\"/>\n              <path d=\"M-96 128 L-34 128 M34 128 L96 128\" stroke=\"#3f4447\" stroke-width=\"11\" stroke-linecap=\"round\"/>\n            </g>\n            <ellipse cx=\"300\" cy=\"700\" rx=\"46\" ry=\"30\" fill=\"#fff\" opacity=\".55\"/>\n          </svg>\n          <div class=\"capa-conectado\">\n            <svg class=\"fundo-verde\" viewBox=\"0 0 1920 880\" preserveAspectRatio=\"xMidYMid slice\">\n              <rect width=\"1920\" height=\"880\" fill=\"#2f7a2a\"/>\n              <g stroke=\"#3f9a33\" stroke-width=\"26\" opacity=\".85\">\n                <path d=\"M-200 300 L900 -200M-100 420 L1000 -80M0 540 L1100 40M100 660 L1200 160\n                         M200 780 L1300 280M300 900 L1400 400M400 1000 L1500 500M700 1000 L1800 500\n                         M1000 1000 L2100 500M1300 1000 L2400 500\"/>\n              </g>\n              <g stroke=\"#8fc64f\" stroke-width=\"10\" opacity=\".55\">\n                <path d=\"M-200 360 L900 -140M0 600 L1100 100M200 840 L1300 340M600 1000 L1700 500\n                         M1100 1000 L2200 500\"/>\n              </g>\n              <rect width=\"1920\" height=\"880\" fill=\"#1f5c1c\" opacity=\".25\"/>\n            </svg>\n            <div class=\"conteudo-banner\">\n              <h3>Asistente para<br>drones agrícolas</h3>\n              <p>Asistente para drones agrícolas</p>\n              <div class=\"linha-banner\">\n                <span class=\"qr\">\n                  <svg viewBox=\"0 0 60 60\">\n                    <rect width=\"60\" height=\"60\" fill=\"#fff\"/>\n                    <g fill=\"#1f2326\">\n                      <rect x=\"5\" y=\"5\" width=\"14\" height=\"14\"/><rect x=\"41\" y=\"5\" width=\"14\" height=\"14\"/>\n                      <rect x=\"5\" y=\"41\" width=\"14\" height=\"14\"/>\n                      <rect x=\"8\" y=\"8\" width=\"8\" height=\"8\" fill=\"#fff\"/><rect x=\"44\" y=\"8\" width=\"8\" height=\"8\" fill=\"#fff\"/>\n                      <rect x=\"8\" y=\"44\" width=\"8\" height=\"8\" fill=\"#fff\"/>\n                      <rect x=\"10\" y=\"10\" width=\"4\" height=\"4\"/><rect x=\"46\" y=\"10\" width=\"4\" height=\"4\"/>\n                      <rect x=\"10\" y=\"46\" width=\"4\" height=\"4\"/>\n                      <rect x=\"24\" y=\"6\" width=\"4\" height=\"4\"/><rect x=\"31\" y=\"6\" width=\"4\" height=\"4\"/>\n                      <rect x=\"24\" y=\"13\" width=\"4\" height=\"4\"/><rect x=\"34\" y=\"13\" width=\"4\" height=\"4\"/>\n                      <rect x=\"6\" y=\"24\" width=\"4\" height=\"4\"/><rect x=\"13\" y=\"24\" width=\"4\" height=\"4\"/>\n                      <rect x=\"24\" y=\"24\" width=\"4\" height=\"4\"/><rect x=\"34\" y=\"24\" width=\"4\" height=\"4\"/>\n                      <rect x=\"44\" y=\"24\" width=\"4\" height=\"4\"/><rect x=\"52\" y=\"24\" width=\"4\" height=\"4\"/>\n                      <rect x=\"6\" y=\"33\" width=\"4\" height=\"4\"/><rect x=\"17\" y=\"33\" width=\"4\" height=\"4\"/>\n                      <rect x=\"27\" y=\"33\" width=\"4\" height=\"4\"/><rect x=\"38\" y=\"33\" width=\"4\" height=\"4\"/>\n                      <rect x=\"48\" y=\"33\" width=\"4\" height=\"4\"/>\n                      <rect x=\"24\" y=\"43\" width=\"4\" height=\"4\"/><rect x=\"33\" y=\"43\" width=\"4\" height=\"4\"/>\n                      <rect x=\"43\" y=\"43\" width=\"4\" height=\"4\"/><rect x=\"52\" y=\"43\" width=\"4\" height=\"4\"/>\n                      <rect x=\"24\" y=\"52\" width=\"4\" height=\"4\"/><rect x=\"36\" y=\"52\" width=\"4\" height=\"4\"/>\n                      <rect x=\"47\" y=\"52\" width=\"4\" height=\"4\"/>\n                    </g>\n                    <rect x=\"24\" y=\"24\" width=\"12\" height=\"12\" rx=\"2\" fill=\"#2f7a2a\"/>\n                  </svg>\n                </span>\n                <span class=\"itens-banner\">\n                  <b>Datos de la tarea</b><b>Gestión de dispositivo</b>\n                  <b>Compartir terrenos</b><b>Permisos de gestión</b>\n                </span>\n              </div>\n            </div>\n            <div class=\"cartao-banner\">\n              <p class=\"titulo-cartao\">Datos de la tarea</p>\n              <p class=\"periodo\">2022/08/01 - 12/01 ˅</p>\n              <div class=\"numeros\"><span><b>2231</b>acres</span><span><b>102.5</b>hora</span><span><b>235</b></span></div>\n              <svg class=\"barras\" viewBox=\"0 0 200 60\">\n                <g fill=\"#3ab54a\">\n                  <rect x=\"4\" y=\"30\" width=\"5\" height=\"30\"/><rect x=\"13\" y=\"18\" width=\"5\" height=\"42\"/>\n                  <rect x=\"22\" y=\"38\" width=\"5\" height=\"22\"/><rect x=\"31\" y=\"10\" width=\"5\" height=\"50\"/>\n                  <rect x=\"40\" y=\"26\" width=\"5\" height=\"34\"/><rect x=\"49\" y=\"42\" width=\"5\" height=\"18\"/>\n                  <rect x=\"58\" y=\"16\" width=\"5\" height=\"44\"/><rect x=\"67\" y=\"34\" width=\"5\" height=\"26\"/>\n                  <rect x=\"76\" y=\"22\" width=\"5\" height=\"38\"/><rect x=\"85\" y=\"46\" width=\"5\" height=\"14\"/>\n                  <rect x=\"94\" y=\"28\" width=\"5\" height=\"32\"/><rect x=\"103\" y=\"12\" width=\"5\" height=\"48\"/>\n                  <rect x=\"112\" y=\"36\" width=\"5\" height=\"24\"/><rect x=\"121\" y=\"20\" width=\"5\" height=\"40\"/>\n                  <rect x=\"130\" y=\"44\" width=\"5\" height=\"16\"/><rect x=\"139\" y=\"30\" width=\"5\" height=\"30\"/>\n                  <rect x=\"148\" y=\"14\" width=\"5\" height=\"46\"/><rect x=\"157\" y=\"38\" width=\"5\" height=\"22\"/>\n                  <rect x=\"166\" y=\"24\" width=\"5\" height=\"36\"/><rect x=\"175\" y=\"40\" width=\"5\" height=\"20\"/>\n                </g>\n              </svg>\n              <p class=\"titulo-cartao\">Resumen de datos diarios</p>\n              <div class=\"linhas-resumo\">\n                <span>09/14<b>1184.2</b>acres</span>\n                <span>09/13<b>1478.2</b>acres</span>\n                <span>09/12<b>1205.6</b>acres</span>\n              </div>\n            </div>\n          </div>\n          <div class=\"icones-topo\">\n            <button class=\"icone-redondo\" data-abre=\"usuario\" title=\"Perfil\"><svg><use href=\"#ic-perfil\"></use></svg></button>\n            <button class=\"icone-redondo\" data-abre=\"notificacoes\" title=\"Notificações\"><svg><use href=\"#ic-sino\"></use></svg></button>\n            <button class=\"icone-redondo\" data-abre=\"gerais\" title=\"Configurações gerais\"><svg><use href=\"#ic-hexagono\"></use></svg></button>\n            <button class=\"icone-redondo\" data-abre=\"arquivos\" title=\"Arquivos\"><svg><use href=\"#ic-pasta\"></use></svg></button>\n          </div>\n        </div>\n        <div class=\"barra-inferior\">\n          <button class=\"cartao\" data-abre=\"registros\">\n            <span class=\"cartao-texto\"><span class=\"cartao-titulo\">Gerenciamento de registros</span></span>\n            <svg class=\"cartao-icone\"><use href=\"#ic-documento\"></use></svg>\n          </button>\n          <button class=\"cartao\">\n            <span class=\"cartao-texto\"><span class=\"cartao-titulo\">Gerenciamento do dispositivo</span><span class=\"cartao-sub\">Atualizado</span></span>\n            <svg class=\"cartao-icone\"><use href=\"#ic-cubo\"></use></svg>\n          </button>\n          <div class=\"cartao cartao-conexao\" id=\"cartao-conexao\" role=\"status\" aria-live=\"polite\">\n            <svg class=\"icone-elo\"><use href=\"#ic-elo\"></use></svg>\n            <svg class=\"icone-ligado\"><use href=\"#ic-check-circulo\"></use></svg>\n            <span class=\"cartao-texto\"><span class=\"cartao-titulo\">Aeronave desconectada</span></span>\n          </div>\n          <button class=\"botao-comecar\" id=\"botao-comecar\">Começar</button>\n        </div>\n      </section>\n\n      <!-- Modos mostrados após tocar em Começar. -->\n      <section class=\"tela-app tela-modos\" data-tela=\"modos\">\n        <h2>Selecione o modo da tarefa</h2>\n        <button class=\"fechar-modos\" data-ir=\"mapa\" aria-label=\"Fechar\">✕</button>\n        <div class=\"grade-modos-app\">\n          <p class=\"grupo-modos agricultura\">Agricultura</p>\n          <p class=\"grupo-modos mapeamento\">Mapeamento</p>\n          <button class=\"cartao-modo m-rota ativo\" data-modo=\"rota\"><b>Rota</b><i class=\"icone-modo\"><svg viewBox=\"0 0 24 24\"><rect x=\"3\" y=\"4\" width=\"18\" height=\"16\" rx=\"2\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"/><path d=\"M7 9h10M7 13h10M7 17h6\" stroke=\"currentColor\" stroke-width=\"2\"/></svg></i></button>\n          <button class=\"cartao-modo m-manual\" data-modo=\"manual\"><b>Manual</b><i class=\"icone-modo letra\">M</i></button>\n          <button class=\"cartao-modo m-arvore\" data-modo=\"arvore\"><b>Árvore frutífera</b><i class=\"icone-modo\"><svg viewBox=\"0 0 24 24\"><path d=\"M12 3 4 13h5v8h6v-8h5z\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"/></svg></i></button>\n          <button class=\"cartao-modo m-maprota\" data-modo=\"maprota\"><b>Mapeamento de rota</b><i class=\"icone-modo\"><svg viewBox=\"0 0 24 24\"><rect x=\"3\" y=\"3\" width=\"8\" height=\"8\" rx=\"1\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"/><rect x=\"13\" y=\"3\" width=\"8\" height=\"8\" rx=\"1\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"/><rect x=\"3\" y=\"13\" width=\"8\" height=\"8\" rx=\"1\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"/><circle cx=\"17\" cy=\"17\" r=\"3.4\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"/></svg></i></button>\n          <button class=\"cartao-modo m-maparvore\" data-modo=\"maparvore\"><b>Mapeamento de árvores</b><i class=\"icone-modo\"><svg viewBox=\"0 0 24 24\"><path d=\"M10 3 3 12h4v7h6v-7h4z\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"/><circle cx=\"18\" cy=\"18\" r=\"3.4\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"/></svg></i></button>\n        </div>\n      </section>\n\n      <!-- ============ TELA DO MAPA ============ -->\n      <section class=\"tela-app\" data-tela=\"mapa\">\n        <svg class=\"arte-mapa\" viewBox=\"0 0 1920 1200\" preserveAspectRatio=\"xMidYMid slice\">\n          <use href=\"#terreno\" x=\"0\" y=\"0\" width=\"1920\" height=\"1200\"/>\n          <g id=\"camada-tarefas\"></g>\n          <g class=\"marcador-home\">\n            <circle cx=\"880\" cy=\"560\" r=\"18\" fill=\"#3ad46a\" stroke=\"#fff\" stroke-width=\"4\"/>\n            <text x=\"880\" y=\"567\" text-anchor=\"middle\" font-size=\"20\" font-weight=\"700\" fill=\"#fff\">H</text>\n          </g>\n          <g class=\"marcador-drone\">\n            <path d=\"M960 600 l-30 52 30-16 30 16z\" fill=\"#e8442e\" stroke=\"#fff\" stroke-width=\"5\" stroke-linejoin=\"round\"/>\n          </g>\n        </svg>\n\n        <div class=\"barra-superior\">\n          <button class=\"icone-barra\" type=\"button\" data-ir=\"modos\" title=\"Selecionar modo da tarefa\" aria-label=\"Selecionar modo da tarefa\"><svg><use href=\"#ic-transferir\"></use></svg></button>\n          <span class=\"estado-aeronave\">Aeronave desconectada</span>\n          <div class=\"barra-direita\">\n            <button class=\"icone-barra icone-rc\"><svg><use href=\"#ic-rc\"></use></svg><span class=\"badge\">24</span></button>\n            <button class=\"icone-barra abre-config\"><svg><use href=\"#ic-engrenagem\"></use></svg></button>\n          </div>\n        </div>\n\n        <div class=\"barra-voo\">\n          <button class=\"icone-barra\" type=\"button\" data-ir=\"modos\" title=\"Selecionar modo da tarefa\" aria-label=\"Selecionar modo da tarefa\"><svg><use href=\"#ic-transferir\"></use></svg></button>\n          <span class=\"alerta-voo\">Incapaz de decolar</span>\n          <span class=\"data-voo\">2026-08-18 16:50</span>\n          <span class=\"status-voo\">\n            <i class=\"sinal\"><svg viewBox=\"0 0 24 24\"><rect x=\"3\" y=\"15\" width=\"3.4\" height=\"6\" rx=\"1\"/><rect x=\"8.4\" y=\"11\" width=\"3.4\" height=\"10\" rx=\"1\"/><rect x=\"13.8\" y=\"7\" width=\"3.4\" height=\"14\" rx=\"1\"/><rect x=\"19.2\" y=\"3\" width=\"3.4\" height=\"18\" rx=\"1\" opacity=\".35\"/></svg></i>\n            <i class=\"gnss\"><svg viewBox=\"0 0 24 24\"><path d=\"M12 2.6 4 20.4l8-4 8 4z\"/></svg><b>23</b>GNSS</i>\n            <i class=\"bat-drone\"><svg viewBox=\"0 0 24 24\"><rect x=\"2.6\" y=\"6.4\" width=\"16.4\" height=\"11.2\" rx=\"2.4\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"/><rect x=\"20.4\" y=\"10\" width=\"2.4\" height=\"4\" rx=\"1\"/><path d=\"M11.4 8.4 7.6 13.6h3l-.8 3.4 4.4-5.6h-3.2z\"/></svg>16%</i>\n            <i class=\"tanque\"><svg viewBox=\"0 0 24 24\"><path d=\"M5 9.4h14v8.2a2.4 2.4 0 0 1-2.4 2.4H7.4A2.4 2.4 0 0 1 5 17.6z\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"/><path d=\"M8 9.4V6.6a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2.8\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"/></svg>0.0/0.0</i>\n            <i class=\"bat-rc\"><svg viewBox=\"0 0 24 24\"><rect x=\"2.6\" y=\"6.4\" width=\"16.4\" height=\"11.2\" rx=\"2.4\"/><rect x=\"20.4\" y=\"10\" width=\"2.4\" height=\"4\" rx=\"1\"/></svg><b>65</b></i>\n          </span>\n          <button class=\"icone-barra abre-config\"><svg><use href=\"#ic-engrenagem\"></use></svg></button>\n        </div>\n\n        <div class=\"avisos-voo\">\n          <div class=\"aviso-branco\"><span>desvio de obstáculos multidirecional ativada &gt;&gt;</span><button>×</button></div>\n          <div class=\"aviso-branco\"><span>Aperte todas as travas do braço com segurança para evitar possíveis riscos de segurança</span><button>×</button></div>\n        </div>\n\n        <button class=\"fpv\" id=\"fpv-mapa\" title=\"Trocar câmera e mapa\">\n          <svg viewBox=\"0 0 1920 1200\" preserveAspectRatio=\"xMidYMid slice\">\n            <g transform=\"translate(-1180 -1420) scale(3.4)\">\n              <use href=\"#terreno\" x=\"0\" y=\"0\" width=\"1920\" height=\"1200\"/>\n            </g>\n            <rect width=\"1920\" height=\"1200\" fill=\"#1b1008\" opacity=\".28\"/>\n            <g class=\"rota-fpv\">\n              <path d=\"M960 1200 V420\" stroke=\"#fff\" stroke-width=\"10\" opacity=\".9\"/>\n              <g fill=\"#fff\"><circle cx=\"960\" cy=\"470\" r=\"10\"/><circle cx=\"960\" cy=\"560\" r=\"10\"/>\n                <circle cx=\"960\" cy=\"650\" r=\"10\"/><circle cx=\"960\" cy=\"740\" r=\"10\"/></g>\n              <circle cx=\"960\" cy=\"640\" r=\"26\" fill=\"none\" stroke=\"#fff\" stroke-width=\"8\"/>\n              <circle cx=\"960\" cy=\"640\" r=\"9\" fill=\"#fff\"/>\n              <g fill=\"#fff\"><circle cx=\"720\" cy=\"640\" r=\"9\"/><circle cx=\"800\" cy=\"640\" r=\"9\"/>\n                <circle cx=\"1120\" cy=\"640\" r=\"9\"/><circle cx=\"1200\" cy=\"640\" r=\"9\"/></g>\n            </g>\n          </svg>\n        </button>\n\n        <div class=\"bussola\">\n          <svg viewBox=\"0 0 120 120\">\n            <circle cx=\"60\" cy=\"60\" r=\"56\" fill=\"rgba(20,26,36,.55)\"/>\n            <circle cx=\"60\" cy=\"60\" r=\"40\" fill=\"none\" stroke=\"#7fb2ff\" stroke-width=\"2\" stroke-dasharray=\"3 5\"/>\n            <circle cx=\"60\" cy=\"60\" r=\"26\" fill=\"none\" stroke=\"#7fb2ff\" stroke-width=\"2\" stroke-dasharray=\"3 5\"/>\n            <path d=\"M60 4v112M4 60h112\" stroke=\"#dfe4e6\" stroke-width=\"2\"/>\n            <path d=\"M60 40 68 66h-16z\" fill=\"#e8442e\"/>\n            <path d=\"M60 80 68 66h-16z\" fill=\"#f4f4f3\"/>\n            <text x=\"60\" y=\"114\" text-anchor=\"middle\" font-size=\"12\" fill=\"#fff\" font-family=\"Inter,sans-serif\">N</text>\n          </svg>\n        </div>\n\n        <div class=\"barra-dados\">\n          <div><span>△ Relativo à origem</span><b>0,0</b><i>m</i></div>\n          <div><span>Velocidade</span><b>0.0</b><i>km/h</i></div>\n          <div><span>Distância</span><b>0.1</b><i>m</i></div>\n          <div><span>Fluxo</span><b>0.0</b><i>L/Min</i></div>\n        </div>\n\n        <div class=\"escolher-mapa\" id=\"escolher-mapa\">\n          <p>Selecione o mapa</p>\n          <div class=\"opcoes-mapa\"></div>\n        </div>\n\n        <div class=\"ferramentas-mapa\">\n          <button class=\"botao-mapa\"><svg><use href=\"#ic-pasta-mais\"></use></svg></button>\n          <button class=\"botao-mapa\"><svg><use href=\"#ic-regua\"></use></svg></button>\n          <button class=\"botao-mapa\"><svg><use href=\"#ic-borracha\"></use></svg></button>\n          <button class=\"botao-mapa\"><svg><use href=\"#ic-trator\"></use></svg></button>\n          <button class=\"botao-mapa\"><svg><use href=\"#ic-transferir\"></use></svg></button>\n          <button class=\"botao-mapa\"><svg><use href=\"#ic-camadas\"></use></svg></button>\n        </div>\n\n        <button class=\"aba-lista\" id=\"aba-lista\" title=\"Lista de tarefas\">\n          <svg viewBox=\"0 0 24 24\"><path d=\"M9 5l7 7-7 7z\"/></svg>\n        </button>\n\n        <div class=\"escala-mapa\"><span>10m</span><i></i></div>\n\n        <div class=\"caixa-info-tarefa\" id=\"caixa-info-tarefa\">\n          <div><span>Precisão do campo</span><em class=\"etiqueta-baixa\">Baixo(GNSS)</em></div>\n          <div><span>Área da tarefa</span><b id=\"info-area\">0.00</b><i>Ha</i></div>\n          <div><span>Volume pulverizado</span><b id=\"info-volume\">0.0</b><i>l</i></div>\n        </div>\n\n        <div class=\"acoes-direita\">\n          <button class=\"botao-selecao\"><svg><use href=\"#ic-selecao\"></use></svg></button>\n          <button class=\"botao-adicionar\" id=\"botao-novo-mapa\" data-ir=\"mapeamento\"><svg><use href=\"#ic-mais\"></use></svg><span>Adicionar</span></button>\n        </div>\n\n        <button class=\"botao-claro botao-dividir\" id=\"botao-dividir\">\n          <svg><use href=\"#ic-dividir\"></use></svg><span>Dividir campo</span>\n        </button>\n        <div class=\"acoes-inferiores\">\n          <button class=\"botao-claro\" id=\"botao-cancelar-selecao\"><svg><use href=\"#ic-x\"></use></svg><span>Cancelar</span></button>\n          <button class=\"botao-claro alterna desativado\" id=\"botao-edicao\"><svg><use href=\"#ic-lapis\"></use></svg><span>Edição</span></button>\n          <button class=\"botao-claro alterna desativado\" id=\"botao-usar\" data-exec=\"1\"><svg><use href=\"#ic-check\"></use></svg><span>Use</span></button>\n        </div>\n\n        <aside class=\"painel-tarefas\" id=\"painel-tarefas\">\n          <div class=\"abas-painel\">\n            <button class=\"aba ativa\" data-aba=\"Tarefa\">Tarefa</button>\n            <button class=\"aba\" data-aba=\"Em andamento\">Em anda<br>mento</button>\n          </div>\n          <div class=\"linha-busca\">\n            <div class=\"campo-busca\"><svg><use href=\"#ic-lupa\"></use></svg></div>\n            <button class=\"ordenar\"><svg><use href=\"#ic-ordenar\"></use></svg><span>Distância</span></button>\n          </div>\n          <div class=\"lista-tarefas\" id=\"lista-tarefas\"></div>\n          <p class=\"lista-vazia\" id=\"lista-vazia\">Nenhuma tarefa salva</p>\n          <button class=\"aba-fechar\" id=\"aba-fechar\" title=\"Fechar lista\">\n            <svg viewBox=\"0 0 24 24\"><path d=\"M15 5l-7 7 7 7z\"/></svg>\n          </button>\n        </aside>\n        <div class=\"dialogo-fundo\" id=\"dialogo-renomear\">\n          <div class=\"dialogo\">\n            <h3>Renomear tarefa</h3>\n            <p class=\"rotulo-dialogo\">Nome da tarefa</p>\n            <input type=\"text\" id=\"novo-nome\">\n            <div class=\"botoes-dialogo\">\n              <button id=\"cancelar-renomear\">Cancelar(R2)</button>\n              <button class=\"verde\" id=\"confirmar-renomear\">Salvar(R3)</button>\n            </div>\n          </div>\n        </div>\n      </section>\n\n      <!-- ============ TELA DE EXECUÇÃO DA TAREFA ============ -->\n      <section class=\"tela-app\" data-tela=\"execucao\">\n        <svg class=\"arte-mapa\" viewBox=\"0 0 1920 1200\" preserveAspectRatio=\"xMidYMid slice\">\n          <g transform=\"translate(-180 -300) scale(1.28)\">\n            <use href=\"#terreno\" x=\"0\" y=\"0\" width=\"1920\" height=\"1200\"/>\n          </g>\n          <g class=\"rota-execucao\">\n            <path d=\"M700 1020 L760 900 L880 830 L1010 800 L1150 780 L1280 720 L1380 640 L1470 540 L1560 430\"\n                  fill=\"none\" stroke=\"#fff\" stroke-width=\"7\" stroke-linecap=\"round\"/>\n            <path d=\"M540 1080 L620 860 L820 700 L1060 560 L1180 420 L1120 320 L900 300 L700 380 L560 520 L520 700 Z\"\n                  fill=\"none\" stroke=\"#f2e03c\" stroke-width=\"5\"/>\n            <path d=\"M1020 560 L1200 520 L1250 660 L1070 700 Z\" fill=\"rgba(232,68,46,.55)\" stroke=\"#e8442e\" stroke-width=\"5\"/>\n            <g fill=\"#c9a6e8\" stroke=\"#fff\" stroke-width=\"3\">\n              <circle cx=\"760\" cy=\"900\" r=\"11\"/><circle cx=\"880\" cy=\"830\" r=\"11\"/><circle cx=\"1010\" cy=\"800\" r=\"11\"/>\n              <circle cx=\"1150\" cy=\"780\" r=\"11\"/><circle cx=\"1280\" cy=\"720\" r=\"11\"/><circle cx=\"1380\" cy=\"640\" r=\"11\"/>\n              <circle cx=\"1470\" cy=\"540\" r=\"11\"/>\n            </g>\n            <circle cx=\"700\" cy=\"1020\" r=\"20\" fill=\"none\" stroke=\"#fff\" stroke-width=\"6\"/>\n            <circle cx=\"700\" cy=\"1020\" r=\"8\" fill=\"#fff\"/>\n            <path d=\"M1290 690 v-30 M1276 676 h28\" stroke=\"#fff\" stroke-width=\"5\" stroke-linecap=\"round\"/>\n          </g>\n        </svg>\n\n        <div class=\"barra-voo sempre\">\n          <button class=\"icone-barra\"><svg><use href=\"#ic-transferir\"></use></svg></button>\n          <span class=\"alerta-voo\">Incapaz de decolar</span>\n          <span class=\"data-voo\"></span>\n          <span class=\"status-voo\">\n            <i class=\"sinal\"><svg viewBox=\"0 0 24 24\"><rect x=\"3\" y=\"15\" width=\"3.4\" height=\"6\" rx=\"1\"/><rect x=\"8.4\" y=\"11\" width=\"3.4\" height=\"10\" rx=\"1\"/><rect x=\"13.8\" y=\"7\" width=\"3.4\" height=\"14\" rx=\"1\"/><rect x=\"19.2\" y=\"3\" width=\"3.4\" height=\"18\" rx=\"1\" opacity=\".35\"/></svg></i>\n            <i class=\"gnss\"><svg viewBox=\"0 0 24 24\"><path d=\"M12 2.6 4 20.4l8-4 8 4z\"/></svg><b>23</b>GNSS</i>\n            <i class=\"bat-drone\"><svg viewBox=\"0 0 24 24\"><rect x=\"2.6\" y=\"6.4\" width=\"16.4\" height=\"11.2\" rx=\"2.4\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"/><rect x=\"20.4\" y=\"10\" width=\"2.4\" height=\"4\" rx=\"1\"/><path d=\"M11.4 8.4 7.6 13.6h3l-.8 3.4 4.4-5.6h-3.2z\"/></svg>15%</i>\n            <i class=\"tanque\"><svg viewBox=\"0 0 24 24\"><path d=\"M5 9.4h14v8.2a2.4 2.4 0 0 1-2.4 2.4H7.4A2.4 2.4 0 0 1 5 17.6z\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"/><path d=\"M8 9.4V6.6a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2.8\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"/></svg>0.0/0.0</i>\n            <i class=\"bat-rc\"><svg viewBox=\"0 0 24 24\"><rect x=\"2.6\" y=\"6.4\" width=\"16.4\" height=\"11.2\" rx=\"2.4\"/><rect x=\"20.4\" y=\"10\" width=\"2.4\" height=\"4\" rx=\"1\"/></svg></i>\n          </span>\n          <button class=\"icone-barra abre-config\"><svg><use href=\"#ic-engrenagem\"></use></svg></button>\n        </div>\n\n        <div class=\"avisos-voo sempre\">\n          <div class=\"aviso-branco aviso-amarelo-voo\"><span>Sinal GNSS da aeronave fraco. Operar aeronave em área aberta, sem obstáculos. &gt;&gt;</span><button>×</button></div>\n          <div class=\"aviso-branco aviso-vermelho-voo\"><span>Pedestres ou obstáculos detectados perto da aeronave. Não é possível decolar &gt;&gt;</span></div>\n          <div class=\"aviso-branco\"><span>Ponto de origem registrado &gt;&gt;</span><button>×</button></div>\n          <div class=\"aviso-branco aviso-vermelho-voo\"><span>A trava do braço 3 não está firmemente apertada. Não é possível decolar. Certifique-se</span></div>\n        </div>\n\n        <aside class=\"painel-execucao\">\n          <div class=\"abas-exec\">\n            <button class=\"ativa\" data-aba-exec=\"tarefa\">Tarefa</button>\n            <button data-aba-exec=\"voo\">Voo</button>\n          </div>\n          <div class=\"conteudo-exec ativa\" data-exec-aba=\"tarefa\">\n            <div class=\"linha-gabarito\">\n              <button class=\"caixa-select\">Nenhum gabarito aplicado<i>⌄</i></button>\n              <button class=\"botao-reset\"><svg viewBox=\"0 0 24 24\"><path d=\"M12 5.4a6.6 6.6 0 1 0 6.4 8.2\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\"/><path d=\"M12 1.8v7l3.6-3.5z\"/></svg></button>\n            </div>\n            <p class=\"rotulo-campo\">Taxa de aplicação <span>(L/Ha)</span></p><div class=\"passo\"><button class=\"passo-botao\" data-exec=\"taxa\" data-delta=\"-1\">−</button><span class=\"passo-valor\" id=\"exec-taxa\">10.05</span><button class=\"passo-botao\" data-exec=\"taxa\" data-delta=\"1\">+</button></div>\n            <div class=\"linha-info\"><span>Fluxo</span><em>2.97 L/Min</em></div>\n            <button class=\"linha-link\"><span>Tamanho da gota de pulverização</span><em class=\"verde-valor\">220 µm</em><i>›</i></button>\n            <p class=\"rotulo-campo\">Velocidade do voo <span>(km/h)</span></p><div class=\"passo\"><button class=\"passo-botao\" data-exec=\"velocidade\" data-delta=\"-1\">−</button><span class=\"passo-valor\" id=\"exec-velocidade\">24.8</span><button class=\"passo-botao\" data-exec=\"velocidade\" data-delta=\"1\">+</button></div>\n            <p class=\"rotulo-campo\">Altura acima das culturas <span>(m)</span></p><div class=\"passo\"><button class=\"passo-botao\" data-exec=\"altura\" data-delta=\"-1\">−</button><span class=\"passo-valor\" id=\"exec-altura\">4.5</span><button class=\"passo-botao\" data-exec=\"altura\" data-delta=\"1\">+</button></div>\n            <p class=\"rotulo-campo\">Espaçamento de rota <span>(m)</span></p><div class=\"passo\"><button class=\"passo-botao\" data-exec=\"espacamento-exec\" data-delta=\"-1\">−</button><span class=\"passo-valor\" id=\"exec-espacamento-exec\">7.13</span><button class=\"passo-botao\" data-exec=\"espacamento-exec\" data-delta=\"1\">+</button></div>\n            <div class=\"linha-toggle-config\"><span class=\"rotulo-toggle\">Subida em baixa velocidade <span class=\"unidade\">(m)</span></span>\n              <button class=\"interruptor\"><i></i></button></div>\n          </div>\n          <div class=\"conteudo-exec\" data-exec-aba=\"voo\">\n            <p class=\"rotulo-campo\">Cenário</p>\n            <div class=\"lista-cenario\">\n              <button class=\"ativa\"><svg viewBox=\"0 0 24 24\"><rect x=\"3\" y=\"3\" width=\"8\" height=\"8\" rx=\"1.4\"/><rect x=\"13\" y=\"3\" width=\"8\" height=\"8\" rx=\"1.4\"/><rect x=\"3\" y=\"13\" width=\"8\" height=\"8\" rx=\"1.4\"/><rect x=\"13\" y=\"13\" width=\"8\" height=\"8\" rx=\"1.4\"/></svg><span>Planícies</span></button>\n              <button><svg viewBox=\"0 0 24 24\"><path d=\"M12 2.6 19 13h-4l3 6H8l3-6H7z\"/><rect x=\"11\" y=\"18\" width=\"2\" height=\"4\"/></svg><span>Pomar<br>Colina</span></button>\n              <button><svg viewBox=\"0 0 24 24\"><path d=\"M2.6 8.4c3-3 6-3 9 0s6 3 9 0M2.6 13.4c3-3 6-3 9 0s6 3 9 0M2.6 18.4c3-3 6-3 9 0s6 3 9 0\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"/></svg><span>Acima da água</span></button>\n            </div>\n            <p class=\"rotulo-campo\">Roteamento de conexão e velocidade RTH <span>(km/h)</span></p><div class=\"passo\"><button class=\"passo-botao\" data-exec=\"rth-vel\" data-delta=\"-1\">−</button><span class=\"passo-valor\" id=\"exec-rth-vel\">36.0</span><button class=\"passo-botao\" data-exec=\"rth-vel\" data-delta=\"1\">+</button></div>\n            <p class=\"rotulo-campo\">Roteamento de conexão e altitude RTH <span>(m)</span></p><div class=\"passo\"><button class=\"passo-botao\" data-exec=\"rth-alt\" data-delta=\"-1\">−</button><span class=\"passo-valor\" id=\"exec-rth-alt\">7</span><button class=\"passo-botao\" data-exec=\"rth-alt\" data-delta=\"1\">+</button></div>\n            <button class=\"linha-link coluna\"><span>Retorno à base automático<em class=\"verde-valor\">Totalmente ativado</em></span><i>›</i></button>\n            <div class=\"linha-toggle-config\"><span class=\"rotulo-toggle\"><svg class=\"alvo\" viewBox=\"0 0 24 24\"><circle cx=\"12\" cy=\"12\" r=\"9\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"/><circle cx=\"12\" cy=\"12\" r=\"3.4\"/></svg> desvio de obstáculos multidirecional</span>\n              <button class=\"interruptor ligado\"><i></i></button></div>\n            <div class=\"linha-toggle-config\"><span class=\"rotulo-toggle\"><svg class=\"alvo\" viewBox=\"0 0 24 24\"><circle cx=\"12\" cy=\"6.4\" r=\"2.6\"/><path d=\"M5.6 12.4a9 9 0 0 1 12.8 0M8.4 16.6a5 5 0 0 1 7.2 0\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"/></svg> Estabilização da altitude</span>\n              <button class=\"interruptor ligado\"><i></i></button></div>\n            <div class=\"linha-toggle-config\"><span class=\"rotulo-toggle\"><svg class=\"alvo\" viewBox=\"0 0 24 24\"><path d=\"M12 3.4v12M8 11.4l4 4.2 4-4.2\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><path d=\"M5.6 20.6h12.8\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"/></svg> Desvio de obstáculos</span>\n              <button class=\"interruptor ligado\"><i></i></button></div>\n          </div>\n        </aside>\n\n        <div class=\"escala-mapa\"><span>5m</span><i></i></div>\n\n        <div class=\"ferramentas-mapa\">\n          <button class=\"botao-mapa\"><svg><use href=\"#ic-pasta-mais\"></use></svg></button>\n          <button class=\"botao-mapa\"><svg><use href=\"#ic-regua\"></use></svg></button>\n          <button class=\"botao-mapa\"><svg><use href=\"#ic-borracha\"></use></svg></button>\n          <button class=\"botao-mapa\"><svg><use href=\"#ic-alvo\"></use></svg></button>\n          <button class=\"botao-mapa\"><svg><use href=\"#ic-transferir\"></use></svg></button>\n          <button class=\"botao-mapa\"><svg><use href=\"#ic-camadas\"></use></svg></button>\n        </div>\n\n        <div class=\"caixa-info-tarefa exec\">\n          <div><span>Precisão do campo</span><em class=\"etiqueta-baixa\">Baixo(GNSS)</em></div>\n          <div><span>Área da tarefa</span><b id=\"exec-area\">0.3</b><i>Ha</i></div>\n          <div><span>Volume pulverizado</span><b id=\"exec-volume\">3.02</b><i>l</i></div>\n        </div>\n\n        <button class=\"botao-claro botao-retificar\" id=\"botao-retificar\">Retificar a compensação</button>\n\n        <div class=\"bloco-conexao\">\n          <div class=\"legenda-conexao\"><span class=\"bolinha-rosa\"></span>Ponto de conexão</div>\n          <button class=\"botao-claro largo\">Adicionar</button>\n        </div>\n\n        <div class=\"acoes-inferiores\">\n          <button class=\"botao-claro\" data-ir=\"mapa\"><svg><use href=\"#ic-sair\"></use></svg><span>Sair</span></button>\n          <button class=\"botao-claro\"><svg><use href=\"#ic-lapis\"></use></svg><span>Edição</span></button>\n          <button class=\"botao-claro\" id=\"botao-iniciar\"><svg><use href=\"#ic-decolar\"></use></svg><span>Iniciar</span></button>\n        </div>\n\n        <div class=\"fpv sempre\">\n          <svg viewBox=\"0 0 160 100\" preserveAspectRatio=\"xMidYMid slice\">\n            <rect width=\"160\" height=\"100\" fill=\"#7d7d78\"/><rect y=\"52\" width=\"160\" height=\"48\" fill=\"#8e8e88\"/>\n            <rect x=\"18\" y=\"20\" width=\"52\" height=\"34\" fill=\"#b9b9b2\"/><rect x=\"74\" y=\"16\" width=\"46\" height=\"38\" fill=\"#a6a6a0\"/>\n            <path d=\"M0 52h160\" stroke=\"#6d6d68\" stroke-width=\"2\"/>\n          </svg>\n        </div>\n        <div class=\"bussola sempre\">\n          <svg viewBox=\"0 0 120 120\">\n            <circle cx=\"60\" cy=\"60\" r=\"56\" fill=\"rgba(20,26,36,.62)\"/>\n            <circle cx=\"60\" cy=\"60\" r=\"40\" fill=\"none\" stroke=\"#fff\" stroke-width=\"1.6\" stroke-dasharray=\"2 5\" opacity=\".8\"/>\n            <g stroke=\"#e8442e\" stroke-width=\"3\" stroke-linecap=\"round\">\n              <path d=\"M60 60 42 30M60 60 60 26M60 60 78 32M60 60 92 52M60 60 88 74M60 60 30 46M60 60 26 62M60 60 32 78\"/>\n            </g>\n            <g fill=\"#fff\" font-size=\"9\" font-family=\"Inter,sans-serif\">\n              <text x=\"40\" y=\"24\">1.4</text><text x=\"62\" y=\"20\">1.5</text><text x=\"78\" y=\"26\">1.4</text>\n              <text x=\"96\" y=\"52\">1.4</text><text x=\"18\" y=\"50\">2.2</text><text x=\"18\" y=\"66\">2.6</text>\n            </g>\n            <path d=\"M60 44 68 70h-16z\" fill=\"#f0c419\"/>\n            <text x=\"60\" y=\"114\" text-anchor=\"middle\" font-size=\"12\" fill=\"#fff\" font-family=\"Inter,sans-serif\">N</text>\n          </svg>\n        </div>\n        <div class=\"barra-dados sempre\">\n          <div><span>△ Relativo à origem</span><b>0,0</b><i>m</i></div>\n          <div><span>Velocidade</span><b>0.0</b><i>km/h</i></div>\n          <div><span>Distância</span><b>0.2</b><i>m</i></div>\n          <div><span>Fluxo</span><b>0.0</b><i>L/Min</i></div>\n        </div>\n\n        <div class=\"dialogo-fundo\" id=\"dialogo-upload\">\n          <div class=\"dialogo\">\n            <div class=\"marca-erro\">!</div>\n            <h3>Falha no upload da tarefa</h3>\n            <p class=\"texto-erro\">Incapaz de decolar</p>\n            <div class=\"botoes-dialogo\">\n              <button id=\"cancelar-upload\">Cancelar(R2)</button>\n              <button class=\"verde\" id=\"tentar-upload\">Tentar novamente(R3)</button>\n            </div>\n          </div>\n        </div>\n\n        <aside class=\"painel-retificar\" id=\"painel-retificar\">\n          <h3>Retificar a compensação</h3>\n          <div class=\"dpad\">\n            <button class=\"seta cima\">∧</button>\n            <button class=\"seta esq\">‹</button>\n            <span class=\"centro\"><b id=\"valor-compensacao\">0.0</b><i>m</i><em>Distância<br>ajustada</em></span>\n            <button class=\"seta dir\">›</button>\n            <button class=\"seta baixo\">∨</button>\n          </div>\n          <div class=\"botoes-dialogo\">\n            <button id=\"cancelar-retificar\">Cancelar(R2)</button>\n            <button class=\"verde\" id=\"confirmar-retificar\">Sim(R3)</button>\n          </div>\n        </aside>\n      </section>\n\n      <!-- ============ TELA DE DIVIDIR CAMPO ============ -->\n      <section class=\"tela-app\" data-tela=\"dividir\">\n        <svg class=\"arte-mapa\" viewBox=\"0 0 1920 1200\" preserveAspectRatio=\"xMidYMid slice\" id=\"mapa-dividir\">\n          <g id=\"zoom-dividir\">\n            <use href=\"#terreno\" x=\"0\" y=\"0\" width=\"1920\" height=\"1200\"/>\n            <g id=\"camada-dividir\"></g>\n          </g>\n          <g id=\"reticulo-dividir\"></g>\n        </svg>\n\n        <div class=\"barra-superior\">\n          <button class=\"icone-barra\"><svg><use href=\"#ic-transferir\"></use></svg></button>\n          <span class=\"estado-aeronave\">Aeronave desconectada</span>\n          <div class=\"barra-direita\">\n            <span class=\"bloco-gnss\">\n              <span class=\"rc-bateria\"><svg><use href=\"#ic-rc\"></use></svg><i>17</i></span>\n              <span class=\"gnss\"><b>6</b>GNSS</span>\n            </span>\n            <button class=\"icone-barra abre-config\"><svg><use href=\"#ic-engrenagem\"></use></svg></button>\n          </div>\n        </div>\n\n        <div class=\"escala-mapa\"><span>10m</span><i></i></div>\n\n        <div class=\"ferramentas-mapa\">\n          <button class=\"botao-mapa\"><svg><use href=\"#ic-pasta-mais\"></use></svg></button>\n          <button class=\"botao-mapa\"><svg><use href=\"#ic-regua\"></use></svg></button>\n          <button class=\"botao-mapa\" id=\"apagar-ancora\"><svg><use href=\"#ic-borracha\"></use></svg></button>\n          <button class=\"botao-mapa\"><svg><use href=\"#ic-trator\"></use></svg></button>\n          <button class=\"botao-mapa\"><svg><use href=\"#ic-transferir\"></use></svg></button>\n          <button class=\"botao-mapa\"><svg><use href=\"#ic-camadas\"></use></svg></button>\n        </div>\n\n        <div class=\"painel-dividir\">\n          <div class=\"legenda-ancoragem\"><span class=\"bolinha-ancoragem\"></span>Ponto de ancoragem</div>\n          <button class=\"botao-claro largo\" id=\"botao-adicionar-ancora\">Adicionar</button>\n        </div>\n\n        <div class=\"acoes-inferiores\">\n          <button class=\"botao-claro\" data-ir=\"mapa\"><svg><use href=\"#ic-sair\"></use></svg><span>Sair</span></button>\n          <button class=\"botao-claro desativado\" id=\"botao-salvar-divisao\">\n            <svg><use href=\"#ic-check\"></use></svg><span>Salvar<br>como</span>\n          </button>\n        </div>\n      </section>\n\n      <!-- ============ TELA DE MAPEAMENTO ============ -->\n      <section class=\"tela-app\" data-tela=\"mapeamento\">\n        <svg class=\"arte-mapa\" viewBox=\"0 0 1920 1200\" preserveAspectRatio=\"xMidYMid slice\" id=\"mapa-trabalho\">\n          <g id=\"mapa-panoramica\">\n            <g transform=\"translate(-315 -450) scale(1.5)\">\n              <use href=\"#terreno\" x=\"0\" y=\"0\" width=\"1920\" height=\"1200\"/>\n            </g>\n            <g id=\"camada-desenho\"></g>\n          </g>\n        </svg>\n\n        <div class=\"barra-superior\">\n          <button class=\"icone-barra\"><svg><use href=\"#ic-transferir\"></use></svg></button>\n          <span class=\"estado-aeronave\">Aeronave desconectada</span>\n          <div class=\"barra-direita\">\n            <span class=\"bloco-gnss\">\n              <span class=\"rc-bateria\"><svg><use href=\"#ic-rc\"></use></svg><i id=\"valor-bateria\">22</i></span>\n              <span class=\"gnss\"><b id=\"valor-satelites\">4</b>GNSS</span>\n            </span>\n            <button class=\"icone-barra abre-config\"><svg><use href=\"#ic-engrenagem\"></use></svg></button>\n          </div>\n        </div>\n\n        <!-- aba que recolhe e abre o painel de configurações de rota -->\n        <button class=\"alternar-painel-rota\" id=\"alternar-painel-rota\" aria-label=\"Recolher o painel\">&#8249;</button>\n\n        <!-- painel de configurações de rota -->\n        <aside class=\"painel-rota\" id=\"painel-rota\">\n          <h2>Configurações de rota de voo</h2>\n          <div class=\"abas-rota\">\n            <button class=\"aba-rota ativa\" data-aba=\"basico\">Básico</button>\n            <button class=\"aba-rota\" data-aba=\"avancado\">Avançado</button>\n          </div>\n\n          <div class=\"conteudo-rota ativa\" data-conteudo=\"basico\">\n            <div class=\"passo primeiro\">\n              <button class=\"passo-botao\" data-passo=\"espacamento\" data-delta=\"-0.5\">−</button>\n              <span class=\"passo-valor\" id=\"valor-espacamento\">6.0</span>\n              <button class=\"passo-botao\" data-passo=\"espacamento\" data-delta=\"0.5\">+</button>\n            </div>\n            <p class=\"rotulo-campo\">Margens de campo ampliadas <span>(m)</span></p>\n            <div class=\"segmentado\" id=\"seg-margem\">\n              <button class=\"ativa\" data-margem=\"Geral\">Geral</button>\n              <button data-margem=\"Um lado\">Um lado</button>\n            </div>\n            <div class=\"passo\">\n              <button class=\"passo-botao\" data-passo=\"margem\" data-delta=\"-0.5\">−</button>\n              <span class=\"passo-valor\" id=\"valor-margem\">1.5</span>\n              <button class=\"passo-botao\" data-passo=\"margem\" data-delta=\"0.5\">+</button>\n            </div>\n            <div class=\"rodape-rota\">\n              <span class=\"ponto-inicial\">Ponto inicial <b>⌄</b></span>\n              <button class=\"botao-contorno\">Configurações</button>\n            </div>\n          </div>\n\n          <div class=\"conteudo-rota\" data-conteudo=\"avancado\">\n            <p class=\"rotulo-campo\">Área de cobertura</p>\n            <div class=\"lista-cobertura\" id=\"lista-cobertura\">\n              <button class=\"ativa\" data-cobertura=\"Somente rota\"><svg><use href=\"#ic-somente-rota\"></use></svg><span>Somente rota</span></button>\n              <button data-cobertura=\"Rota e fronteira\"><svg><use href=\"#ic-rota-fronteira\"></use></svg><span>Rota e fronteira</span></button>\n              <button data-cobertura=\"Somente fronteira\"><svg><use href=\"#ic-somente-fronteira\"></use></svg><span>Somente fronteira</span></button>\n            </div>\n            <div class=\"linha-toggle\">\n              <span class=\"rotulo-campo\">Pulverização apenas um lado <svg class=\"info\"><use href=\"#ic-info\"></use></svg></span>\n              <button class=\"interruptor\" id=\"interruptor-umlado\"><i></i></button>\n            </div>\n            <div class=\"linha-config\"><span>Ângulo da rota</span><button class=\"botao-contorno\">Configurações</button></div>\n            <div class=\"linha-config\"><span>Segmentação de rota</span><button class=\"botao-contorno\">Configurações</button></div>\n          </div>\n        </aside>\n\n        <!-- aviso amarelo -->\n        <div class=\"aviso-amarelo\" id=\"aviso-amarelo\">\n          <span>Gravando pontos com retículo. Adicionar ponto dentro da área mapeada para maior precisão &gt;&gt;</span>\n          <button class=\"fechar-aviso\" id=\"fechar-aviso\">×</button>\n        </div>\n\n        <!-- ferramentas -->\n        <div class=\"ferramentas-mapa\">\n          <button class=\"botao-mapa\"><svg><use href=\"#ic-pasta-mais\"></use></svg></button>\n          <button class=\"botao-mapa\"><svg><use href=\"#ic-regua\"></use></svg></button>\n          <button class=\"botao-mapa\" id=\"botao-apagar\"><svg><use href=\"#ic-borracha\"></use></svg></button>\n          <button class=\"botao-mapa\"><svg><use href=\"#ic-trator\"></use></svg></button>\n          <button class=\"botao-mapa\"><svg><use href=\"#ic-transferir\"></use></svg></button>\n          <button class=\"botao-mapa\"><svg><use href=\"#ic-camadas\"></use></svg></button>\n        </div>\n\n        <!-- áreas -->\n        <div class=\"caixa-areas\">\n          <div><span>Área de campo</span><b id=\"area-campo\">0.0</b><i>Ha</i></div>\n          <div><span>Área da tarefa</span><b id=\"area-tarefa\">0.0</b><i>Ha</i></div>\n        </div>\n\n        <!-- tipos de ponto -->\n        <div class=\"lista-tipos\" id=\"lista-tipos\">\n          <button data-tipo=\"Marcar linha\"><span class=\"bolinha onda\"><svg><use href=\"#ic-linha-onda\"></use></svg></span><span>Marcar linha</span></button>\n          <button data-tipo=\"Marcar ponto\"><span class=\"bolinha pino\"><svg><use href=\"#ic-pin\"></use></svg></span><span>Marcar ponto</span></button>\n          <button data-tipo=\"Área sem aplicação\"><span class=\"bolinha cinza\"></span><span>Área sem aplicação</span></button>\n          <button data-tipo=\"Redondo\"><span class=\"bolinha anel\"></span><span>Redondo</span></button>\n          <button data-tipo=\"Ponto de obstáculo\"><span class=\"bolinha vermelha\"></span><span>Ponto de obstáculo</span></button>\n          <button class=\"ativa\" data-tipo=\"Ponto limite\"><span class=\"bolinha roxa\"></span><span>Ponto limite</span></button>\n        </div>\n\n        <!-- adicionar ponto -->\n        <div class=\"linha-adicionar\">\n          <button class=\"botao-reticulo\" id=\"botao-reticulo\"><svg><use href=\"#ic-reticulo\"></use></svg></button>\n          <button class=\"botao-adicionar-ponto\" id=\"botao-adicionar-ponto\">Adicionar</button>\n        </div>\n        <div class=\"menu-metodo\" id=\"menu-metodo\">\n          <p>Adicionar ponto com</p>\n          <button class=\"ativa\" data-metodo=\"Retículo\"><svg><use href=\"#ic-reticulo\"></use></svg><span>Retículo</span></button>\n          <button data-metodo=\"Controlador\"><svg><use href=\"#ic-rc\"></use></svg><span>Controlador</span></button>\n          <button data-metodo=\"Aeronave\"><svg><use href=\"#ic-aeronave\"></use></svg><span>Aeronave</span></button>\n        </div>\n\n        <!-- sair / salvar -->\n        <div class=\"acoes-inferiores\">\n          <button class=\"botao-claro\" data-ir=\"mapa\"><svg><use href=\"#ic-sair\"></use></svg><span>Sair</span></button>\n          <button class=\"botao-claro\" id=\"botao-salvar\"><svg><use href=\"#ic-check\"></use></svg><span>Salvar</span></button>\n        </div>\n\n        <!-- diálogo salvar -->\n        <div class=\"dialogo-fundo\" id=\"dialogo-salvar\">\n          <div class=\"dialogo\">\n            <h3>Salvar como tarefa</h3>\n            <p class=\"rotulo-dialogo\">Nome da tarefa</p>\n            <input type=\"text\" id=\"nome-tarefa\" value=\"\">\n            <div class=\"botoes-dialogo\">\n              <button id=\"cancelar-salvar\">Cancelar(R2)</button>\n              <button class=\"verde\" id=\"confirmar-salvar\">Salvar(R3)</button>\n            </div>\n          </div>\n        </div>\n      </section>\n\n      <div class=\"painel-config\" id=\"painel-config\"></div>\n      <div class=\"painel-config\" id=\"painel-extra\"></div>\n    </div>\n    </div>\n\n  <div class=\"leds\"><span class=\"led vermelho\"></span><span class=\"led verde\"></span><span class=\"led apagado\"></span></div>\n\n</div>\n</div>\n\n<script src=\"script.js?v=21caeb89bde4\"></script>\n<script src=\"configuracoes.js?v=93875f55cb6e\"></script>\n<script src=\"telas_extra.js?v=3f45138a6cdf\"></script>\n<script src=\"telas_gravadas.js?v=914cbad63a89\"></script>\n<script src=\"telas_drone.js?v=4dd75d6fcc7e\"></script>\n</body>\n</html>\n"
