          "content": {
            "size": 13500,
            "mimeType": "text/css",
            "text": "/* ============================================================\r\n   Telas tiradas das gravações do RC Plus de verdade\r\n   ============================================================ */\r\n\r\n/* No aparelho a engrenagem abre um painel na direita, da altura da tela,\r\n   com o mapa aparecendo à esquerda (menu em x=624..744 de 1920). */\r\n#painel-config{justify-content:flex-end;}\r\n#painel-config .caixa-config{width:67.5%;height:100%;border-radius:0;}\r\n\r\n/* As telas da tela inicial ocupam a tela inteira, com o X no canto. */\r\n.caixa-extra{width:100%;height:100%;border-radius:0;box-shadow:none;}\r\n.caixa-extra .rolagem-config{position:relative;}\r\n\r\n/* ---------- peças comuns ---------- */\r\n.aviso-rapido{\r\n  position:absolute;left:50%;bottom:6%;transform:translateX(-50%);z-index:40;\r\n  background:#fff;border-radius:.8cqw;box-shadow:0 .4cqw 1.6cqw rgba(0,0,0,.18);\r\n  padding:1cqw 1.8cqw;display:flex;align-items:center;gap:.8cqw;font-size:1.8cqw;color:#2f3336;white-space:nowrap;\r\n}\r\n.aviso-rapido svg{width:2.2cqw;height:2.2cqw;fill:var(--verde);}\r\n.dialogo-app{z-index:35;background:rgba(0,0,0,.4);}\r\n.dialogo-app .dialogo{width:40cqw;text-align:center;}\r\n.dialogo-app h3{font-weight:500;color:#2f3336;line-height:1.4;}\r\n.marca-ok{width:3.2cqw;height:3.2cqw;margin:0 auto .8cqw;}\r\n.marca-ok svg{width:100%;height:100%;fill:var(--verde);}\r\n\r\n.lista-suspensa{\r\n  position:absolute;z-index:45;background:#fff;border-radius:.6cqw;box-shadow:0 .6cqw 2cqw rgba(0,0,0,.2);\r\n  max-height:22cqw;overflow-y:auto;display:flex;flex-direction:column;padding:.4cqw 0;\r\n}\r\n.lista-suspensa button{\r\n  background:transparent;border:0;cursor:pointer;font-family:inherit;text-align:left;\r\n  font-size:1.75cqw;color:#2f3336;padding:1cqw 1.4cqw;line-height:1.35;\r\n}\r\n.lista-suspensa button.ativa{color:var(--verde-texto);}\r\n.caixa-select.aberta{box-shadow:0 0 0 .16cqw var(--verde);}\r\n.caixa-select.aberta i{transform:rotate(180deg);}\r\n\r\n.marcar{\r\n  width:2.2cqw;height:2.2cqw;border-radius:.3cqw;border:.16cqw solid #b4b8bb;background:#fff;flex:none;\r\n  display:inline-grid;place-items:center;cursor:pointer;\r\n}\r\n.marcar.marcado{background:var(--verde);border-color:var(--verde);}\r\n.marcar.marcado:after{content:'';width:.6cqw;height:1.1cqw;border:solid #fff;border-width:0 .28cqw .28cqw 0;transform:translateY(-.1cqw) rotate(45deg);}\r\n.botao-verde{\r\n  background:var(--verde);color:#fff;border:0;border-radius:.6cqw;cursor:pointer;font-family:inherit;\r\n  font-size:1.85cqw;padding:.8cqw 1.8cqw;white-space:nowrap;\r\n}\r\n.botao-verde.apagado,.botao-excluir.apagado{opacity:.4;cursor:default;}\r\n.botao-excluir{\r\n  background:#fff;color:#e8442e;border:.14cqw solid #e8442e;border-radius:.6cqw;cursor:pointer;font-family:inherit;\r\n  font-size:1.85cqw;padding:.7cqw 1.6cqw;\r\n}\r\n\r\n/* ---------- engrenagem: tabela dos motores, peso, RTK ---------- */\r\n.tabela-config .linha:not(.cabecalho){display:grid;grid-template-columns:1fr 1fr 1fr;padding:1cqw 1.2cqw;}\r\n.tabela-config .linha:not(.cabecalho) span{font-size:1.8cqw;color:#2f3336;}\r\n.campo-lapis{\r\n  width:22cqw;height:3.6cqw;background:#ececeb;border-radius:.5cqw;display:flex;justify-content:flex-end;\r\n  align-items:center;padding:0 1cqw;\r\n}\r\n.campo-lapis svg{width:1.9cqw;height:1.9cqw;fill:#8b8f93;}\r\n\r\n.rtk-desligado .rtk-corpo{display:none;}\r\n.fonte-rede .so-drtk,.fonte-drtk .so-rede{display:none;}\r\n.aviso-drtk{\r\n  display:flex;gap:1cqw;background:#fdf3e4;border-radius:.6cqw;padding:1.2cqw;margin-top:1cqw;\r\n}\r\n.aviso-drtk b{\r\n  width:2.2cqw;height:2.2cqw;border-radius:50%;background:#f08a24;color:#fff;flex:none;\r\n  display:grid;place-items:center;font-size:1.5cqw;\r\n}\r\n.aviso-drtk p{margin:0;font-size:1.75cqw;color:#2f3336;line-height:1.5;}\r\n.coordenadas-rtk{background:#ececeb;border-radius:.6cqw;padding:1.2cqw;margin-bottom:1.2cqw;}\r\n.coordenadas-rtk .topo{display:flex;justify-content:space-between;align-items:center;font-size:1.9cqw;color:#2f3336;}\r\n.coordenadas-rtk .nome{margin:.6cqw 0;font-size:1.7cqw;color:#8b8f93;}\r\n.coordenadas-rtk .valores{display:grid;grid-template-columns:repeat(3,1fr);}\r\n.coordenadas-rtk .valores div{display:flex;flex-direction:column;gap:.2cqw;}\r\n.coordenadas-rtk .valores b{font-size:2cqw;color:#2f3336;font-weight:500;}\r\n.coordenadas-rtk .valores span{font-size:1.5cqw;color:#8b8f93;}\r\n\r\n/* ---------- calibração do controle ---------- */\r\n.calibracao-cr .dialogo{width:58cqw;}\r\n.cal-cartoes{display:flex;gap:1.4cqw;margin-bottom:.4cqw;}\r\n.cal-pino,.cal-roda{flex:1;background:#ececeb;border-radius:.6cqw;padding:1cqw;position:relative;}\r\n.cal-pino{height:22cqw;}\r\n.cal-pino p,.cal-roda p{margin:0;text-align:left;font-size:1.6cqw;color:#2f3336;}\r\n.cal-pino .c{position:absolute;font-size:1.5cqw;color:#5b5f63;}\r\n.cal-pino .cima{left:50%;top:3.2cqw;transform:translateX(-50%);}\r\n.cal-pino .baixo{left:50%;bottom:.8cqw;transform:translateX(-50%);}\r\n.cal-pino .esquerda{left:1.2cqw;top:50%;}\r\n.cal-pino .direita{right:1.2cqw;top:50%;}\r\n.cal-cruz{\r\n  position:absolute;left:22%;right:22%;top:5.6cqw;bottom:3cqw;cursor:grab;touch-action:none;\r\n  background:linear-gradient(#cfd2d4,#cfd2d4) center/.2cqw 100% no-repeat,\r\n             linear-gradient(#cfd2d4,#cfd2d4) center/100% .2cqw no-repeat;\r\n}\r\n.cal-cruz .ponto{\r\n  position:absolute;left:calc(50% - 1cqw);top:calc(50% - 1cqw);width:2cqw;height:2cqw;border-radius:50%;\r\n  background:var(--verde);box-shadow:0 0 0 .4cqw rgba(58,181,74,.25);\r\n}\r\n.barra-roda{display:flex;align-items:center;gap:.8cqw;margin:1cqw 0;font-size:1.5cqw;color:#5b5f63;}\r\n.barra-roda .trilho{flex:1;height:.6cqw;background:#d4d6d8;border-radius:.3cqw;position:relative;cursor:ew-resize;touch-action:none;}\r\n.barra-roda .trilho i{position:absolute;top:0;bottom:0;background:var(--verde);border-radius:.3cqw;width:0;}\r\n.barra-roda .neg{right:50%;}\r\n.barra-roda .pos{left:50%;}\r\n.figura-roda{width:100%;height:9cqw;}\r\n\r\n/* ---------- perfil > registros de voo ---------- */\r\n.topo-voos{display:flex;justify-content:space-between;align-items:center;padding:.6cqw 0 1.2cqw;}\r\n.tabela-voos{display:flex;flex-direction:column;gap:.8cqw;}\r\n.tabela-voos .linha{\r\n  display:grid;grid-template-columns:1.3fr 1fr 1fr .9fr 1fr;align-items:end;gap:1cqw;position:relative;\r\n  background:#fff;border-radius:.6cqw;padding:1.2cqw 1.4cqw;font-size:1.75cqw;color:#2f3336;\r\n}\r\n.tabela-voos .linha.cabecalho{background:transparent;padding-top:0;padding-bottom:0;color:#5b5f63;font-size:1.6cqw;}\r\n.tabela-voos .linha span b{display:block;font-weight:400;margin-bottom:.5cqw;}\r\n.tabela-voos .linha span i{font-style:normal;}\r\n.tabela-voos .linha .nuvem{position:absolute;right:1cqw;top:.8cqw;width:2cqw;height:2cqw;}\r\n\r\n/* ---------- pastinha ---------- */\r\n.item-arquivo{cursor:default;border:.14cqw solid transparent;}\r\n.item-arquivo[data-item]{cursor:pointer;}\r\n.item-arquivo.marcado{background:#e4f1e8;border-color:var(--verde);}\r\n.item-arquivo.sd{background:#fff;}\r\n.item-arquivo.sd.marcado{background:#e4f1e8;}\r\n.aviso-sd{padding:.2cqw 0 1cqw;}\r\n.aviso-sd p{margin:0 0 .4cqw;display:flex;gap:.6cqw;font-size:1.55cqw;color:#5b5f63;line-height:1.4;}\r\n.aviso-sd i{\r\n  width:1.7cqw;height:1.7cqw;border-radius:50%;background:#5b5f63;color:#fff;flex:none;font-style:normal;\r\n  display:grid;place-items:center;font-size:1.1cqw;margin-top:.1cqw;\r\n}\r\n.rodape-selecao{\r\n  position:sticky;bottom:-1.6cqw;margin:1cqw -2cqw -1.6cqw;padding:1.2cqw 2cqw;background:#fff;\r\n  display:flex;align-items:center;gap:1.6cqw;border-top:.12cqw solid #ececeb;z-index:2;\r\n}\r\n.marcas-rodape{display:flex;flex-direction:column;gap:.6cqw;}\r\n.marcar-linha{display:flex;align-items:center;gap:.8cqw;font-size:1.75cqw;color:#2f3336;cursor:pointer;}\r\n.rodape-selecao .desmarcar{\r\n  background:transparent;border:0;cursor:pointer;font-family:inherit;font-size:1.75cqw;color:#2f3336;\r\n  margin-left:auto;margin-right:auto;\r\n}\r\n.rodape-selecao .contagem{font-size:1.75cqw;color:var(--verde-texto);margin-left:auto;}\r\n\r\n/* ---------- gerenciamento de registros ---------- */\r\n.extra-registros .rolagem-config{background:#f0f0ef;}\r\n.topo-registros{display:flex;gap:1cqw;padding:1.2cqw 0;}\r\n.topo-registros .chip{\r\n  background:#fff;border:0;border-radius:.6cqw;cursor:pointer;font-family:inherit;font-size:1.75cqw;color:#2f3336;\r\n  padding:.9cqw 1.4cqw;display:flex;align-items:center;gap:.6cqw;\r\n}\r\n.topo-registros .chip.direita{margin-left:auto;background:transparent;}\r\n.topo-registros .chip i{font-style:normal;font-size:2.2cqw;color:#5b5f63;}\r\n.grade-registros{display:grid;grid-template-columns:1fr 1fr;gap:1.2cqw;}\r\n.cartao-registro{\r\n  background:#fff;border:0;border-radius:.8cqw;cursor:pointer;font-family:inherit;text-align:left;\r\n  padding:1.6cqw;min-height:13cqw;display:flex;flex-direction:column;gap:.8cqw;position:relative;overflow:hidden;\r\n}\r\n.cartao-registro:nth-child(n+3){min-height:7cqw;}\r\n.cartao-registro b{font-size:2.1cqw;color:#2f3336;font-weight:600;}\r\n.cartao-registro span{font-size:1.6cqw;color:#5b5f63;line-height:1.45;max-width:85%;}\r\n.cartao-registro svg{position:absolute;right:1.6cqw;bottom:1cqw;width:6cqw;height:6cqw;fill:#eeeeed;}\r\n.cartao-registro.apagado{cursor:default;}\r\n.cartao-registro.apagado b,.cartao-registro.apagado span{color:#c4c8ca;}\r\n.dica-registros{margin:1.4cqw 0 0;text-align:center;font-size:1.5cqw;color:#8b8f93;}\r\n.lista-registros{display:flex;flex-direction:column;position:relative;min-height:20cqw;}\r\n.lista-registros .registro{\r\n  display:flex;align-items:center;gap:1.2cqw;padding:1.3cqw .6cqw;border-bottom:.12cqw solid #e6e6e5;\r\n  font-size:1.85cqw;color:#2f3336;cursor:pointer;\r\n}\r\n.lista-registros.carregando .registro{display:none;}\r\n.lista-registros .girando{display:none;}\r\n.lista-registros.carregando .girando{\r\n  display:block;position:absolute;left:50%;top:6cqw;width:3cqw;height:3cqw;border-radius:50%;\r\n  border:.3cqw solid var(--verde);border-right-color:transparent;animation:girar-registro .8s linear infinite;\r\n}\r\n@keyframes girar-registro{to{transform:rotate(360deg);}}\r\n\r\n/* ---------- firmware ---------- */\r\n.extra-dispositivo.em-sub .rolagem-config{background:#f0f0ef;}\r\n.lista-firmware{display:grid;grid-template-columns:repeat(4,1fr);gap:1.2cqw;padding-top:1cqw;}\r\n.cartao-firmware{\r\n  background:#fff;border-radius:.8cqw;padding:1.2cqw;display:flex;flex-direction:column;gap:1cqw;min-height:14cqw;\r\n}\r\n.cartao-firmware .nome{font-size:1.9cqw;color:#2f3336;text-align:center;}\r\n.cartao-firmware.apagado .nome{color:#c4c8ca;}\r\n.cartao-firmware.apagado .marcar{opacity:.4;cursor:default;}\r\n.versao-firmware{\r\n  margin-top:auto;background:#f0f0ef;border:0;border-radius:.6cqw;cursor:pointer;font-family:inherit;\r\n  display:flex;align-items:center;justify-content:space-between;padding:.8cqw 1cqw;text-align:left;\r\n}\r\n.versao-firmware span{display:flex;flex-direction:column;font-size:1.45cqw;color:#8b8f93;}\r\n.versao-firmware b{font-size:1.7cqw;color:#2f3336;font-weight:400;}\r\n.versao-firmware i{font-style:normal;font-size:2.4cqw;color:#5b5f63;}\r\n.fundo-firmware{position:absolute;inset:0;background:rgba(0,0,0,.4);z-index:5;display:flex;justify-content:flex-end;}\r\n.painel-firmware{width:67.5%;height:100%;background:#fff;padding:1.4cqw 2cqw;overflow-y:auto;}\r\n.painel-firmware .topo{display:flex;align-items:center;justify-content:center;position:relative;margin-bottom:1.2cqw;}\r\n.painel-firmware h2{margin:0;font-size:2.2cqw;font-weight:500;color:#2f3336;}\r\n.painel-firmware .topo .botao-verde{position:absolute;right:0;padding:.5cqw 1.2cqw;}\r\n.tipo-versao{margin:1cqw 0 .6cqw;font-size:1.6cqw;color:#8b8f93;}\r\n.painel-firmware .versao{\r\n  display:flex;align-items:flex-start;gap:1cqw;border:.14cqw solid #e6e6e5;border-radius:.8cqw;padding:1.2cqw;\r\n}\r\n.painel-firmware .versao.atual{background:#e4f1e8;border-color:var(--verde);border-bottom-left-radius:0;border-bottom-right-radius:0;}\r\n.painel-firmware .versao .bolha{width:2cqw;height:2cqw;border-radius:50%;border:.26cqw solid #c4c8ca;flex:none;margin-top:.2cqw;}\r\n.painel-firmware .versao.atual .bolha{border:.6cqw solid var(--verde);}\r\n.painel-firmware .versao div{flex:1;display:flex;flex-direction:column;gap:.3cqw;}\r\n.painel-firmware .versao b{font-size:1.9cqw;color:#2f3336;font-weight:500;}\r\n.painel-firmware .versao.atual b{color:var(--verde-texto);}\r\n.painel-firmware .versao em{font-style:normal;font-size:1.4cqw;color:var(--verde-texto);background:#cdebd6;border-radius:.4cqw;padding:.1cqw .6cqw;margin-left:.6cqw;}\r\n.painel-firmware .versao span{font-size:1.6cqw;color:#5b5f63;}\r\n.painel-firmware .versao i{font-style:normal;font-size:1.6cqw;color:#5b5f63;}\r\n.notas-versao{\r\n  background:#e4f1e8;border:.14cqw solid var(--verde);border-top:0;border-radius:0 0 .8cqw .8cqw;\r\n  padding:1cqw 1.4cqw 1.4cqw;font-size:1.5cqw;color:#5b5f63;line-height:1.5;margin-bottom:.6cqw;\r\n}\r\n\n/* rodapé da seleção sempre embaixo, como no aparelho */\n.extra-arquivos .rolagem-config,.extra-dispositivo.em-sub .rolagem-config{display:flex;flex-direction:column;}\n.extra-arquivos .lista-arquivos{flex:none;}\n.extra-arquivos .lista-arquivos:has(.vazio-central){flex:1;}\n.rodape-selecao{margin-top:auto;}\n\n/* baixando da nuvem */\n.icone-baixar{display:flex;justify-content:center;margin-bottom:.6cqw;}\n.icone-baixar .nuvem{width:3.2cqw;height:3.2cqw;}\n.progresso-baixar{height:.5cqw;background:#e6e6e5;border-radius:.3cqw;margin:1.6cqw 1cqw .6cqw;overflow:hidden;}\n.progresso-baixar i{display:block;height:100%;width:0;background:var(--verde);transition:width .15s;}\n.dialogo-baixar .porcento{margin:0 1cqw;text-align:left;font-size:1.6cqw;color:var(--verde-texto);}\n.dialogo-baixar h3{font-size:1.9cqw;}\n"
          },
