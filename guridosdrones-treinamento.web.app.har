          "content": {
            "size": 8175,
            "mimeType": "text/css",
            "text": "/* ==========================================================================\r\n   A camada de treinamento por cima do campo\r\n\r\n   Regra: o campo manda. A guia do instrutor e uma faixa estreita no canto,\r\n   que da para recolher - ela nunca pode disputar espaco com o HUD do\r\n   simulador nem tapar a aeronave.\r\n   ========================================================================== */\r\n\r\n:root {\r\n  --vidro:       rgba(9, 16, 22, .92);\r\n  --borda:       rgba(255, 255, 255, .14);\r\n  --texto:       #EAF1EC;\r\n  --texto-fraco: #9FB3B9;\r\n  --ambar:       #E8901A;\r\n  --verde:       #6FC23C;\r\n  --vermelho:    #E2593F;\r\n\r\n  --display: \"Outfit\", \"Segoe UI\", system-ui, sans-serif;\r\n  --corpo:   \"Asap\", \"Segoe UI\", system-ui, sans-serif;\r\n\r\n  color-scheme: dark;\r\n}\r\n\r\n*, *::before, *::after { box-sizing: border-box; }\r\n\r\nhtml, body {\r\n  margin: 0;\r\n  height: 100%;\r\n  overflow: hidden;\r\n  background: #0A1219;\r\n  color: var(--texto);\r\n  font-family: var(--corpo);\r\n  font-size: 15px;\r\n}\r\n\r\n#campo {\r\n  position: fixed;\r\n  inset: 0;\r\n  width: 100%;\r\n  height: 100%;\r\n  border: 0;\r\n  display: block;\r\n}\r\n\r\nh1, h2, h3 { font-family: var(--display); margin: 0; line-height: 1.2; }\r\n\r\n.olho {\r\n  font-family: var(--display);\r\n  font-size: .68rem;\r\n  font-weight: 700;\r\n  letter-spacing: .14em;\r\n  text-transform: uppercase;\r\n  color: var(--ambar);\r\n  margin: 0 0 2px;\r\n}\r\n\r\n.esconder { display: none !important; }\n#guia[hidden], body.modo-livre #guia { display: none !important; }\n\r\n/* ---------------------------------------------------------------- guia */\r\n\r\n.guia {\r\n  position: fixed;\r\n  right: 14px;                  /* o painel do campo usa a esquerda */\r\n  top: 74px;                    /* abaixo do HUD do campo */\r\n  width: min(30vw, 330px);\r\n  max-height: calc(100vh - 150px);\r\n  background: var(--vidro);\r\n  border: 1px solid var(--borda);\r\n  border-radius: 14px;\r\n  backdrop-filter: blur(10px);\r\n  display: flex;\r\n  flex-direction: column;\r\n  overflow: hidden;\r\n  box-shadow: 0 12px 40px rgba(0, 0, 0, .5);\r\n  z-index: 20;\r\n}\r\n\r\n.guia--pronta { border-color: rgba(111, 194, 60, .55); }\r\n\r\n.guia__topo {\r\n  display: flex;\r\n  align-items: flex-start;\r\n  gap: 10px;\r\n  padding: 12px 14px;\r\n  border-bottom: 1px solid var(--borda);\r\n}\r\n\r\n.guia__titulos { min-width: 0; }\r\n.guia__topo h1 { font-size: 1.05rem; }\r\n\r\n.guia__voltar, .guia__recolher {\r\n  flex: none;\r\n  width: 28px; height: 28px;\r\n  border: 1px solid var(--borda);\r\n  border-radius: 8px;\r\n  background: transparent;\r\n  color: var(--texto-fraco);\r\n  font-size: .95rem;\r\n  line-height: 1;\r\n  display: grid;\r\n  place-items: center;\r\n  text-decoration: none;\r\n  cursor: pointer;\r\n}\r\n.guia__voltar:hover, .guia__recolher:hover { color: var(--texto); background: rgba(255,255,255,.08); }\r\n.guia__recolher { margin-left: auto; }\r\n\r\n.guia__corpo {\r\n  padding: 12px 14px;\r\n  overflow-y: auto;\r\n}\r\n\r\n.guia--recolhida .guia__corpo,\r\n.guia--recolhida .guia__concluir { display: none; }\r\n\r\n.guia__instrucao {\r\n  margin: 0 0 12px;\r\n  line-height: 1.5;\r\n  color: var(--texto);\r\n}\r\n\r\n/* ------------------------------------------------------- o que falta */\r\n\r\n.lista { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }\r\n\r\n.lista__item {\r\n  position: relative;\r\n  padding-left: 26px;\r\n  font-size: .92rem;\r\n  line-height: 1.4;\r\n  color: var(--texto-fraco);\r\n}\r\n.lista__item::before {\r\n  content: \"\";\r\n  position: absolute;\r\n  left: 2px;\r\n  top: .25em;\r\n  width: 15px; height: 15px;\r\n  border: 1.5px solid var(--borda);\r\n  border-radius: 5px;\r\n}\r\n.lista__item--feito { color: var(--texto); }\r\n.lista__item--feito::before {\r\n  content: \"✓\";\r\n  border-color: var(--verde);\r\n  background: rgba(111, 194, 60, .18);\r\n  color: var(--verde);\r\n  font-size: .75rem;\r\n  line-height: 13px;\r\n  text-align: center;\r\n  font-weight: 700;\r\n}\r\n\r\n/* ------------------------------------------------------------ por que */\r\n\r\n.guia__porque {\r\n  margin-top: 14px;\r\n  border-top: 1px solid var(--borda);\r\n  padding-top: 10px;\r\n}\r\n.guia__porque summary {\r\n  cursor: pointer;\r\n  font-family: var(--display);\r\n  font-size: .8rem;\r\n  color: var(--texto-fraco);\r\n  letter-spacing: .04em;\r\n  text-transform: uppercase;\r\n}\r\n.guia__porque p {\r\n  margin: 8px 0 0;\r\n  font-size: .9rem;\r\n  line-height: 1.5;\r\n  color: var(--texto-fraco);\r\n}\r\n\r\n/* ----------------------------------------------------------- concluir */\r\n\r\n.guia__concluir {\r\n  margin: 0 14px 14px;\r\n  padding: 12px;\r\n  border: none;\r\n  border-radius: 999px;\r\n  background: var(--verde);\r\n  color: #0B1A06;\r\n  font-family: var(--display);\r\n  font-weight: 700;\r\n  font-size: 1rem;\r\n  cursor: pointer;\r\n}\r\n.guia__concluir:hover { filter: brightness(1.07); }\r\n\r\n/* --------------------------------------------------------- carregando */\r\n\r\n.carregando {\r\n  position: fixed;\r\n  inset: 0;\r\n  display: grid;\r\n  place-items: center;\r\n  background: #0A1219;\r\n  z-index: 60;\r\n}\r\n.carregando__caixa { text-align: center; max-width: 420px; padding: 24px; }\r\n.carregando h2 { font-size: 1.5rem; margin-bottom: 8px; }\r\n.carregando p { color: var(--texto-fraco); margin: 0; }\r\n\r\n/* -------------------------------------------------------------- modal */\r\n\r\n.modal {\r\n  position: fixed;\r\n  inset: 0;\r\n  background: rgba(5, 10, 14, .8);\r\n  display: grid;\r\n  place-items: center;\r\n  z-index: 70;\r\n  padding: 20px;\r\n}\r\n\r\n.modal__caixa {\r\n  width: min(560px, 100%);\r\n  max-height: 86vh;\r\n  overflow-y: auto;\r\n  background: rgba(15, 26, 34, .96);\r\n  border: 1px solid var(--borda);\r\n  border-radius: 16px;\r\n  padding: 26px;\r\n}\r\n.modal__caixa h2 { font-size: 1.5rem; margin-bottom: 14px; }\r\n.modal__botoes { display: grid; gap: 10px; margin-top: 18px; }\r\n\r\n.item {\r\n  border: 1px solid var(--borda);\r\n  border-left: 3px solid var(--texto-fraco);\r\n  border-radius: 0 10px 10px 0;\r\n  padding: 11px 14px;\r\n  margin-bottom: 10px;\r\n}\r\n.item--bom  { border-left-color: var(--verde); }\r\n.item--ruim { border-left-color: var(--vermelho); }\r\n.item h3 { font-size: .95rem; }\r\n.item b { display: block; font-family: var(--display); font-size: 1.1rem; margin: 2px 0 4px; }\r\n.item p { margin: 0; font-size: .88rem; color: var(--texto-fraco); line-height: 1.5; }\r\n\r\n.nota {\r\n  font-family: var(--display);\r\n  font-size: 2.6rem;\r\n  font-weight: 800;\r\n  color: var(--ambar);\r\n  margin: 0 0 10px;\r\n}\r\n\r\n.botao-grande {\r\n  display: block;\r\n  text-align: center;\r\n  padding: 13px;\r\n  border: none;\r\n  border-radius: 999px;\r\n  background: var(--verde);\r\n  color: #0B1A06;\r\n  font-family: var(--display);\r\n  font-weight: 700;\r\n  text-decoration: none;\r\n}\r\n\r\n.botao-linha {\r\n  display: block;\r\n  text-align: center;\r\n  padding: 12px;\r\n  border: 1px solid var(--borda);\r\n  border-radius: 999px;\r\n  color: var(--texto);\r\n  text-decoration: none;\r\n  font-family: var(--display);\r\n  font-weight: 600;\r\n}\r\n\r\n/* --------------------------------------------------------- telas menores */\r\n\r\n@media (max-width: 900px) {\r\n  .guia { width: auto; left: 14px; right: 14px; max-height: 38vh; }\r\n}\r\n\r\n\r\n/* ==========================================================================\r\n   A TELA DO APARELHO\r\n\r\n   O campo ja desenha o controle na mao do operador, com a cena atras. O\r\n   que entra aqui e so o CONTEUDO da tela: o app de verdade, encaixado no\r\n   retangulo que o campo reserva (rcCaixa.sx/sy/sw/sh, recalculado a cada\r\n   resize). Por isso este bloco nao tem tamanho proprio - quem posiciona\r\n   e o principal.js.\r\n   ========================================================================== */\r\n\r\n.aparelho {\r\n  position: fixed;\r\n  z-index: 30;\r\n  overflow: hidden;\r\n  pointer-events: none;\r\n}\r\n\r\n.aparelho iframe {\r\n  width: 100%;\r\n  height: 100%;\r\n  border: 0;\r\n  display: block;\r\n  background: transparent;\r\n  pointer-events: auto;      /* a tela recebe os toques; a moldura, não */\r\n}\r\n\r\n.aparelho__voltar {\r\n  position: fixed;\r\n  left: 14px;\r\n  bottom: 60px;\r\n  z-index: 31;\r\n  padding: 9px 15px;\r\n  border: 1px solid var(--borda);\r\n  border-radius: 999px;\r\n  background: var(--vidro);\r\n  color: var(--texto);\r\n  font-family: var(--display);\r\n  font-weight: 600;\r\n  font-size: .9rem;\r\n  cursor: pointer;\r\n  backdrop-filter: blur(8px);\r\n}\r\n.aparelho__voltar:hover { background: rgba(255, 255, 255, .12); }\r\n"
          },
