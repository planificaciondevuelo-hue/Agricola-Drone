            "size": 15772,
            "mimeType": "text/css",
            "text": "/* ============================================================\r\n   Telas com o drone conectado (gravação \"drone conectado\")\r\n   ============================================================ */\r\n\r\n/* ---------- Selecione o modo da tarefa ---------- */\r\n.tela-modos{background:#fff;padding:1.6cqw 2.4cqw;}\r\n.tela-modos h2{font-size:2.1cqw;font-weight:600;color:#2f3336;margin:0 0 1.2cqw;}\r\n.fechar-modos{\r\n  position:absolute;right:2cqw;top:1.2cqw;background:transparent;border:0;cursor:pointer;\r\n  font-size:2.4cqw;color:#8b8f93;\r\n}\r\n.grade-modos-app{\r\n  display:grid;grid-template-columns:1fr 1fr 1fr;grid-template-rows:auto 24cqw 17cqw;\r\n  column-gap:1.2cqw;row-gap:.8cqw;align-content:start;\r\n}\r\n.grupo-modos{margin:0;font-size:1.6cqw;font-weight:600;color:#2f3336;}\r\n.grupo-modos.agricultura{grid-column:1 / 3;}\r\n.grupo-modos.mapeamento{grid-column:3;}\r\n.cartao-modo{\r\n  border:0;border-radius:.6cqw;cursor:pointer;font-family:inherit;text-align:left;position:relative;overflow:hidden;\r\n  padding:1.2cqw 1.4cqw;color:#fff;display:flex;align-items:flex-start;\r\n  background:linear-gradient(160deg,#4a4d50,#232527);\r\n}\r\n.cartao-modo b{font-size:2.1cqw;font-weight:600;position:relative;z-index:1;}\r\n.cartao-modo:before{content:'';position:absolute;inset:0;opacity:.35;\r\n  background:repeating-linear-gradient(115deg,transparent 0 2.2cqw,rgba(255,255,255,.18) 2.2cqw 2.35cqw);}\r\n.cartao-modo.ativo{background:linear-gradient(160deg,#3fae4c,#1d7a33);}\r\n.m-maprota.ativo,.m-maparvore.ativo{background:linear-gradient(170deg,#56b9c8,#3c9a4a 60%,#2a7a2e);}\r\n.m-rota{grid-column:1 / 3;grid-row:2;}\r\n.m-manual{grid-column:1;grid-row:3;}\r\n.m-arvore{grid-column:2;grid-row:3;}\r\n.m-maprota{grid-column:3;grid-row:2;}\r\n.m-maparvore{grid-column:3;grid-row:3;}\r\n.icone-modo{position:absolute;right:1.2cqw;bottom:1cqw;width:3cqw;height:3cqw;color:#fff;font-style:normal;z-index:1;}\r\n.icone-modo svg{width:100%;height:100%;}\r\n.icone-modo.letra{font-size:3cqw;font-weight:700;line-height:1;text-align:center;}\r\n\r\n/* o que cada modo mostra na tela do mapa */\r\nbody.app-modo-manual [data-tela=\"mapa\"] .acoes-direita,\r\nbody.app-modo-manual [data-tela=\"mapa\"] .acoes-inferiores,\r\nbody.app-modo-manual [data-tela=\"mapa\"] .aba-lista,\r\nbody.app-modo-arvore [data-tela=\"mapa\"] .aba-lista,\r\nbody.app-modo-maparvore [data-tela=\"mapa\"] .aba-lista{display:none;}\r\n.painel-manual,.botao-rota-fixa,.botao-iniciar-manual,.lista-arvores{display:none;}\r\nbody.app-modo-manual .painel-manual,body.app-modo-manual .botao-rota-fixa,body.app-modo-manual .botao-iniciar-manual{display:flex;}\r\nbody.app-modo-arvore .lista-arvores,body.app-modo-maparvore .lista-arvores{display:flex;}\r\nbody.app-modo-arvore [data-tela=\"mapa\"] .botao-selecao,body.app-modo-maparvore [data-tela=\"mapa\"] .botao-selecao{display:none;}\r\n\r\n.painel-manual{\r\n  position:absolute;left:1cqw;top:6.4cqw;bottom:1cqw;width:23.5cqw;z-index:4;\r\n  background:#f4f4f3;border-radius:1cqw;padding:1cqw 1.2cqw;flex-direction:column;overflow-y:auto;\r\n}\r\n.abas-mm{display:flex;border-bottom:.14cqw solid #e2e2e1;margin-bottom:1cqw;}\r\n.abas-mm button{\r\n  flex:1;background:transparent;border:0;cursor:pointer;font-family:inherit;font-size:1.9cqw;color:#5b5f63;\r\n  padding:.6cqw 0;\r\n}\r\n.abas-mm button.ativa{color:var(--verde-texto);font-weight:600;background:#fff;border-radius:.6cqw .6cqw 0 0;}\r\n.painel-manual .abas-exec{margin-bottom:1cqw;}\r\n.painel-manual .abas-exec button{flex:1;}\r\n.conteudo-man{display:none;}\r\n.conteudo-man.ativa{display:block;}\r\n.painel-manual .so-mmais{display:none;}\r\n.painel-manual.mmais .so-mmais{display:block;}\r\n.painel-manual.mmais .so-m{display:none;}\r\n.segmentado-cenario{display:flex;flex-direction:column;border:.14cqw solid #dededd;border-radius:.6cqw;overflow:hidden;margin-bottom:1cqw;}\r\n.segmentado-cenario button{\r\n  background:#fff;border:0;border-bottom:.12cqw solid #e6e6e5;cursor:pointer;font-family:inherit;\r\n  font-size:1.7cqw;color:#5b5f63;padding:.7cqw;\r\n}\r\n.segmentado-cenario button.ativa{background:#e4f1e8;color:var(--verde-texto);font-weight:600;}\r\n.botao-rota-fixa{position:absolute;right:1.4cqw;top:23cqw;}\r\n.botao-rota-fixa svg,.botao-iniciar-manual svg{width:2cqw;height:2cqw;fill:#3a3e41;color:#3a3e41;}\r\n.botao-iniciar-manual{position:absolute;right:1.4cqw;bottom:2.2cqw;}\r\n.aviso-centro{\r\n  position:absolute;left:50%;bottom:14%;transform:translateX(-50%);z-index:30;max-width:36cqw;\r\n  background:#fff;border-radius:.8cqw;padding:1.2cqw 1.8cqw;text-align:center;font-size:1.8cqw;color:#2f3336;\r\n  box-shadow:0 .4cqw 1.6cqw rgba(0,0,0,.25);\r\n}\r\n\r\n.lista-arvores{\r\n  position:absolute;left:0;top:6cqw;bottom:0;width:21cqw;z-index:4;background:#f4f4f3;\r\n  flex-direction:column;padding:1cqw;\r\n}\r\n.lista-arvores h3{margin:0 0 1cqw;text-align:center;font-size:1.9cqw;font-weight:600;color:#2f3336;}\r\n.filtros-arvores{display:flex;gap:.8cqw;}\r\n.filtros-arvores .busca{width:5cqw;height:3.6cqw;background:#e6e6e5;border-radius:.5cqw;display:grid;place-items:center;}\r\n.filtros-arvores .busca svg{width:1.8cqw;height:1.8cqw;fill:#8b8f93;}\r\n.filtros-arvores button{\r\n  flex:1;background:#fff;border:0;border-radius:.5cqw;font-family:inherit;font-size:1.7cqw;color:#2f3336;\r\n  display:flex;align-items:center;justify-content:center;gap:.5cqw;\r\n}\r\n.filtros-arvores button svg{width:1.7cqw;height:1.7cqw;fill:#5b5f63;}\r\n.vazio-arvores{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:.8cqw;}\r\n.vazio-arvores svg{width:6cqw;height:6cqw;}\r\n.vazio-arvores p{margin:0;font-size:1.7cqw;color:#5b5f63;text-align:center;}\r\n\r\n/* ---------- mapeamento de rota ---------- */\r\n.painel-tarefa-map,.caixa-mapeamento{display:none;}\r\nbody.app-modo-maprota [data-tela=\"mapeamento\"] .painel-rota,\r\nbody.app-modo-maprota [data-tela=\"mapeamento\"] .caixa-areas:not(.caixa-mapeamento),\r\nbody.app-modo-maprota [data-tela=\"mapeamento\"] .lista-tipos button:not([data-tipo=\"Ponto limite\"]){display:none;}\r\nbody.app-modo-maprota .painel-tarefa-map{display:flex;}\r\nbody.app-modo-maprota .caixa-mapeamento{display:block;}\r\n.caixa-mapeamento{width:26cqw;}\r\n.painel-tarefa-map{\r\n  position:absolute;left:1cqw;top:6.4cqw;max-height:calc(100% - 7.4cqw);width:23.5cqw;z-index:4;\r\n  background:#f4f4f3;border-radius:1cqw;padding:1.3cqw 1.4cqw;flex-direction:column;overflow-y:auto;\r\n}\r\n.painel-tarefa-map h2{margin:0 0 1cqw;text-align:center;font-size:1.8cqw;font-weight:600;color:#2f3336;}\r\n.cartao-rota-map{\r\n  background:#fff;border:.16cqw solid #e2e2e1;border-radius:.7cqw;cursor:pointer;font-family:inherit;text-align:left;\r\n  display:grid;grid-template-columns:auto 1fr auto;align-items:center;gap:.4cqw .8cqw;padding:.9cqw 1cqw;margin-bottom:.8cqw;\r\n}\r\n.cartao-rota-map b{font-size:1.85cqw;font-weight:500;color:#2f3336;}\r\n.cartao-rota-map .ic{width:2cqw;height:2cqw;color:#8b8f93;}\r\n.cartao-rota-map .ic svg{width:100%;height:100%;}\r\n.cartao-rota-map .desc{grid-column:1 / 4;font-size:1.5cqw;color:#5b5f63;line-height:1.4;}\r\n.cartao-rota-map .bolha{width:1.8cqw;height:1.8cqw;border-radius:50%;border:.24cqw solid #b4b8bb;}\r\n.cartao-rota-map.ativa{background:#e4f1e8;border-color:var(--verde);}\r\n.cartao-rota-map.ativa b{color:var(--verde-texto);}\r\n.cartao-rota-map.ativa .bolha{border:.55cqw solid var(--verde);}\r\n.desc-resolucao{margin:.6cqw 0 0;font-size:1.5cqw;color:#5b5f63;line-height:1.4;}\r\n\r\n/* ---------- painéis flutuantes do mapa ---------- */\r\n.flutuante-mapa{z-index:25;}\r\n.painel-prescricao{\r\n  position:absolute;left:1cqw;top:6.4cqw;bottom:1cqw;width:21cqw;background:#fff;border-radius:.8cqw;\r\n  display:flex;flex-direction:column;padding:1cqw 1cqw 0;box-shadow:0 .4cqw 1.6cqw rgba(0,0,0,.2);\r\n}\r\n.painel-prescricao h3{margin:0 0 .8cqw;text-align:left;font-size:1.7cqw;font-weight:600;color:#2f3336;}\r\n.abas-prescricao{display:flex;justify-content:space-around;border-bottom:.12cqw solid #ececeb;}\r\n.abas-prescricao button{\r\n  background:transparent;border:0;cursor:pointer;font-family:inherit;font-size:1.8cqw;color:#5b5f63;padding:.4cqw 1cqw .6cqw;\r\n}\r\n.abas-prescricao button.ativa{color:var(--verde-texto);font-weight:600;border-bottom:.26cqw solid var(--verde);}\r\n.corpo-prescricao{flex:1;display:flex;align-items:center;justify-content:center;position:relative;}\r\n.vazio-prescricao{display:flex;flex-direction:column;align-items:center;gap:.8cqw;padding:0 .6cqw;}\r\n.vazio-prescricao svg{width:5.4cqw;height:5.4cqw;}\r\n.vazio-prescricao p{margin:0;text-align:center;font-size:1.5cqw;color:#5b5f63;line-height:1.45;}\r\n.girando-p{\r\n  width:3cqw;height:3cqw;border-radius:50%;border:.3cqw solid var(--verde);border-right-color:transparent;\r\n  animation:girar-p .8s linear infinite;\r\n}\r\n@keyframes girar-p{to{transform:rotate(360deg);}}\r\n.painel-prescricao .botoes-dialogo{margin:0 -1cqw;}\r\n\r\n.painel-tipo-mapa{\r\n  position:absolute;right:1cqw;width:33cqw;max-height:66%;overflow-y:auto;background:#fff;border-radius:.8cqw;\r\n  padding:1.2cqw 1.4cqw;box-shadow:0 .4cqw 1.6cqw rgba(0,0,0,.22);\r\n}\r\n.linha-tipo{display:flex;align-items:center;justify-content:space-between;gap:1cqw;padding:.9cqw 0;}\r\n.linha-tipo>span{font-size:1.75cqw;color:#2f3336;line-height:1.3;}\r\n.minis{display:flex;gap:1cqw;}\r\n.mini-mapa{\r\n  background:transparent;border:0;cursor:pointer;font-family:inherit;display:flex;flex-direction:column;align-items:center;gap:.3cqw;\r\n  font-size:1.5cqw;color:#5b5f63;padding:0;\r\n}\r\n.mini-mapa svg{width:9cqw;height:5.6cqw;border-radius:.4cqw;border:.2cqw solid transparent;display:block;}\r\n.mini-mapa.ativa svg{border-color:var(--verde);}\r\n.mini-mapa.ativa span{color:var(--verde-texto);font-weight:600;}\r\n\r\n.link-hd{background:transparent;border:0;cursor:pointer;font-family:inherit;font-size:1.6cqw;color:var(--verde-texto);display:flex;align-items:center;gap:.4cqw;}\r\n.link-hd svg{width:1.6cqw;height:1.6cqw;fill:var(--verde-texto);}\r\n.painel-tipo-mapa .interruptor{width:4.6cqw;height:2.6cqw;}\r\n.painel-tipo-mapa .interruptor i{width:2.2cqw;height:2.2cqw;}\r\n.painel-tipo-mapa .interruptor.ligado i{left:2.2cqw;}\r\n.titulo-auxilios{margin:.6cqw 0;font-size:1.75cqw;color:#2f3336;}\r\n.auxilios{display:flex;gap:1cqw;}\r\n.aux{flex:1;background:transparent;border:0;cursor:pointer;font-family:inherit;display:flex;flex-direction:column;align-items:center;gap:.3cqw;font-size:1.5cqw;color:#5b5f63;}\r\n.aux.ativa span{color:var(--verde-texto);}\r\n.fig-aux{\r\n  width:100%;height:5cqw;border-radius:.4cqw;border:.2cqw solid transparent;display:block;position:relative;\r\n  background:linear-gradient(#a9c7d8 0 45%,#7f9a55 45%);\r\n}\r\n.aux.ativa .fig-aux{border-color:var(--verde);}\r\n.fig-aux.horizonte:after{content:'';position:absolute;left:10%;right:10%;top:50%;border-top:.2cqw dashed #fff;}\r\n.fig-aux.orientacao:after{content:'';position:absolute;left:50%;top:20%;bottom:10%;border-left:.3cqw solid #fff;}\r\n.fig-aux.grade:after{content:'';position:absolute;inset:0;\r\n  background:linear-gradient(90deg,transparent 32%,rgba(255,255,255,.7) 33% 34%,transparent 35% 65%,rgba(255,255,255,.7) 66% 67%,transparent 68%),\r\n             linear-gradient(transparent 32%,rgba(255,255,255,.7) 33% 34%,transparent 35% 65%,rgba(255,255,255,.7) 66% 67%,transparent 68%);}\r\n.radios-hd{display:flex;flex-direction:column;text-align:left;}\r\n.radios-hd .linha-radio{font-size:1.75cqw;padding:1cqw .4cqw;}\r\n\r\n/* \"Padrão\": o terreno do jogo em tons de mapa, não a foto */\r\n.veu-padrao{position:absolute;inset:0;pointer-events:none;display:none;background:rgba(222,238,214,.58);}\r\nbody.mapa-padrao .veu-padrao{display:block;}\r\n\r\n/* ---------- janelinhas da barra de estado ---------- */\r\n.janelinha{\r\n  position:absolute;transform:translateX(-50%);width:28cqw;background:#fff;border-radius:.8cqw;\r\n  padding:1cqw 1.2cqw 1.2cqw;box-shadow:0 .4cqw 1.6cqw rgba(0,0,0,.25);\r\n}\r\n.janelinha:before{\r\n  content:'';position:absolute;left:50%;top:-.9cqw;transform:translateX(-50%);\r\n  border:.9cqw solid transparent;border-top:0;border-bottom-color:#fff;\r\n}\r\n.titulo-janelinha{\r\n  width:100%;background:transparent;border:0;cursor:pointer;font-family:inherit;display:flex;justify-content:space-between;\r\n  align-items:center;font-size:1.75cqw;color:#2f3336;padding:0 0 .9cqw;text-align:left;\r\n}\r\n.titulo-janelinha i{font-style:normal;font-size:2.2cqw;color:#5b5f63;}\r\n.janelinha .duas{display:flex;gap:.8cqw;}\r\n.janelinha .meia,.janelinha .cheia{\r\n  flex:1;background:#f4f4f3;border-radius:.5cqw;padding:1cqw .6cqw;display:flex;flex-direction:column;align-items:center;gap:.3cqw;\r\n}\r\n.janelinha .cheia+.cheia{margin-top:.6cqw;}\r\n.janelinha b{font-size:1.9cqw;color:var(--verde-texto);font-weight:600;display:flex;align-items:center;gap:.4cqw;}\r\n.janelinha b svg{width:1.8cqw;height:1.8cqw;fill:var(--verde-texto);}\r\n.janelinha b i{font-style:normal;font-size:1.3cqw;}\r\n.janelinha span{font-size:1.45cqw;color:#2f3336;text-align:center;}\r\n.janelinha .meia.vermelha{background:#fde5e2;}\r\n.janelinha .meia.vermelha b{color:#e8442e;}\r\n.janelinha .meia:not(.verde):not(.vermelha) b{color:#2f3336;}\r\n.janelinha .meia.verde b{color:var(--verde-texto);}\r\n.titulo-ionosfera{margin:1.2cqw 0 .4cqw;font-size:1.65cqw;color:#2f3336;}\r\n.texto-ionosfera{margin:0;font-size:1.35cqw;color:#5b5f63;line-height:1.45;}\r\n\r\n/* ---------- alertas próprios ---------- */\r\n.alertas-app{position:absolute;left:1cqw;top:6.4cqw;width:24cqw;z-index:12;display:flex;flex-direction:column;gap:.6cqw;}\r\n.alerta-app{\r\n  display:flex;gap:.6cqw;align-items:flex-start;border-radius:.3cqw;padding:.7cqw .9cqw;\r\n  font-size:1.5cqw;line-height:1.4;color:#2f3336;background:rgba(240,240,239,.95);\r\n}\r\n.alerta-app.vermelho{background:rgba(214,52,46,.92);color:#fff;}\r\n.alerta-app.amarelo{background:rgba(214,190,30,.94);color:#2f3336;}\r\n.alerta-app span{flex:1;}\r\n.alerta-app button{background:transparent;border:0;cursor:pointer;font-size:1.8cqw;color:inherit;padding:0;line-height:1;}\r\n\r\n/* ---------- diálogos ---------- */\r\n.lista-aviso{margin:0 0 .8cqw;padding-left:2cqw;text-align:left;font-size:1.6cqw;line-height:1.45;color:#5b5f63;}\r\n.lista-aviso.vermelha{color:#e8442e;}\r\n.dialogo-app h3.forte{font-weight:600;}\r\n.marca-aviso.vermelha{background:#e8442e;}\r\n\r\n/* ---------- engrenagem com drone ---------- */\r\nbody.conectado #painel-config .grupo-opcoes.desativado button{cursor:pointer;color:#5b5f63;background:#fff;}\r\nbody.conectado #painel-config .grupo-opcoes.desativado button.ativa{color:var(--verde-texto);background:#e4f1e8;}\r\nbody.conectado #painel-config .botao-contorno.apagado{border-color:var(--verde);color:var(--verde-texto);}\r\nbody.conectado #painel-config .interruptor.apagado.ligado{background:var(--verde);}\r\nbody.conectado #painel-config .caixa-select.apagado{color:#2f3336;}\r\n.so-com-drone{display:none;}\r\nbody.conectado .so-com-drone{display:block;}\r\n.desvio-prioridade{background:#ececeb;border-radius:.6cqw;padding:1cqw 1.2cqw;margin-bottom:1.2cqw;}\r\n.desvio-prioridade .diagrama svg{width:100%;height:auto;}\r\n.rotulos-desvio{display:flex;justify-content:space-between;font-size:1.5cqw;color:#2f3336;margin-top:.4cqw;}\r\n.rotulos-desvio span{max-width:40%;text-align:center;}\r\n.abas-geo{display:flex;align-items:center;gap:1.4cqw;border-bottom:.12cqw solid #e6e6e5;margin-bottom:1cqw;}\r\n.abas-geo button{\r\n  background:transparent;border:0;cursor:pointer;font-family:inherit;font-size:1.75cqw;color:#5b5f63;padding:.6cqw 0;\r\n}\r\n.abas-geo button.ativa{color:var(--verde-texto);border-bottom:.26cqw solid var(--verde);}\r\n.abas-geo .atualizar-geo{margin-left:auto;font-size:1.5cqw;padding:.4cqw .9cqw;}\r\n.vazio-geo{display:flex;flex-direction:column;align-items:center;gap:1cqw;padding:8cqw 0;}\r\n.vazio-geo svg{width:7cqw;height:7cqw;}\r\n.vazio-geo p{margin:0;font-size:1.8cqw;color:#2f3336;font-weight:600;text-align:center;}\r\n.vazio-geo.carregando *{visibility:hidden;}\r\n.faixa-desvio{display:flex;align-items:center;gap:1cqw;margin-top:.6cqw;}\r\n.faixa-desvio input{flex:1;accent-color:var(--verde);}\r\n"
