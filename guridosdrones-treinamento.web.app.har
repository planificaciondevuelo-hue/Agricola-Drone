u\": [\n    \"Open menu\",\n    \"Abrir menú\"\n  ],\n  \"Camadas do mapa\": [\n    \"Map layers\",\n    \"Capas del mapa\"\n  ],\n  \"Aproximar mapa\": [\n    \"Zoom in\",\n    \"Acercar mapa\"\n  ],\n  \"Afastar mapa\": [\n    \"Zoom out\",\n    \"Alejar mapa\"\n  ],\n  \"Centralizar mapa\": [\n    \"Center map\",\n    \"Centrar mapa\"\n  ],\n  \"Lim. mapa\": [\n    \"Map boundary\",\n    \"Lím. mapa\"\n  ],\n  \"Zona sem pulverização\": [\n    \"No-spray zone\",\n    \"Zona sin pulverización\"\n  ],\n  \"Ponto op.\": [\n    \"Operation point\",\n    \"Punto op.\"\n  ],\n  \"Toque nos cantos da forma e feche o polígono.\": [\n    \"Tap the shape's corners and close the polygon.\",\n    \"Toca las esquinas de la forma y cierra el polígono.\"\n  ],\n  \"Toque no mapa para marcar os cantos. Segure e arraste para mover. Toque duas vezes no ponto para apagar.\": [\n    \"Tap the map to mark corners. Hold and drag to move. Double-tap a point to delete it.\",\n    \"Toca el mapa para marcar las esquinas. Mantén pulsado y arrastra para mover. Toca dos veces un punto para borrarlo.\"\n  ],\n  \"Marque os vértices da zona.\": [\n    \"Mark the zone's vertices.\",\n    \"Marca los vértices de la zona.\"\n  ],\n  \"Toque no mapa para acrescentar pontos.\": [\n    \"Tap the map to add points.\",\n    \"Toca el mapa para añadir puntos.\"\n  ],\n  \"Reduzir diâmetro\": [\n    \"Reduce diameter\",\n    \"Reducir diámetro\"\n  ],\n  \"Aumentar diâmetro\": [\n    \"Increase diameter\",\n    \"Aumentar diámetro\"\n  ],\n  \"Mover à esquerda\": [\n    \"Move left\",\n    \"Mover a la izquierda\"\n  ],\n  \"Mover para cima\": [\n    \"Move up\",\n    \"Mover arriba\"\n  ],\n  \"Mover para baixo\": [\n    \"Move down\",\n    \"Mover abajo\"\n  ],\n  \"Mover à direita\": [\n    \"Move right\",\n    \"Mover a la derecha\"\n  ],\n  \"Voltar à página inicial\": [\n    \"Back to home\",\n    \"Volver al inicio\"\n  ],\n  \"Limite do mapa\": [\n    \"Map boundary\",\n    \"Límite del mapa\"\