          "content": {
            "size": 12040,
            "mimeType": "text/css",
            "text": "/* ============================================================\n   Telas do perfil, sino, configurações gerais, arquivos e\n   gerenciamento do dispositivo\n   ============================================================ */\n\n.caixa-extra{width:92cqw;height:56cqw;}\n.corpo-extra{flex:1;display:flex;min-height:0;}\n.caixa-extra .rolagem-config{flex:1;padding:0 2cqw 1.6cqw;}\n.caixa-extra .topo-config{border-bottom:.12cqw solid #e6e6e5;padding-bottom:1cqw;}\n\n.abas-topo{flex:1;display:flex;justify-content:center;gap:3cqw;}\n.abas-topo button{\n  background:transparent;border:0;cursor:pointer;font-family:inherit;\n  font-size:2.1cqw;color:#5b5f63;padding-bottom:.5cqw;\n}\n.abas-topo button.ativa{color:var(--verde-texto);font-weight:600;border-bottom:.28cqw solid var(--verde);}\n\n.espaco-config{height:1cqw;background:#ececeb;margin:.6cqw -2cqw;}\n\n/* ---------------- perfil ---------------- */\n/* no aparelho a tela do usuario ocupa a tela inteira: nada da tela inicial aparece em volta */\n.caixa-extra.extra-usuario{width:100%;height:100%;border-radius:0;box-shadow:none;}\n.usuario-topo{display:flex;align-items:center;gap:1.4cqw;padding:1.6cqw 0 1.2cqw;}\n.avatar{\n  width:6cqw;height:6cqw;border-radius:50%;background:#e2e2e1;display:grid;place-items:center;flex:none;\n}\n.avatar svg{width:3.4cqw;height:3.4cqw;fill:#b4b8bb;}\n.usuario-dados{display:flex;flex-direction:column;gap:.3cqw;flex:1;}\n.usuario-dados b{font-size:2.3cqw;color:#2f3336;font-weight:500;display:flex;align-items:center;gap:1cqw;}\n.usuario-dados em{\n  font-style:normal;font-size:1.5cqw;color:var(--verde-texto);background:#dff1e4;\n  border-radius:.9cqw;padding:.25cqw .9cqw;font-weight:500;\n}\n.usuario-dados .email{font-size:1.75cqw;color:#8b8f93;}\n.atualizado{font-size:1.5cqw;color:#a4a8ab;align-self:flex-start;margin-top:1.4cqw;}\n\n.cartoes-usuario{display:flex;gap:1.4cqw;margin-bottom:1.4cqw;}\n.cartoes-usuario div{\n  flex:1;background:#e4f1e8;border-radius:.8cqw;padding:1.2cqw 1.4cqw;position:relative;\n  display:flex;flex-direction:column;gap:.3cqw;\n}\n.cartoes-usuario b{font-size:3cqw;color:#2f3336;font-weight:500;}\n.cartoes-usuario b i{font-size:1.5cqw;font-style:normal;color:#5b5f63;margin-left:.2cqw;}\n.cartoes-usuario span{font-size:1.7cqw;color:#5b5f63;}\n.cartoes-usuario svg{\n  position:absolute;right:1.2cqw;top:1.4cqw;width:3.4cqw;height:3.4cqw;\n  fill:#9ed4ae;color:#9ed4ae;\n}\n.linha-equipe{\n  display:flex;align-items:center;gap:1.4cqw;padding:1.4cqw 0;border-bottom:.12cqw solid #e6e6e5;\n}\n.linha-equipe span{flex:1;font-size:1.95cqw;color:#2f3336;}\n.linha-equipe em{font-style:normal;font-size:1.85cqw;color:#5b5f63;}\n.botao-cinza{\n  background:#fff;border:.14cqw solid #dededd;border-radius:.6cqw;cursor:pointer;font-family:inherit;\n  font-size:1.8cqw;color:#5b5f63;padding:.7cqw 1.2cqw;display:flex;align-items:center;gap:.6cqw;\n}\n.botao-cinza svg{width:1.8cqw;height:1.8cqw;fill:#5b5f63;}\n.sair-conta{\n  margin:1.6cqw 0 0;text-align:center;font-size:2.1cqw;color:#e8442e;font-weight:600;cursor:pointer;\n}\n\n/* ---------------- vazio ---------------- */\n.vazio-central{\n  height:100%;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:1cqw;\n}\n.vazio-central svg{width:8cqw;height:8cqw;}\n.vazio-central p{margin:0;font-size:1.9cqw;color:#8b8f93;}\n\n/* ---------------- gerenciamento do dispositivo ---------------- */\n.abas-dispositivo{display:flex;justify-content:space-between;gap:1.4cqw;padding:1.2cqw 0;}\n.abas-dispositivo button{\n  background:#ececeb;border:0;border-radius:.6cqw;cursor:pointer;font-family:inherit;\n  font-size:2cqw;color:#8b8f93;padding:1cqw 2cqw;\n}\n.abas-dispositivo button.ativa{background:#ececeb;color:#2f3336;}\n.grade-dispositivos{display:grid;grid-template-columns:repeat(4,1fr);gap:1.2cqw;}\n.cartao-dispositivo{\n  background:#f7f7f6;border:.12cqw solid #e6e6e5;border-radius:.8cqw;overflow:hidden;\n  display:flex;flex-direction:column;\n}\n.cartao-dispositivo .topo{\n  display:flex;flex-direction:column;align-items:center;gap:.6cqw;padding:1.2cqw .8cqw;\n  border-bottom:.12cqw solid #e6e6e5;\n}\n.cartao-dispositivo .topo svg{width:5cqw;height:3.8cqw;fill:#c4c8ca;color:#c4c8ca;}\n.cartao-dispositivo .topo span{font-size:1.8cqw;color:#a4a8ab;text-align:center;line-height:1.25;}\n.cartao-dispositivo.ativo .topo svg{fill:#3c4245;color:#3c4245;}\n.cartao-dispositivo.ativo .topo span{color:#2f3336;}\n.cartao-dispositivo .campos{padding:.9cqw 1cqw;display:flex;flex-direction:column;gap:.5cqw;}\n.cartao-dispositivo .campos p{margin:0;display:flex;flex-direction:column;}\n.cartao-dispositivo .campos span{font-size:1.4cqw;color:#a4a8ab;}\n.cartao-dispositivo .campos b{font-size:1.6cqw;color:#a4a8ab;font-weight:400;word-break:break-all;}\n.cartao-dispositivo.ativo .campos b{color:#2f3336;}\n\n/* ---------------- pastinha (arquivos) ---------------- */\n.caixa-extra.com-menu .rolagem-config{padding-top:1cqw;}\n.menu-arquivos{\n  width:17cqw;flex:none;background:#fff;padding:1cqw .8cqw;display:flex;flex-direction:column;gap:.4cqw;\n  border-right:.12cqw solid #ececeb;\n}\n.menu-arquivos button{\n  background:transparent;border:0;border-radius:.6cqw;cursor:pointer;font-family:inherit;text-align:left;\n  font-size:1.85cqw;color:#5b5f63;padding:.9cqw 1cqw;line-height:1.25;\n}\n.menu-arquivos button.ativa{background:#e4f1e8;color:var(--verde-texto);font-weight:600;}\n\n.filtros-arquivo{display:flex;align-items:center;gap:.8cqw;padding:.4cqw 0 1cqw;}\n.filtro{\n  background:#ececeb;border:0;border-radius:.6cqw;cursor:pointer;font-family:inherit;\n  font-size:1.75cqw;color:#5b5f63;padding:.8cqw 1cqw;display:flex;align-items:center;gap:.5cqw;\n  white-space:nowrap;\n}\n.filtro svg{width:1.7cqw;height:1.7cqw;fill:#5b5f63;}\n.filtro i{font-style:normal;color:#8b8f93;}\n.filtro.claro{background:#f4f4f3;}\n.campo-busca-arquivo{\n  flex:1;min-width:8cqw;background:#ececeb;border-radius:.6cqw;padding:.8cqw 1cqw;\n  display:flex;align-items:center;gap:.6cqw;\n}\n.campo-busca-arquivo svg{width:1.7cqw;height:1.7cqw;fill:#a4a8ab;}\n.campo-busca-arquivo span{font-size:1.75cqw;color:#a4a8ab;}\n\n.lista-arquivos{display:flex;flex-direction:column;gap:1cqw;}\n.item-arquivo{\n  background:#f7f7f6;border-radius:.8cqw;padding:1cqw;display:flex;align-items:center;gap:1.2cqw;\n}\n.item-arquivo .mini{width:9cqw;flex:none;border-radius:.4cqw;overflow:hidden;display:block;}\n.item-arquivo .mini svg{width:100%;height:auto;display:block;}\n.item-arquivo .dados{flex:1;display:flex;flex-direction:column;gap:.35cqw;min-width:0;}\n.item-arquivo .data{font-size:1.6cqw;color:#a4a8ab;}\n.item-arquivo .nome{font-size:2.1cqw;color:#2f3336;}\n.item-arquivo .local{\n  font-size:1.55cqw;color:#8b8f93;line-height:1.35;display:flex;gap:.4cqw;\n}\n.item-arquivo .local svg{width:1.5cqw;height:1.5cqw;flex:none;fill:#8b8f93;margin-top:.15cqw;}\n.item-arquivo .direita{\n  display:flex;flex-direction:column;align-items:flex-end;gap:.6cqw;flex:none;\n}\n.item-arquivo .direita b{font-size:2.2cqw;color:#2f3336;font-weight:500;}\n.item-arquivo .direita b i{font-size:1.4cqw;font-style:normal;color:#5b5f63;}\n.etiquetas-arquivo{display:flex;align-items:center;gap:.6cqw;}\n.etiquetas-arquivo em{\n  font-style:normal;font-size:1.5cqw;color:#5b5f63;background:#ececeb;\n  border-radius:.4cqw;padding:.3cqw .8cqw;white-space:nowrap;\n}\n.nuvem{width:2.4cqw;height:2.4cqw;display:grid;place-items:center;flex:none;}\n.nuvem svg{width:100%;height:100%;}\n.nuvem.ok svg{fill:#3ab54a;}\n.nuvem.erro svg{fill:#e8442e;}\n.sem-mais{margin:1.6cqw 0;text-align:center;font-size:1.7cqw;color:#a4a8ab;}\n\n.item-arquivo.material .grafico-material{\n  width:20cqw;flex:none;background:#ececeb;border-radius:.6cqw;padding:.8cqw;\n  display:flex;flex-direction:column;gap:.2cqw;\n}\n.grafico-material .eixo-y{font-size:1.5cqw;color:#5b5f63;}\n.grafico-material .eixo-x{font-size:1.5cqw;color:#5b5f63;text-align:center;}\n.grafico-material svg{width:100%;height:auto;}\n\n/* ---------------- configurações gerais ---------------- */\n.valor-link{font-style:normal;font-size:1.85cqw;color:#5b5f63;margin-left:auto;margin-right:1cqw;}\n.rodape-legal{margin:2cqw 0 .4cqw;text-align:center;font-size:1.6cqw;color:#8b8f93;}\n.rodape-legal b{color:var(--verde-texto);font-weight:400;}\n.copyright{margin:0 0 1cqw;text-align:center;font-size:1.55cqw;color:#a4a8ab;}\n\n.linha-seg{display:flex;align-items:center;gap:1.4cqw;padding:1.4cqw 0;border-bottom:.12cqw solid #e6e6e5;}\n.linha-seg>span{flex:1;font-size:1.95cqw;color:#2f3336;}\n.linha-seg .grupo-opcoes{width:22cqw;margin:0;}\n\n.linha-radio{\n  width:100%;background:transparent;border:0;border-bottom:.12cqw solid #e6e6e5;cursor:pointer;\n  font-family:inherit;display:flex;align-items:center;gap:1.2cqw;padding:1.4cqw .6cqw;\n  font-size:1.95cqw;color:#2f3336;text-align:left;\n}\n.linha-radio .bolha{\n  width:2cqw;height:2cqw;border-radius:50%;border:.28cqw solid #c4c8ca;flex:none;\n}\n.linha-radio.ativa .bolha{border-color:var(--verde);border-width:.6cqw;}\n\n.lista-audios{display:flex;flex-direction:column;}\n.lista-audios div{\n  display:flex;align-items:center;gap:1.2cqw;padding:1.1cqw .4cqw;border-bottom:.12cqw solid #e6e6e5;\n}\n.lista-audios span{flex:1;font-size:1.9cqw;color:#2f3336;}\n.lista-audios em{font-style:normal;font-size:1.7cqw;color:#8b8f93;}\n.lista-audios .botao-contorno{width:auto;padding:.6cqw 1.4cqw;}\n\n.lista-pontos{display:flex;flex-direction:column;gap:.8cqw;margin:0 0 1.2cqw 1cqw;}\n.lista-pontos div{display:flex;flex-direction:column;gap:.2cqw;}\n.lista-pontos b{font-size:1.65cqw;color:#5b5f63;font-weight:400;}\n.lista-pontos span{font-size:1.55cqw;color:#8b8f93;line-height:1.45;margin-left:1.2cqw;}\n\n/* armazenamento */\n.barra-armazenamento{\n  display:flex;height:1.4cqw;border-radius:.3cqw;overflow:hidden;background:#ececeb;margin:1.2cqw 0 .8cqw;\n}\n.barra-armazenamento i{display:block;height:100%;}\n.legenda-armazenamento{display:flex;gap:2.4cqw;margin-bottom:1.2cqw;}\n.legenda-armazenamento span{display:flex;align-items:center;gap:.6cqw;font-size:1.7cqw;color:#5b5f63;}\n.legenda-armazenamento b{width:1.6cqw;height:1.6cqw;border-radius:.2cqw;display:block;}\n.legenda-armazenamento .faixas{\n  background:linear-gradient(90deg,#e055c8 0 33%,#f08a24 33% 66%,#3ab54a 66% 100%);\n}\n.legenda-armazenamento .vazio{background:#fff;box-shadow:inset 0 0 0 .14cqw #c4c8ca;}\n.valor-armazenamento{margin:.2cqw 0;font-size:3cqw;color:#2f3336;}\n.aviso-vermelho{margin:1.2cqw 0;font-size:1.7cqw;color:#e8442e;line-height:1.5;}\n.item-armazenamento{\n  display:flex;align-items:center;gap:1.2cqw;padding:1.1cqw .4cqw;border-bottom:.12cqw solid #e6e6e5;\n}\n.item-armazenamento b{width:1.5cqw;height:1.5cqw;border-radius:.2cqw;flex:none;}\n.item-armazenamento span{flex:1;font-size:1.9cqw;color:#2f3336;}\n.item-armazenamento em{font-style:normal;font-size:1.75cqw;color:#5b5f63;}\n.item-armazenamento .botao-contorno{width:auto;padding:.6cqw 1.4cqw;}\n\n/* diagnóstico de rede */\n.diagrama-rede{position:relative;padding:2cqw 0;text-align:center;}\n.etiqueta-wifi{\n  display:inline-flex;align-items:center;gap:.6cqw;background:#e4f1e8;color:var(--verde-texto);\n  border-radius:1cqw;padding:.6cqw 1.4cqw;font-size:1.9cqw;font-weight:500;\n}\n.etiqueta-wifi svg{width:2cqw;height:2cqw;fill:var(--verde-texto);color:var(--verde-texto);}\n.diagrama-rede .linhas{position:absolute;left:8%;right:8%;top:8cqw;width:84%;height:14cqw;}\n.diagrama-rede .nos{display:flex;justify-content:space-between;align-items:flex-start;padding:2cqw 4cqw 0;}\n.diagrama-rede .nos.baixo{justify-content:center;gap:12cqw;padding-top:3cqw;}\n.diagrama-rede .no{display:flex;flex-direction:column;align-items:center;gap:.5cqw;width:16cqw;}\n.diagrama-rede .no svg{width:3.4cqw;height:3.4cqw;fill:#a4a8ab;color:#a4a8ab;}\n.diagrama-rede .no span{font-size:1.7cqw;color:#a4a8ab;line-height:1.3;}\n.diagrama-rede .no.verde svg,.diagrama-rede .no.centro svg{fill:var(--verde);color:var(--verde);}\n.diagrama-rede .no.verde span,.diagrama-rede .no.centro span{color:var(--verde-texto);}\n.diagrama-rede .atualizar{\n  position:absolute;left:50%;top:15cqw;transform:translateX(-50%);\n}\n\n.caixa-extra .botao-contorno{width:auto;padding:.7cqw 1.6cqw;word-break:normal;white-space:nowrap;}\n"
          },
