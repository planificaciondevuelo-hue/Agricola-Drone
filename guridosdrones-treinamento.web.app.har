          "cookies": [],
          "content": {
            "size": 45478,
            "mimeType": "text/css",
            "text": "/* ============================================================\n   Controle remoto T25 / T50 — desenhado em cima das fotos\n   ============================================================ */\n\n@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');\n\n:root{\n  --verde:#35b04a;\n  --verde-texto:#2a9d4f;\n  --cinza-texto:#3f4245;\n  --cinza-suave:#8b8f93;\n  --branco-app:#f4f4f5;\n  --preto-corpo:#0d0f11;\n}\n\n*{box-sizing:border-box;}\n\nhtml,body{margin:0;padding:0;}\n\nbody{\n  background:radial-gradient(120% 90% at 50% 0%, #15181c 0%, #090a0c 60%, #050506 100%);\n  color:#d8dbde;\n  font-family:Inter,'Segoe UI',Roboto,system-ui,sans-serif;\n  min-height:100vh;\n  padding:28px 16px 60px;\n}\n\n.biblioteca-icones{position:absolute;width:0;height:0;overflow:hidden;}\n\n.cabecalho{max-width:1420px;margin:0 auto 22px;text-align:center;}\n.cabecalho h1{font-size:22px;font-weight:600;letter-spacing:.2px;margin:0 0 6px;color:#e9ecef;}\n.cabecalho p{margin:0;font-size:14px;color:#8b9096;}\n.cabecalho strong{color:#b6bcc2;font-weight:600;}\n.simulador-drone{display:flex;align-items:center;justify-content:center;gap:10px;flex-wrap:wrap;margin:14px auto 0;}\n.simulador-drone .indicador-drone{color:#d7dad8;font-size:14px;}\n.simulador-drone button{background:#364039;color:#fff;border:1px solid #728277;border-radius:7px;\n  padding:8px 14px;font:inherit;font-size:13px;cursor:pointer;}\n.simulador-drone button:focus-visible{outline:3px solid #51d777;outline-offset:2px;}\n.simulador-drone small{color:#959b98;font-size:11px;width:100%;}\nbody.drone-ligado .simulador-drone button{background:#268f44;border-color:#5bd47a;}\n\n.palco{display:flex;justify-content:center;}\n\n/* =======================================================\n   O CONTROLE — desenhado em cima da foto do RC Plus\n   As posições são porcentagens medidas na foto de frente.\n   ======================================================= */\n.controle{\n  position:relative;\n  width:min(1340px,97vw);\n  aspect-ratio:1.687;\n  border-radius:3.6% / 6%;\n  background:\n    linear-gradient(180deg,#b3b8b4 0%,#a3a9a5 8%,#9aa09c 55%,#8b918e 88%,#7d8380 100%);\n  box-shadow:\n    0 34px 70px rgba(0,0,0,.65),\n    inset 0 2px 2px rgba(255,255,255,.35),\n    inset 0 -6px 12px rgba(0,0,0,.28);\n  border:1px solid #6f7572;\n}\n/* reforço emborrachado dos cantos de cima */\n.controle:before,.controle:after{\n  content:'';position:absolute;top:-.6%;width:9%;height:13%;\n  background:linear-gradient(180deg,#9ba19d,#868c89);\n  border-radius:34% 34% 12% 12%;box-shadow:inset 0 1px 0 rgba(255,255,255,.4);\n}\n.controle:before{left:2.6%;}\n.controle:after{right:2.6%;}\n\n.antena{\n  position:absolute;top:-2.2%;width:7%;height:4.4%;\n  background:linear-gradient(180deg,#b6bbb7,#8d938f);\n  border-radius:40% 40% 18% 18%;box-shadow:0 2px 4px rgba(0,0,0,.4);\n}\n.antena.esquerda{left:8.4%;}\n.antena.direita{right:8.4%;}\n\n/* ---- tela ---- */\n.moldura-tela{\n  position:absolute;left:14.4%;top:2.4%;width:71.2%;\n  background:linear-gradient(180deg,#5d6360,#3d4340);\n  border-radius:1.4%;\n  padding:1.1% 1%;\n  box-shadow:\n    inset 0 0 0 1px rgba(255,255,255,.18),\n    0 3px 8px rgba(0,0,0,.35);\n}\n.tela{\n  width:100%;aspect-ratio:16/10;position:relative;overflow:hidden;\n  border-radius:.6%;background:#0a0a0a;\n  container-type:size;\n  font-family:Inter,'Segoe UI',Roboto,sans-serif;\n  user-select:none;\n  box-shadow:0 0 0 1px #000, inset 0 0 26px rgba(0,0,0,.6);\n}\n.tela-app{position:absolute;inset:0;display:none;}\n.tela-app.ativa{display:block;}\n\n/* Estados do controle antes da tela inicial. O botão físico fica fora desta camada. */\n.tela-energia{\n  position:absolute;inset:0;z-index:50;background:#08090b;\n  display:grid;place-items:center;color:#f5f6f6;transition:opacity .35s;\n}\n.tela-energia[data-fase=\"pronto\"]{opacity:0;visibility:hidden;pointer-events:none;}\n/* ligado com a tela apagada (um toque no botao de energia): tela preta, controle continua ligado */\nbody.tela-apagada .tela-energia[data-fase=\"pronto\"]{opacity:1;visibility:visible;pointer-events:auto;background:#000;}\n.etapa-inicializacao{display:none;align-items:center;justify-content:center;flex-direction:column;gap:2cqw;}\n.tela-energia[data-fase=\"logo\"] .etapa-logo,\n.tela-energia[data-fase=\"aeronave\"] .etapa-aeronave,\n.tela-energia[data-fase=\"carregando\"] .etapa-carregando{display:flex;}\n.etapa-logo span{font-size:13cqw;font-style:italic;font-weight:700;letter-spacing:-1.4cqw;line-height:1;}\n.etapa-aeronave svg{width:46cqw;height:24cqw;max-width:80%;}\n.etapa-aeronave span,.etapa-carregando span:last-child{font-size:1.8cqw;color:#9aa4a7;}\n.tela-energia[data-fase=\"aeronave\"]{background:#f4f5f3;}\n.etapa-carregando .icone-carregando{color:#36b458;font-size:5cqw;animation:carregar 1.3s ease-in-out infinite;}\n@keyframes carregar{50%{opacity:.4;transform:scale(.85);}}\n.mensagem-conexao{\n  position:absolute;z-index:42;left:50%;top:50%;transform:translate(-50%,-50%);\n  padding:1.6cqw 2.8cqw;border-radius:.8cqw;background:rgba(16,24,22,.88);\n  color:#fff;font-size:2.1cqw;box-shadow:0 .6cqw 2cqw rgba(0,0,0,.35);pointer-events:none;\n}\n.mensagem-conexao[hidden]{display:none;}\n\n/* Escolha do modo da tarefa no estado conectado. */\n.tela-modos{background:#f6f7f6;color:#333b3b;padding:2.6cqw 3cqw;}\n.tela-modos h2{font-size:2.5cqw;text-align:center;font-weight:500;margin:0 0 2.5cqw;}\n.voltar-modos{position:absolute;top:1.4cqw;left:2cqw;border:0;background:transparent;color:#4c5555;font-size:4cqw;cursor:pointer;line-height:1;}\n.grade-modos{display:grid;grid-template-columns:repeat(6,1fr);grid-template-rows:18cqw 12cqw;gap:1.1cqw;}\n.modo-cartao{border:0;border-radius:.6cqw;text-align:left;padding:1.6cqw;position:relative;overflow:hidden;cursor:pointer;\n  background:#d9dddd;color:#fff;display:flex;flex-direction:column;justify-content:space-between;}\n.modo-cartao b{font-size:2.4cqw;position:relative;z-index:1;}\n.modo-cartao span{font-size:1.35cqw;max-width:75%;position:relative;z-index:1;}\n.modo-cartao i{position:absolute;right:2cqw;bottom:1cqw;font-size:5cqw;font-style:normal;opacity:.55;}\n.modo-rota{grid-column:span 4;background:repeating-linear-gradient(155deg,transparent 0 2.5cqw,rgba(255,255,255,.28) 2.5cqw 2.65cqw),linear-gradient(145deg,#56e133,#239c32);}\n.modo-mapa{grid-column:span 2;background:linear-gradient(150deg,#999f9c,#4e5c5a);}\n.modo-manual,.modo-arvores{grid-column:span 2;background:linear-gradient(135deg,#8d9693,#59635f);}\n.modo-cartao:disabled{cursor:not-allowed;opacity:.67;}\n.modo-cartao:focus-visible,.voltar-modos:focus-visible,.t-power:focus-visible{outline:.35cqw solid #46cc70;outline-offset:.3cqw;}\n.status-config-drone{font-size:1.25cqw;color:#76837e;white-space:nowrap;}\n\n/* ---- manches ---- */\n.manche{\n  position:absolute;width:13.6%;aspect-ratio:1;border-radius:50%;\n  background:radial-gradient(circle at 50% 46%, #6c7370 0 38%, #434946 39%, #2b312e 62%, #191e1c 78%, #232926 100%);\n  box-shadow:inset 0 3px 7px rgba(0,0,0,.65), 0 3px 8px rgba(0,0,0,.4);\n  display:grid;place-items:center;\n}\n.manche.esquerdo{left:1.4%;top:30%;}\n.manche.direito{right:1.4%;top:30%;}\n.manche .base{\n  width:52%;aspect-ratio:1;border-radius:50%;\n  background:radial-gradient(circle at 46% 40%, #a9afab, #767c79 70%, #5c625f 100%);\n  box-shadow:inset 0 -2px 5px rgba(0,0,0,.45);\n  display:grid;place-items:center;\n}\n.manche .haste{\n  position:absolute;width:15%;height:34%;border-radius:22% 22% 34% 34%;\n  background:\n    repeating-linear-gradient(90deg,#cfd4d0 0 1.4px,#8d938f 1.4px 2.8px);\n  box-shadow:0 1px 3px rgba(0,0,0,.5);\n  transform:translateY(-8%);\n}\n.manche .haste:before{\n  content:'';position:absolute;left:-42%;right:-42%;top:-30%;height:46%;border-radius:50%;\n  background:radial-gradient(circle at 42% 34%, #f0e2b4, #c9a94e 70%, #8d7530 100%);\n  box-shadow:0 1px 3px rgba(0,0,0,.45);\n}\n\n/* ---- teclas redondas ---- */\n.tecla{\n  position:absolute;border:0;cursor:pointer;padding:0;border-radius:50%;\n  display:grid;place-items:center;\n  background:radial-gradient(circle at 42% 34%, #5a605d, #3b413e 70%, #2a302d 100%);\n  box-shadow:inset 0 1px 0 rgba(255,255,255,.22), 0 2px 5px rgba(0,0,0,.45);\n}\n.tecla:active{background:radial-gradient(circle at 42% 34%, #3f4542, #262c29 80%);}\n.tecla svg{width:52%;height:52%;fill:#c9cecb;color:#c9cecb;}\n.tecla.redonda{width:4.6%;aspect-ratio:1;}\n.t-emergencia{\n  left:9.6%;top:19.5%;width:5.4%;\n  box-shadow:\n    inset 0 0 0 .22vw #ff2d1e,\n    0 0 16px rgba(255,45,30,.85),\n    inset 0 1px 0 rgba(255,255,255,.2), 0 2px 5px rgba(0,0,0,.45);\n}\n.t-voltar{left:3.4%;top:62%;}\n.t-home{left:8.6%;top:83%;}\n.t-power{right:8.4%;top:83%;}\nbody.desligado .t-power,body.armado .t-power{animation:destacar-energia 1.7s ease-in-out infinite;}\n@keyframes destacar-energia{50%{box-shadow:0 0 0 .6vw rgba(53,176,74,.15),0 0 18px rgba(53,176,74,.9);}}\n.t-pausa{\n  right:2.6%;top:19.5%;width:4%;\n  background:radial-gradient(circle at 42% 34%, #f5a95a 0, #e8862e 55%, #c96a1e 100%);\n  box-shadow:inset 0 1px 0 rgba(255,255,255,.35), 0 0 12px rgba(255,120,30,.55), 0 2px 5px rgba(0,0,0,.4);\n}\n.t-pausa svg{width:44%;height:44%;fill:#fff;}\n.dial-lateral{\n  position:absolute;right:3%;top:62%;width:4.2%;aspect-ratio:1;border-radius:50%;\n  background:radial-gradient(circle at 44% 36%, #8b918e, #595f5c 62%, #3c423f 100%);\n  box-shadow:inset 0 -2px 4px rgba(0,0,0,.5), 0 2px 4px rgba(0,0,0,.4);\n}\n\n/* ---- colunas L1..L3 / R1..R3 ---- */\n.coluna-teclas{\n  position:absolute;top:55%;display:flex;flex-direction:column;align-items:center;gap:1.2%;\n  width:4.8%;z-index:2;\n}\n.coluna-teclas.esquerda{left:8.9%;}\n.coluna-teclas.direita{right:8.9%;}\n.botao-lateral{\n  width:100%;height:auto;aspect-ratio:2.05;border-radius:14%/28%;\n  background:linear-gradient(180deg,#5a605d,#383e3b 60%,#2b312e);\n  color:#d6dbd8;font-size:clamp(7px,.78vw,12px);font-weight:600;letter-spacing:.4px;\n  display:grid;place-items:center;cursor:pointer;\n  box-shadow:inset 0 1px 0 rgba(255,255,255,.22), 0 2px 4px rgba(0,0,0,.4);\n}\n.botao-lateral:active{background:linear-gradient(180deg,#313734,#202623);}\n.coluna-teclas .risco{\n  display:block;width:34%;height:.14em;border-radius:2px;background:#7d8380;opacity:.7;\n}\n\n/* ---- bateria, contatos e pé ---- */\n.contatos{\n  position:absolute;left:44%;width:12%;top:77.4%;height:1.4%;\n  background:\n    repeating-linear-gradient(90deg,#6f7572 0 8%,transparent 8% 18%);\n  opacity:.8;border-radius:2px;\n}\n.bateria{\n  position:absolute;left:19%;right:19%;top:79.5%;bottom:2.4%;\n  background:linear-gradient(180deg,#b7bcb8,#a6aca8 40%,#959b97);\n  border-radius:1.6%/9%;\n  display:flex;align-items:center;justify-content:center;gap:4%;\n  box-shadow:\n    inset 0 2px 2px rgba(255,255,255,.5),\n    inset 0 -3px 6px rgba(0,0,0,.2),\n    0 3px 7px rgba(0,0,0,.28);\n}\n.bateria .furos{\n  flex:1;height:14%;max-height:9px;\n  background:radial-gradient(circle,#6e7471 42%,transparent 44%) 0 50%/ 7% 100% repeat-x;\n  opacity:.85;\n}\n.bateria .marca{\n  font-size:clamp(11px,1.35vw,21px);font-weight:700;letter-spacing:1px;color:#6a706d;\n  text-shadow:0 1px 0 rgba(255,255,255,.45);flex:none;\n}\n.pe-controle{\n  position:absolute;left:26%;right:26%;bottom:-2.4%;height:3.4%;\n  background:linear-gradient(180deg,#4a504d,#2e3431);\n  border-radius:0 0 26% 26%/0 0 100% 100%;\n  box-shadow:0 5px 10px rgba(0,0,0,.45);\n}\n\n/* ---- LEDs ---- */\n.leds{\n  position:absolute;left:50%;transform:translateX(-50%);top:76.4%;\n  display:flex;gap:clamp(7px,.85vw,14px);\n}\n.led{width:clamp(4px,.42vw,7px);height:clamp(6px,.75vw,12px);border-radius:2px;}\n.led.vermelho{background:#ff3b2e;box-shadow:0 0 8px rgba(255,59,46,.9);}\n.led.verde{background:#2bef5d;box-shadow:0 0 8px rgba(43,239,93,.9);}\n.led.apagado{background:#7d8380;opacity:.5;}\nbody.desligado .led,body.ligando .led{background:#555c58;box-shadow:none;opacity:.45;}\nbody.armado .led{background:#2bef5d;box-shadow:0 0 8px rgba(43,239,93,.9);opacity:1;}\n.t-power{touch-action:none;user-select:none;}\nbody.ligando .led.verde{background:#2bef5d;opacity:1;box-shadow:0 0 8px rgba(43,239,93,.9);}\n\n/* ===================== TELA INICIAL ===================== */\n.capa{position:absolute;inset:0 0 26.6cqw 0;overflow:hidden;}\n.arte-capa{width:100%;height:100%;display:block;}\n\n.icones-topo{position:absolute;top:2.6cqw;left:2.4cqw;display:flex;gap:2.5cqw;}\n.icone-redondo{\n  width:3.4cqw;height:3.4cqw;border-radius:50%;border:0;cursor:pointer;\n  background:rgba(255,255,255,.88);display:grid;place-items:center;padding:0;\n  box-shadow:0 .15cqw .4cqw rgba(0,0,0,.25);\n}\n.icone-redondo svg{width:2cqw;height:2cqw;fill:#4a4f53;color:#4a4f53;}\n\n.barra-inferior{\n  position:absolute;left:0;right:0;bottom:0;height:26.6cqw;\n  background:#eceded;display:flex;align-items:center;gap:1.5cqw;\n  padding:0 2.2cqw;\n}\n.cartao{\n  flex:1;height:9.6cqw;background:#fff;border:0;border-radius:1.1cqw;cursor:pointer;\n  display:flex;align-items:center;gap:1cqw;padding:0 1.4cqw;text-align:left;\n  box-shadow:0 .1cqw .35cqw rgba(0,0,0,.07);\n}\n.cartao-texto{display:flex;flex-direction:column;gap:.25cqw;flex:1;min-width:0;}\n.cartao-titulo{font-size:1.95cqw;color:#3b3e41;line-height:1.24;font-weight:400;}\n.cartao-sub{font-size:1.55cqw;color:#8b8f93;}\n.cartao-icone{width:3.6cqw;height:3.6cqw;flex:none;fill:#c9cbcd;color:#c9cbcd;}\n.cartao-conexao .icone-elo{width:2.3cqw;height:2.3cqw;flex:none;fill:#6d7175;color:#6d7175;}\n.botao-comecar{\n  flex:1;height:9.6cqw;border:0;border-radius:1.1cqw;cursor:pointer;\n  background:var(--verde);color:#fff;font-size:2.3cqw;font-weight:500;\n  font-family:inherit;box-shadow:0 .15cqw .4cqw rgba(0,0,0,.18);\n}\n.botao-comecar:active{background:#2d9a40;}\n\n/* ===================== TELAS DE MAPA ===================== */\n.arte-mapa{position:absolute;inset:0;width:100%;height:100%;display:block;}\n.arte-mapa .rotulos text{\n  font-family:Inter,'Segoe UI',Roboto,sans-serif;\n  paint-order:stroke;stroke:rgba(0,0,0,.35);stroke-width:3px;\n}\n\n.barra-superior{\n  position:absolute;top:0;left:0;right:0;height:5.6cqw;\n  background:rgba(20,22,24,.45);display:flex;align-items:center;gap:1.2cqw;padding:0 1.2cqw;\n}\n.icone-barra{\n  background:rgba(255,255,255,.14);border:0;border-radius:.6cqw;cursor:pointer;\n  width:3cqw;height:3cqw;display:grid;place-items:center;padding:0;position:relative;\n}\n.icone-barra svg{width:2.1cqw;height:2.1cqw;fill:#fff;color:#fff;}\n.barra-superior .estado-aeronave{font-size:1.95cqw;color:#fff;font-weight:500;}\n.barra-direita{margin-left:auto;display:flex;align-items:center;gap:1.4cqw;}\n.icone-rc .badge{\n  position:absolute;left:.35cqw;bottom:.25cqw;font-size:1cqw;color:#ff4034;font-weight:700;\n}\n.bloco-gnss{display:flex;align-items:center;gap:.3cqw;}\n.rc-bateria{position:relative;display:grid;place-items:center;}\n.rc-bateria svg{width:2.4cqw;height:2.4cqw;fill:#ff3b2f;color:#ff3b2f;}\n.rc-bateria i{position:absolute;bottom:.1cqw;font-size:1cqw;font-style:normal;font-weight:700;color:#ff3b2f;}\n.gnss{font-size:1.7cqw;font-weight:700;color:#ff3b2f;position:relative;padding-left:.2cqw;}\n.gnss b{position:absolute;top:-1.1cqw;left:-.1cqw;font-size:1.1cqw;}\n\n/* ferramentas (linha de ícones) */\n.ferramentas-mapa{\n  position:absolute;top:6.6cqw;right:1.4cqw;display:flex;gap:1.5cqw;align-items:center;\n}\n.botao-mapa{\n  background:transparent;border:0;cursor:pointer;padding:0;\n  width:2.9cqw;height:2.9cqw;display:grid;place-items:center;\n}\n.botao-mapa svg{\n  width:2.6cqw;height:2.6cqw;fill:#fff;color:#fff;\n  filter:drop-shadow(0 .1cqw .2cqw rgba(0,0,0,.55));\n}\n.botao-mapa:first-child svg{\n  background:rgba(255,255,255,.9);border-radius:.4cqw;fill:#3a3e41;color:#3a3e41;padding:.25cqw;\n}\n\n/* aba que abre a lista */\n.aba-lista,.aba-fechar{\n  position:absolute;border:0;cursor:pointer;padding:0;\n  background:rgba(255,255,255,.62);\n  width:2.8cqw;height:5.4cqw;display:grid;place-items:center;\n}\n.aba-lista{left:0;top:50%;transform:translateY(-50%);border-radius:0 .9cqw .9cqw 0;}\n.aba-lista svg{width:1.7cqw;height:1.7cqw;fill:#5b5f63;}\n.aba-fechar{right:-2.8cqw;top:50%;transform:translateY(-50%);border-radius:0 .9cqw .9cqw 0;}\n.painel-tarefas:not(.aberto) .aba-fechar{display:none;}\n.aba-fechar svg{width:1.7cqw;height:1.7cqw;fill:#5b5f63;}\n\n/* ações da direita */\n.acoes-direita{\n  position:absolute;right:1.4cqw;top:44%;display:flex;align-items:center;gap:.8cqw;\n}\n.botao-selecao{\n  width:5cqw;height:5cqw;border:0;border-radius:.9cqw;cursor:pointer;\n  background:rgba(255,255,255,.92);display:grid;place-items:center;padding:0;\n}\n.botao-selecao svg{width:2.8cqw;height:2.8cqw;fill:#3a3e41;color:#3a3e41;}\n.botao-adicionar{\n  height:5cqw;border:0;border-radius:.9cqw;cursor:pointer;padding:0 2cqw;\n  background:rgba(255,255,255,.92);display:flex;align-items:center;gap:.7cqw;\n  color:#3a3e41;font-size:2.1cqw;font-family:inherit;\n}\n.botao-adicionar svg{width:2.2cqw;height:2.2cqw;fill:none;color:#3a3e41;}\n\n.acoes-inferiores{\n  position:absolute;right:1.4cqw;bottom:2.2cqw;display:flex;flex-direction:column;gap:1cqw;\n}\n.botao-claro{\n  min-width:11cqw;height:4.4cqw;border:0;border-radius:.8cqw;cursor:pointer;\n  background:rgba(255,255,255,.92);display:flex;align-items:center;justify-content:center;gap:.8cqw;\n  color:#3a3e41;font-size:1.95cqw;font-family:inherit;\n}\n.botao-claro svg{width:2cqw;height:2cqw;fill:#3a3e41;color:#3a3e41;}\n.botao-claro.desativado{background:rgba(255,255,255,.55);color:#9a9ea1;}\n.botao-claro.desativado svg{fill:#9a9ea1;color:#9a9ea1;}\n\n/* ===================== PAINEL DE TAREFAS ===================== */\n.painel-tarefas{\n  position:absolute;left:0;top:5.6cqw;bottom:0;width:27cqw;\n  background:#f1f1f0;transform:translateX(-100%);transition:transform .22s ease;\n  display:flex;flex-direction:column;\n}\n.painel-tarefas.aberto{transform:translateX(0);}\n.abas-painel{display:flex;align-items:flex-start;padding:1.4cqw 1.6cqw .4cqw;gap:2cqw;}\n.aba{\n  background:transparent;border:0;cursor:pointer;font-family:inherit;padding:0 0 .6cqw;\n  font-size:2.1cqw;color:#6d7175;line-height:1.15;text-align:center;\n}\n.aba.ativa{color:var(--verde-texto);font-weight:600;border-bottom:.3cqw solid var(--verde);}\n.linha-busca{display:flex;align-items:center;gap:1cqw;padding:.4cqw 1.6cqw 1cqw;}\n.campo-busca{\n  flex:1;height:3.4cqw;border-radius:.7cqw;background:#e4e4e3;\n  display:flex;align-items:center;padding:0 1cqw;\n}\n.campo-busca svg{width:1.9cqw;height:1.9cqw;fill:#8b8f93;color:#8b8f93;}\n.ordenar{\n  background:transparent;border:0;cursor:pointer;font-family:inherit;\n  display:flex;align-items:center;gap:.6cqw;color:#4a4e52;font-size:1.85cqw;\n}\n.ordenar svg{width:1.8cqw;height:1.8cqw;fill:#4a4e52;color:#4a4e52;}\n.lista-tarefas{flex:1;overflow-y:auto;overflow-x:hidden;}\n.item-tarefa{\n  width:100%;background:#f6f6f5;border:0;border-bottom:.12cqw solid #e2e2e1;cursor:pointer;\n  font-family:inherit;text-align:left;padding:1.2cqw 1.6cqw 1.4cqw;display:block;\n}\n.item-tarefa:hover{background:#eceeeb;}\n.linha-topo{display:flex;justify-content:space-between;align-items:baseline;gap:1cqw;}\n.linha-topo .data{font-size:1.7cqw;color:#9a9ea1;}\n.linha-topo .area{font-size:1.9cqw;color:#3f4245;font-weight:500;}\n.item-tarefa .nome{font-size:2.2cqw;color:#2f3336;margin:.5cqw 0 .4cqw;}\n.item-tarefa .local{display:flex;gap:.5cqw;color:#7f8386;font-size:1.65cqw;line-height:1.35;}\n.item-tarefa .local svg{width:1.6cqw;height:1.6cqw;flex:none;fill:#7f8386;margin-top:.15cqw;}\n\n/* ===================== TELA DE MAPEAMENTO ===================== */\n.painel-rota{\n  position:absolute;left:1cqw;top:6.4cqw;max-height:calc(100% - 7.4cqw);width:23.5cqw;\n  background:#f4f4f3;border-radius:1cqw;padding:1.3cqw 1.4cqw;\n  display:flex;flex-direction:column;overflow:hidden;\n}\n/* aba do painel: encostada na borda direita dele; com o painel recolhido,\n   fica na borda da tela e a seta vira para fora */\n.alternar-painel-rota{\n  position:absolute;left:calc(1cqw + 23.5cqw);top:15cqw;z-index:6;\n  width:2.3cqw;height:6.5cqw;padding:0;border:0;border-radius:0 .9cqw .9cqw 0;\n  background:rgba(244,244,243,.96);color:#414548;font-size:2.6cqw;line-height:1;cursor:pointer;\n  display:flex;align-items:center;justify-content:center;box-shadow:.2cqw 0 .6cqw rgba(0,0,0,.18);\n}\n[data-tela=\"mapeamento\"].painel-recolhido .painel-rota{display:none}\n[data-tela=\"mapeamento\"].painel-recolhido .alternar-painel-rota{left:0}\n.painel-rota h2{\n  margin:0 0 1cqw;font-size:1.85cqw;font-weight:400;color:#414548;text-align:center;line-height:1.25;\n}\n.abas-rota{display:flex;justify-content:space-around;gap:1cqw;margin-bottom:1.4cqw;}\n.aba-rota{\n  background:transparent;border:0;cursor:pointer;font-family:inherit;\n  font-size:2cqw;color:#8b8f93;padding-bottom:.5cqw;line-height:1.1;\n}\n.aba-rota.ativa{color:var(--verde-texto);font-weight:600;border-bottom:.28cqw solid var(--verde);}\n.conteudo-rota{display:none;flex:1;flex-direction:column;}\n.conteudo-rota.ativa{display:flex;}\n.rotulo-campo{margin:0 0 .9cqw;font-size:1.8cqw;color:#414548;line-height:1.3;}\n.rotulo-campo span{font-size:1.4cqw;color:#8b8f93;}\n.rotulo-campo .info{width:1.5cqw;height:1.5cqw;fill:#a0a4a7;color:#a0a4a7;vertical-align:-.2cqw;}\n.passo{display:flex;align-items:center;gap:1cqw;margin-bottom:1.6cqw;}\n.passo-botao{\n  width:4.2cqw;height:3.4cqw;border:0;border-radius:.6cqw;background:#e5e5e4;cursor:pointer;\n  font-size:2.2cqw;color:#5b5f63;font-family:inherit;display:grid;place-items:center;\n}\n.passo-botao:active{background:#d6d6d5;}\n.passo-valor{\n  flex:1;text-align:center;font-size:2.5cqw;font-weight:600;color:var(--verde-texto);\n  border-bottom:.14cqw solid #d6d6d5;padding-bottom:.35cqw;\n}\n.segmentado{display:flex;margin-bottom:1.3cqw;border-radius:.6cqw;overflow:hidden;}\n.segmentado button{\n  flex:1;height:3.4cqw;border:.14cqw solid #d6d6d5;background:#fff;cursor:pointer;\n  font-family:inherit;font-size:1.8cqw;color:#5b5f63;\n}\n.segmentado button:first-child{border-radius:.6cqw 0 0 .6cqw;}\n.segmentado button:last-child{border-radius:0 .6cqw .6cqw 0;border-left:0;}\n.segmentado button.ativa{border-color:var(--verde);color:var(--verde-texto);font-weight:600;}\n.rodape-rota{\n  display:flex;align-items:center;justify-content:space-between;\n  gap:.8cqw;padding-top:.4cqw;\n}\n.ponto-inicial{font-size:1.75cqw;color:#8b8f93;white-space:nowrap;}\n.botao-contorno{\n  border:.14cqw solid var(--verde);background:#fff;color:var(--verde-texto);cursor:pointer;\n  border-radius:.6cqw;font-family:inherit;font-size:1.7cqw;padding:.6cqw .5cqw;line-height:1.15;\n  width:8.6cqw;min-width:0;flex:none;font-weight:600;word-break:break-all;text-align:center;\n}\n.lista-cobertura{display:flex;flex-direction:column;margin-bottom:1.6cqw;}\n.lista-cobertura button{\n  display:flex;align-items:center;gap:1cqw;padding:.9cqw 1cqw;cursor:pointer;font-family:inherit;\n  background:#fff;border:.14cqw solid #dededd;border-bottom:0;font-size:1.8cqw;color:#5b5f63;text-align:left;\n}\n.lista-cobertura button:first-child{border-radius:.6cqw .6cqw 0 0;}\n.lista-cobertura button:last-child{border-radius:0 0 .6cqw .6cqw;border-bottom:.14cqw solid #dededd;}\n.lista-cobertura button svg{width:1.9cqw;height:1.9cqw;fill:#5b5f63;color:#5b5f63;flex:none;}\n.lista-cobertura button.ativa{border-color:var(--verde);color:var(--verde-texto);font-weight:600;}\n.lista-cobertura button.ativa svg{fill:var(--verde-texto);color:var(--verde-texto);}\n.linha-toggle{display:flex;align-items:flex-start;justify-content:space-between;gap:1cqw;margin-bottom:1.4cqw;}\n.linha-toggle .rotulo-campo{margin:0;flex:1;}\n.interruptor{\n  width:4.4cqw;height:2.4cqw;border-radius:1.2cqw;background:#d8d8d7;border:0;cursor:pointer;\n  position:relative;flex:none;transition:background .18s;\n}\n.interruptor i{\n  position:absolute;top:.2cqw;left:.2cqw;width:2cqw;height:2cqw;border-radius:50%;\n  background:#fff;box-shadow:0 .1cqw .25cqw rgba(0,0,0,.25);transition:left .18s;\n}\n.interruptor.ligado{background:var(--verde);}\n.interruptor.ligado i{left:2.2cqw;}\n.linha-config{\n  display:flex;align-items:center;justify-content:space-between;gap:1cqw;margin-bottom:1.3cqw;\n}\n.linha-config span{font-size:1.8cqw;color:#414548;line-height:1.25;}\n\n/* aviso amarelo */\n.aviso-amarelo{\n  position:absolute;left:25.8cqw;top:6.2cqw;width:31cqw;\n  background:#f2c52a;border-radius:.5cqw;padding:1cqw 1.2cqw;\n  font-size:1.75cqw;color:#3a3326;line-height:1.35;display:flex;gap:.8cqw;\n}\n.aviso-amarelo.escondido{display:none;}\n.fechar-aviso{\n  background:transparent;border:0;cursor:pointer;color:#3a3326;font-size:2cqw;\n  line-height:1;padding:0;flex:none;align-self:flex-start;font-family:inherit;\n}\n\n/* caixa das áreas */\n.caixa-areas{\n  position:absolute;right:1.4cqw;top:11.2cqw;width:22cqw;white-space:nowrap;\n  background:rgba(25,20,15,.6);border-radius:.4cqw;padding:.7cqw 1cqw;\n}\n.caixa-areas div{display:flex;align-items:baseline;gap:.5cqw;color:#fff;}\n.caixa-areas div+div{margin-top:.4cqw;}\n.caixa-areas span{flex:1;font-size:1.7cqw;font-weight:600;}\n.caixa-areas b{font-size:1.9cqw;font-weight:700;}\n.caixa-areas i{font-size:1.4cqw;font-style:normal;}\n\n/* lista de tipos de ponto */\n.lista-tipos{\n  position:absolute;right:1.4cqw;top:19cqw;width:24cqw;max-height:21.4cqw;overflow-y:auto;\n  background:#f4f4f3;border-radius:.9cqw;padding:.5cqw 0;\n}\n.lista-tipos button{\n  width:100%;background:transparent;border:0;cursor:pointer;font-family:inherit;\n  display:flex;align-items:center;gap:1cqw;padding:.85cqw 1.2cqw;\n  font-size:1.85cqw;color:#414548;text-align:left;\n}\n.lista-tipos button.ativa{background:var(--verde);color:#fff;font-weight:600;}\n.bolinha{width:1.5cqw;height:1.5cqw;border-radius:50%;flex:none;display:grid;place-items:center;}\n.bolinha.cinza{background:#a8acae;}\n.bolinha.vermelha{background:#ef3b2c;}\n.bolinha.roxa{background:#b84fd6;}\n.bolinha.anel{border:.35cqw solid #ef3b2c;background:#fff;}\n.bolinha.onda svg,.bolinha.pino svg{width:1.6cqw;height:1.6cqw;fill:#414548;color:#414548;}\n.lista-tipos button.ativa .bolinha.onda svg,.lista-tipos button.ativa .bolinha.pino svg{fill:#fff;color:#fff;}\n\n/* adicionar ponto */\n.linha-adicionar{\n  position:absolute;right:1.4cqw;top:42.5cqw;display:flex;gap:.7cqw;width:24cqw;\n}\n.botao-reticulo{\n  width:4.6cqw;height:4.6cqw;border:0;border-radius:.8cqw;cursor:pointer;\n  background:#f4f4f3;display:grid;place-items:center;padding:0;flex:none;\n}\n.botao-reticulo svg{width:2.6cqw;height:2.6cqw;fill:none;color:#414548;}\n.botao-adicionar-ponto{\n  flex:1;height:4.6cqw;border:0;border-radius:.8cqw;cursor:pointer;\n  background:#f4f4f3;color:#414548;font-size:2cqw;font-family:inherit;\n}\n.botao-adicionar-ponto:active{background:#e3e3e2;}\n\n.menu-metodo{\n  position:absolute;right:26.4cqw;top:40cqw;width:17cqw;\n  background:#f4f4f3;border-radius:.9cqw;padding:1cqw .9cqw;display:none;\n}\n.menu-metodo.aberto{display:block;}\n.menu-metodo p{margin:0 0 .7cqw;font-size:1.6cqw;color:#8b8f93;}\n.menu-metodo button{\n  width:100%;background:transparent;border:0;cursor:pointer;font-family:inherit;\n  display:flex;align-items:center;gap:1cqw;padding:.7cqw 1cqw;border-radius:.6cqw;\n  font-size:1.9cqw;color:#414548;\n}\n.menu-metodo button svg{width:2cqw;height:2cqw;fill:#414548;color:#414548;}\n.menu-metodo button.ativa{background:var(--verde);color:#fff;font-weight:600;}\n.menu-metodo button.ativa svg{fill:#fff;color:#fff;}\n\n/* diálogo */\n.dialogo-fundo{\n  position:absolute;inset:0;display:none;align-items:center;justify-content:center;\n  background:rgba(0,0,0,.18);\n}\n.dialogo-fundo.aberto{display:flex;}\n.dialogo{\n  width:36cqw;background:#f7f7f6;border-radius:1.2cqw;padding:2cqw 2.2cqw 0;\n  box-shadow:0 1cqw 3cqw rgba(0,0,0,.35);\n}\n.dialogo h3{margin:0 0 1.6cqw;text-align:center;font-size:2.2cqw;font-weight:400;color:#414548;}\n.rotulo-dialogo{margin:0 0 .7cqw;font-size:1.8cqw;color:#5b5f63;}\n.dialogo input{\n  width:100%;height:4cqw;border:0;border-radius:.5cqw;background:#e8e8e7;\n  padding:0 1cqw;font-family:inherit;font-size:1.9cqw;color:#5b5f63;\n}\n.dialogo input:focus{outline:.14cqw solid var(--verde);}\n.botoes-dialogo{display:flex;margin-top:1.6cqw;border-top:.12cqw solid #e0e0df;}\n.botoes-dialogo button{\n  flex:1;background:transparent;border:0;cursor:pointer;font-family:inherit;\n  padding:1.3cqw 0;font-size:2cqw;color:#5b5f63;\n}\n.botoes-dialogo button+button{border-left:.12cqw solid #e0e0df;}\n.botoes-dialogo .verde{color:var(--verde-texto);}\n\n/* marcador do controle no mapa */\n.marcador-controle{fill:#2b7fe0;}\n\n@media (max-width:760px){\n  .cabecalho h1{font-size:17px;}\n  .cabecalho p{font-size:12px;}\n  .controle{border-radius:20px;}\n}\n\n/* ---------- lista de tarefas: item escolhido ---------- */\n.lista-vazia{margin:2.5cqw 0;text-align:center;font-size:1.7cqw;color:#a8acae;}\n.item-tarefa{position:relative;overflow:hidden;}\n.item-tarefa.selecionada{\n  background:#fff;border:.14cqw solid var(--verde);border-radius:.7cqw;margin:.4cqw .6cqw;\n}\n.item-tarefa .numero{display:none;}\n.item-tarefa.selecionada .numero{\n  display:grid;place-items:center;position:absolute;top:0;right:0;\n  width:2.8cqw;height:2.2cqw;background:var(--verde);color:#fff;\n  font-size:1.4cqw;font-weight:600;border-radius:0 .5cqw 0 .9cqw;\n}\n.acoes-item{display:none;}\n.item-tarefa.selecionada .acoes-item{\n  display:flex;border-top:.12cqw solid #e2e2e1;margin-top:1cqw;\n}\n.acoes-item button{\n  flex:1;background:transparent;border:0;cursor:pointer;font-family:inherit;\n  display:flex;flex-direction:column;align-items:center;gap:.3cqw;\n  padding:.9cqw .2cqw;color:#4a4e52;font-size:1.6cqw;line-height:1.2;\n}\n.acoes-item button+button{border-left:.12cqw solid #e2e2e1;}\n.acoes-item svg{width:1.9cqw;height:1.9cqw;fill:#4a4e52;color:#4a4e52;}\n\n/* ---------- escala do mapa ---------- */\n.escala-mapa{\n  position:absolute;right:26cqw;top:7cqw;display:flex;flex-direction:column;align-items:center;gap:.2cqw;\n}\n.escala-mapa span{font-size:1.5cqw;color:#fff;text-shadow:0 .1cqw .2cqw rgba(0,0,0,.6);}\n.escala-mapa i{\n  display:block;width:5cqw;height:.5cqw;border:.2cqw solid #fff;border-top:0;\n  filter:drop-shadow(0 .1cqw .2cqw rgba(0,0,0,.6));\n}\n\n/* ---------- caixa de informações da tarefa ---------- */\n.caixa-info-tarefa{\n  position:absolute;right:1.4cqw;top:11.2cqw;width:26cqw;display:none;\n  background:rgba(25,20,15,.62);border-radius:.4cqw;padding:.7cqw 1cqw;\n}\n.caixa-info-tarefa div{display:flex;align-items:baseline;gap:.5cqw;color:#fff;}\n.caixa-info-tarefa div+div{margin-top:.35cqw;}\n.caixa-info-tarefa span{flex:1;font-size:1.62cqw;font-weight:600;white-space:nowrap;}\n.caixa-info-tarefa b{font-size:1.9cqw;font-weight:700;}\n.caixa-info-tarefa i{font-size:1.4cqw;font-style:normal;}\n\n.botao-dividir{\n  position:absolute;right:1.4cqw;top:23cqw;display:none;\n}\n\n/* ---------- tela de dividir campo ---------- */\n.painel-dividir{\n  position:absolute;right:1.4cqw;top:40%;width:22cqw;display:flex;flex-direction:column;gap:.7cqw;\n}\n.legenda-ancoragem{\n  background:rgba(25,20,15,.62);border-radius:.4cqw;padding:.7cqw 1cqw;\n  color:#fff;font-size:1.8cqw;font-weight:600;display:flex;align-items:center;gap:.8cqw;\n}\n.bolinha-ancoragem{width:1.6cqw;height:1.6cqw;border-radius:50%;background:#e9eef0;flex:none;}\n.botao-claro.largo{width:100%;min-width:0;}\n.botao-claro span br{content:'';}\n\n\n/* ============================================================\n   Aeronave conectada\n   ============================================================ */\n.capa-conectado,.barra-voo,.avisos-voo,.fpv,.bussola,.barra-dados{display:none;}\n.cartao-conexao .icone-ligado{display:none;}\n.cartao-conexao{cursor:default;}\n\nbody.conectado .arte-capa{display:none;}\nbody.conectado .capa-conectado{display:block;position:absolute;inset:0;overflow:hidden;}\nbody.conectado .cartao-conexao .icone-elo{display:none;}\nbody.conectado .cartao-conexao .icone-ligado{\n  display:block;width:2.3cqw;height:2.3cqw;flex:none;fill:var(--verde);color:var(--verde);\n}\nbody.conectado [data-tela=\"mapa\"] .barra-superior{display:none;}\nbody.conectado [data-tela=\"mapa\"] .barra-voo,\nbody.conectado [data-tela=\"mapa\"] .avisos-voo,\nbody.conectado [data-tela=\"mapa\"] .fpv,\nbody.conectado [data-tela=\"mapa\"] .bussola,\nbody.conectado [data-tela=\"mapa\"] .barra-dados{display:flex;}\n\n/* botão de emergência verde e LEDs todos verdes */\nbody.conectado .t-emergencia{\n  box-shadow:\n    inset 0 0 0 .22vw #3ad46a,\n    0 0 16px rgba(58,212,106,.85),\n    inset 0 1px 0 rgba(255,255,255,.2), 0 2px 5px rgba(0,0,0,.45);\n}\nbody.conectado .led.vermelho{background:#2bef5d;box-shadow:0 0 8px rgba(43,239,93,.9);}\nbody.conectado .led.apagado{background:#2bef5d;box-shadow:0 0 8px rgba(43,239,93,.9);opacity:1;}\n\n/* ---------------- capa do app conectado ---------------- */\n.capa-conectado .fundo-verde{width:100%;height:100%;display:block;}\n.conteudo-banner{position:absolute;left:5cqw;top:7cqw;width:46cqw;color:#fff;}\n.conteudo-banner h3{margin:0 0 .8cqw;font-size:4.2cqw;font-weight:700;line-height:1.15;}\n.conteudo-banner p{margin:0 0 2cqw;font-size:2cqw;font-weight:600;}\n.linha-banner{display:flex;gap:1.6cqw;align-items:flex-start;}\n.linha-banner .qr{width:11cqw;flex:none;background:#fff;border-radius:.6cqw;padding:.5cqw;}\n.linha-banner .qr svg{width:100%;height:auto;display:block;}\n.itens-banner{display:flex;flex-direction:column;gap:.7cqw;flex:1;}\n.itens-banner b{\n  background:rgba(120,200,90,.65);border-radius:.5cqw;padding:.6cqw 1cqw;\n  font-size:1.9cqw;font-weight:500;\n}\n.cartao-banner{\n  position:absolute;right:9cqw;top:4cqw;width:24cqw;background:#fbfbfa;border-radius:1cqw;\n  padding:1.2cqw;box-shadow:0 .6cqw 2cqw rgba(0,0,0,.3);\n}\n.cartao-banner .titulo-cartao{margin:0 0 .3cqw;font-size:1.8cqw;color:#2f3336;font-weight:600;}\n.cartao-banner .periodo{margin:0 0 .8cqw;font-size:1.4cqw;color:#a4a8ab;}\n.cartao-banner .numeros{display:flex;justify-content:space-between;margin-bottom:.6cqw;}\n.cartao-banner .numeros span{font-size:1.3cqw;color:#8b8f93;}\n.cartao-banner .numeros b{font-size:2cqw;color:#2f3336;margin-right:.2cqw;}\n.cartao-banner .barras{width:100%;height:auto;margin-bottom:1cqw;}\n.linhas-resumo{display:flex;flex-direction:column;gap:.5cqw;}\n.linhas-resumo span{\n  display:flex;gap:.6cqw;align-items:baseline;font-size:1.4cqw;color:#8b8f93;\n  border-top:.1cqw solid #ececeb;padding-top:.5cqw;\n}\n.linhas-resumo b{font-size:1.7cqw;color:#2f3336;}\n\n/* ---------------- barra de voo ---------------- */\n.barra-voo{\n  position:absolute;top:0;left:0;right:0;height:5.4cqw;\n  align-items:center;gap:1cqw;padding:0 1.2cqw;\n  background:linear-gradient(90deg,rgba(20,22,24,.35) 0 2cqw,rgba(20,22,24,.18));\n}\n.barra-voo .alerta-voo{\n  background:#e8322c;color:#fff;font-size:2cqw;font-weight:600;\n  padding:.7cqw 2.4cqw .7cqw 1.4cqw;border-radius:.2cqw;margin-left:-.4cqw;\n}\n.barra-voo .data-voo{\n  flex:1;font-size:1.6cqw;color:#fff;opacity:.9;text-align:right;\n  text-shadow:0 .1cqw .2cqw rgba(0,0,0,.6);\n}\n.status-voo{display:flex;align-items:center;gap:1.2cqw;}\n.status-voo i{\n  display:flex;align-items:center;gap:.25cqw;font-style:normal;font-size:1.7cqw;font-weight:700;\n  text-shadow:0 .1cqw .2cqw rgba(0,0,0,.5);\n}\n.status-voo i svg{width:2.1cqw;height:2.1cqw;}\n.status-voo .sinal svg{fill:#3ad46a;}\n.status-voo .gnss{color:#3ad46a;}\n.status-voo .gnss svg{fill:#3ad46a;}\n.status-voo .gnss b{font-size:1.2cqw;align-self:flex-start;}\n.status-voo .bat-drone{color:#f0c419;}\n.status-voo .bat-drone svg{fill:#f0c419;color:#f0c419;}\n.status-voo .tanque{color:#ff4034;}\n.status-voo .tanque svg{fill:none;color:#ff4034;}\n.status-voo .bat-rc{color:#3ad46a;}\n.status-voo .bat-rc svg{fill:#3ad46a;}\n.status-voo .bat-rc b{position:absolute;font-size:0;}\n\n/* avisos brancos */\n.avisos-voo{\n  position:absolute;left:1.2cqw;top:6.4cqw;width:30cqw;flex-direction:column;gap:.5cqw;\n}\n.aviso-branco{\n  background:#f7f7f6;border-radius:.3cqw;padding:.8cqw 1cqw;display:flex;gap:.8cqw;\n  font-size:1.75cqw;color:#2f3336;line-height:1.35;\n}\n.aviso-branco span{flex:1;}\n.aviso-branco button{\n  background:transparent;border:0;cursor:pointer;font-size:1.9cqw;color:#5b5f63;\n  line-height:1;padding:0;font-family:inherit;\n}\n.aviso-vermelho-voo{background:#e8322c;color:#fff;}\n.aviso-vermelho-voo button{color:#fff;}\n.aviso-amarelo-voo{background:#f2c52a;color:#3a3326;}\n\n/* FPV, bússola e dados */\n.fpv{\n  position:absolute;left:1.2cqw;bottom:1.2cqw;width:22cqw;aspect-ratio:16/10;\n  border-radius:.4cqw;overflow:hidden;box-shadow:0 .2cqw .6cqw rgba(0,0,0,.5);\n}\n.fpv svg{width:100%;height:100%;display:block;}\n.bussola{\n  position:absolute;left:24.4cqw;bottom:1.2cqw;width:12cqw;\n}\n.bussola svg{width:100%;height:auto;display:block;}\n.barra-dados{\n  position:absolute;left:37.5cqw;right:20cqw;bottom:1.6cqw;\n  align-items:flex-end;justify-content:space-between;gap:1.4cqw;\n}\n.barra-dados div{display:flex;flex-direction:column;gap:.2cqw;color:#fff;\n  text-shadow:0 .1cqw .3cqw rgba(0,0,0,.7);}\n.barra-dados span{font-size:1.6cqw;font-weight:600;}\n.barra-dados b{font-size:2.6cqw;font-weight:700;}\n.barra-dados i{font-size:1.4cqw;font-style:normal;margin-left:-.2cqw;}\n.barra-dados div b+i{display:inline;}\n.barra-dados div{flex-direction:row;align-items:baseline;gap:.3cqw;flex-wrap:wrap;}\n.barra-dados span{width:100%;}\n\n/* escolher entre mapas sobrepostos */\n.escolher-mapa{\n  position:absolute;display:none;background:#f7f7f6;border-radius:.7cqw;padding:.8cqw;\n  box-shadow:0 .4cqw 1.2cqw rgba(0,0,0,.35);width:22cqw;z-index:6;\n}\n.escolher-mapa.aberto{display:block;}\n.escolher-mapa p{margin:0 0 .6cqw;font-size:1.6cqw;color:#8b8f93;}\n.opcoes-mapa{display:flex;flex-direction:column;gap:.3cqw;}\n.opcoes-mapa button{\n  background:transparent;border:0;border-radius:.5cqw;cursor:pointer;font-family:inherit;\n  display:flex;align-items:center;gap:1cqw;\n  padding:.9cqw 1cqw;font-size:1.95cqw;color:#2f3336;text-align:left;\n}\n.opcoes-mapa button:before{\n  content:'';width:2.2cqw;height:2.2cqw;border-radius:50%;border:.24cqw solid #c4c8ca;flex:none;\n}\n.opcoes-mapa button.ativa:before{\n  content:attr(data-numero);background:var(--verde);border-color:var(--verde);color:#fff;\n  font-size:1.4cqw;font-weight:700;display:grid;place-items:center;\n}\n.opcoes-mapa button span{flex:1;}\n.opcoes-mapa button:hover{background:#e8e8e7;}\n.opcoes-mapa button em{font-style:normal;font-size:1.6cqw;color:#8b8f93;}\n\n\n/* ============================================================\n   Tela de execução da tarefa\n   ============================================================ */\n[data-tela=\"execucao\"] .barra-voo,\n[data-tela=\"execucao\"] .avisos-voo,\n[data-tela=\"execucao\"] .fpv,\n[data-tela=\"execucao\"] .bussola,\n[data-tela=\"execucao\"] .barra-dados{display:flex;}\n[data-tela=\"execucao\"] .avisos-voo{left:27cqw;top:6.4cqw;width:27cqw;}\n[data-tela=\"execucao\"] .fpv{display:none;}\n[data-tela=\"execucao\"] .bussola{left:27cqw;bottom:.6cqw;width:13cqw;}\n[data-tela=\"execucao\"] .barra-dados{left:40.5cqw;right:19cqw;}\n[data-tela=\"execucao\"] .escala-mapa{right:30cqw;top:6.6cqw;}\n[data-tela=\"execucao\"] .ferramentas-mapa{top:6.4cqw;}\n\n.painel-execucao{\n  position:absolute;left:1cqw;top:6.4cqw;bottom:.8cqw;width:25cqw;\n  background:#f7f7f6;border-radius:1cqw;padding:1cqw 1.2cqw;\n  display:flex;flex-direction:column;overflow:hidden;\n}\n.abas-exec{\n  display:flex;background:#ececeb;border-radius:2cqw;padding:.3cqw;margin-bottom:1.2cqw;flex:none;\n}\n.abas-exec button{\n  flex:1;background:transparent;border:0;border-radius:2cqw;cursor:pointer;font-family:inherit;\n  font-size:2cqw;color:#8b8f93;padding:.8cqw 0;\n}\n.abas-exec button.ativa{background:var(--verde);color:#fff;font-weight:600;}\n.conteudo-exec{display:none;overflow-y:auto;padding-right:.4cqw;}\n.conteudo-exec.ativa{display:block;}\n.conteudo-exec::-webkit-scrollbar{width:.4cqw;}\n.conteudo-exec::-webkit-scrollbar-thumb{background:#d8d8d7;border-radius:.2cqw;}\n\n.linha-gabarito{display:flex;align-items:center;gap:.8cqw;margin-bottom:1.4cqw;}\n.linha-gabarito .caixa-select{flex:1;min-width:0;font-size:1.85cqw;padding:1cqw;}\n.botao-reset{\n  background:transparent;border:0;cursor:pointer;width:3.4cqw;height:3.4cqw;flex:none;\n  display:grid;place-items:center;padding:0;\n}\n.botao-reset svg{width:2.6cqw;height:2.6cqw;fill:#5b5f63;color:#5b5f63;}\n\n.linha-info{display:flex;justify-content:space-between;align-items:baseline;padding:.2cqw 0 1.2cqw;}\n.linha-info span{font-size:1.8cqw;color:#8b8f93;}\n.linha-info em{font-style:normal;font-size:1.8cqw;color:#5b5f63;}\n.conteudo-exec .linha-link{padding:1.1cqw 0;font-size:1.85cqw;gap:.8cqw;}\n.conteudo-exec .linha-link span{flex:1;text-align:left;line-height:1.3;}\n.conteudo-exec .linha-link.coluna span{display:flex;flex-direction:column;gap:.3cqw;}\n.verde-valor{font-style:normal;color:var(--verde-texto);font-size:1.8cqw;}\n.rotulo-toggle .unidade{font-size:1.4cqw;color:#8b8f93;}\n.rotulo-toggle .alvo{width:1.9cqw;height:1.9cqw;fill:#5b5f63;color:#5b5f63;vertical-align:-.3cqw;}\n\n.lista-cenario{display:flex;flex-direction:column;margin-bottom:1.4cqw;}\n.lista-cenario button{\n  display:flex;align-items:center;gap:1cqw;background:#fff;border:.14cqw solid #dededd;border-bottom:0;\n  cursor:pointer;font-family:inherit;padding:1cqw 1.2cqw;font-size:1.9cqw;color:#5b5f63;text-align:left;\n}\n.lista-cenario button:first-child{border-radius:.6cqw .6cqw 0 0;}\n.lista-cenario button:last-child{border-radius:0 0 .6cqw .6cqw;border-bottom:.14cqw solid #dededd;}\n.lista-cenario button svg{width:2.2cqw;height:2.2cqw;fill:#8b8f93;color:#8b8f93;flex:none;}\n.lista-cenario button.ativa{background:#eaf6ee;border-color:var(--verde);color:var(--verde-texto);font-weight:600;}\n.lista-cenario button.ativa svg{fill:var(--verde);color:var(--verde);}\n\n.caixa-info-tarefa.exec{display:block;top:9.4cqw;width:27cqw;background:rgba(18,16,14,.72);}\n.caixa-info-tarefa .etiqueta-baixa{\n  font-style:normal;font-size:1.7cqw;color:#ff6a5e;background:rgba(255,80,60,.18);\n  border-radius:.4cqw;padding:.2cqw .8cqw;font-weight:600;\n}\n.botao-retificar{\n  position:absolute;right:1.4cqw;top:17.6cqw;min-width:22cqw;justify-content:center;\n  color:#5b5f63;\n}\n.bloco-conexao{position:absolute;right:1.4cqw;top:23.4cqw;width:22cqw;}\n.legenda-conexao{\n  background:rgba(18,16,14,.72);border-radius:.5cqw;padding:.7cqw 1cqw;color:#fff;\n  font-size:1.8cqw;font-weight:600;display:flex;align-items:center;gap:.8cqw;margin-bottom:.6cqw;\n}\n.bolinha-rosa{width:1.6cqw;height:1.6cqw;border-radius:50%;background:#e94fd0;flex:none;}\n\n/* painel de retificação */\n.painel-retificar{\n  position:absolute;left:1cqw;top:6.4cqw;bottom:.8cqw;width:25cqw;\n  background:#f7f7f6;border-radius:1cqw;padding:1.4cqw 1.2cqw 0;\n  display:none;flex-direction:column;\n}\n.painel-retificar.aberto{display:flex;}\n.painel-retificar h3{margin:0 0 2cqw;text-align:center;font-size:2cqw;font-weight:400;color:#414548;}\n.dpad{\n  width:17cqw;height:17cqw;margin:0 auto;border-radius:50%;background:#ececeb;\n  position:relative;display:grid;place-items:center;\n}\n.dpad .seta{\n  position:absolute;background:transparent;border:0;cursor:pointer;font-family:inherit;\n  color:var(--verde-texto);font-size:2.4cqw;line-height:1;padding:0;\n}\n.dpad .cima{top:1cqw;left:50%;transform:translateX(-50%);}\n.dpad .baixo{bottom:1cqw;left:50%;transform:translateX(-50%);}\n.dpad .esq{left:1cqw;top:50%;transform:translateY(-50%);}\n.dpad .dir{right:1cqw;top:50%;transform:translateY(-50%);}\n.dpad .centro{\n  width:9.6cqw;height:9.6cqw;border-radius:50%;background:#f7f7f6;\n  display:flex;flex-direction:column;align-items:center;justify-content:center;gap:.2cqw;\n}\n.dpad .centro b{font-size:2.6cqw;color:#2f3336;font-weight:500;}\n.dpad .centro i{font-size:1.4cqw;font-style:normal;color:#5b5f63;margin-top:-1.8cqw;margin-left:5cqw;}\n.dpad .centro em{font-style:normal;font-size:1.5cqw;color:#8b8f93;text-align:center;line-height:1.25;}\n.painel-retificar .botoes-dialogo{margin-top:auto;}\n\n/* rota desenhada da execução */\n.rota-execucao{pointer-events:none;}\n\n\n/* ---------- câmera do drone e troca com o mapa ---------- */\n.fpv{border:0;padding:0;cursor:pointer;}\n.marcador-home,.marcador-drone{display:none;}\nbody.conectado .marcador-home,body.conectado .marcador-drone{display:block;}\n\n[data-tela=\"mapa\"].trocado .arte-mapa{\n  left:1.2cqw;right:auto;top:auto;bottom:1.2cqw;width:22cqw;height:auto;aspect-ratio:16/10;\n  border-radius:.4cqw;overflow:hidden;z-index:5;\n  box-shadow:0 .2cqw .6cqw rgba(0,0,0,.5);\n}\n[data-tela=\"mapa\"].trocado .fpv{\n  left:0;bottom:0;width:100%;height:100%;aspect-ratio:auto;border-radius:0;\n  box-shadow:none;z-index:0;\n}\n[data-tela=\"mapa\"].trocado .rotulos,\n[data-tela=\"mapa\"].trocado .poligonos{display:none;}\n\n\n/* diálogo de falha no upload */\n.marca-erro{\n  width:3.4cqw;height:3.4cqw;margin:0 auto .8cqw;display:grid;place-items:center;\n  color:#e8322c;font-size:3cqw;font-weight:700;\n}\n.texto-erro{margin:0 0 1.4cqw;text-align:center;font-size:1.9cqw;color:#8b8f93;}\n#dialogo-upload .dialogo{width:42cqw;}\n#dialogo-upload h3{margin-bottom:.6cqw;}\n\n/* Arraste com o botão direito para deslocar o mapa durante a marcação. */\n#mapa-trabalho.arrastando{cursor:grabbing;}\n\n#camada-desenho{pointer-events:none;}\n\n\n/* Tela do sistema ao sair do aplicativo pelo botão físico Voltar. */\n.tela-sistema{background:#aec9d5;}\n#papel-sistema{position:absolute;inset:0;overflow:hidden;}\n#papel-sistema svg{width:100%;height:100%;object-fit:cover;}\n.status-sistema{position:absolute;top:1cqw;left:2cqw;right:2cqw;color:#fff;font-size:1.3cqw;text-shadow:0 1px 3px #344;}\n.status-sistema span{float:right;}\n.apps-sistema{position:absolute;left:0;right:0;bottom:0;padding:2cqw 4cqw;background:rgba(255,255,255,.42);}\n.app-agras{display:flex;align-items:center;flex-direction:column;gap:.7cqw;border:0;background:none;color:#fff;font:inherit;font-size:1.5cqw;cursor:pointer;text-shadow:0 1px 3px #455;}\n.app-agras span{display:grid;place-items:center;background:#31c444;border-radius:1cqw;width:5.8cqw;height:5.8cqw;color:white;font-style:italic;font-weight:700;font-size:2cqw;text-shadow:none;}\n"
