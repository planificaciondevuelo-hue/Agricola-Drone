          "cookies": [],
          "content": {
            "size": 12732,
            "mimeType": "text/html",
            "text": "<!doctype html>\n<html data-idioma-automatico lang=\"pt-BR\">\n<head>\n<script src=\"/treinamento/js/manutencao.js?v=1\"></script>\n<meta charset=\"utf-8\">\n<!-- TPD-IDiomas -->\n<script src=\"./catalogo.js?v=db00108b4684\"></script>\n<script src=\"./idiomas.js?v=a20785ea568a\"></script>\n\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no\">\n<title>Agras</title>\n<link rel=\"stylesheet\" href=\"app.css?v=7cee3c89e54f\">\n</head>\n<body>\n<svg id=\"sprite\" width=\"0\" height=\"0\" style=\"position:absolute\"><defs id=\"sprite-defs\"></defs></svg>\n<div id=\"palco\">\n\n  <!-- ===================== TELA INICIAL ===================== -->\n  <section class=\"tela ativa\" id=\"t-inicial\">\n    <div class=\"banner\">\n      <div class=\"icones-topo\">\n        <button data-extra=\"usuario\"><span><svg><use href=\"#i-perfil\"/></svg></span></button>\n        <button data-extra=\"notificacoes\"><span><svg><use href=\"#i-sino\"/></svg></span></button>\n        <button data-extra=\"gerais\"><span><svg><use href=\"#i-hexa\"/></svg></span></button>\n        <button data-extra=\"arquivos\"><span><svg><use href=\"#i-pasta\"/></svg></span></button>\n      </div>\n      <!-- boas-vindas do Centro de Treinamento (no lugar da propaganda do Agras) -->\n      <div class=\"bv\">\n        <span class=\"bv-selo\">CENTRO DE TREINAMENTO</span>\n        <h1>Bem-vindo ao Centro de Treinamento <em>Guri dos Drones</em></h1>\n        <p class=\"bv-frase\">Aqui você pode errar quantas vezes quiser.</p>\n        <ul class=\"bv-itens\">\n          <li><b>1</b>Treine com o controle de verdade</li>\n          <li><b>2</b>Erre, entenda o porquê e tente de novo</li>\n          <li><b>3</b>Leve para o campo só o que deu certo</li>\n        </ul>\n      </div>\n      <svg class=\"bv-arte\" viewBox=\"0 0 760 820\" aria-hidden=\"true\">\n        <defs>\n          <linearGradient id=\"bv-ceu\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\"><stop offset=\"0\" stop-color=\"#ffffff\" stop-opacity=\".16\"/><stop offset=\"1\" stop-color=\"#ffffff\" stop-opacity=\"0\"/></linearGradient>\n          <radialGradient id=\"bv-nevoa\" cx=\".5\" cy=\"0\" r=\"1\"><stop offset=\"0\" stop-color=\"#e8fff1\" stop-opacity=\".55\"/><stop offset=\"1\" stop-color=\"#e8fff1\" stop-opacity=\"0\"/></radialGradient>\n        </defs>\n        <circle cx=\"400\" cy=\"330\" r=\"300\" fill=\"url(#bv-ceu)\"/>\n        <!-- linhas da lavoura em perspectiva -->\n        <g stroke=\"#9fdc6f\" stroke-opacity=\".55\" stroke-width=\"5\" stroke-linecap=\"round\">\n          <path d=\"M380 560 L40 820\"/><path d=\"M390 560 L170 820\"/><path d=\"M400 560 L300 820\"/>\n          <path d=\"M410 560 L430 820\"/><path d=\"M420 560 L560 820\"/><path d=\"M430 560 L690 820\"/><path d=\"M440 560 L760 790\"/>\n        </g>\n        <path d=\"M200 820 L390 560 L430 560 L560 820 Z\" fill=\"#7be08a\" fill-opacity=\".18\"/>\n        <!-- névoa da pulverização -->\n        <path d=\"M300 420 L200 650 Q400 700 600 650 L500 420 Z\" fill=\"url(#bv-nevoa)\"/>\n        <!-- drone visto de cima, oito hélices em quatro braços -->\n        <g transform=\"translate(400 330)\">\n          <g stroke=\"#1b2b22\" stroke-width=\"16\" stroke-linecap=\"round\">\n            <path d=\"M-150 -110 L150 110\"/><path d=\"M150 -110 L-150 110\"/>\n          </g>\n          <g fill=\"#ffffff\" fill-opacity=\".22\" stroke=\"#ffffff\" stroke-opacity=\".7\" stroke-width=\"3\">\n            <circle cx=\"-150\" cy=\"-110\" r=\"72\"/><circle cx=\"150\" cy=\"-110\" r=\"72\"/>\n            <circle cx=\"-150\" cy=\"110\" r=\"72\"/><circle cx=\"150\" cy=\"110\" r=\"72\"/>\n          </g>\n          <g fill=\"#1b2b22\"><circle cx=\"-150\" cy=\"-110\" r=\"14\"/><circle cx=\"150\" cy=\"-110\" r=\"14\"/><circle cx=\"-150\" cy=\"110\" r=\"14\"/><circle cx=\"150\" cy=\"110\" r=\"14\"/></g>\n          <rect x=\"-78\" y=\"-96\" width=\"156\" height=\"192\" rx=\"34\" fill=\"#f4f6f5\"/>\n          <rect x=\"-50\" y=\"-62\" width=\"100\" height=\"124\" rx=\"20\" fill=\"#00b951\"/>\n          <circle cx=\"0\" cy=\"-74\" r=\"9\" fill=\"#1b2b22\"/>\n          <path d=\"M-22 18 L0 -22 L22 18\" fill=\"none\" stroke=\"#fff\" stroke-width=\"9\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n        </g>\n      </svg>\n    </div>\n    <div class=\"rodape-inicial\"></div>\n    <button class=\"cartao-ini\" id=\"c-registros\" data-extra=\"registros\">\n      <span class=\"txt\">Gerenciamento de registros</span><svg viewBox=\"0 0 48 62\"><use href=\"#i-documento\" x=\"0\" y=\"7\" width=\"48\" height=\"48\"/></svg>\n    </button>\n    <button class=\"cartao-ini\" id=\"c-dispositivo\" data-extra=\"dispositivo\">\n      <span class=\"txt\">Gerenciamento do dispositivo<small>Atualizado</small></span><svg viewBox=\"0 0 48 62\"><use href=\"#i-cubo\" x=\"0\" y=\"7\" width=\"48\" height=\"48\"/></svg>\n    </button>\n    <div class=\"cartao-ini\" id=\"c-conexao\">\n      <div class=\"estado\" id=\"estado-conexao\"><span class=\"nao\"></span><span>Aeronave desconectada</span></div>\n      <button id=\"bt-comecar\">Começar</button>\n    </div>\n  </section>\n\n  <!-- ===================== MAPA ===================== -->\n  <section class=\"tela\" id=\"t-mapa\">\n    <svg id=\"mundo\" viewBox=\"0 0 1920 1200\" preserveAspectRatio=\"none\">\n      <g id=\"vista\">\n        <rect x=\"-4000\" y=\"-4000\" width=\"10000\" height=\"10000\" fill=\"#1d2023\"/>\n        <image id=\"foto-mapa\" x=\"-960\" y=\"-600\" width=\"3840\" height=\"2400\" preserveAspectRatio=\"none\"/>\n        <rect class=\"fundo-padrao\" x=\"0\" y=\"0\" width=\"1920\" height=\"1200\" fill=\"rgb(222,238,214)\" opacity=\".55\"/>\n        <g id=\"camada-tarefas\"></g>\n        <g id=\"camada-rota\"></g>\n        <g id=\"camada-trilha\"></g>\n        <g id=\"camada-marcos\"></g>\n        <g id=\"camada-edicao\"></g>\n        <g id=\"camada-aero\"></g>\n      </g>\n    </svg>\n    <svg class=\"reticulo oculto\" id=\"reticulo\" viewBox=\"0 0 80 80\"><use href=\"#i-reticulo-mira\"/></svg>\n    <!-- alça de direção da rota (ANALISE_LINHAS 2.15): fixa na tela, só na edição -->\n    <svg class=\"alca oculto\" id=\"alca\" viewBox=\"0 0 80 80\"><circle cx=\"40\" cy=\"40\" r=\"33.75\" fill=\"rgba(255,255,255,.32)\" stroke=\"#FFFFFF\" stroke-width=\"2.5\" stroke-dasharray=\"4.7 4.94\"/><circle class=\"pega\" cx=\"40\" cy=\"40\" r=\"9.75\" fill=\"#EDD600\" stroke=\"#FFFFFF\" stroke-width=\"3.5\"/></svg>\n\n    <div class=\"fpv\" id=\"fpv\"><img id=\"fpv-fluxo\" alt=\"\"><canvas id=\"fpv-tela\"></canvas><span class=\"linha\"></span></div>\n\n    <div class=\"barra-estado\">\n      <button class=\"bt-modo\" id=\"bt-modo\"><svg viewBox=\"0 0 24 24\"><use href=\"#i-modo\"/></svg></button>\n      <div class=\"estado-voo\" id=\"estado-voo\">Aeronave desconectada</div>\n      <div id=\"status-drone\">\n        <div class=\"status\" id=\"s-sinal\" data-jan=\"sinal\"><svg viewBox=\"0 0 48 48\"><use href=\"#i-sinal\"/></svg></div>\n        <div class=\"status\" id=\"s-gps\" data-jan=\"rtk\"><svg viewBox=\"0 0 48 48\"><use href=\"#i-sat\"/></svg><span class=\"num\">0</span><span class=\"tipo\">GNSS</span></div>\n        <div class=\"status\" id=\"s-bat\" data-jan=\"bateria\"><svg viewBox=\"0 0 48 48\"><use href=\"#i-bat-drone\"/></svg><b>0<i>%</i></b></div>\n        <div class=\"status\" id=\"s-tanque\" data-jan=\"tanque\"><svg viewBox=\"0 0 48 48\"><use href=\"#i-tanque\"/></svg><b><span class=\"resta\">0.0</span>/0.0<i>l</i></b></div>\n      </div>\n      <div class=\"status\" id=\"s-rc\" data-jan=\"cr\"><svg viewBox=\"0 0 42 72\"><use href=\"#i-rc-bat\"/></svg><b id=\"rc-bat\">56</b></div>\n      <button class=\"bt-engr\" id=\"bt-engr\"><svg viewBox=\"0 0 24 24\"><use href=\"#i-engr\"/></svg></button>\n    </div>\n\n    <div class=\"ferramentas\" id=\"ferramentas\">\n      <div class=\"escala-mapa\" id=\"escala-mapa\"><span>10m</span><svg viewBox=\"0 0 60 20\"><use href=\"#i-escala\"/></svg></div>\n      <button class=\"bt-f\" data-f=\"prescricao\"><svg viewBox=\"0 0 48 48\"><use href=\"#i-pasta-mais\"/></svg></button>\n      <button class=\"bt-f\" data-f=\"regua\"><svg viewBox=\"0 0 48 48\"><use href=\"#i-regua\"/></svg></button>\n      <button class=\"bt-f\" data-f=\"borracha\"><svg viewBox=\"0 0 48 48\"><use href=\"#i-borracha\"/></svg></button>\n      <button class=\"bt-f\" data-f=\"local\"><svg viewBox=\"0 0 48 48\"><use href=\"#i-local\"/></svg></button>\n      <button class=\"bt-f\" data-f=\"trava\"><svg viewBox=\"0 0 48 48\"><use href=\"#i-rota-livre\"/></svg></button>\n      <button class=\"bt-f\" data-f=\"camadas\"><svg viewBox=\"0 0 48 48\"><use href=\"#i-camadas\"/></svg></button>\n    </div>\n\n    <div class=\"alertas\" id=\"alertas\"></div>\n    <div class=\"info-dir oculto\" id=\"info-dir\"></div>\n\n    <div class=\"hsi\"><svg viewBox=\"0 0 360 312\" id=\"hsi\"></svg></div>\n    <button class=\"bt-radar\" id=\"bt-radar\"><svg viewBox=\"0 0 80 80\" style=\"width:80px;height:80px\"><use href=\"#i-radar-btn\"/></svg></button>\n    <button class=\"bt-pouso\"><svg viewBox=\"0 0 80 80\" style=\"width:80px;height:80px\"><use href=\"#i-pouso\"/></svg></button>\n    <div class=\"osd\">\n      <div class=\"c c1\"><svg class=\"ic-alt\" id=\"o-alt-ic\" viewBox=\"0 0 30 36\"><g fill=\"none\" stroke=\"#fff\" stroke-width=\"2.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M-1.5 27L4 8L10 18Q13 21 16.5 21.5Q19.5 22 23.5 27Z\"/></g></svg><span id=\"o-alt-tit\">Relativo à<br>origem</span><b id=\"o-alt\">0,0<i>m</i></b></div>\n      <div class=\"c c2\"><span>Velocidade</span><b id=\"o-vel\">0.0<i>km/h</i></b></div>\n      <div class=\"c c3\"><span>Distância</span><b id=\"o-dist\">0.0<i>m</i></b></div>\n      <div class=\"c c4\"><span>Fluxo</span><b id=\"o-flu\">0.0<i>L/Min</i></b></div>\n    </div>\n\n    <div class=\"dir-centro\" id=\"dir-centro\"></div>\n    <div class=\"acoes\" id=\"acoes\"></div>\n    <!-- \"Retornar à\" (rota pausada no manual): ponto de interrupção / 1 / 2, ou conexão / inicial -->\n    <div class=\"retornar-a oculto\" id=\"retornar-a\"></div>\n\n    <button class=\"puxador\" id=\"puxador\"><svg viewBox=\"0 0 24 48\" id=\"puxador-seta\"><use href=\"#i-seta-dir\"/></svg></button>\n    <aside class=\"painel\" id=\"painel\"></aside>\n  </section>\n\n  <!-- ===================== MODOS ===================== -->\n  <section class=\"tela\" id=\"t-modos\">\n    <h2>Selecione o modo da tarefa</h2>\n    <button class=\"fechar\" id=\"modos-fechar\"><svg viewBox=\"0 0 48 48\"><use href=\"#i-x\"/></svg></button>\n    <p class=\"grupo\" style=\"left:72px\">Agricultura</p>\n    <p class=\"grupo\" data-mapeamento-admin style=\"display:none;left:1290px\">Mapeamento</p>\n    <button class=\"cartao-modo\" data-modo=\"rota\" style=\"left:72px;top:207px;width:1140px;height:540px\"><b>Rota</b><svg viewBox=\"0 0 48 48\"><rect x=\"6\" y=\"8\" width=\"36\" height=\"32\" rx=\"4\" fill=\"none\" stroke=\"#fff\" stroke-width=\"3.4\"/><path d=\"M14 18h20M14 26h20M14 34h12\" stroke=\"#fff\" stroke-width=\"3.4\"/></svg></button>\n    <button class=\"cartao-modo mapeamento\" data-modo=\"maprota\" data-mapeamento-admin style=\"display:none;left:1290px;top:207px;width:558px;height:540px\"><b>Mapeamento de rota</b><svg viewBox=\"0 0 48 48\"><rect x=\"6\" y=\"6\" width=\"16\" height=\"16\" rx=\"2\" fill=\"none\" stroke=\"#fff\" stroke-width=\"3.4\"/><rect x=\"26\" y=\"6\" width=\"16\" height=\"16\" rx=\"2\" fill=\"none\" stroke=\"#fff\" stroke-width=\"3.4\"/><rect x=\"6\" y=\"26\" width=\"16\" height=\"16\" rx=\"2\" fill=\"none\" stroke=\"#fff\" stroke-width=\"3.4\"/><circle cx=\"34\" cy=\"34\" r=\"7\" fill=\"none\" stroke=\"#fff\" stroke-width=\"3.4\"/></svg></button>\n    <button class=\"cartao-modo\" data-modo=\"manual\" style=\"left:72px;top:771px;width:558px;height:360px\"><b>Manual</b><span class=\"letra\">M</span></button>\n    <button class=\"cartao-modo\" data-modo=\"arvore\" style=\"left:654px;top:771px;width:558px;height:360px\"><b>Árvore frutífera</b><svg viewBox=\"0 0 48 48\"><path d=\"M22 6 8 24h9v14h10V24h9z\" fill=\"none\" stroke=\"#fff\" stroke-width=\"3.4\" stroke-linejoin=\"round\"/><path d=\"M30 34h12M30 40h12\" stroke=\"#fff\" stroke-width=\"3.4\"/></svg></button>\n    <button class=\"cartao-modo mapeamento\" data-modo=\"maparvore\" data-mapeamento-admin style=\"display:none;left:1290px;top:771px;width:558px;height:360px\"><b>Mapeamento de árvores</b><svg viewBox=\"0 0 48 48\"><path d=\"M18 6 6 22h8v14h8V22h8z\" fill=\"none\" stroke=\"#fff\" stroke-width=\"3.4\" stroke-linejoin=\"round\"/><circle cx=\"36\" cy=\"34\" r=\"7\" fill=\"none\" stroke=\"#fff\" stroke-width=\"3.4\"/></svg></button>\n  </section>\n\n  <!-- engrenagem e telas extras -->\n  <div id=\"cfg\"></div>\n  <div id=\"extra\"></div>\n</div>\n\n<script src=\"virtual.js?v=dbfaa486d88e\"></script>\n<script src=\"nucleo.js?v=f18aea33b198\"></script>\n<script src=\"inicial.js?v=2261cd335d15\"></script>\n<script src=\"mapa.js?v=a3a943468669\"></script>\n<script src=\"config.js?v=f8c7a1b0e3de\"></script>\n<script src=\"extras.js?v=b78bc4c2a368\"></script>\n<script src=\"protecao.js?v=f6dca8e4c740\"></script>\n<script src=\"botoes.js?v=a8bed513db06\"></script>\n<script src=\"rotas_relatorios.js?v=c59eefd45840\"></script>\n<script src=\"bateria.js?v=7d511ac08bc3\"></script>\n<script src=\"fpv3d.js?v=b3b1db9d3c1b\"></script>\n<script src=\"conta.js?v=11ae34841803\"></script>\n<script src=\"rtc.js?v=5dc196f57154\"></script>\n<script src=\"auxilios.js?v=4d083f4daf90\"></script>\n\n<script src=\"j100-paginas.js?v=eav-relatorio-2\"></script>\n<script src=\"j100.js?v=eav-relatorio-2\"></script>\n<script src=\"j100-acoes.js?v=caecc877bc31\"></script>\n<script src=\"t10.js?v=ec89466a428e\"></script>\n</body>\n</html>\n"
