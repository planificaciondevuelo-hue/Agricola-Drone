            "size": 17941,
            "mimeType": "text/css",
            "text": "/* ============================================================\r\n   Painel de configurações (engrenagem)\r\n   ============================================================ */\r\n\r\n.painel-config{\r\n  position:absolute;inset:0;display:none;align-items:center;justify-content:center;\r\n  z-index:20;\r\n}\r\n.painel-config.aberto{display:flex;}\r\n\r\n.caixa-config{\r\n  width:88cqw;height:53cqw;background:#f4f4f3;border-radius:.8cqw;overflow:hidden;\r\n  display:flex;box-shadow:0 1cqw 3cqw rgba(0,0,0,.35);\r\n}\r\n.painel-config.sem-menu .menu-config{display:none;}\r\n\r\n/* ------- menu lateral ------- */\r\n.menu-config{\r\n  width:8.6cqw;background:#ebebea;display:flex;flex-direction:column;\r\n  align-items:center;padding:1.2cqw 0;gap:1.6cqw;flex:none;\r\n}\r\n.menu-config button{\r\n  background:transparent;border:0;cursor:pointer;font-family:inherit;\r\n  display:flex;flex-direction:column;align-items:center;gap:.3cqw;\r\n  color:#6d7175;padding:.2cqw 0;width:100%;\r\n}\r\n.menu-config button svg{width:2.4cqw;height:2.4cqw;fill:#6d7175;color:#6d7175;}\r\n.menu-config button span{font-size:1.25cqw;}\r\n.menu-config button.ativa{color:var(--verde-texto);font-weight:600;}\r\n.menu-config button.ativa svg{fill:var(--verde);color:var(--verde);}\r\n\r\n/* ------- corpo ------- */\r\n.corpo-config{flex:1;display:flex;flex-direction:column;min-width:0;}\r\n.topo-config{\r\n  display:flex;align-items:center;gap:1cqw;padding:1.2cqw 1.6cqw .8cqw;flex:none;\r\n}\r\n.topo-config h2{\r\n  flex:1;text-align:center;margin:0;font-size:2.1cqw;font-weight:600;color:#2f3336;\r\n}\r\n.voltar-config,.fechar-config{\r\n  background:transparent;border:0;cursor:pointer;font-family:inherit;\r\n  font-size:2.4cqw;color:#404447;line-height:1;padding:0 .4cqw;width:3cqw;\r\n}\r\n.rolagem-config{flex:1;overflow-y:auto;padding:0 1.8cqw 1.6cqw;}\r\n.rolagem-config::-webkit-scrollbar{width:.5cqw;}\r\n.rolagem-config::-webkit-scrollbar-thumb{background:#cfcfce;border-radius:.3cqw;}\r\n\r\n.pagina-config{display:none;}\r\n.pagina-config.ativa{display:block;}\r\n.subtela-config{display:none;}\r\n.subtela-config.ativa{display:block;}\r\n.lista-config.escondida{display:none;}\r\n\r\n/* ------- blocos ------- */\r\n.config-secao{margin:1.2cqw 0 .6cqw;font-size:1.5cqw;color:#9a9ea1;}\r\n.config-titulo{margin:1.2cqw 0 .8cqw;font-size:1.95cqw;color:#2f3336;}\r\n.config-desc{margin:.5cqw 0 1cqw;font-size:1.55cqw;color:#8b8f93;line-height:1.5;}\r\n.config-desc .laranja{color:#e8742e;font-weight:500;}\r\n.config-verde{\r\n  margin:0;padding:1.3cqw 0;text-align:center;font-size:2cqw;color:var(--verde-texto);\r\n  font-weight:600;border-top:.12cqw solid #e2e2e1;cursor:pointer;\r\n}\r\n.config-verde.apagado{color:#9ed4ae;}\r\n.config-bloco{padding:.6cqw 0;border-bottom:.12cqw solid #e6e6e5;}\r\n.config-bloco.caixa{background:#ececeb;border-radius:.6cqw;padding:1cqw 1.2cqw;border:0;margin-bottom:.8cqw;}\r\n\r\n.marca-verde{\r\n  background:#dff1e4;color:var(--verde-texto);border-radius:.3cqw;\r\n  padding:.1cqw .5cqw;font-weight:500;\r\n}\r\n\r\n/* faixas */\r\n.linha-faixa{display:flex;align-items:baseline;gap:1cqw;margin:.8cqw 0 .4cqw;}\r\n.rotulo-faixa{flex:1;font-size:1.95cqw;color:#2f3336;}\r\n.valor-faixa{font-size:2.6cqw;font-weight:700;color:#2f3336;}\r\n.valor-faixa i{font-size:1.5cqw;font-weight:400;font-style:normal;margin-left:.2cqw;}\r\n.faixa{display:flex;align-items:center;gap:1cqw;padding-bottom:1.4cqw;}\r\n.passo-config{\r\n  width:4.4cqw;height:3.2cqw;border:0;border-radius:.5cqw;background:#e5e5e4;\r\n  color:#8b8f93;font-size:2cqw;cursor:pointer;font-family:inherit;display:grid;place-items:center;\r\n}\r\n.trilho{flex:1;position:relative;}\r\n.trilho input[type=range]{\r\n  -webkit-appearance:none;appearance:none;width:100%;height:.45cqw;border-radius:.3cqw;\r\n  background:linear-gradient(90deg,#d8d8d7 0 var(--preenchido,0%),#d8d8d7 var(--preenchido,0%));\r\n  outline:0;margin:0;\r\n}\r\n.faixa.preenchida .trilho input[type=range]{\r\n  background:linear-gradient(90deg,#8fd5a4 0 var(--preenchido,0%),#d8d8d7 var(--preenchido,0%));\r\n}\r\n.trilho input[type=range]::-webkit-slider-thumb{\r\n  -webkit-appearance:none;width:2.2cqw;height:2.2cqw;border-radius:50%;\r\n  background:#f4f4f3;box-shadow:0 .1cqw .3cqw rgba(0,0,0,.3);cursor:pointer;\r\n}\r\n.limites{display:flex;justify-content:space-between;font-size:1.4cqw;color:#a4a8ab;margin-top:.3cqw;}\r\n\r\n/* notas com diagrama */\r\n.config-nota{\r\n  background:#ececeb;border-radius:.6cqw;padding:1cqw 1.2cqw;margin-bottom:1cqw;\r\n  display:flex;align-items:center;gap:1cqw;\r\n}\r\n.config-nota p{margin:0;flex:1;font-size:1.6cqw;color:#5b5f63;line-height:1.5;}\r\n.config-nota .verde{color:var(--verde-texto);}\r\n.diagrama{width:16cqw;flex:none;}\r\n.diagrama svg{width:100%;height:auto;display:block;}\r\n.nota-diagrama{background:#ececeb;border-radius:.6cqw;padding:.8cqw;margin:.6cqw 0 1cqw;width:20cqw;}\r\n\r\n/* grupos de opção */\r\n.grupo-opcoes{display:flex;margin-bottom:.4cqw;}\r\n.grupo-opcoes button{\r\n  flex:1;background:#fff;border:.12cqw solid #dededd;cursor:pointer;font-family:inherit;\r\n  font-size:1.75cqw;color:#8b8f93;padding:.9cqw .6cqw;line-height:1.25;\r\n}\r\n.grupo-opcoes button:first-child{border-radius:.5cqw 0 0 .5cqw;}\r\n.grupo-opcoes button:last-child{border-radius:0 .5cqw .5cqw 0;}\r\n.grupo-opcoes button+button{border-left:0;}\r\n.grupo-opcoes button.ativa{background:#e4f3e8;border-color:#a8dcb8;color:var(--verde-texto);font-weight:600;}\r\n.grupo-opcoes.desativado button{cursor:default;color:#b4b8bb;background:#f7f7f6;}\r\n.grupo-opcoes.apagado button.ativa{color:#7cc493;}\r\n\r\n/* escolha em cartões */\r\n.grupo-escolha{background:#ececeb;border-radius:.6cqw;margin-bottom:1cqw;}\r\n.grupo-escolha button{\r\n  width:100%;background:transparent;border:0;cursor:pointer;font-family:inherit;text-align:left;\r\n  display:flex;align-items:center;gap:1cqw;padding:1cqw 1.2cqw;\r\n}\r\n.grupo-escolha button+button{border-top:.12cqw solid #dededd;}\r\n.grupo-escolha .texto{flex:1;display:flex;flex-direction:column;gap:.3cqw;}\r\n.grupo-escolha .texto b{font-size:1.85cqw;color:#2f3336;font-weight:600;}\r\n.grupo-escolha .texto i{font-size:1.55cqw;color:#8b8f93;font-style:normal;line-height:1.45;}\r\n.grupo-escolha .diagrama{width:14cqw;}\r\n.grupo-escolha.colunas{display:flex;gap:1cqw;background:transparent;}\r\n.grupo-escolha.colunas button{\r\n  background:#fff;border:.14cqw solid #dededd;border-radius:.6cqw;align-items:flex-start;\r\n}\r\n.grupo-escolha.colunas button+button{border-top:.14cqw solid #dededd;}\r\n.grupo-escolha.colunas button.ativa{background:#eaf6ee;border-color:var(--verde);}\r\n.grupo-escolha.colunas button.ativa .texto b{color:var(--verde-texto);}\r\n.radio{\r\n  width:1.8cqw;height:1.8cqw;border-radius:50%;border:.28cqw solid #c4c8ca;flex:none;margin-top:.2cqw;\r\n}\r\n.grupo-escolha.colunas button.ativa .radio{border-color:var(--verde);}\r\n\r\n/* linhas */\r\n.linha-link{\r\n  width:100%;background:transparent;border:0;border-bottom:.12cqw solid #e6e6e5;cursor:pointer;\r\n  font-family:inherit;display:flex;align-items:center;justify-content:space-between;\r\n  padding:1.3cqw 0;font-size:1.95cqw;color:#2f3336;\r\n}\r\n.linha-link i{font-style:normal;color:#a4a8ab;font-size:2.2cqw;}\r\n.linha-acao{display:flex;align-items:center;justify-content:space-between;gap:1cqw;padding:.8cqw 0 .4cqw;}\r\n.linha-acao span{font-size:1.95cqw;color:#2f3336;}\r\n.botao-contorno.apagado{border-color:#a8dcb8;color:#8fc9a2;}\r\n.linha-select{display:flex;align-items:center;justify-content:space-between;gap:1cqw;padding:.8cqw 0;}\r\n.linha-select span{font-size:1.95cqw;color:#2f3336;}\r\n.linha-select.simples .caixa-select{background:transparent;}\r\n.caixa-select{\r\n  background:#e8e8e7;border:0;border-radius:.5cqw;cursor:pointer;font-family:inherit;\r\n  font-size:1.8cqw;color:#5b5f63;padding:.8cqw 1cqw;min-width:14cqw;text-align:left;\r\n  display:flex;align-items:center;justify-content:space-between;gap:.6cqw;line-height:1.25;\r\n}\r\n.caixa-select i{font-style:normal;color:#8b8f93;}\r\n.caixa-select.apagado{color:#a4a8ab;}\r\n.etiquetas{display:flex;gap:.8cqw;align-items:center;}\r\n.etiquetas b{font-size:1.7cqw;font-weight:500;padding:.5cqw .9cqw;border-radius:.5cqw;background:#e8e8e7;color:#5b5f63;}\r\n.etiquetas .sinal i{color:#e8442e;font-style:normal;}\r\n.etiquetas .cinza{color:#a4a8ab;}\r\n\r\n/* interruptores */\r\n.linha-toggle-config{display:flex;align-items:center;justify-content:space-between;gap:1cqw;padding:.8cqw 0 .2cqw;}\r\n.rotulo-toggle{font-size:1.95cqw;color:#2f3336;flex:1;}\r\n.rotulo-toggle.forte{font-weight:500;}\r\n.rotulo-toggle .alerta{\r\n  display:inline-grid;place-items:center;width:1.7cqw;height:1.7cqw;border-radius:50%;\r\n  background:#f08a24;color:#fff;font-size:1.2cqw;font-style:normal;font-weight:700;vertical-align:-.2cqw;\r\n}\r\n.painel-config .interruptor{width:4.6cqw;height:2.6cqw;}\r\n.painel-config .interruptor i{width:2.2cqw;height:2.2cqw;}\r\n.painel-config .interruptor.ligado i{left:2.2cqw;}\r\n.painel-config .interruptor.ligado.apagado{background:#a6ddb8;}\r\n\r\n/* dados e tabelas */\r\n.grade-dados{\r\n  background:#ececeb;border-radius:.6cqw;padding:1.2cqw;margin-bottom:1.2cqw;\r\n  display:grid;grid-template-columns:repeat(3,1fr);gap:1.2cqw .8cqw;\r\n}\r\n.grade-dados div{display:flex;flex-direction:column;gap:.2cqw;}\r\n.grade-dados b{font-size:2.2cqw;color:#5b5f63;font-weight:500;}\r\n.grade-dados b.verde{color:#8fc9a2;}\r\n.grade-dados span{font-size:1.5cqw;color:#8b8f93;}\r\n.grade-erros{\r\n  background:#ececeb;border-radius:.6cqw;padding:1.2cqw;margin-bottom:1.2cqw;\r\n  display:grid;grid-template-columns:1fr 1fr;gap:1.4cqw;\r\n}\r\n.grade-erros span{font-size:1.6cqw;color:#5b5f63;display:block;margin-bottom:.5cqw;}\r\n.grade-erros b{font-size:2.4cqw;color:#2f3336;}\r\n.grade-erros .barra{height:.5cqw;border-radius:.3cqw;background:#d8d8d7;margin-top:.5cqw;}\r\n.grade-erros .barra i{display:block;width:22%;height:100%;border-radius:.3cqw;background:var(--verde);}\r\n.tabela-config{background:#ececeb;border-radius:.6cqw;margin-bottom:1.2cqw;}\r\n.tabela-config .linha{display:grid;grid-template-columns:1fr 1.4fr 1.4fr;padding:1cqw;}\r\n.tabela-config .linha span{font-size:1.6cqw;color:#8b8f93;}\r\n\r\n.tabela-bomba{border:.12cqw solid #e2e2e1;border-radius:.6cqw;overflow:hidden;margin-bottom:1.2cqw;}\r\n.tabela-bomba .topo{display:grid;grid-template-columns:1.6fr 1fr;background:#ececeb;}\r\n.tabela-bomba .topo div{padding:1cqw;}\r\n.tabela-bomba .topo div+div{border-left:.12cqw solid #e2e2e1;}\r\n.tabela-bomba .topo b{display:block;font-size:1.9cqw;color:#2f3336;margin-bottom:.3cqw;}\r\n.tabela-bomba .topo span{font-size:1.4cqw;color:#8b8f93;line-height:1.4;}\r\n.tabela-bomba .grade{display:grid;grid-template-columns:.7fr 1.2fr 1fr .7fr 1.2fr;}\r\n.tabela-bomba .grade span{\r\n  padding:.9cqw .6cqw;font-size:1.6cqw;color:#5b5f63;text-align:center;\r\n  border-top:.12cqw solid #e2e2e1;border-left:.12cqw solid #e2e2e1;\r\n}\r\n.tabela-bomba .grade span:nth-child(5n+1){border-left:0;}\r\n.tabela-bomba .grade span i{display:block;font-size:1.3cqw;font-style:normal;color:#8b8f93;}\r\n.tabela-rtk{margin-bottom:1cqw;}\r\n.tabela-rtk .linha{display:grid;grid-template-columns:1.2fr 1fr 1fr;padding:.9cqw 1cqw;border-radius:.4cqw;}\r\n.tabela-rtk .linha span{font-size:1.7cqw;color:#5b5f63;}\r\n.tabela-rtk .cabecalho{background:#ececeb;}\r\n.tabela-rtk .cabecalho span{color:#2f3336;text-align:center;}\r\n.tabela-rtk .cabecalho span:first-child{text-align:left;}\r\n.tabela-rtk .linha.par{background:#ececeb;}\r\n.tabela-rtk .linha span:not(:first-child){text-align:center;color:#8b8f93;}\r\n\r\n/* ------- joystick ------- */\r\n.modos-joystick{display:flex;border:.14cqw solid #dededd;border-radius:.5cqw;overflow:hidden;margin-bottom:1.2cqw;}\r\n.modos-joystick button{\r\n  flex:1;background:#fff;border:0;cursor:pointer;font-family:inherit;\r\n  font-size:1.95cqw;color:#8b8f93;padding:1cqw 0;\r\n}\r\n.modos-joystick button.ativa{background:#e4f3e8;color:var(--verde-texto);font-weight:600;box-shadow:inset 0 0 0 .14cqw var(--verde);}\r\n.cartoes-joystick{display:flex;gap:1.2cqw;margin-bottom:1.2cqw;}\r\n.cartao-pino{\r\n  flex:1;background:#ececeb;border-radius:.6cqw;padding:1cqw;position:relative;\r\n  display:grid;place-items:center;min-height:16cqw;\r\n}\r\n.cartao-pino .nome{position:absolute;left:1cqw;top:1cqw;font-size:1.7cqw;color:#5b5f63;width:6cqw;line-height:1.2;}\r\n.cartao-pino span{font-size:1.5cqw;color:#5b5f63;text-align:center;line-height:1.25;}\r\n.cartao-pino .cima{position:absolute;top:1.4cqw;left:50%;transform:translateX(-50%);}\r\n.cartao-pino .baixo{position:absolute;bottom:1.2cqw;left:50%;transform:translateX(-50%);}\r\n.cartao-pino .esquerda{position:absolute;left:1cqw;top:50%;transform:translateY(-50%);width:7cqw;}\r\n.cartao-pino .direita{position:absolute;right:1cqw;top:50%;transform:translateY(-50%);width:7cqw;}\r\n.manche-svg{width:7.5cqw;height:7.5cqw;}\r\n\r\n.cartoes-calibracao{display:flex;gap:1.2cqw;margin:1cqw 0;}\r\n.cartao-cal{flex:1;background:#ececeb;border-radius:.6cqw;padding:1cqw;}\r\n.cartao-cal p{margin:0 0 .8cqw;font-size:1.7cqw;color:#5b5f63;}\r\n.barra-cal{display:flex;align-items:center;gap:.8cqw;}\r\n.barra-cal span{font-size:1.6cqw;color:#5b5f63;}\r\n.trilho-cal{flex:1;height:.4cqw;background:#d8d8d7;border-radius:.2cqw;position:relative;}\r\n.trilho-cal i{position:absolute;left:50%;top:-.25cqw;width:.9cqw;height:.9cqw;border-radius:50%;background:#b9bdc0;transform:translateX(-50%);}\r\n.cartao-cal .pino{display:flex;justify-content:space-between;margin:1.2cqw 0 .4cqw;}\r\n.cartao-cal .pino b{font-weight:400;}\r\n.cruz-cal{display:flex;align-items:center;gap:.8cqw;}\r\n.cruz-cal .cruz{\r\n  flex:1;height:3cqw;position:relative;\r\n  background:\r\n    linear-gradient(#d8d8d7,#d8d8d7) center/100% .4cqw no-repeat,\r\n    linear-gradient(#d8d8d7,#d8d8d7) center/.4cqw 100% no-repeat;\r\n}\r\n.cartao-cal .baixo{text-align:center;margin:.4cqw 0 0;}\r\n\r\n.personalizados{display:flex;gap:1.4cqw;align-items:center;padding:1.2cqw 0;border-bottom:.12cqw solid #e6e6e5;}\r\n.personalizados .figura{width:26cqw;flex:none;}\r\n.personalizados .figura svg{width:100%;height:auto;}\r\n.personalizados .campos{flex:1;display:flex;flex-direction:column;gap:.8cqw;}\r\n.campo-botao{display:flex;align-items:center;gap:1cqw;}\r\n.campo-botao>span{width:7cqw;flex:none;font-size:1.8cqw;color:#5b5f63;text-align:right;}\r\n.campo-botao .caixa-select{flex:1;}\r\n\r\n/* visão geral dos botões */\r\n.visao-botoes{display:flex;gap:2cqw;padding-top:.5cqw;}\r\n.visao-botoes .figuras{width:32cqw;flex:none;display:flex;flex-direction:column;gap:1cqw;}\r\n.visao-botoes .figuras svg{width:100%;height:auto;}\r\n.lista-numerada{flex:1;display:flex;flex-direction:column;}\r\n.lista-numerada div{display:flex;gap:1.2cqw;padding:.7cqw 0;align-items:baseline;}\r\n.lista-numerada b{width:2.6cqw;flex:none;font-size:1.8cqw;color:#8b8f93;font-weight:400;}\r\n.lista-numerada span{font-size:1.85cqw;color:#2f3336;line-height:1.35;}\r\n.lista-numerada div:nth-child(5){border-bottom:.12cqw solid #e2e2e1;padding-bottom:1.2cqw;}\r\n\r\n/* aviso de mudança de modo */\r\n.aviso-modo .dialogo.largo{width:56cqw;padding:1.6cqw 2cqw 0;}\r\n.marca-aviso{\r\n  width:3.2cqw;height:3.2cqw;border-radius:50%;background:#f08a24;color:#fff;\r\n  display:grid;place-items:center;font-size:2.2cqw;font-weight:700;margin:0 auto .8cqw;\r\n}\r\n.texto-aviso{margin:0 0 1.2cqw;text-align:center;font-size:1.8cqw;color:#5b5f63;line-height:1.5;}\r\n.botoes-dialogo .vermelho{color:#e8442e;}\r\n\r\n/* ---------- bateria ---------- */\r\n.linha-titulo-config{display:flex;align-items:baseline;justify-content:space-between;gap:1cqw;padding:1cqw 0;}\r\n.linha-titulo-config span{font-size:1.95cqw;color:#2f3336;}\r\n.linha-titulo-config i{font-size:1.7cqw;color:#8b8f93;font-style:normal;}\r\n.titulo-marcado{display:flex;align-items:center;justify-content:space-between;gap:1cqw;padding:.6cqw 0 .8cqw;}\r\n.titulo-marcado span{font-size:1.95cqw;color:#2f3336;}\r\n.titulo-marcado .marca{display:inline-block;width:.45cqw;height:1.6cqw;border-radius:.2cqw;margin-right:.6cqw;vertical-align:-.2cqw;}\r\n.titulo-marcado i{font-size:1.8cqw;color:#5b5f63;font-style:normal;}\r\n.celulas-bateria{display:flex;gap:.5cqw;padding:.6cqw 0 1.2cqw;}\r\n.celulas-bateria div{flex:1;display:flex;flex-direction:column;align-items:center;gap:.4cqw;}\r\n.celulas-bateria svg{width:2.4cqw;height:4.8cqw;}\r\n.celulas-bateria span{font-size:1.4cqw;color:#8b8f93;}\r\n.grade-dados.quatro{grid-template-columns:repeat(4,1fr);}\r\n.grade-dados b i{font-size:1.4cqw;font-style:normal;color:#8b8f93;margin-left:.15cqw;}\r\n.faixa-dupla{display:flex;align-items:center;gap:.6cqw;padding:1cqw 0 .3cqw;}\r\n.faixa-dupla .alca{background:#f0f0ef;border-radius:.4cqw;padding:.5cqw .4cqw;color:#f0a63a;font-size:1.2cqw;letter-spacing:.1cqw;box-shadow:0 .1cqw .3cqw rgba(0,0,0,.15);}\r\n.trilho-duplo{flex:1;height:.55cqw;border-radius:.3cqw;background:#f5c98a;}\r\n.limites-duplos{display:flex;justify-content:space-between;font-size:1.5cqw;color:#e8742e;}\r\n\r\n/* ---------- gráfico do canal ---------- */\r\n.grafico-canal{padding:.8cqw 0 1.2cqw;}\r\n.grafico-canal .eixo{display:flex;flex-direction:column;gap:.2cqw;margin-bottom:.4cqw;}\r\n.grafico-canal .eixo span{font-size:1.4cqw;color:#a4a8ab;}\r\n.grafico-canal .eixo b{font-size:1.7cqw;color:#5b5f63;font-weight:400;margin-left:1.4cqw;}\r\n.grafico-canal .area{display:flex;gap:.6cqw;align-items:stretch;}\r\n.grafico-canal .marcas{display:flex;flex-direction:column;justify-content:space-between;font-size:1.4cqw;color:#8b8f93;width:3cqw;text-align:right;}\r\n.grafico-canal .quadro{flex:1;height:11cqw;border:.12cqw solid #e2e2e1;position:relative;}\r\n.grafico-canal .coluna{position:absolute;left:0;top:0;bottom:0;width:5cqw;border-right:.12cqw solid #cfcfce;}\r\n.grafico-canal .coluna:after{content:'';position:absolute;left:0;right:0;bottom:0;height:35%;background:#e2e2e1;}\r\n.grafico-canal .distancias{display:flex;flex-direction:column;justify-content:center;gap:1.4cqw;font-size:1.5cqw;color:#8b8f93;width:7cqw;}\r\n.grafico-canal .distancias .mhz{font-size:1.3cqw;color:#a4a8ab;}\r\n.grafico-canal .rodape-grafico{font-size:1.5cqw;color:#5b5f63;margin-left:3.6cqw;}\r\n\r\n/* ajustes dos cartões de calibração */\r\n.cartao-cal .pino{font-size:1.6cqw;color:#5b5f63;}\r\n.cruz-cal span{font-size:1.5cqw;color:#5b5f63;}\r\n.cartao-cal .baixo{font-size:1.5cqw;color:#5b5f63;}\r\n"
