          "content": {
            "size": 7488,
            "mimeType": "text/html",
            "text": "<!DOCTYPE html>\n<html lang=\"pt-BR\" data-idioma-automatico>\n<head>\n<script src=\"/treinamento/js/manutencao.js?v=1\"></script>\n<meta charset=\"utf-8\">\n<!-- APP-TELA -->\n<link rel=\"manifest\" href=\"/treinamento/app.webmanifest\">\n<link rel=\"apple-touch-icon\" href=\"/treinamento/icones/app-180.png\">\n<meta name=\"mobile-web-app-capable\" content=\"yes\">\n<meta name=\"apple-mobile-web-app-capable\" content=\"yes\">\n<meta name=\"apple-mobile-web-app-title\" content=\"Simulador\">\n<meta name=\"apple-mobile-web-app-status-bar-style\" content=\"black\">\n<meta name=\"theme-color\" content=\"#0e1a14\">\n<script src=\"/treinamento/js/app_tela.js?v=ef687926fd7c\" defer></script>\n<!-- /APP-TELA -->\n<script src=\"js/dispositivo.js?v=506ec99d2d87\"></script>\n<script src=\"js/pausa.js?v=188dc54f2c6a\"></script>\n<!-- TPD-IDiomas -->\n<script src=\"js/idiomas/catalogo.js?v=2bbe6ff20684\"></script>\n<script src=\"js/idiomas/idiomas.js?v=ddee82f66a1b\"></script>\n<script src=\"js/campo/traducao_jogo.js?v=d4c09931a01f\"></script>\n\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1, maximum-scale=1\">\n<title>Simulador de operação</title>\n<meta name=\"robots\" content=\"noindex\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Outfit:wght@600;700;800&family=Asap:wght@400;500;600&display=swap\">\n<link rel=\"stylesheet\" href=\"css/campo.css?v=dbda41f9b427\">\n</head>\n<body>\n\n<!-- O campo: o simulador de voo roda inteiro aqui dentro, sem alteração. -->\n<iframe id=\"campo\" src=\"campo/index.html?v=62025a89c272\" allow=\"xr-spatial-tracking; fullscreen; accelerometer; gyroscope\" allowfullscreen title=\"Campo de treinamento\"></iframe>\n\n<!-- O controle de verdade: aparece quando o aluno escolhe a vista Controle.\n     É o mesmo site do RC Plus, com as telas do app Agras funcionando. -->\n<div class=\"aparelho esconder\" id=\"aparelho\">\n  <iframe id=\"controle\" src=\"about:blank\" title=\"Controle RC Plus\"></iframe>\n</div>\n\n<!-- ------------------------------------------------------------ carregando -->\n<div class=\"carregando\" id=\"carregando\">\n  <div class=\"carregando__caixa\">\n    <p class=\"olho\">Preparando o campo</p>\n    <h2 id=\"carregando-titulo\">Carregando</h2>\n    <p id=\"carregando-passo\">Montando o terreno, a lavoura e a aeronave…</p>\n    <a id=\"carregando-voltar\" class=\"esconder\" href=\"conta/drones.html\">Voltar à escolha do drone</a>\n  </div>\n</div>\n\n<!-- --------------------------------------------------------- a instrução -->\n<aside class=\"guia\" id=\"guia\" hidden>\n  <header class=\"guia__topo\">\n    <a class=\"guia__voltar\" href=\"index.html\" title=\"Voltar ao painel\">←</a>\n    <div class=\"guia__titulos\">\n      <p class=\"olho\" id=\"guia-etapa\">Etapa</p>\n      <h1 id=\"guia-titulo\">—</h1>\n    </div>\n    <button class=\"guia__recolher\" type=\"button\" id=\"btn-recolher\" title=\"Recolher\">−</button>\n  </header>\n\n  <div class=\"guia__corpo\" id=\"guia-corpo\">\n    <p class=\"guia__instrucao\" id=\"guia-instrucao\"></p>\n\n    <ul class=\"lista\" id=\"guia-conferir\"></ul>\n\n    <details class=\"guia__porque\">\n      <summary>Por que isso importa</summary>\n      <p id=\"guia-porque\"></p>\n    </details>\n  </div>\n\n  <button class=\"guia__concluir esconder\" type=\"button\" id=\"btn-concluir\">\n    Concluir etapa\n  </button>\n</aside>\n\n<!-- -------------------------------------------------------------- boletim -->\n<div class=\"modal esconder\" id=\"modal\">\n  <div class=\"modal__caixa\">\n    <p class=\"olho\">Etapa concluída</p>\n    <h2 id=\"modal-titulo\">Boletim</h2>\n    <div id=\"modal-corpo\"></div>\n    <div class=\"modal__botoes\">\n      <a class=\"botao-grande\" id=\"btn-proxima\" href=\"#\">Próxima etapa</a>\n      <a class=\"botao-linha\" href=\"index.html\">Voltar ao painel</a>\n    </div>\n  </div>\n</div>\n\n<script src=\"../js/config.js?v=seguranca-20261006\"></script>\n<script src=\"../js/marcas.js?v=480d2bbb1b85\"></script>\n<script src=\"../js/sessao.js?v=7fb3c7a485f1\"></script>\n<script src=\"js/campo/ponte.js?v=e946ff669757\"></script>\n<script src=\"js/campo/estruturas_reais.js?v=6afc772efdc8\"></script>\n<script src=\"js/campo/plantas_reais.js?v=ce82444b1bcc\"></script>\n<script src=\"js/campo/cenario_real.js?v=d7e3e6fcae85\"></script>\n<script src=\"js/campo/etapas.js?v=5f2dbf5a0c8c\"></script>\n<script src=\"js/campo/vinculo.js?v=07c88d99c403\"></script>\n<script src=\"js/campo/vinculo_xag.js?v=c29eb755f871\"></script>\n<script src=\"js/campo/telas_xag.js?v=80b8d1a852cc\"></script>\n<script src=\"js/campo/aparelho_xag.js?v=020ac3d28ee7\"></script>\n<script src=\"js/campo/andamento.js?v=c7a68e963741\"></script>\n<script src=\"js/campo/operacao.js?v=c90005470c02\"></script>\n<script src=\"js/campo/alertas.js?v=2207a719a9f5\"></script>\n<script src=\"js/campo/holofote.js?v=a396a4a627d9\"></script>\n<script src=\"js/campo/camera_p60.js?v=9ce152953e98\"></script>\n<script src=\"js/campo/camera_t10.js?v=6cd9f55f35bf\"></script>\n<script src=\"js/campo/voo_xag.js?v=a2a7100a5278\"></script>\n<script src=\"js/campo/app_rcplus.js?v=c6f32bc0d311\"></script>\n<script src=\"js/campo/controle_real.js?v=5b2f70920f2e\"></script>\n<script src=\"js/campo/celular_xag.js?v=54c5016da88d\"></script>\n<script src=\"js/campo/teclado_rc.js?v=c5e549a72791\"></script>\n<script src=\"js/campo/rc_n1.js?v=612534ba6033\"></script>\n<script src=\"js/campo/rc_plus_cabo.js?v=7bc2fe4ae204\"></script>\n<script src=\"js/campo/cerca_virtual.js?v=2ebee43b5d90\"></script>\n<script src=\"js/campo/manual.js?v=e8477123bf99\"></script>\n<script src=\"js/campo/fisica.js?v=f41e34956001\"></script>\n<script src=\"js/campo/gnss.js?v=13cccc1e968e\"></script>\n<script src=\"js/campo/equipe.js?v=5fdd64e44096\"></script>\n<script src=\"js/campo/radar.js?v=7fae0e769e93\"></script>\n<script src=\"js/campo/ajustes.js?v=d31f7217b56e\"></script>\n<script src=\"js/campo/editor_rota.js?v=cd1ab9e46182\"></script>\n<script src=\"js/campo/meteorologia.js?v=53aa882677b8\"></script>\n<script src=\"js/campo/pulverizacao.js?v=c94d46be831f\"></script>\n<script src=\"js/campo/vortice.js?v=2eaf1f64d9a5\"></script>\n<script src=\"js/campo/controle_xag_3d.js?v=c52ce7f3d245\"></script>\n<script src=\"js/campo/controle_dji_3d.js?v=efbd26bb75d7\"></script>\n<script src=\"js/campo/app_fly.js?v=9a1bdab2e6e7\"></script>\n<script src=\"js/campo/app_guri.js?v=3d77ef1a3008\"></script>\n<script src=\"js/campo/controle_mao_xag_3d.js?v=9132b78eb989\"></script>\n<script src=\"js/campo/modelo_drone.js?v=2a35e67db026\"></script>\n<script src=\"conta/config.js?v=seguranca-20261006\"></script>\n<script src=\"conta/contas.js?v=ca6b0e4055a8\"></script>\n<script src=\"js/campo/bateria.js?v=045b4f6a6ccc\"></script>\n<!-- RETOMADA -->\n<script src=\"js/campo/retomada_estado.js?v=d13bfd7f0066\"></script>\n<script src=\"js/retomada.js?v=d0cfd708009b\"></script>\n<!-- /RETOMADA -->\n<script src=\"js/campo/principal.js?v=746d0d6c45e0\"></script>\n<!-- tela grande e computador fraco: teto de resolucao e qualidade automatica -->\n<script src=\"js/campo/desempenho.js?v=8c12355e536e\"></script>\n<!-- area do aluno: conta as horas quando aberto pelo Iniciar sessao (ver conta/medidor.js) -->\n\n<script src=\"tutoriais/idiomas-videos.js?v=20261004-en-es-1\"></script>\n<script src=\"js/campo/tutorial_primeiro_voo.js?v=0f2284cae9c8\"></script>\n<script src=\"conta/medidor.js?v=a7c9b83c4806\"></script>\n<script src=\"js/campo/vr_controle_original.js?v=8df215383111\"></script>\n<script src=\"js/campo/vr.js?v=0a8cfa032d84\"></script>\n<script src=\"js/campo/falar_auxiliar.js?v=29bd9dd85d04\"></script>\n<script src=\"js/campo/sons_dji.js?v=d5f0fa017e9c\"></script>\n</body>\n</html>\n"
          },
