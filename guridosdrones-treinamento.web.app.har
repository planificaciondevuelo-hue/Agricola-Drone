          ],
          "cookies": [],
          "content": {
            "size": 189818,
            "mimeType": "text/html",
            "text": "<!doctype html>\n<html lang=\"pt-BR\" data-idioma-automatico>\n<meta charset=\"utf-8\">\n<script src=\"/treinamento/js/manutencao.js?v=1\"></script>\n<script src=\"../js/pausa.js?v=188dc54f2c6a\"></script>\n<!-- TPD-IDiomas -->\n<script src=\"../js/idiomas/catalogo.js?v=2bbe6ff20684\"></script>\n<script src=\"../js/idiomas/idiomas.js?v=ddee82f66a1b\"></script>\n<script src=\"../js/campo/traducao_jogo.js?v=3e1424810e83\"></script>\n\n<title>Simulador de Pulverização T50</title>\n<style>\n  :root{--fundo:rgba(14,16,20,.86);--linha:rgba(255,255,255,.10);--texto:#EEF2F6;--fraco:#8E99A6;\n    --azul:#2F80ED;--azul2:#4A94F5;--alerta:#F5A524;--perigo:#F04438;--ok:#32D583}\n  *{box-sizing:border-box}\n  html,body{margin:0;height:100%;overflow:hidden;background:#0c1014;font-family:Roboto,\"Segoe UI\",sans-serif;color:var(--texto)}\n  canvas{display:block}\n  button{font:inherit;color:inherit;border:none;background:none;cursor:pointer}\n  button:focus-visible,input:focus-visible{outline:2px solid var(--azul2);outline-offset:2px}\n  [hidden]{display:none!important}\n\n  /* barra superior de status */\n  #topo{position:absolute;left:0;right:0;top:0;display:flex;align-items:center;gap:14px;padding:7px 12px;\n    background:linear-gradient(rgba(8,10,13,.9),rgba(8,10,13,.55));font-size:13px}\n  #topo .estado{font-weight:500}\n  #topo .estado small{display:block;font-size:11px;color:var(--fraco);font-weight:400}\n  #topo .sp{flex:1}\n  #topo .v{display:flex;flex-direction:column;align-items:flex-end;min-width:58px}\n  #topo .v span{font-size:10.5px;color:var(--fraco)}\n  #topo .v b{font-family:\"Roboto Mono\",Consolas,monospace;font-size:14.5px;font-weight:500;font-variant-numeric:tabular-nums}\n  #topo b.al{color:var(--alerta)} #topo b.cr{color:var(--perigo)} #topo b.ok{color:var(--ok)}\n\n  /* indicador de radar */\n  #radar{position:absolute;left:14px;bottom:14px;width:168px;height:168px}\n\n  #bar{position:absolute;right:12px;bottom:12px;display:flex;gap:6px;flex-wrap:wrap;justify-content:flex-end;max-width:70vw}\n  #bar button{padding:9px 14px;border-radius:8px;background:var(--fundo);border:1px solid var(--linha);font-size:14px;font-weight:500}\n  #bar button:hover{border-color:rgba(255,255,255,.25)}\n  #bar button.on{background:var(--azul);border-color:var(--azul)}\n  #bar button.cr{border-color:var(--perigo);color:#ffb4ae}\n  #vistas{display:flex;border:1px solid var(--linha);border-radius:8px;overflow:hidden}\n  #bar #vistas button{border:none;border-radius:0;padding:9px 12px}\n  #bar #vistas button+button{border-left:1px solid var(--linha)}\n  #bar #vistas button[aria-pressed=\"true\"]{background:var(--azul)}\n\n  /* visão: tela do controle */\n  #vCtrlRc{position:absolute;pointer-events:none}\n  #vCtrlRc svg{display:block;width:100%;height:100%;filter:drop-shadow(0 18px 30px rgba(0,0,0,.55))}\n  #vCtrlRc .rcbt{pointer-events:auto;cursor:pointer}\n  #vCtrlRc .rcbt:focus-visible{outline:none}\n  #vCtrlRc .rcbt:focus-visible circle{stroke:#4A94F5;stroke-width:10}\n  #tela{position:absolute;overflow:hidden;border-radius:6px;pointer-events:none;color:#fff}\n  #tela .tTopo{position:absolute;left:0;right:0;top:0;display:flex;align-items:center;gap:.5em;padding:.35em .7em;background:rgba(10,12,15,.74)}\n  #tela .tTopo .sp{flex:1}\n  #tela .tTopo b.e{display:block;font-weight:500;font-size:1.02em}\n  #tela .tTopo small{display:block;font-size:.72em;color:#9aa6b2}\n  #tela .chip{font-size:.82em;padding:.18em .5em;border-radius:.4em;background:rgba(255,255,255,.09);white-space:nowrap}\n  #tela .chip b{font-family:\"Roboto Mono\",Consolas,monospace;font-weight:500}\n  #tela .ok{color:#32D583} #tela b.al{color:#F5A524} #tela b.cr{color:#F04438}\n  #tela .tFpv{position:absolute;left:.7em;top:3.1em;font-size:.7em;letter-spacing:.1em;padding:.1em .45em;border-radius:.3em;background:rgba(0,0,0,.45)}\n  #tela .tMira{position:absolute;left:50%;top:50%;width:2.2em;height:2.2em;margin:-1.1em 0 0 -1.1em;border:2px solid rgba(255,255,255,.55);border-radius:50%}\n  #rMapa{position:absolute;left:.6em;bottom:.6em;width:30%;height:34%;border-radius:.5em;border:1px solid rgba(255,255,255,.22)}\n  #rDados{position:absolute;right:.6em;bottom:.6em;display:grid;grid-template-columns:auto auto;gap:.12em .9em;padding:.5em .75em;border-radius:.5em;background:rgba(10,12,15,.68);font-size:.92em}\n  #rDados span{color:#9aa6b2} #rDados b{font-family:\"Roboto Mono\",Consolas,monospace;font-weight:500;text-align:right}\n  #rObs{position:absolute;left:50%;top:20%;transform:translateX(-50%);padding:.3em .8em;border-radius:.4em;background:rgba(240,68,56,.88);font-weight:500;white-space:nowrap}\n  #rDesvio{position:absolute;left:50%;bottom:.7em;transform:translateX(-50%);padding:.2em .6em;border-radius:.3em;background:rgba(0,0,0,.55);color:#F04438;font-size:.82em;font-weight:600;white-space:nowrap}\n  #vOpRot{position:absolute;transform:translate(-50%,-170%);padding:3px 9px;border-radius:999px;background:rgba(10,12,16,.72);border:1px solid rgba(255,255,255,.28);\n    font-size:12px;font-weight:500;white-space:nowrap;pointer-events:none}\n\n  #alerta{position:absolute;left:50%;top:62px;transform:translateX(-50%);width:min(460px,92vw);background:rgba(28,22,10,.94);\n    border:1px solid var(--alerta);border-radius:10px;padding:12px 14px}\n  #alerta.vermelho{background:rgba(34,12,12,.94);border-color:var(--perigo)}\n  #alerta b{display:block;color:var(--alerta);font-size:15px;margin-bottom:3px}\n  #alerta.vermelho b{color:var(--perigo)}\n  #alerta span{display:block;font-size:13.5px;line-height:1.45;color:#E9E2D3}\n  #alerta .bts{display:flex;gap:8px;margin-top:10px}\n  #alerta .bts button{flex:1;padding:9px;border-radius:7px;background:rgba(255,255,255,.08);font-size:13.5px;font-weight:500}\n  #alerta .bts button.pri{background:var(--alerta);color:#1a1307}\n\n  .modal{position:absolute;inset:0;display:grid;place-items:center;background:rgba(6,8,10,.62);padding:16px}\n  .modal .c{width:min(480px,100%);max-height:100%;overflow-y:auto;background:#161a1f;border:1px solid var(--linha);border-radius:14px;padding:18px}\n  .modal h2{margin:0 0 4px;font-size:20px;font-weight:500}\n  .modal p.s{margin:0 0 12px;font-size:13.5px;color:#B4BEC9;line-height:1.45}\n  .check{display:flex;align-items:center;gap:10px;padding:8px 0;border-top:1px solid var(--linha);font-size:14px}\n  .check .n{flex:1}\n  .check .r{font-family:\"Roboto Mono\",monospace;font-size:13px}\n  .check .r.ok{color:var(--ok)} .check .r.al{color:var(--alerta)}\n  .deslizar{position:relative;margin-top:16px;height:52px;border-radius:999px;background:rgba(255,255,255,.07);overflow:hidden}\n  .deslizar .rot{position:absolute;inset:0;display:grid;place-items:center;font-size:14px;color:var(--fraco);pointer-events:none}\n  .deslizar input{position:absolute;inset:0;width:100%;height:100%;margin:0;appearance:none;-webkit-appearance:none;background:transparent;cursor:grab}\n  .deslizar input::-webkit-slider-thumb{-webkit-appearance:none;width:52px;height:52px;border-radius:50%;background:var(--azul);\n    box-shadow:0 0 0 6px rgba(47,128,237,.25)}\n  .deslizar input::-moz-range-thumb{width:52px;height:52px;border:none;border-radius:50%;background:var(--azul)}\n  .modal .bts{display:flex;gap:8px;margin-top:12px}\n  .modal .bts button{flex:1;padding:10px;border-radius:8px;background:rgba(255,255,255,.08);font-weight:500}\n  .modal .bts button.pri{background:var(--azul)}\n  #queda .c{border-color:var(--perigo)}\n  #queda h2{color:var(--perigo)}\n  .licao{margin:0;font-size:13.5px;line-height:1.5;color:#C9D1D9;background:rgba(255,255,255,.05);border-radius:8px;padding:10px 12px}\n  .grade{display:grid;grid-template-columns:1fr 1fr;gap:1px;background:var(--linha);border-radius:8px;overflow:hidden;margin:8px 0}\n  .grade div{background:#1b2027;padding:8px 10px}\n  .grade span{display:block;font-size:11.5px;color:var(--fraco)}\n  .grade b{font-family:\"Roboto Mono\",monospace;font-size:15px;font-weight:500}\n\n  /* painel inicial */\n  #painel{position:absolute;inset:0;display:flex;align-items:center;padding:16px;\n    background:linear-gradient(90deg,rgba(8,10,13,.9) 0%,rgba(8,10,13,.55) 55%,rgba(8,10,13,0) 100%)}\n  #painel .c{width:min(540px,100%);max-height:100%;overflow-y:auto;background:rgba(18,21,26,.95);border:1px solid var(--linha);border-radius:14px;padding:18px}\n  #painel .sobre{font-size:11.5px;letter-spacing:.14em;text-transform:uppercase;color:var(--azul2);margin:0 0 2px}\n  #painel h1{margin:0 0 14px;font-size:24px;font-weight:500}\n  #painel h3{margin:18px 0 8px;font-size:12.5px;font-weight:500;letter-spacing:.06em;text-transform:uppercase;color:var(--fraco)}\n  .cen{display:flex;flex-direction:column;gap:8px}\n  .cen button{text-align:left;padding:11px 13px;border-radius:10px;background:rgba(255,255,255,.04);border:1.5px solid var(--linha)}\n  .cen button[aria-pressed=\"true\"]{border-color:var(--azul);background:rgba(47,128,237,.12)}\n  .cen .t{display:flex;align-items:center;gap:8px;font-size:15.5px;font-weight:500}\n  .nv{font-size:11px;padding:2px 8px;border-radius:999px;border:1px solid currentColor}\n  .nv.f{color:var(--ok)} .nv.m{color:var(--alerta)} .nv.d{color:var(--perigo)}\n  .cen .d{display:block;margin-top:4px;font-size:13px;line-height:1.45;color:#B4BEC9}\n  .seg{display:flex;gap:6px;flex-wrap:wrap}\n  .seg button{flex:1;min-width:110px;padding:9px 8px;border-radius:8px;background:rgba(255,255,255,.05);border:1.5px solid var(--linha);font-size:13px;text-align:center}\n  .seg button[aria-pressed=\"true\"]{border-color:var(--azul);background:rgba(47,128,237,.14)}\n  .ajuda{font-size:12px;color:var(--fraco);line-height:1.45;margin:6px 0 0}\n  #cFaixa{display:block;width:100%;height:auto;aspect-ratio:1000/150;border-radius:8px;margin-top:4px;background:#2a241b}\n  #ajFaixa b{font-weight:500} #ajFaixa b.ok{color:var(--ok)} #ajFaixa b.al{color:var(--alerta)}\n  .campo{display:grid;grid-template-columns:1fr auto;align-items:center;gap:2px 10px;margin:9px 0}\n  .campo label{font-size:13.5px}\n  .campo output{font-family:\"Roboto Mono\",monospace;font-size:13.5px}\n  .campo input{grid-column:1/-1;width:100%;accent-color:var(--azul)}\n  .chave{display:flex;align-items:center;gap:10px;padding:9px 0;border-top:1px solid var(--linha)}\n  .chave .g{flex:1}\n  .chave .g b{display:block;font-size:14px;font-weight:500}\n  .chave .g small{display:block;font-size:12px;color:var(--fraco);line-height:1.4;margin-top:1px}\n  .tog{flex:none;width:44px;height:25px;border-radius:999px;background:#3a414a;position:relative}\n  .tog::after{content:\"\";position:absolute;top:2.5px;left:2.5px;width:20px;height:20px;border-radius:50%;background:#fff;transition:transform .15s}\n  .tog[aria-pressed=\"true\"]{background:var(--azul)}\n  .tog[aria-pressed=\"true\"]::after{transform:translateX(19px)}\n  #iniciar{width:100%;margin-top:16px;padding:12px;border-radius:9px;background:var(--azul);font-size:16px;font-weight:500}\n  #iniciar:hover{background:var(--azul2)}\n  #carregando{position:absolute;inset:0;display:grid;place-items:center;background:#0c1014;color:#cfe0f0;font-size:15px;z-index:9}\n  /* mapeamento caminhando */\n  #mTopo{position:absolute;left:0;right:0;top:0;display:flex;align-items:center;gap:14px;padding:7px 12px;\n    background:linear-gradient(rgba(8,10,13,.9),rgba(8,10,13,.55));font-size:13px}\n  #mTopo .estado{font-weight:500} #mTopo .estado small{display:block;font-size:11px;color:var(--fraco);font-weight:400}\n  #mTopo .sp{flex:1}\n  #mTopo .v{display:flex;flex-direction:column;align-items:flex-end;min-width:58px}\n  #mTopo .v span{font-size:10.5px;color:var(--fraco)}\n  #mTopo .v b{font-family:\"Roboto Mono\",Consolas,monospace;font-size:14.5px;font-weight:500;font-variant-numeric:tabular-nums}\n  #mTopo b.ok{color:var(--ok)}\n  #mMapa{position:absolute;left:12px;bottom:12px;width:270px;height:270px;border-radius:12px;border:1px solid var(--linha);background:#0e1216}\n  #mBar{position:absolute;right:12px;bottom:12px;width:min(390px,calc(100vw - 310px));background:var(--fundo);border:1px solid var(--linha);border-radius:12px;padding:10px}\n  #mBar .seg button{min-width:0;font-size:12.5px;padding:8px 4px}\n  #mBar .linha{display:flex;gap:6px;margin-top:8px}\n  #mBar .linha button{flex:1;padding:10px 6px;border-radius:8px;background:rgba(255,255,255,.08);font-size:13.5px;font-weight:500}\n  #mBar .linha button.pri{background:var(--azul)}\n  #mBar .linha button.ok{background:#1f7a4d}\n  #mBar .linha button:disabled{opacity:.4;cursor:default}\n  #mRaio{display:flex;align-items:center;gap:8px;margin-top:8px;font-size:13px}\n  #mRaio input{flex:1;accent-color:var(--azul)} #mRaio output{font-family:\"Roboto Mono\",monospace;min-width:44px;text-align:right}\n  #mDica{margin:8px 0 0;font-size:12px;line-height:1.45;color:#B4BEC9}\n  #mAjuda{position:absolute;left:12px;top:58px;width:min(360px,calc(100vw - 24px));background:rgba(18,21,26,.94);border:1px solid var(--linha);border-radius:12px;padding:12px 14px;font-size:13px;line-height:1.5}\n  #mAjuda b{display:block;font-size:14.5px;font-weight:500;margin-bottom:4px}\n  #mAjuda kbd{font-family:\"Roboto Mono\",monospace;font-size:11.5px;background:rgba(255,255,255,.1);border-radius:4px;padding:1px 5px}\n  #mAjuda button{margin-top:8px;padding:7px 12px;border-radius:7px;background:rgba(255,255,255,.08);font-size:13px}\n  .mapaSt{font-size:13.5px;line-height:1.45;padding:10px 12px;border-radius:9px;background:rgba(255,255,255,.04);border:1px solid var(--linha);margin-bottom:8px}\n  .mapaSt.vazio{border-color:rgba(245,165,36,.45);color:#F3D9A8}\n  #iniciar:disabled{background:#2a3038;color:#8E99A6;cursor:default}\n  @media (max-width:760px){#mMapa{width:170px;height:170px}#mBar{width:calc(100vw - 196px)}#mTopo .v:nth-child(n+6){display:none}}\n  /* tela de início */\n  #inicio{position:absolute;inset:0;display:flex;align-items:center;padding:28px clamp(16px,5vw,64px);\n    background:linear-gradient(90deg,rgba(7,9,12,.94) 0%,rgba(7,9,12,.72) 38%,rgba(7,9,12,0) 68%)}\n  /* sem barra de rolagem: letras um pouco menores e, se ainda nao couber, o\n     painel inteiro encolhe para caber na altura (encaixarInicio, abaixo) */\n  #inicio .c{width:min(440px,100%);max-height:100%;overflow-x:hidden;overflow-y:auto;scrollbar-width:none;padding-right:4px;transform-origin:left center}\n  #inicio .c::-webkit-scrollbar{display:none}\n  #inicio .c #bComecar{position:sticky;bottom:4px;z-index:3}\n  #inicio .sobre{font-size:11px;letter-spacing:.16em;text-transform:uppercase;color:var(--azul2);margin:0 0 8px}\n  #inicio h1{margin:0;font-size:clamp(30px,4.4vw,48px);line-height:1;font-weight:600;letter-spacing:-.01em}\n  #inicio h1 span{display:block;color:var(--azul2)}\n  #inicio .lead{margin:10px 0 14px;font-size:13.5px;line-height:1.45;color:#C3CCD5;max-width:40ch}\n  #inicio .rot{display:block;margin:0 0 7px;font-size:12.5px;letter-spacing:.06em;text-transform:uppercase;color:var(--fraco)}\n  #nomeOp{width:100%;padding:12px 14px;border-radius:10px;border:1.5px solid var(--linha);background:rgba(255,255,255,.06);color:var(--texto);font:inherit;font-size:15px;margin-bottom:18px}\n  #nomeOp:focus{border-color:var(--azul2);outline:none}\n  .avatares{display:grid;grid-template-columns:repeat(auto-fill,minmax(120px,1fr));gap:6px}\n  .avatares button{padding:10px 8px;border-radius:9px;border:1.5px solid var(--linha);background:rgba(255,255,255,.05);font-size:13.5px}\n  .avatares button[aria-pressed=\"true\"]{border-color:var(--azul);background:rgba(47,128,237,.18)}\n  #bComecar{width:100%;margin-top:22px;padding:15px;border-radius:11px;background:var(--azul);font-size:17px;font-weight:600}\n  #bComecar:hover{background:var(--azul2)}\n  .como{margin-top:16px;font-size:13.5px;color:#B4BEC9;line-height:1.5}\n  .como summary{cursor:pointer;color:var(--texto);font-weight:500;padding:6px 0}\n  .como ol{margin:6px 0 0;padding-left:20px}\n  .como li{margin:4px 0}\n  #bInicio{margin:-4px 0 10px;padding:6px 0;font-size:13px;color:var(--fraco)}\n  #bInicio:hover{color:var(--texto)}\n  /* 13/10/2026: sair da abertura do simulador de volta à escolha do drone */\n  #bVoltarDrones{margin:0 0 14px;padding:6px 0;font-size:13px;color:var(--fraco)}\n  #bVoltarDrones:hover{color:var(--texto)}\n  body.telaInicio #topo,body.telaInicio #radar,body.telaInicio #bar{display:none}\n  /* 08/10/2026: no menu, sem o RC Plus desenhado nem a tela interna do campo (voltando da vista Controle) */\n  body.telaInicio #vCtrl,body.telaInicio #tela{display:none!important}\n  @media (max-width:760px){#inicio{align-items:flex-end;background:linear-gradient(0deg,rgba(7,9,12,.95) 0%,rgba(7,9,12,.8) 60%,rgba(7,9,12,.1) 100%)}}\n  @media (prefers-reduced-motion:reduce){.tog::after{transition:none}}\n  @media (max-width:760px){#topo .v.op{display:none}#radar{width:120px;height:120px}}\n</style>\n\n<div id=\"carregando\">Carregando o Agras T50…</div>\n\n<div id=\"topo\">\n  <div class=\"estado\"><span id=\"tEstado\">Em solo</span><small id=\"tModo\">Modo fácil · Rota</small></div>\n  <div class=\"sp\"></div>\n  <div class=\"v\"><span>RTK</span><b id=\"hRtk\" class=\"ok\">FIX</b></div>\n  <div class=\"v\"><span>Bateria</span><b id=\"hBat\">100%</b></div>\n  <div class=\"v\"><span>Tanque</span><b id=\"hTan\">40,0 L</b></div>\n  <div class=\"v op\"><span>Vazão</span><b id=\"hVaz\">0,0 L/min</b></div>\n  <div class=\"v\"><span>Velocidade</span><b id=\"hVel\">0,0 m/s</b></div>\n  <div class=\"v\"><span>Altura</span><b id=\"hAgl\">0,0 m</b></div>\n  <div class=\"v op\"><span>Aplicado</span><b id=\"hApl\">0,00 ha</b></div>\n</div>\n\n<canvas id=\"radar\" width=\"336\" height=\"336\" aria-label=\"Indicador de radar\"></canvas>\n\n<!-- visão pela tela do controle -->\n<div id=\"vCtrl\" hidden>\n  <div id=\"vCtrlRc\"></div>\n  <div id=\"tela\">\n    <div class=\"tTopo\">\n      <span><b class=\"e\" id=\"rEstado\"></b><small id=\"rModo\"></small></span><span class=\"sp\"></span>\n      <span class=\"chip ok\">RTK FIX</span><span class=\"chip\">H <b id=\"rDist\"></b></span>\n      <span class=\"chip\">Bateria <b id=\"rBat\"></b></span><span class=\"chip\">Tanque <b id=\"rTan\"></b></span>\n    </div>\n    <span class=\"tFpv\">FPV</span>\n    <div class=\"tMira\"></div>\n    <div id=\"rObs\" hidden></div>\n    <div id=\"rDesvio\" hidden>DESVIO DE OBSTÁCULOS DESLIGADO</div>\n    <canvas id=\"rMapa\" aria-label=\"Mapa da tarefa\"></canvas>\n    <div id=\"rDados\">\n      <span>Altura</span><b id=\"rAgl\"></b><span>Velocidade</span><b id=\"rVel\"></b>\n      <span>Vazão</span><b id=\"rVaz\"></b><span>Aplicado</span><b id=\"rApl\"></b>\n      <span>Faixa / espaç.</span><b id=\"rFai\"></b>\n    </div>\n  </div>\n</div>\n<div id=\"vOpRot\" hidden></div>\n\n<div id=\"alerta\" hidden>\n  <b id=\"alTit\"></b><span id=\"alTxt\"></span>\n  <div class=\"bts\" id=\"alBts\"></div>\n</div>\n\n<div id=\"bar\">\n  <div id=\"vistas\" role=\"group\" aria-label=\"Visão\">\n    <button data-v=\"drone\" aria-pressed=\"true\">Drone</button>\n    <button data-v=\"controle\" aria-pressed=\"false\">Controle</button>\n    <button data-v=\"operador\" aria-pressed=\"false\">Operador</button>\n    <button data-v=\"livre\" aria-pressed=\"false\">Livre</button>\n  </div>\n  <!-- velocidade do jogo (1x/4x/10x) tirada: o treino e sempre em tempo real (02/10) -->\n  <button id=\"bVel\" hidden>1×</button>\n  <button id=\"bRth\" class=\"cr\">RTH</button>\n  <button id=\"bPausa\">Pausar</button>\n  <button id=\"bCen\">Campos</button>\n</div>\n\n<!-- mapeamento com controle remoto -->\n<div id=\"mapaUi\" hidden>\n  <div id=\"mTopo\">\n    <div class=\"estado\"><span>Mapeamento com controle remoto</span><small>RC Plus · RTK do controle</small></div>\n    <div class=\"sp\"></div>\n    <div class=\"v\"><span>RTK</span><b class=\"ok\">FIX ±2 cm</b></div>\n    <div class=\"v\"><span>Pontos limite</span><b id=\"mPts\">0</b></div>\n    <div class=\"v\"><span>Obstáculos</span><b id=\"mObs\">0</b></div>\n    <div class=\"v\"><span>Área</span><b id=\"mArea\">0,00 ha</b></div>\n    <div class=\"v\"><span>Último ponto</span><b id=\"mDist\">—</b></div>\n  </div>\n  <canvas id=\"mMapa\" width=\"540\" height=\"540\" aria-label=\"Mapa do controle\"></canvas>\n  <div id=\"mAjuda\">\n    <b>Caminhe e marque o campo</b>\n    Com o RTK do controle em FIX, vá até cada canto do talhão e marque um ponto de limite.\n    Depois marque os obstáculos: contornando (polígono) ou só no centro com um raio.<br>\n    <kbd>W A S D</kbd> caminha · <kbd>Shift</kbd> corre · arraste o mouse para olhar · roda do mouse afasta<br>\n    <kbd>Espaço</kbd> marca ponto · <kbd>Backspace</kbd> desfaz · <kbd>Enter</kbd> fecha obstáculo · <kbd>1 2 3</kbd> tipo de ponto\n    <br><button id=\"mAjOk\">Entendi</button>\n  </div>\n  <div id=\"mBar\">\n    <div class=\"seg\" id=\"mTipo\">\n      <button data-v=\"limite\" aria-pressed=\"true\" tabindex=\"-1\">Limite</button>\n      <button data-v=\"poligono\" aria-pressed=\"false\" tabindex=\"-1\">Obstáculo</button>\n      <button data-v=\"circulo\" aria-pressed=\"false\" tabindex=\"-1\">Obstáculo circular</button>\n    </div>\n    <div id=\"mRaio\" hidden><label for=\"mRaioIn\">Raio</label><input type=\"range\" id=\"mRaioIn\" min=\"1\" max=\"30\" step=\".5\" value=\"6\"><output id=\"mRaioOut\">6,0 m</output></div>\n    <p id=\"mDica\"></p>\n    <div class=\"linha\">\n      <button id=\"mMarcar\" class=\"pri\" tabindex=\"-1\">Marcar ponto</button>\n      <button id=\"mFechar\" tabindex=\"-1\">Fechar obstáculo</button>\n      <button id=\"mDesfazer\" tabindex=\"-1\">Desfazer</button>\n    </div>\n    <div class=\"linha\">\n      <button id=\"mLimpar\" tabindex=\"-1\">Recomeçar</button>\n      <button id=\"mSair\" tabindex=\"-1\">Sair</button>\n      <button id=\"mConcluir\" class=\"ok\" tabindex=\"-1\">Concluir mapa</button>\n    </div>\n  </div>\n</div>\n\n<div class=\"modal\" id=\"mFim\" hidden>\n  <div class=\"c\">\n    <h2>Mapa salvo</h2>\n    <p class=\"s\" id=\"mFimTxt\"></p>\n    <div class=\"grade\" id=\"mFimGrade\"></div>\n    <div class=\"bts\"><button id=\"mFimOp\" class=\"pri\">Iniciar operação</button><button id=\"mFimVolta\">Continuar mapeando</button></div>\n    <div class=\"bts\"><button id=\"mFimCampos\">Voltar aos campos</button></div>\n  </div>\n</div>\n\n<!-- verificação automática antes da tarefa -->\n<div class=\"modal\" id=\"verif\" hidden>\n  <div class=\"c\">\n    <h2>Verificação automática antes da tarefa</h2>\n    <p class=\"s\" id=\"vCampo\"></p>\n    <div id=\"vLista\"></div>\n    <div class=\"deslizar\"><span class=\"rot\">Deslize para decolar</span>\n      <input type=\"range\" id=\"vDesl\" min=\"0\" max=\"100\" value=\"0\" aria-label=\"Deslize para decolar\"></div>\n    <div class=\"bts\"><button id=\"vCancel\">Cancelar</button></div>\n  </div>\n</div>\n\n<!-- aeronave perdida -->\n<div class=\"modal\" id=\"queda\" hidden>\n  <div class=\"c\">\n    <h2>Aeronave perdida</h2>\n    <p class=\"s\" id=\"qMotivo\"></p>\n    <p class=\"licao\" id=\"qLicao\"></p>\n    <div class=\"bts\"><button id=\"qDenovo\" class=\"pri\">Tentar de novo</button><button id=\"qConfig\">Mudar configuração</button></div>\n  </div>\n</div>\n\n<!-- operação concluída -->\n<div class=\"modal\" id=\"fim\" hidden>\n  <div class=\"c\">\n    <h2>Operação concluída</h2>\n    <p class=\"s\" id=\"fTexto\"></p>\n    <div class=\"grade\" id=\"fGrade\"></div>\n    <div class=\"bts\"><button id=\"fDenovo\" class=\"pri\">Voar de novo</button><button id=\"fCampos\">Campos</button></div>\n  </div>\n</div>\n\n<script>\n/* tela de inicio sem barra de rolagem: se o conteudo passar da altura da\n   janela, encolhe o painel inteiro (zoom) ate caber */\n(function(){\n  function encaixarInicio(){\n    var i=document.getElementById(\"inicio\"), c=i&&i.querySelector(\".c\");\n    if(!c||i.hidden) return;\n    c.style.zoom=1;\n    var livre=i.clientHeight-56, alto=c.scrollHeight;\n    if(alto>livre&&livre>100) c.style.zoom=Math.max(.55,livre/alto).toFixed(3);\n  }\n  addEventListener(\"resize\",encaixarInicio);\n  setInterval(encaixarInicio,500);\n})();\n</script>\n<div id=\"inicio\" hidden>\n  <div class=\"c\">\n    <button id=\"bVoltarDrones\" type=\"button\">‹ Voltar à escolha do drone</button>\n    <p class=\"sobre\">Treinamento de operador</p>\n    <h1>Simulador <span>Agras T50</span></h1>\n    <p class=\"lead\">Mapeie o campo caminhando com o controle, configure a tarefa e acompanhe a aplicação pela câmera do drone, pela tela do controle ou ao lado do operador.</p>\n    <p class=\"lead\" id=\"olaOp\" hidden></p>\n    <button id=\"bComecar\">Começar</button>\n    <details class=\"como\"><summary>Como jogar</summary>\n      <ol>\n        <li>Escolha um campo e faça o mapa caminhando: marque os cantos do talhão e os obstáculos.</li>\n        <li>Ajuste altura, velocidade, gota e espaçamento até as faixas fecharem.</li>\n        <li>Inicie a operação, deslize para decolar e acompanhe pelas visões Drone, Controle ou Operador.</li>\n        <li>No fim, confira a cobertura do talhão, a sobreposição e o que mudar na próxima.</li>\n      </ol>\n    </details>\n  </div>\n</div>\n\n<div id=\"painel\" hidden>\n  <div class=\"c\">\n    <button id=\"bInicio\">‹ Tela inicial</button>\n    <p class=\"sobre\">Agras T50 · treinamento de operador</p>\n    <h1>Campos</h1>\n    <div class=\"cen\" id=\"listaCen\"></div>\n\n    <h3>Mapa do campo</h3>\n    <div class=\"mapaSt\" id=\"mapaSt\"></div>\n    <div class=\"seg\">\n      <button id=\"bMapear\">Mapear caminhando</button>\n      <button id=\"bPronto\">Usar mapa pronto</button>\n    </div>\n    <p class=\"ajuda\">O mapa pronto tem só o contorno do talhão, sem obstáculos marcados. Quem desvia é o radar.</p>\n\n\n    <h3>Modo do aplicativo</h3>\n    <div class=\"seg\" id=\"segModo\">\n      <button data-v=\"facil\" aria-pressed=\"true\">Modo fácil</button>\n      <button data-v=\"padrao\" aria-pressed=\"false\">Modo padrão</button>\n    </div>\n    <p class=\"ajuda\" id=\"ajModo\"></p>\n\n    <h3>Configurações de tarefa</h3>\n    <div class=\"campo\"><label for=\"pAlt\">Altura acima das culturas</label><output id=\"oAlt\"></output>\n      <input type=\"range\" id=\"pAlt\" min=\"1.5\" max=\"15\" step=\".5\" value=\"3\"></div>\n    <div class=\"campo\"><label for=\"pVel\">Velocidade</label><output id=\"oVel\"></output>\n      <input type=\"range\" id=\"pVel\" min=\"1\" max=\"10\" step=\".5\" value=\"7\"></div>\n    <div class=\"campo\"><label for=\"pFai\">Espaçamento de rota</label><output id=\"oFai\"></output>\n      <input type=\"range\" id=\"pFai\" min=\"3\" max=\"12\" step=\".5\" value=\"7.5\"></div>\n    <canvas id=\"cFaixa\" width=\"1000\" height=\"150\" aria-label=\"Faixas de aplicação lado a lado\"></canvas>\n    <p class=\"ajuda\" id=\"ajFaixa\"></p>\n    <div class=\"campo\"><label for=\"pVaz\">Volume de pulverização</label><output id=\"oVaz\"></output>\n      <input type=\"range\" id=\"pVaz\" min=\"5\" max=\"40\" step=\"1\" value=\"15\"></div>\n    <div class=\"campo\"><label for=\"pGota\">Tamanho da gota</label><output id=\"oGota\"></output>\n      <input type=\"range\" id=\"pGota\" min=\"50\" max=\"500\" step=\"10\" value=\"300\"></div>\n    <div class=\"campo\"><label for=\"pRth\">Altitude RTH</label><output id=\"oRth\"></output>\n      <input type=\"range\" id=\"pRth\" min=\"5\" max=\"50\" step=\"1\" value=\"20\"></div>\n\n    <h3>Configurações de detecção</h3>\n    <div class=\"seg\" id=\"segTerreno\">\n      <button data-v=\"planicie\" aria-pressed=\"true\">Planícies</button>\n      <button data-v=\"montanha\" aria-pressed=\"false\">Montanhas e pomares</button>\n      <button data-v=\"agua\" aria-pressed=\"false\">Acima da água</button>\n    </div>\n    <p class=\"ajuda\" id=\"ajTerreno\"></p>\n    <div class=\"chave\"><div class=\"g\"><b>Desvio de obstáculos</b>\n      <small>Com ele ligado, a velocidade fica limitada a 10 m/s e a altura acima das culturas entre 2,5 e 8 m.</small></div>\n      <button class=\"tog\" id=\"tDesvio\" aria-pressed=\"true\" aria-label=\"Desvio de obstáculos\"></button></div>\n    <div class=\"chave\"><div class=\"g\"><b>Estabilização da altitude</b>\n      <small>Acompanha o terreno pelo radar. Desligada, a altura é contada a partir do ponto de decolagem.</small></div>\n      <button class=\"tog\" id=\"tEstab\" aria-pressed=\"true\" aria-label=\"Estabilização da altitude\"></button></div>\n\n    <button id=\"iniciar\">Iniciar operação</button>\n  </div>\n</div>\n\n<script src=\"https://cdn.jsdelivr.net/npm/three@0.147.0/build/three.min.js\"></script>\n<script src=\"https://cdn.jsdelivr.net/npm/three@0.147.0/examples/js/loaders/OBJLoader.js\"></script>\n<script src=\"https://cdn.jsdelivr.net/npm/three@0.147.0/examples/js/loaders/ColladaLoader.js\"></script>\n<script src=\"https://cdn.jsdelivr.net/npm/fflate@0.6.9/umd/index.js\"></script>\n<script src=\"https://cdn.jsdelivr.net/npm/three@0.147.0/examples/js/loaders/FBXLoader.js\"></script>\n<script src=\"https://cdn.jsdelivr.net/npm/three@0.147.0/examples/js/controls/OrbitControls.js\"></script>\n<script src=\"https://cdn.jsdelivr.net/npm/three@0.147.0/examples/js/loaders/GLTFLoader.js\"></script>\n<script src=\"https://cdn.jsdelivr.net/npm/three@0.147.0/examples/js/utils/BufferGeometryUtils.js\"></script>\n<script>\n/* 24/11/2026 (montar42): no celular (iPhone, iPad, Android) a pagina passava do limite de memoria logo depois de o campo\n   aparecer e o aparelho a derrubava: tela branca, recarrega e cai no Entrar (video dele, T25 no navegador do Instagram).\n   As texturas dos modelos 3D vinham inteiras (2048 x 2048: o T25 sozinho tinha 67 MB, ~250 MB no total). No celular:\n   1) toda foto que vira textura e reduzida para no maximo ~1 milhao de pontos (2048x2048 -> 1024x1024; o ceu 4096x1024 ->\n      2048x512) e a original e liberada. Desenhos feitos pelo jogo (canvas, como a pintura da faixa) nao sao mexidos.\n   2) a primeira vez comeca na qualidade \"baixa\" do desempenho.js (sem sombra, menos pontos na tela); ele ainda desce sozinho.\n   No computador nada muda. */\n(function () {\n  var ua = navigator.userAgent || \"\";\n  var movel = /iPhone|iPad|iPod|Android/i.test(ua) || (/Macintosh/.test(ua) && navigator.maxTouchPoints > 1);\n  if (!movel || !window.THREE || !THREE.Source) return;\n  window.XG_MOVEL = { reduzidas: 0, antesMB: 0, depoisMB: 0 };\n  try { if (!localStorage.getItem(\"tpd_qualidade\")) localStorage.setItem(\"tpd_qualidade\", \"baixa\"); } catch (e) { /* sem armazenamento */ }\n  var LIMITE = 1024 * 1024, CHAVE = \"__xgDados\", feitas = typeof WeakMap === \"function\" ? new WeakMap() : null;\n  function reduzir(d) {\n    if (d && typeof d === \"object\" && feitas && feitas.has(d)) return feitas.get(d);   // a mesma foto em duas texturas\n    var foto = (typeof HTMLImageElement !== \"undefined\" && d instanceof HTMLImageElement && d.complete && d.naturalWidth) ||\n               (typeof ImageBitmap !== \"undefined\" && d instanceof ImageBitmap);\n    if (!foto) return d;\n    var w = d.naturalWidth || d.width, h = d.naturalHeight || d.height;\n    if (!w || !h || w * h <= LIMITE) return d;\n    var k = Math.sqrt(LIMITE / (w * h)), nw = Math.max(1, Math.floor(w * k)), nh = Math.max(1, Math.floor(h * k));\n    try {\n      var c = document.createElement(\"canvas\"); c.width = nw; c.height = nh;\n      c.getContext(\"2d\").drawImage(d, 0, 0, nw, nh);\n      if (feitas) feitas.set(d, c);\n      if (d.close) d.close();\n      XG_MOVEL.reduzidas++; XG_MOVEL.antesMB += w * h * 4 / 1e6; XG_MOVEL.depoisMB += nw * nh * 4 / 1e6;\n      return c;\n    } catch (e) { return d; }\n  }\n  Object.defineProperty(THREE.Source.prototype, \"data\", {\n    configurable: true,\n    get: function () { return this[CHAVE]; },\n    set: function (v) { this[CHAVE] = reduzir(v); }\n  });\n})();\n</script>\n<script src=\"../js/campo/apoiadores.js?v=a6f66862226d\"></script>\n<script>\n\"use strict\";\nconst $=id=>document.getElementById(id);\nconst nf=(v,d)=>v.toLocaleString(\"pt-BR\",{minimumFractionDigits:d,maximumFractionDigits:d});\nconst trava=(v,a,b)=>v<a?a:v>b?b:v;\nconst mmss=s=>{s=Math.max(0,Math.round(s));return Math.floor(s/60)+\":\"+String(s%60).padStart(2,\"0\")};\n\n/* Números do manual do Agras T50 (Especificações e Aviônica) */\nconst T50={tanque:40,vazaoMaxLmin:16,autonomiaVazioMin:16.5,autonomiaCheioMin:7,\n  radarAlcance:50,distSeguranca:2.5,raioHelice:.69,velMaxDesvio:10,altMinDesvio:2.5,altMaxDesvio:8,\n  velMax:10,alcanceFio:4,frenagem:4,   /* T50: 36 km/h no maximo */\n  /* regras de campo ditas pelo Eduardo (06/10/2026): depois de passar por cima\n     de um obstáculo a aeronave só volta à altura de trabalho 6 m além dele;\n     árvore seca (sem folha) só é vista pelo radar abaixo de 15 km/h */\n  distPosObstaculo:6,velArvoreSeca:15/3.6};\n/* velocidade horizontal: na rota é V.v; no voo manual (manual.js) é mvx/mvz */\nconst velHorizontal=()=>V.estado===\"manual\"?Math.hypot(V.mvx||0,V.mvz||0):V.v;\n\n/* ===================================================================\n   RENDER E LUZ\n   =================================================================== */\nconst render=new THREE.WebGLRenderer({antialias:true,powerPreference:\"high-performance\"});\nrender.setPixelRatio(Math.min(2,devicePixelRatio));\nrender.setSize(innerWidth,innerHeight);\nrender.shadowMap.enabled=true;render.shadowMap.type=THREE.PCFSoftShadowMap;\nrender.outputEncoding=THREE.sRGBEncoding;\nrender.toneMapping=THREE.ACESFilmicToneMapping;render.toneMappingExposure=.85;\ndocument.body.prepend(render.domElement);\n\nconst cena=new THREE.Scene();\ncena.fog=new THREE.Fog(\"#c6d4dc\",220,1050);\nconst cam=new THREE.PerspectiveCamera(55,innerWidth/innerHeight,.1,3000);\nconst orb=new THREE.OrbitControls(cam,render.domElement);\norb.enableDamping=true;orb.maxPolarAngle=Math.PI*.495;\n/* 19/11/2026 (Eduardo: \"quando a camera ta no drone deixa possivel fazer orbita e tirar e dar zoom\"): na vista Drone a câmera continua\n   seguindo a aeronave, mas no ângulo e na distância que o aluno deixar: arrastar gira em volta dela, a rodinha (ou a pinça no celular) dá zoom.\n   az = ângulo em volta do drone contado de \"atrás dele\", el = elevação, dist = distância. Sem mexer é a posição de sempre (11 m atrás, 3,6 m de\n   lado, 4,2 m acima); apertar \"Drone\" de novo volta a ela. Quem gira e dá zoom são os OrbitControls; aqui só se lê o resultado. */\nconst XG_ORB0={az:Math.atan2(3.6,11),el:Math.atan2(3.7,Math.hypot(11,3.6)),dist:Math.hypot(11,3.6,3.7)};\nconst xgOrb={az:XG_ORB0.az,el:XG_ORB0.el,dist:XG_ORB0.dist,mexendo:false,ate:0};   /* ate: depois de soltar, a câmera ainda desliza um pouco (amortecimento); até lá ela continua sendo do aluno */\nfunction xgOrbLer(){\n  const ox=cam.position.x-orb.target.x,oy=cam.position.y-orb.target.y,oz=cam.position.z-orb.target.z,h=Math.hypot(ox,oz),tx=-Math.cos(V.yaw),tz=Math.sin(V.yaw);\n  xgOrb.dist=Math.min(120,Math.max(2.5,Math.hypot(h,oy)));xgOrb.el=Math.min(1.5,Math.max(.03,Math.atan2(oy,h)));\n  if(h>.05)xgOrb.az=Math.atan2(ox*tz-oz*tx,ox*tx+oz*tz);\n}\norb.addEventListener(\"start\",()=>{if(vista===\"drone\"&&seguir&&!modoMapa&&!telaInicial)xgOrb.mexendo=true});\norb.addEventListener(\"change\",()=>{if(xgOrb.mexendo||performance.now()<xgOrb.ate)xgOrbLer()});\norb.addEventListener(\"end\",()=>{if(xgOrb.mexendo){xgOrbLer();xgOrb.mexendo=false;xgOrb.ate=performance.now()+900}});\n\n(function ceu(){\n  const c=document.createElement(\"canvas\");c.width=4;c.height=256;\n  const g=c.getContext(\"2d\"),gr=g.createLinearGradient(0,0,0,256);\n  gr.addColorStop(0,\"#3b78ae\");gr.addColorStop(.55,\"#9ac0d9\");gr.addColorStop(.72,\"#d3dfe4\");gr.addColorStop(1,\"#d3dfe4\");\n  g.fillStyle=gr;g.fillRect(0,0,4,256);\n  const t=new THREE.CanvasTexture(c);t.encoding=THREE.sRGBEncoding;\n  cena.add(new THREE.Mesh(new THREE.SphereGeometry(1700,32,16),new THREE.MeshBasicMaterial({map:t,side:THREE.BackSide,fog:false})));\n})();\ncena.add(new THREE.HemisphereLight(\"#cfe3f2\",\"#55462f\",.6));\nconst sol=new THREE.DirectionalLight(\"#fff1dc\",1.9);\nsol.castShadow=true;sol.shadow.mapSize.set(2048,2048);\nObject.assign(sol.shadow.camera,{left:-30,right:30,top:30,bottom:-30,near:1,far:300});\nsol.shadow.bias=-.0004;\ncena.add(sol,sol.target);\n\n/* ===================================================================\n   RUÍDO PARA O RELEVO\n   =================================================================== */\nconst perm=(()=>{let s=1337;const r=()=>(s=(s*1664525+1013904223)>>>0)/4294967296;\n  const p=[...Array(256).keys()];for(let i=255;i>0;i--){const j=Math.floor(r()*(i+1));[p[i],p[j]]=[p[j],p[i]]}\n  const q=new Uint8Array(512);for(let i=0;i<512;i++)q[i]=p[i&255];return q})();\nfunction ruido(x,y){\n  const X=Math.floor(x)&255,Y=Math.floor(y)&255;x-=Math.floor(x);y-=Math.floor(y);\n  const f=t=>t*t*t*(t*(t*6-15)+10),u=f(x),v=f(y);\n  const gr=(h,a,b)=>{const g=h&7;return (g<4?a:b)*((g&1)?-1:1)+(g<4?b:a)*((g&2)?-.5:.5)};\n  const a=perm[X]+Y,b=perm[X+1]+Y,l=(t,p,q)=>p+t*(q-p);\n  return l(v,l(u,gr(perm[a],x,y),gr(perm[b],x-1,y)),l(u,gr(perm[a+1],x,y-1),gr(perm[b+1],x-1,y-1)));\n}\nconst fbm=(x,y)=>ruido(x,y)+.5*ruido(x*2.1+17,y*2.1+9)+.25*ruido(x*4.3+41,y*4.3+3);\nconst suave=(a,b,t)=>{t=trava((t-a)/(b-a),0,1);return t*t*(3-2*t)};\n\n/* ===================================================================\n   CAMPOS (CENÁRIOS)\n   =================================================================== */\nconst TALHAO={x0:-90,z0:-200,larg:180,prof:220};\nconst BASE={x:-4,z:28};\n\nfunction linhaDePostes(ax,az,bx,bz,vao){\n  const n=Math.max(1,Math.round(Math.hypot(bx-ax,bz-az)/vao)),pts=[];\n  for(let i=0;i<=n;i++)pts.push([ax+(bx-ax)*i/n,az+(bz-az)*i/n]);return pts;\n}\n\nconst CENARIOS=[\n  {id:\"coxilha\",nome:\"Coxilha com rede de baixa\",nivel:[\"Fácil\",\"f\"],\n   desc:\"4 ha em relevo suave. Uma rede de baixa tensão cruza o talhão na diagonal e há uma árvore isolada e uma árvore seca no meio das linhas.\",\n   terrenoSugerido:\"planicie\",\n   altura:(x,z)=>5*Math.sin(x/95+.6)*Math.cos(z/120)+2.6*fbm(x/75,z/75),\n   montar(){\n     redeEletrica(linhaDePostes(-150,-6,160,-178,40),9.5,.9,\"baixa tensão\");\n     arvores([{x:30,z:-95,alt:12,copa:4.6}],\"a árvore isolada\");\n     /* árvore seca: o radar só a vê abaixo de 15 km/h (T50.velArvoreSeca) */\n     arvores([{x:-45,z:-150,alt:9,copa:3.2,seca:true}],\"a árvore seca\");\n     const fila=[];for(let z=-215;z<45;z+=9)fila.push({x:-110+Math.sin(z)*2,z,alt:10+Math.abs((z*7)%5),copa:3.6});\n     arvores(fila,\"a fileira de árvores\");\n     palmeiras([{x:24,z:46,h:8},{x:30,z:40,h:9.5}]);\n   }},\n  {id:\"baixada\",nome:\"Baixada do açude\",nivel:[\"Médio\",\"m\"],\n   desc:\"O talhão desce até um açude. Capão de mata invadindo a lateral, eucaliptos no fim das linhas e uma torre de internet dentro da área.\",\n   terrenoSugerido:\"planicie\",\n   altura:(x,z)=>{const d=Math.hypot(x-140,z+72);return 4.5-8.5*Math.exp(-d*d/(2*72*72))+1.8*fbm(x/60,z/60)},\n   montar(){\n     acude(140,-72,46);\n     const capao=[];let s=11;const r=()=>(s=(s*1664525+1013904223)>>>0)/4294967296;\n     for(let i=0;i<34;i++){const a=r()*6.283,d=Math.sqrt(r())*27;capao.push({x:-106+Math.cos(a)*d,z:-140+Math.sin(a)*d,alt:9+r()*8,copa:3.2+r()*2})}\n     arvores(capao,\"o capão de mata\");\n     const euc=[];for(let x=-92;x<=92;x+=6)euc.push({x,z:-207,alt:24+Math.abs((x*13)%4),copa:3.3,eucalipto:true});\n     arvores(euc,\"a bordadura de eucalipto\");\n     mastro(70,8,22,\"a torre de internet\");\n     predio(-45,56,9,7,3,.3,\"#d9d2c3\",\"#8a4b35\",\"a casa\");\n     predio(-82,60,20,12,5.5,.1,\"#b9bec2\",\"#6f7a82\",\"o galpão\");\n     palmeiras([{x:-22,z:54,h:9},{x:-62,z:48,h:8}]);\n     bombaCombustivel(-68,50,Math.PI/2);\n     bananeiras([{x:-33,z:47,h:4.2},{x:-37,z:44,h:3.6},{x:-30,z:43,h:3.9},{x:-54,z:67,h:4.4},{x:-58,z:70,h:3.4},{x:-33,z:66,h:4}]);\n   }},\n  {id:\"encosta\",nome:\"Encosta com rede na coxilha\",nivel:[\"Difícil\",\"d\"],\n   desc:\"Declive de 16° com uma coxilha no meio do talhão. A rede de média tensão passa só 3 m acima do chão bem em cima da coxilha.\",\n   terrenoSugerido:\"montanha\",\n   altura:(x,z)=>{const sobe=.29*Math.max(0,20-z)*suave(-10,25,20-z);\n     const crista=6.5*Math.exp(-x*x/(2*28*28))*suave(15,-15,z);\n     return sobe+crista+1.1*fbm(x/55,z/55)},\n   montar(){\n     redeEletrica([[-190,-80],[-62,-80],[62,-80],[190,-80]],11,1.5,\"média tensão\");\n     silo(40,-232);\n     palmeiras([{x:-10,z:-228,h:8.5},{x:-18,z:-246,h:7.5}]);\n     bombaCombustivel(26,-222,0);\n     predio(12,-238,16,10,5,.1,\"#b9bec2\",\"#6f7a82\",\"o galpão\");\n     const bordas=[];for(let z=-210;z<35;z+=8)bordas.push({x:112+Math.cos(z)*2,z,alt:11+Math.abs((z*5)%4),copa:3.8});\n     arvores(bordas,\"a fileira de árvores\");\n   }},\n];\nlet cen=CENARIOS[0];\nconst alt=(x,z)=>cen.altura(x,z);\n\n/* ===================================================================\n   MUNDO\n   =================================================================== */\nconst mundo=new THREE.Group();cena.add(mundo);\nconst acudes=[];\nconst colisores=[];\n\nfunction texturaSolo(){\n  const c=document.createElement(\"canvas\");c.width=c.height=1024;\n  const g=c.getContext(\"2d\");let s=91;const r=()=>(s=(s*1664525+1013904223)>>>0)/4294967296;\n  g.fillStyle=\"#6a5a45\";g.fillRect(0,0,1024,1024);\n  for(let i=0;i<260;i++){g.globalAlpha=.07+r()*.12;g.fillStyle=r()>.5?\"#7d6c55\":\"#4e412f\";\n    g.beginPath();g.ellipse(r()*1024,r()*1024,30+r()*140,20+r()*90,r()*3,0,7);g.fill()}\n  for(let x=0;x<1024;x+=25.6){g.globalAlpha=.16;g.fillStyle=\"#3a2f22\";g.fillRect(x,0,4,1024);\n    g.globalAlpha=.08;g.fillStyle=\"#a8987a\";g.fillRect(x+6,0,2,1024)}\n  for(let i=0;i<9000;i++){g.globalAlpha=.10+r()*.35;g.fillStyle=r()>.5?\"#2f261b\":\"#9d8d70\";\n    const x=r()*1024,y=r()*1024,rr=.6+r()*2.4;g.fillRect(x,y,rr,rr*(.5+r()))}\n  g.globalAlpha=1;\n  const t=new THREE.CanvasTexture(c);t.wrapS=t.wrapT=THREE.RepeatWrapping;t.encoding=THREE.sRGBEncoding;\n  t.anisotropy=render.capabilities.getMaxAnisotropy();return t;\n}\nconst solo=texturaSolo();\nconst TAM=1400,SEG=440;solo.repeat.set(TAM/20,TAM/20);\n\n/* a pintura cobre o talhão e 30 m em volta: um mapa mal feito aplica fora */\nconst PINT={x0:TALHAO.x0-30,z0:TALHAO.z0-30,larg:TALHAO.larg+60,prof:TALHAO.prof+60};\n/* quantas passadas molharam cada célula (4 por metro). A textura do chão molhado sai dessa contagem:\n   1 passada = molhado, 2 ou mais = emenda sobreposta (mais escura), 0 = chão seco (falha entre faixas) */\nconst COB_PX=4,COB_W=PINT.larg*COB_PX,COB_H=PINT.prof*COB_PX;\nconst cobN=new Uint8Array(COB_W*COB_H),cobPasse=new Int32Array(COB_W*COB_H);\nconst pintDados=new Uint8Array(COB_W*COB_H*4);\nconst pintTx=new THREE.DataTexture(pintDados,COB_W,COB_H,THREE.RGBAFormat);\npintTx.encoding=THREE.sRGBEncoding;pintTx.magFilter=THREE.LinearFilter;pintTx.minFilter=THREE.LinearFilter;pintTx.generateMipmaps=false;pintTx.needsUpdate=true;\nlet pintMudou=false;\nfunction limparCobertura(){cobN.fill(0);cobPasse.fill(-1);pintDados.fill(0);pintTx.needsUpdate=true}\nlimparCobertura();\nfunction pintarFaixa(x1,z1,x2,z2,larg,passe){\n  const dx=x2-x1,dz=z2-z1,l=Math.hypot(dx,dz)||1,nx=-dz/l,nz=dx/l;\n  const n=Math.ceil(larg*COB_PX*2),m=Math.max(1,Math.ceil(l*COB_PX*2));\n  for(let j=0;j<=m;j++){\n    const px=x1+dx*j/m,pz=z1+dz*j/m;\n    for(let k=0;k<=n;k++){\n      const s=-larg/2+larg*k/n;\n      const cx=Math.floor((px+nx*s-PINT.x0)*COB_PX),cz=Math.floor((pz+nz*s-PINT.z0)*COB_PX);\n      if(cx<0||cz<0||cx>=COB_W||cz>=COB_H)continue;\n      const c=cz*COB_W+cx;\n      if(cobPasse[c]===passe)continue;\n      cobPasse[c]=passe;if(cobN[c]<255)cobN[c]++;\n      /* a geometria do chão tem v=1 no z menor: a linha da textura é invertida */\n      const t=((COB_H-1-cz)*COB_W+cx)*4;\n      pintDados[t]=40;pintDados[t+1]=30;pintDados[t+2]=19;pintDados[t+3]=cobN[c]>1?205:130;\n      pintMudou=true;\n    }\n  }\n  if(pintMudou){pintTx.needsUpdate=true;pintMudou=false}\n}\n\nfunction limparMundo(){\n  for(const o of [...mundo.children]){\n    mundo.remove(o);\n    o.traverse(x=>{if(x.geometry)x.geometry.dispose();if(x.material&&x.material.dispose)x.material.dispose()});\n  }\n  colisores.length=0;\n}\n\nfunction construirCenario(c){\n  cen=c;limparMundo();\n  limparCobertura();\n  const T=TALHAO;\n\n  const g=new THREE.PlaneGeometry(TAM,TAM,SEG,SEG);g.rotateX(-Math.PI/2);g.translate(0,0,-80);\n  const pos=g.attributes.position,cor=new Float32Array(pos.count*3);\n  for(let i=0;i<pos.count;i++){\n    const x=pos.getX(i),z=pos.getZ(i);pos.setY(i,alt(x,z));\n    const dx=Math.max(T.x0-x,0,x-(T.x0+T.larg)),dz=Math.max(T.z0-z,0,z-(T.z0+T.prof));\n    const f=Math.min(1,Math.hypot(dx,dz)/7);\n    cor[i*3]=1-f*.46;cor[i*3+1]=1+f*.12;cor[i*3+2]=1-f*.6;\n  }\n  g.setAttribute(\"color\",new THREE.BufferAttribute(cor,3));g.computeVertexNormals();\n  const chao=new THREE.Mesh(g,new THREE.MeshStandardMaterial({map:solo,vertexColors:true,roughness:.97}));\n  chao.receiveShadow=true;mundo.add(chao);\n\n  const gm=new THREE.PlaneGeometry(PINT.larg,PINT.prof,PINT.larg/2,PINT.prof/2);gm.rotateX(-Math.PI/2);\n  gm.translate(PINT.x0+PINT.larg/2,0,PINT.z0+PINT.prof/2);\n  const pm=gm.attributes.position;for(let i=0;i<pm.count;i++)pm.setY(i,alt(pm.getX(i),pm.getZ(i))+.07);\n  gm.computeVertexNormals();\n  mundo.add(new THREE.Mesh(gm,new THREE.MeshStandardMaterial({map:pintTx,transparent:true,opacity:1,roughness:.45,\n    depthWrite:false,polygonOffset:true,polygonOffsetFactor:-2,polygonOffsetUnits:-2})));\n\n  /* marcos de madeira nos cantos do talhão: referência para quem vai mapear caminhando */\n  {const madeira=new THREE.MeshStandardMaterial({color:\"#6b5238\",roughness:1}),tinta=new THREE.MeshStandardMaterial({color:\"#e9e4d8\",roughness:.8});\n   for(const [x,z] of [[T.x0,T.z0],[T.x0+T.larg,T.z0],[T.x0+T.larg,T.z0+T.prof],[T.x0,T.z0+T.prof]]){\n     const g=new THREE.Group(),y=alt(x,z);\n     const m=new THREE.Mesh(new THREE.CylinderGeometry(.07,.09,1.3,7),madeira);m.position.y=.65;\n     const c=new THREE.Mesh(new THREE.CylinderGeometry(.072,.072,.22,7),tinta);c.position.y=1.2;\n     g.add(m,c);g.position.set(x,y,z);g.traverse(o=>{if(o.isMesh)o.castShadow=true});mundo.add(g)}}\n\n  {const geo=new THREE.ConeGeometry(.011,.19,3,1,true);geo.translate(0,.095,0);\n   const N=120000,m=new THREE.InstancedMesh(geo,new THREE.MeshStandardMaterial({color:\"#8a7a52\",roughness:1,side:THREE.DoubleSide}),N);\n   const o=new THREE.Object3D(),cc=new THREE.Color();let s=5;const r=()=>(s=(s*1664525+1013904223)>>>0)/4294967296;\n   for(let i=0;i<N;i++){\n     const x=T.x0-2+r()*(T.larg+4),z=T.z0-2+r()*(T.prof+4),xx=Math.round(x/.5)*.5+(r()-.5)*.12;\n     o.position.set(xx,alt(xx,z),z);o.rotation.set((r()-.5)*.5,r()*6,(r()-.5)*.5);\n     const e=.55+r()*.8;o.scale.set(e,e*(.7+r()*.6),e);o.updateMatrix();m.setMatrixAt(i,o.matrix);\n     cc.setHSL(.10+r()*.03,.28+r()*.14,.26+r()*.16);m.setColorAt(i,cc);\n   }\n   m.receiveShadow=true;mundo.add(m);}\n\n  {const grupo=new THREE.Group();mundo.add(grupo);\n   Promise.all([carregarGlb(GLB.verde),carregarGlb(GLB.outono),carregarGlb(GLB.seca)]).then(([verde,outono,seca])=>{\n     const h0=verde.userData.caixa.max.y,v=[],o=[],sc=[];let s=77;const r=()=>(s=(s*1664525+1013904223)>>>0)/4294967296;\n     for(let i=0;i<520;i++){const a=r()*6.283,R=230+r()*420,x=Math.cos(a)*R,z=Math.sin(a)*R-80,h=7+r()*11,e=h/h0;\n       const k=r(),m=matriz(x,alt(x,z)-.2,z,r()*6.28,e*(1+r()*.5),e);(k<.04?o:k<.07?sc:v).push(m)}\n     instanciar(verde,v,grupo,false);instanciar(outono,o,grupo,false);instanciar(seca,sc,grupo,false);\n   }).catch(e=>console.warn(\"mata do horizonte\",e));}\n  tufosDeCapim();\n\n  operador();\n  camioneta(BASE.x+10,BASE.z+8,0);\n  acudes.length=0;\n  c.montar();\n  fundoMapa=null;desenharMapa3D();\n}\n\n/* ===================================================================\n   OBJETOS 3D: ÁRVORES E PALMEIRA (Quaternius, CC0), BOMBA, CAMIONETE\n   =================================================================== */\nconst GLB={verde:\"assets/web/natureza/quaternius_cc0-common-tree-837.glb\",outono:\"assets/web/natureza/quaternius_cc0-common-tree-841.glb\",\n  seca:\"assets/web/natureza/quaternius_cc0-common-tree-846.glb\",palmeira:\"assets/web/natureza/quaternius_cc0-palm-tree-1203.glb\",\n  bomba:\"assets/web/natureza/jerryblessed-fuel-5054.glb\"};\nconst cacheGlb={};\nfunction carregarGlb(url){\n  return cacheGlb[url]||(cacheGlb[url]=new Promise((ok,erro)=>new THREE.GLTFLoader().load(url,g=>{\n    g.scene.updateMatrixWorld(true);\n    const b=new THREE.Box3().setFromObject(g.scene);g.scene.userData.caixa=b;ok(g.scene);\n  },undefined,erro)));\n}\n/* uma InstancedMesh por pedaço do modelo (tronco, copa clara, copa escura) */\nfunction instanciar(modelo,matrizes,destino,sombra){\n  if(!matrizes.length)return;\n  const m=new THREE.Matrix4();\n  modelo.traverse(p=>{\n    if(!p.isMesh)return;\n    const im=new THREE.InstancedMesh(p.geometry,p.material,matrizes.length);\n    matrizes.forEach((t,i)=>{m.multiplyMatrices(t,p.matrixWorld);im.setMatrixAt(i,m)});\n    im.castShadow=sombra;im.receiveShadow=true;destino.add(im);\n  });\n}\nconst matriz=(x,y,z,giro,sx,sy,sz)=>new THREE.Matrix4().compose(new THREE.Vector3(x,y,z),\n  new THREE.Quaternion().setFromAxisAngle(new THREE.Vector3(0,1,0),giro),new THREE.Vector3(sx,sy,sz===undefined?sx:sz));\n\nfunction camioneta(x,z,giro){\n  /* camionete cabine dupla genérica, feita aqui a partir das proporções de uma média do segmento:\n     5,3 m de comprimento, 1,85 m de largura, 3,08 m entre eixos */\n  const g=new THREE.Group(),y=alt(x,z);\n  const tinta=new THREE.MeshStandardMaterial({color:\"#e4e6e3\",metalness:.45,roughness:.32});\n  const preto=new THREE.MeshStandardMaterial({color:\"#1b1d1f\",roughness:.75});\n  const vidro=new THREE.MeshStandardMaterial({color:\"#1a2229\",metalness:.3,roughness:.06,transparent:true,opacity:.92});\n  const cromo=new THREE.MeshStandardMaterial({color:\"#c9ced2\",metalness:1,roughness:.2});\n  const pneu=new THREE.MeshStandardMaterial({color:\"#141414\",roughness:.95});\n  const LARG=1.8,EF=1.45,ET=-1.63,RA=.48,YR=.39;\n  const extrudar=(forma,largura,mat)=>{\n    const geo=new THREE.ExtrudeGeometry(forma,{depth:largura,bevelEnabled:true,bevelThickness:.035,bevelSize:.035,bevelSegments:2,curveSegments:10});\n    geo.translate(0,0,-largura/2);return new THREE.Mesh(geo,mat);\n  };\n  /* lateral da cabine e do capô, com o arco da roda dianteira */\n  const corpo=new THREE.Shape();\n  corpo.moveTo(-.98,.47);corpo.lineTo(-.98,1.2);corpo.lineTo(.55,1.2);corpo.lineTo(1.2,1.13);corpo.lineTo(2.58,1.04);corpo.lineTo(2.66,.95);corpo.lineTo(2.62,.47);\n  {const a=Math.asin((.47-YR)/RA);corpo.lineTo(EF+RA*Math.cos(a),.47);corpo.absarc(EF,YR,RA,a,Math.PI-a,false);}\n  corpo.lineTo(-.98,.47);\n  g.add(extrudar(corpo,LARG,tinta));\n  /* caçamba: parte de baixo com o arco da roda traseira, paredes e tampa */\n  const cac=new THREE.Shape();\n  cac.moveTo(-2.64,.5);cac.lineTo(-2.64,1.24);cac.lineTo(-1.0,1.24);cac.lineTo(-1.0,.47);\n  {const a=Math.asin((.47-YR)/RA);cac.lineTo(ET+RA*Math.cos(a),.47);cac.absarc(ET,YR,RA,a,Math.PI-a,false);}\n  cac.lineTo(-2.64,.5);\n  for(const lado of [-1,1]){const p=extrudar(cac,.07,tinta);p.position.z=lado*(LARG/2-.035);g.add(p)}\n  {const fundo=new THREE.Mesh(new THREE.BoxGeometry(1.6,.06,LARG-.12),preto);fundo.position.set(-1.82,.98,0);g.add(fundo);\n   const base=new THREE.Mesh(new THREE.BoxGeometry(1.64,.4,1.2),preto);base.position.set(-1.82,.72,0);g.add(base);\n   const tampa=new THREE.Mesh(new THREE.BoxGeometry(.07,.76,LARG),tinta);tampa.position.set(-2.62,.88,0);g.add(tampa);\n   const frente=new THREE.Mesh(new THREE.BoxGeometry(.07,.3,LARG-.1),tinta);frente.position.set(-1.02,1.1,0);g.add(frente);}\n  /* cabine: vidros, colunas e teto */\n  const cab=new THREE.Shape();\n  cab.moveTo(-.95,1.2);cab.lineTo(-.88,1.8);cab.lineTo(.02,1.84);cab.lineTo(.55,1.22);cab.lineTo(-.95,1.2);\n  g.add(extrudar(cab,1.56,vidro));\n  {const teto=new THREE.Mesh(new THREE.BoxGeometry(.98,.05,1.62),tinta);teto.position.set(-.44,1.85,0);g.add(teto);\n   for(const zc of [-.79,.79]){\n     const colB=new THREE.Mesh(new THREE.BoxGeometry(.09,.62,.04),preto);colB.position.set(-.2,1.52,zc);g.add(colB);\n     const colC=new THREE.Mesh(new THREE.BoxGeometry(.1,.62,.04),tinta);colC.position.set(-.9,1.51,zc);colC.rotation.z=-.1;g.add(colC);\n     const esp=new THREE.Mesh(new THREE.BoxGeometry(.22,.14,.12),preto);esp.position.set(.5,1.28,zc*1.2);g.add(esp);\n     const estribo=new THREE.Mesh(new THREE.BoxGeometry(1.7,.05,.16),preto);estribo.position.set(-.2,.42,zc*1.08);g.add(estribo);\n     for(const xm of [.1,-.62]){const maca=new THREE.Mesh(new THREE.BoxGeometry(.16,.03,.02),preto);maca.position.set(xm,1.08,zc*1.15);g.add(maca)}\n   }}\n  /* frente: grade, faróis, para-choques */\n  {const grade=new THREE.Mesh(new THREE.BoxGeometry(.05,.3,1.1),preto);grade.position.set(2.68,.84,0);g.add(grade);\n   for(let k=0;k<4;k++){const f=new THREE.Mesh(new THREE.BoxGeometry(.02,.02,1.08),cromo);f.position.set(2.705,.73+k*.075,0);g.add(f)}\n   for(const zc of [-.66,.66]){\n     const farol=new THREE.Mesh(new THREE.BoxGeometry(.05,.13,.34),new THREE.MeshStandardMaterial({color:\"#e8f0f5\",emissive:\"#9fb3c2\",emissiveIntensity:.35,metalness:.5,roughness:.1}));\n     farol.position.set(2.62,.97,zc);g.add(farol);\n     const lanterna=new THREE.Mesh(new THREE.BoxGeometry(.05,.34,.12),new THREE.MeshStandardMaterial({color:\"#8a0f10\",emissive:\"#3a0406\",roughness:.3}));\n     lanterna.position.set(-2.67,1.02,zc*1.25);g.add(lanterna);\n   }\n   const pcD=new THREE.Mesh(new THREE.BoxGeometry(.22,.24,LARG+.04),preto);pcD.position.set(2.62,.5,0);g.add(pcD);\n   const pcT=new THREE.Mesh(new THREE.BoxGeometry(.2,.16,LARG+.02),cromo);pcT.position.set(-2.66,.5,0);g.add(pcT);}\n  /* rodas e alargadores */\n  for(const xr of [EF,ET])for(const zc of [-1,1]){\n    const r=new THREE.Group();r.position.set(xr,YR,zc*(LARG/2-.12));\n    const t=new THREE.Mesh(new THREE.CylinderGeometry(.39,.39,.27,22),pneu);t.rotation.x=Math.PI/2;\n    const aro=new THREE.Mesh(new THREE.CylinderGeometry(.23,.23,.28,14),cromo);aro.rotation.x=Math.PI/2;\n    const cubo=new THREE.Mesh(new THREE.CylinderGeometry(.07,.07,.29,8),preto);cubo.rotation.x=Math.PI/2;\n    r.add(t,aro,cubo);g.add(r);\n    const alarg=new THREE.Mesh(new THREE.CylinderGeometry(.5,.5,.14,20,1,true,-Math.PI/2*1.1,Math.PI*1.1),preto);\n    alarg.rotation.set(Math.PI/2,0,Math.PI/2);alarg.position.set(xr,YR,zc*(LARG/2+.02));\n    alarg.material.side=THREE.DoubleSide;g.add(alarg);\n  }\n  /* na caçamba: caixa de 1000 L de calda e as baterias */\n  {const ibc=new THREE.Group();\n   const tanque=new THREE.Mesh(new THREE.BoxGeometry(1.1,.92,1.0),new THREE.MeshStandardMaterial({color:\"#e9eef0\",roughness:.5,transparent:true,opacity:.9}));\n   const agua=new THREE.Mesh(new THREE.BoxGeometry(1.06,.55,.96),new THREE.MeshStandardMaterial({color:\"#9fc2c9\",roughness:.3,transparent:true,opacity:.55}));agua.position.y=-.17;\n   const gaiola=new THREE.LineSegments(new THREE.EdgesGeometry(new THREE.BoxGeometry(1.14,.96,1.04,3,2,3)),new THREE.LineBasicMaterial({color:\"#8b9195\"}));\n   const palete=new THREE.Mesh(new THREE.BoxGeometry(1.14,.12,1.04),preto);palete.position.y=-.52;\n   ibc.add(tanque,agua,gaiola,palete);ibc.position.set(-1.95,1.6,-.25);ibc.userData.carga=\"ibc\";g.add(ibc);\n   for(let k=0;k<2;k++){const bat=new THREE.Mesh(new THREE.BoxGeometry(.4,.28,.3),new THREE.MeshStandardMaterial({color:\"#2a2d31\",roughness:.6}));\n     bat.position.set(-1.25-k*.45,1.15,.55);bat.userData.carga=\"bateria\"+k;g.add(bat)}}\n  g.traverse(o=>{if(o.isMesh){o.castShadow=true;o.receiveShadow=true}});\n  g.position.set(x,y,z);g.rotation.y=giro;mundo.add(g);\n  /* 13/10/2026 (pedido do Eduardo): camionete cabine simples RANZER (sem marca), modelo em .glb.\n     A de cima fica até o modelo chegar (e se ele não carregar). Frente do modelo = +Z, aqui = +X;\n     o modelo vai 12 cm para trás para a bola do engate (x = -2,80) ficar sob o bocal da carretinha da equipe.js. A caixa de 1000 L\n     e as baterias vão para dentro da caçamba nova (assoalho a 0,81 m, entre as caixas de roda). */\n  carregarGlb(\"../../assets/modelos/camionete_ranzer.glb\").then(m=>{\n    const r=m.clone(true);r.rotation.y=Math.PI/2;r.position.x=-.12;\n    r.traverse(o=>{if(o.isMesh){o.castShadow=true;o.receiveShadow=true}});\n    for(const o of [...g.children]){\n      if(o.userData.carga===\"ibc\")o.position.set(-1.92,1.39,0);\n      else if(o.userData.carga===\"bateria0\")o.position.set(-.62,.95,.36);\n      else if(o.userData.carga===\"bateria1\")o.position.set(-1.07,.95,.36);\n      else g.remove(o);\n    }\n    g.add(r);\n    /* 17/10/2026: adesivo das empresas apoiadoras nos dois lados (js/campo/apoiadores.js) */\n    try{window.xgApoiadores&&xgApoiadores.camionete(r)}catch(e){console.warn(\"apoiadores:\",e)}\n  }).catch(e=>console.warn(\"camionete RANZER não carregou, fica a feita no código:\",e));\n  registrar({tipo:\"caixa\",x,z,sx:5.5,sz:2.1,rot:giro,y0:y,y1:y+2.45,nome:\"a camionete\",\n    dica:\"A camionete de apoio fica perto do ponto de decolagem. Deixe a área de pouso livre e longe dela.\"});\n}\n\nfunction palmeiras(lista){\n  const grupo=new THREE.Group();mundo.add(grupo);\n  for(const p of lista)registrar({tipo:\"cil\",x:p.x,z:p.z,r:p.h*.33,y0:alt(p.x,p.z)+p.h*.6,y1:alt(p.x,p.z)+p.h,nome:\"a palmeira\",tronco:.22,\n    dica:\"Palmeira perto da sede: as folhas abrem longe do tronco. Planeje a rota e a subida com folga.\"});\n  carregarGlb(GLB.palmeira).then(m=>{\n    const h0=m.userData.caixa.max.y;\n    instanciar(m,lista.map((p,i)=>matriz(p.x,alt(p.x,p.z)-.05,p.z,i*1.9,p.h/h0,p.h/h0)),grupo,true);\n  }).catch(e=>console.warn(\"palmeira não carregou\",e));\n}\nfunction bombaCombustivel(x,z,giro){\n  const grupo=new THREE.Group();mundo.add(grupo);\n  registrar({tipo:\"caixa\",x,z,sx:1.6,sz:1.2,rot:giro,y0:alt(x,z),y1:alt(x,z)+2.2,nome:\"a bomba de diesel\",dica:\"Bomba de diesel da sede. Fica fora da rota.\"});\n  carregarGlb(GLB.bomba).then(m=>{\n    const c=m.clone();c.traverse(o=>{if(o.isMesh){o.castShadow=true;o.receiveShadow=true}});\n    c.position.set(x,alt(x,z)-m.userData.caixa.min.y,z);c.rotation.y=giro;grupo.add(c);\n  }).catch(e=>console.warn(\"bomba não carregou\",e));\n}\n\n/* capim em tufos na pastagem: perto da base e na volta do talhão */\nlet texTufo=null;\nfunction tufosDeCapim(){\n  if(!texTufo){\n    const c=document.createElement(\"canvas\");c.width=128;c.height=128;const g=c.getContext(\"2d\");\n    let s=17;const r=()=>(s=(s*1664525+1013904223)>>>0)/4294967296;\n    for(let i=0;i<46;i++){\n      const x=10+r()*108,h=50+r()*72,curva=(r()-.5)*30;\n      g.strokeStyle=\"rgba(255,255,255,\"+(.75+r()*.25)+\")\";g.lineWidth=2+r()*2.5;\n      g.beginPath();g.moveTo(x,128);g.quadraticCurveTo(x+curva*.4,128-h*.6,x+curva,128-h);g.stroke();\n    }\n    texTufo=new THREE.CanvasTexture(c);texTufo.encoding=THREE.sRGBEncoding;\n  }\n  const geo=new THREE.PlaneGeometry(.42,.26);geo.translate(0,.13,0);\n  /* quatro faces só da frente (em vez de DoubleSide, que inverte a normal atrás e deixa metade dos tufos preta) */\n  const faces=[0,Math.PI/2,Math.PI,Math.PI*1.5].map(a=>{const q=geo.clone();q.rotateY(a);return q});\n  const cruz=THREE.BufferGeometryUtils?THREE.BufferGeometryUtils.mergeBufferGeometries(faces):geo;\n  /* normal para cima: o tufo recebe a mesma luz do chão e não vira um cartão claro contra o sol */\n  {const nn=cruz.attributes.normal;for(let i=0;i<nn.count;i++)nn.setXYZ(i,0,1,0)}\n  const N=30000,T=TALHAO;\n  const mat=new THREE.MeshStandardMaterial({map:texTufo,alphaTest:.45,roughness:1});\n  const im=new THREE.InstancedMesh(cruz,mat,N);\n  const o=new THREE.Object3D(),cc=new THREE.Color();let s=29;const r=()=>(s=(s*1664525+1013904223)>>>0)/4294967296;\n  let n=0;\n  for(let tent=0;tent<N*3&&n<N;tent++){\n    let x,z;\n    if(r()<.45){const a=r()*6.283,d=Math.sqrt(r())*75;x=BASE.x+Math.cos(a)*d;z=BASE.z+10+Math.sin(a)*d}\n    else{const lado=Math.floor(r()*4),t=r(),fora=1.5+Math.pow(r(),1.6)*35;\n      if(lado===0){x=T.x0+t*T.larg;z=T.z0-fora}else if(lado===1){x=T.x0+t*T.larg;z=T.z0+T.prof+fora}\n      else if(lado===2){x=T.x0-fora;z=T.z0+t*T.prof}else{x=T.x0+T.larg+fora;z=T.z0+t*T.prof}}\n    if(x>T.x0-1&&x<T.x0+T.larg+1&&z>T.z0-1&&z<T.z0+T.prof+1)continue;\n    if(Math.hypot(x-BASE.x,z-BASE.z)<3.2)continue;\n    if(acudes.some(a=>Math.hypot(x-a.x,z-a.z)<a.r+1))continue;\n    const e=.55+r()*.75;\n    o.position.set(x,alt(x,z)-.03,z);o.rotation.set(0,r()*6.28,0);o.scale.set(e,e*(.7+r()*.8),e);o.updateMatrix();\n    im.setMatrixAt(n,o.matrix);cc.setHSL(.21+r()*.06,.38+r()*.18,.075+r()*.06);im.setColorAt(n,cc);n++;\n  }\n  im.count=n;im.receiveShadow=true;mundo.add(im);\n}\n\n/* nuvens */\n(function nuvens(){\n  const c=document.createElement(\"canvas\");c.width=256;c.height=128;const g=c.getContext(\"2d\");\n  let s=5;const r=()=>(s=(s*1664525+1013904223)>>>0)/4294967296;\n  for(let i=0;i<26;i++){const x=40+r()*176,y=50+r()*40,R=18+r()*30;\n    const gr=g.createRadialGradient(x,y,0,x,y,R);gr.addColorStop(0,\"rgba(255,255,255,.55)\");gr.addColorStop(1,\"rgba(255,255,255,0)\");\n    g.fillStyle=gr;g.beginPath();g.arc(x,y,R,0,7);g.fill()}\n  const tex=new THREE.CanvasTexture(c);tex.encoding=THREE.sRGBEncoding;\n  for(let i=0;i<18;i++){\n    const sp=new THREE.Sprite(new THREE.SpriteMaterial({map:tex,fog:false,depthWrite:false,opacity:.75+r()*.25}));\n    const a=r()*6.283,d=900+r()*500;sp.position.set(Math.cos(a)*d,260+r()*220,Math.sin(a)*d-80);\n    const e=260+r()*260;sp.scale.set(e,e*.42,1);cena.add(sp);\n  }\n})();\n\nfunction registrar(c){\n  if(c.tipo===\"cil\"){c.cx=c.x;c.cz=c.z;c.raio=c.r}\n  else if(c.tipo===\"caixa\"){c.cx=c.x;c.cz=c.z;c.raio=Math.hypot(c.sx,c.sz)/2}\n  else{c.cx=(c.a.x+c.b.x)/2;c.cz=(c.a.z+c.b.z)/2;c.raio=c.a.distanceTo(c.b)/2+c.r}\n  colisores.push(c);\n}\nfunction arvores(lista,nome){\n  const grupo=new THREE.Group();mundo.add(grupo);\n  for(const a of lista){const y=alt(a.x,a.z),hTr=a.eucalipto?a.alt*.55:a.alt*.35;\n    registrar({tipo:\"cil\",x:a.x,z:a.z,r:a.palito?Math.max(.15,a.copa*.5):a.copa*.92,y0:a.palito?y:y+hTr*.8,y1:y+a.alt,nome:a.palito?a.nome||\"o tronco seco (palito)\":a.seca?a.nome||\"a árvore seca\":nome,tronco:.3,seca:!!(a.seca||a.palito),\n      dica:(a.seca||a.palito)\n        ?\"Árvore seca, sem folhas, quase não devolve o sinal do radar. O desvio automático só a enxerga com a aeronave abaixo de 15 km/h; acima disso ela não freia nem desvia. Marque a árvore seca como obstáculo no planejamento ou reduza a velocidade perto dela.\"\n        :\"Árvore dentro ou perto do talhão precisa ser marcada como obstáculo no planejamento. Com o desvio de obstáculos ligado, o radar enxerga árvore de longe e para a aeronave.\"})}\n  Promise.all([carregarGlb(GLB.verde),carregarGlb(GLB.outono),carregarGlb(GLB.seca)]).then(([verde,outono,seca])=>{\n    const cx=verde.userData.caixa,h0=cx.max.y,r0=Math.max(cx.max.x-cx.min.x,cx.max.z-cx.min.z)/2;\n    const cs=seca.userData.caixa,hs=cs.max.y,rs=Math.max(cs.max.x-cs.min.x,cs.max.z-cs.min.z)/2;\n    const v=[],o=[],sc=[],arb=[];\n    lista.forEach((a,i)=>{\n      if(a.palito)return;   /* o palito e desenhado a parte (palitos) */\n      if(a.seca){sc.push(matriz(a.x,alt(a.x,a.z)-.1,a.z,i*2.39,a.copa/rs,a.alt/hs));return}\n      if(!a.eucalipto&&a.alt<3.3){arb.push(a);return}   /* 24/10/2026: mato baixo e moita (moitas), nao arvore esticada */\n      const s=a.copa/r0*(a.eucalipto?.8:1),m=matriz(a.x,alt(a.x,a.z)-.1,a.z,i*2.39,s,a.alt/h0);\n      (!a.eucalipto&&i%17===8?o:v).push(m);\n    });\n    instanciar(verde,v,grupo,true);instanciar(outono,o,grupo,true);if(sc.length)instanciar(seca,sc,grupo,true);\n    palitos(lista,grupo);\n    moitas(arb,grupo);\n  }).catch(e=>{console.warn(\"árvores simples\",e);arvoresSimples(lista,grupo)});\n}\n/* \"mato\" (24/10/2026): arbusto baixo (alt menor que 3,3 m). O modelo de arvore esticado so na horizontal virava uma pedra achatada;\n   aqui cada arbusto e uma moita de 3 bolas lisas (copa = raio na base, alt = altura), uma malha instanciada. A cor vem do vertice (mais escura\n   embaixo, com pintas de folha) vezes a cor da instancia (verde variando de um arbusto para outro, alguns secos). */\nfunction moitas(lista,grupo){\n  if(!lista.length)return;\n  const bola=(r,x,y,z)=>{const g=new THREE.IcosahedronGeometry(r,1);g.translate(x,y,z);return g};\n  const g=THREE.BufferGeometryUtils.mergeBufferGeometries([bola(.66,0,.5,0),bola(.52,.5,.4,.2),bola(.5,-.44,.38,-.24)]);\n  const p=g.attributes.position,cor=new Float32Array(p.count*3);\n  for(let i=0;i<p.count;i++){const t=Math.max(0,Math.min(1,p.getY(i)/1.1)),pinta=.88+.24*Math.abs(Math.sin(p.getX(i)*91+p.getY(i)*57+p.getZ(i)*37)),k=(.5+.5*t)*pinta;cor[i*3]=k;cor[i*3+1]=k;cor[i*3+2]=k}\n  g.setAttribute(\"color\",new THREE.BufferAttribute(cor,3));\n  const im=new THREE.InstancedMesh(g,new THREE.MeshStandardMaterial({color:\"#ffffff\",vertexColors:true,roughness:1}),lista.length);\n  const o=new THREE.Object3D(),cc=new THREE.Color();\n  lista.forEach((a,i)=>{\n    o.position.set(a.x,alt(a.x,a.z)-.05,a.z);o.rotation.set(0,i*2.39,0);o.scale.set(Math.max(.5,a.copa),Math.max(.5,a.alt)/1.1,Math.max(.5,a.copa)*(.85+((i*5)%4)/12));o.updateMatrix();im.setMatrixAt(i,o.matrix);\n    if(i%16===3)cc.setHSL(.16+((i*3)%4)/100,.55,.42);else cc.setHSL(.26+((i*7)%7)/100,.5+((i*3)%5)/30,.25+((i*11)%7)/70);\n    im.setColorAt(i,cc);\n  });\n  im.castShadow=true;im.receiveShadow=true;im.frustumCulled=false;grupo.add(im);\n}\n/* \"palito\" (24/10/2026): tronco seco reto, sem galhos nem copa. alt = altura total, copa = espessura (0,25 a 0,6 m).\n   Um cilindro fino que afina para o topo, em uma unica malha instanciada. */\nfunction palitos(lista,grupo){\n  const p=lista.filter(a=>a.palito);if(!p.length)return;\n  const g=new THREE.CylinderGeometry(.045,.15,1,6);g.translate(0,.5,0);\n  const im=new THREE.InstancedMesh(g,new THREE.MeshStandardMaterial({color:\"#ffffff\",roughness:1,flatShading:true}),p.length);\n  const o=new THREE.Object3D(),cc=new THREE.Color();\n  p.forEach((a,i)=>{const e=Math.max(.5,(a.copa||.4)/.3);o.position.set(a.x,alt(a.x,a.z)-.05,a.z);o.rotation.set(0,i*2.39,0);o.scale.set(e,a.alt,e);o.updateMatrix();im.setMatrixAt(i,o.matrix);\n    cc.setHSL(.08+((i*7)%5)/100,.10+((i*3)%4)/50,.27+((i*11)%7)/100);im.setColorAt(i,cc)});\n  im.castShadow=true;im.receiveShadow=true;grupo.add(im);\n}\nfunction arvoresSimples(lista,grupo){\n  palitos(lista,grupo);lista=lista.filter(a=>!a.palito);\n  const n=lista.length;\n  const copa=new THREE.InstancedMesh(new THREE.IcosahedronGeometry(1,1),new THREE.MeshStandardMaterial({color:\"#ffffff\",roughness:1,flatShading:true}),n);\n  const tronco=new THREE.InstancedMesh(new THREE.CylinderGeometry(.16,.26,1,6),new THREE.MeshStandardMaterial({color:\"#4a3a2a\",roughness:1}),n);\n  const o=new THREE.Object3D(),cc=new THREE.Color();\n  lista.forEach((a,i)=>{\n    const y=alt(a.x,a.z),hTr=a.eucalipto?a.alt*.55:a.alt*.35;\n    o.position.set(a.x,y+hTr/2,a.z);o.rotation.set(0,0,0);o.scale.set(a.eucalipto?.8:1,hTr,a.eucalipto?.8:1);o.updateMatrix();tronco.setMatrixAt(i,o.matrix);\n    const hc=a.alt-hTr*.8;\n    o.position.set(a.x,y+hTr*.8+hc/2,a.z);o.rotation.set(i*.7,i*1.3,i*.4);\n    o.scale.set(a.copa,hc/2,a.copa);o.updateMatrix();copa.setMatrixAt(i,o.matrix);\n    if(a.eucalipto)cc.setHSL(.30,.16,.30+((i*37)%10)/100);else cc.setHSL(.25+((i*13)%6)/100,.34,.21+((i*29)%9)/100);\n    copa.setColorAt(i,cc);\n  });\n  copa.castShadow=true;tronco.castShadow=true;grupo.add(copa,tronco);\n}\nfunction poste(x,z,H,ang){\n  const g=new THREE.Group(),y=alt(x,z);\n  const p=new THREE.Mesh(new THREE.CylinderGeometry(.12,.17,H,8),new THREE.MeshStandardMaterial({color:\"#9aa0a3\",roughness:.9}));p.position.y=H/2;\n  const cruzeta=new THREE.Mesh(new THREE.BoxGeometry(2.3,.12,.12),new THREE.MeshStandardMaterial({color:\"#6b5a44\",roughness:1}));\n  cruzeta.position.y=H-.45;cruzeta.rotation.y=ang;\n  g.add(p,cruzeta);g.position.set(x,y,z);g.traverse(o=>{if(o.isMesh)o.castShadow=true});mundo.add(g);\n  registrar({tipo:\"cil\",x,z,r:.35,y0:y,y1:y+H,nome:\"o poste\",dica:\"O radar detecta poste. Sem desvio de obstáculos, marque cada poste no planejamento do campo.\"});\n  return y+H-.45;\n}\nfunction redeEletrica(pontos,H,flecha,tipo){\n  const fioMat=new THREE.MeshStandardMaterial({color:\"#1b1d20\",roughness:.6,metalness:.3});\n  const topo=[];\n  for(let i=0;i<pontos.length;i++){\n    const [x,z]=pontos[i],viz=pontos[Math.min(i+1,pontos.length-1)],ant=pontos[Math.max(i-1,0)];\n    const ang=Math.atan2(viz[1]-ant[1],viz[0]-ant[0]);\n    topo.push({x,z,y:poste(x,z,H,-ang+Math.PI/2),ang});\n  }\n  for(let i=0;i+1<topo.length;i++){\n    const A=topo[i],B=topo[i+1];\n    for(const off of [-1.05,0,1.05]){\n      const px=-Math.sin(A.ang)*off,pz=Math.cos(A.ang)*off;\n      const a=new THREE.Vector3(A.x+px,A.y+.1,A.z+pz),b=new THREE.Vector3(B.x+px,B.y+.1,B.z+pz);\n      const pts=[],N=16;\n      for(let k=0;k<=N;k++){const t=k/N,p=a.clone().lerp(b,t);p.y-=flecha*4*t*(1-t);pts.push(p)}\n      mundo.add(new THREE.Mesh(new THREE.TubeGeometry(new THREE.CatmullRomCurve3(pts),N*2,.028,5,false),fioMat));\n      for(let k=0;k<N;k++)registrar({tipo:\"seg\",a:pts[k],b:pts[k+1],r:.03,fio:true,nome:\"a rede de \"+tipo,\n        dica:\"O manual do T50 avisa: com linhas de energia ou obstáculos pequenos, a detecção pode ser ineficaz. O radar só enxergou o fio de muito perto e a aeronave não parou a tempo. Perto de rede, reduza a velocidade, passe bem acima dela ou marque a rede como obstáculo.\"});\n    }\n  }\n}\nfunction mastro(x,z,H,nome){\n  const y=alt(x,z),g=new THREE.Group();\n  const trelica=new THREE.Mesh(new THREE.CylinderGeometry(.35,.6,H,3,14,true),new THREE.MeshStandardMaterial({color:\"#c7ccd0\",wireframe:true}));\n  trelica.position.y=H/2;\n  const nucleo=new THREE.Mesh(new THREE.CylinderGeometry(.06,.08,H,6),new THREE.MeshStandardMaterial({color:\"#9aa0a3\"}));nucleo.position.y=H/2;\n  const antena=new THREE.Mesh(new THREE.CylinderGeometry(.5,.5,.12,16),new THREE.MeshStandardMaterial({color:\"#e8eaec\"}));\n  antena.position.set(.4,H-1.5,0);antena.rotation.z=Math.PI/2;\n  g.add(trelica,nucleo,antena);g.position.set(x,y,z);g.traverse(o=>{if(o.isMesh)o.castShadow=true});mundo.add(g);\n  registrar({tipo:\"cil\",x,z,r:.7,y0:y,y1:y+H,nome,dica:\"Torre fina dentro da área. Marque como obstáculo no planejamento — sem desvio de obstáculos a rota passa direto por ela.\"});\n}\nfunction predio(x,z,sx,sz,hp,rot,corP,corT,nome){\n  const y=alt(x,z),g=new THREE.Group();\n  const parede=new THREE.Mesh(new THREE.BoxGeometry(sx,hp,sz),new THREE.MeshStandardMaterial({color:corP,roughness:.9}));parede.position.y=hp/2;\n  const forma=new THREE.Shape([new THREE.Vector2(-sz/2-.35,0),new THREE.Vector2(sz/2+.35,0),new THREE.Vector2(0,sz*.32)]);\n  const gt=new THREE.ExtrudeGeometry(forma,{depth:sx+.6,bevelEnabled:false});gt.translate(0,0,-(sx+.6)/2);gt.rotateY(Math.PI/2);\n  const tel=new THREE.Mesh(gt,new THREE.MeshStandardMaterial({color:corT,roughness:.8,flatShading:true}));tel.position.y=hp;\n  g.add(parede,tel);g.position.set(x,y-.2,z);g.rotation.y=rot;\n  g.traverse(o=>{if(o.isMesh){o.castShadow=true;o.receiveShadow=true}});mundo.add(g);\n  registrar({tipo:\"caixa\",x,z,sx:sx+1,sz:sz+1,rot,y0:y,y1:y+hp+sz*.32,nome,dica:\"Construção perto da base: a subida e o retorno passam por cima dela. Confira a Altitude RTH.\"});\n}\nlet bananeiraBase=null;\nfunction bananeiras(lista){\n  const grupo=new THREE.Group();mundo.add(grupo);\n  for(const p of lista)registrar({tipo:\"cil\",x:p.x,z:p.z,r:p.h*.45,y0:alt(p.x,p.z),y1:alt(p.x,p.z)+p.h,nome:\"a bananeira\",tronco:.25,\n    dica:\"Bananal perto da sede: as folhas abrem longe do tronco. Planeje a rota e a subida da base com folga.\"});\n  if(!bananeiraBase)bananeiraBase=new Promise((ok,erro)=>{\n    const pasta=\"assets/web/palmeira/\",tl=new THREE.TextureLoader(),tex=(n,cor)=>{const x=tl.load(pasta+n+\".png\");if(cor)x.encoding=THREE.sRGBEncoding;return x};\n    const mats={\n      Default_Stem1:new THREE.MeshStandardMaterial({map:tex(\"TR13brk\",1),roughness:1}),\n      Default_Stem2:new THREE.MeshStandardMaterial({map:tex(\"TR13brk2\",1),roughness:1}),\n      Default_leaf2:new THREE.MeshStandardMaterial({map:tex(\"TR13lef1\",1),alphaTest:.5,side:THREE.DoubleSide,roughness:.8}),\n      Default_rotten:new THREE.MeshStandardMaterial({map:tex(\"TR13lef2\",1),alphaTest:.5,side:THREE.DoubleSide,roughness:1}),\n    };\n    new THREE.FBXLoader().load(pasta+\"palmeira.fbx\",f=>{\n      f.traverse(o=>{if(o.isMesh){o.material=[].concat(o.material).map(m=>mats[m.name]||m);if(o.material.length===1)o.material=o.material[0];o.castShadow=true}});\n      const b=new THREE.Box3().setFromObject(f);f.userData.altura=b.max.y-b.min.y;f.userData.base=b.min.y;ok(f);\n    },undefined,erro);\n  });\n  bananeiraBase.then(f=>{\n    lista.forEach((p,i)=>{const c=f.clone(),e=p.h/f.userData.altura;\n      c.scale.setScalar(e);c.position.set(p.x,alt(p.x,p.z)-f.userData.base*e,p.z);c.rotation.y=i*2.1;grupo.add(c)});\n  }).catch(e=>console.warn(\"bananeira não carregou\",e));\n}\nfunction silo(x,z){\n  const y=alt(x,z),g=new THREE.Group(),m=new THREE.MeshStandardMaterial({color:\"#c9ced3\",roughness:.35,metalness:.6});\n  const corpo=new THREE.Mesh(new THREE.CylinderGeometry(3.4,3.4,13,24),m);corpo.position.y=6.5;\n  const teto=new THREE.Mesh(new THREE.ConeGeometry(3.6,2.4,24),m);teto.position.y=14.2;\n  g.add(corpo,teto);g.position.set(x,y,z);g.traverse(o=>{if(o.isMesh)o.castShadow=true});mundo.add(g);\n  registrar({tipo:\"cil\",x,z,r:3.6,y0:y,y1:y+15.4,nome:\"o silo\",dica:\"No alto da encosta o topo do silo fica na altura da rota. Com relevo forte, use o terreno Montanhas e pomares.\"});\n}\nfunction acude(x,z,r){\n  acudes.push({x,z,r});\n  const agua=new THREE.Mesh(new THREE.CircleGeometry(r,48),new THREE.MeshStandardMaterial({color:\"#3f6b78\",roughness:.12,metalness:.15,transparent:true,opacity:.9}));\n  agua.rotation.x=-Math.PI/2;agua.position.set(x,alt(x,z)+2.6,z);mundo.add(agua);\n}\n/* ===================================================================\n   OPERADOR — trabalhadores em Collada (esqueleto do manequim Unreal)\n   =================================================================== */\nconst TRABALHADORES=[\n  {id:\"tall_european_worker\",nome:\"Chapéu\",olho:\"brownlight_eye\",pele:\"middleage_lightskinned_male_diffuse\"},\n  {id:\"norm_european_worker\",nome:\"Cabelo curto\",olho:\"blue_eye\",pele:\"middleage_lightskinned_male_diffuse\"},\n  {id:\"asian_worker\",nome:\"Grisalho\",olho:\"green_eye\",pele:\"old_lightskinned_male_diffuse2\"},\n  {id:\"african_worker\",nome:\"Careca\",olho:\"brown_eye\",pele:\"old_darkskinned_male_diffuse\"},\n  {id:\"fat_european_worker\",nome:\"Robusto\",olho:\"grey_eye\",pele:\"old_lightskinned_male_diffuse\"},\n];\nlet avatarEscolhido=TRABALHADORES[0].id;\ntry{const s=localStorage.getItem(\"t50_avatar\");if(TRABALHADORES.some(a=>a.id===s))avatarEscolhido=s}catch(e){}\nconst grupoOperador=new THREE.Group();cena.add(grupoOperador);\nconst cacheAvatar={};\n\nfunction carregarTrabalhador(def){\n  if(cacheAvatar[def.id])return cacheAvatar[def.id];\n  const pasta=\"assets/web/trabalhadores/\"+def.id+\"/\";\n  return cacheAvatar[def.id]=new Promise((ok,erro)=>new THREE.ColladaLoader().load(pasta+\"modelo.dae\",col=>{\n    const av=col.scene,tl=new THREE.TextureLoader(),B={};\n    const tex=n=>{const t=tl.load(pasta+\"textures/\"+n+\".png\");t.encoding=THREE.sRGBEncoding;return t};\n    av.traverse(o=>{\n      if(o.isBone)B[o.name]=o;\n      if(!o.isSkinnedMesh)return;\n      const k=o.name.replace(/^.*?-/,\"\");\n      if(/teeth|tongue/.test(k)){o.visible=false;return}\n      const arq=k===\"base\"?def.pele:k===\"low_poly\"?def.olho:k===\"fedora_cocked\"?\"fedora_texture\":k+\"_diffuse\";\n      o.material=new THREE.MeshStandardMaterial({map:tex(arq),roughness:k===\"low_poly\"?.3:.85,\n        transparent:/^short/.test(k),alphaTest:/^short/.test(k)?.4:0,side:/^short/.test(k)?THREE.DoubleSide:THREE.FrontSide});\n      o.castShadow=true;o.frustumCulled=false;\n    });\n    /* pose: braços dobrados à frente, segurando o controle (personagem olha para +z) */\n    const apontar=(osso,filho,dir)=>{\n      av.updateMatrixWorld(true);\n      const a=new THREE.Vector3().setFromMatrixPosition(B[osso].matrixWorld),b=new THREE.Vector3().setFromMatrixPosition(B[filho].matrixWorld);\n      const dq=new THREE.Quaternion().setFromUnitVectors(b.sub(a).normalize(),new THREE.Vector3(...dir).normalize());\n      const wq=B[osso].getWorldQuaternion(new THREE.Quaternion()),pq=B[osso].parent.getWorldQuaternion(new THREE.Quaternion());\n      B[osso].quaternion.copy(pq.invert().multiply(dq.multiply(wq)));\n    };\n    apontar(\"upperarm_r\",\"lowerarm_r\",[-.14,-.93,.28]);apontar(\"lowerarm_r\",\"hand_r\",[.4,.12,.9]);\n    apontar(\"upperarm_l\",\"lowerarm_l\",[.14,-.93,.28]);apontar(\"lowerarm_l\",\"hand_l\",[-.4,.12,.9]);\n    apontar(\"neck_01\",\"head\",[0,.9,.3]);\n    av.updateMatrixWorld(true);\n    const escala=1.78/2.52;\n    const mao=n=>new THREE.Vector3().setFromMatrixPosition(B[n].matrixWorld);\n    const meio=mao(\"hand_r\").add(mao(\"hand_l\")).multiplyScalar(.5);\n    const g=new THREE.Group();g.add(av);\n    g.userData.B=B;g.userData.av=av;g.userData.avY=av.position.y;g.userData.repouso={};\n    for(const n of [\"thigh_l\",\"calf_l\",\"foot_l\",\"thigh_r\",\"calf_r\",\"foot_r\"])g.userData.repouso[n]=B[n].quaternion.clone();\n    /* controle DJI RC Plus: corpo, tela e antenas, entre as mãos */\n    const rc=new THREE.Group(),m=c=>new THREE.MeshStandardMaterial({color:c,roughness:.6});\n    const corpo=new THREE.Mesh(new THREE.BoxGeometry(.27/escala,.15/escala,.04/escala),m(\"#1b1f23\"));\n    const tela=new THREE.Mesh(new THREE.PlaneGeometry(.2/escala,.12/escala),new THREE.MeshStandardMaterial({color:\"#9fc6ee\",emissive:\"#2f6fb0\",emissiveIntensity:.7}));\n    tela.position.z=.024/escala;tela.rotation.y=Math.PI;tela.position.z=-.024/escala;\n    for(const x of [-.11,.11]){const an=new THREE.Mesh(new THREE.BoxGeometry(.03/escala,.1/escala,.01/escala),m(\"#2a2e33\"));an.position.set(x/escala,.12/escala,.01/escala);rc.add(an)}\n    rc.add(corpo,tela);rc.position.copy(meio).add(new THREE.Vector3(0,.05/escala,.02/escala));rc.rotation.x=-.75;\n    rc.traverse(o=>{if(o.isMesh)o.castShadow=true});\n    g.add(rc);g.scale.setScalar(escala);\n    ok(g);\n  },undefined,erro));\n}\nfunction operador(){\n  const ox=BASE.x-5,oz=BASE.z+5; /* fora do raio de bloqueio de 6 m */\n  grupoOperador.position.set(ox,alt(ox,oz),oz);grupoOperador.rotation.y=Math.PI*.85+Math.PI;\n  const anel=new THREE.Mesh(new THREE.RingGeometry(2.4,2.6,48),new THREE.MeshBasicMaterial({color:\"#ffffff\",transparent:true,opacity:.8}));\n  anel.rotation.x=-Math.PI/2;anel.position.set(BASE.x,alt(BASE.x,BASE.z)+.06,BASE.z);mundo.add(anel);\n  trocarAvatar(avatarEscolhido);\n}\nfunction trocarAvatar(id){\n  avatarEscolhido=id;try{localStorage.setItem(\"t50_avatar\",id)}catch(e){}\n  const def=TRABALHADORES.find(a=>a.id===id);\n  carregarTrabalhador(def).then(g=>{if(avatarEscolhido!==id)return;grupoOperador.clear();grupoOperador.add(g)})\n    .catch(e=>console.warn(\"avatar não carregou\",e));\n}\n\nconst tmpA=new THREE.Vector3(),tmpB=new THREE.Vector3();\nfunction distColisor(c,p){\n  if(c.tipo===\"cil\"){\n    const dh=Math.max(0,Math.hypot(p.x-c.x,p.z-c.z)-c.r);\n    const dy=p.y<c.y0?c.y0-p.y:(p.y>c.y1?p.y-c.y1:0);return Math.hypot(dh,dy);\n  }\n  if(c.tipo===\"caixa\"){\n    const cs=Math.cos(-c.rot),sn=Math.sin(-c.rot),lx=(p.x-c.x)*cs-(p.z-c.z)*sn,lz=(p.x-c.x)*sn+(p.z-c.z)*cs;\n    const dx=Math.max(0,Math.abs(lx)-c.sx/2),dz=Math.max(0,Math.abs(lz)-c.sz/2);\n    const dy=p.y<c.y0?c.y0-p.y:(p.y>c.y1?p.y-c.y1:0);return Math.hypot(dx,dy,dz);\n  }\n  tmpA.subVectors(c.b,c.a);tmpB.subVectors(p,c.a);\n  const t=trava(tmpB.dot(tmpA)/tmpA.lengthSq(),0,1);\n  tmpA.multiplyScalar(t).add(c.a);return tmpA.distanceTo(p)-c.r;\n}\nconst topoColisor=c=>c.tipo===\"seg\"?Math.max(c.a.y,c.b.y):c.y1;\n\n/* ===================================================================\n   AGRAS T50 — modelo OBJ\n   =================================================================== */\nconst drone=new THREE.Group(),inclina=new THREE.Group(),helices=[];\ndrone.add(inclina);\nconst ESCALA=3.085/2030;   /* comprimento real com hélices abertas / comprimento no arquivo */\n/* 18/11/2026 (Eduardo: \"confere o tamanho nos outros modelos\", \"Sim, acerta os dois\"): com a escala acima a ESTRUTURA do T50\n   ficava 12 a 15% maior que a real (2,52 m entre motores na diagonal e 0,92 m de altura; a ficha da DJI dá 2,20 m e 0,82 m),\n   enquanto as hélices já estavam no tamanho certo (1,37 m). A estrutura entra em 2,20/2,52 e cada hélice volta ao tamanho\n   dela em volta do próprio eixo. */\nconst ESCALA_T50=2.20/2.52;\n\nfunction corDaPeca(nome){\n  if(/Propeller_P1$/.test(nome))return null;               /* pás: tratadas à parte */\n  if(/Propeller/.test(nome))return \"#23262a\";              /* braços e motores */\n  if(/WaterTank_P1$/.test(nome))return \"#2b2f33\";          /* tampa */\n  if(/WaterTank/.test(nome))return \"#dfe4e7\";              /* tanque */\n  if(/Battery/.test(nome))return \"#16181b\";\n  if(/Foot/.test(nome))return \"#5f666c\";\n  if(/Front_P8$/.test(nome))return \"#101214\";              /* radar/FPV dianteiro */\n  return \"#3a3f45\";                                        /* carenagem */\n}\n\nnew THREE.OBJLoader().load(\"dat50/t50.obj\",obj=>{\n  const modelo=new THREE.Group();\n  const mats={};\n  const mat=cor=>mats[cor]||(mats[cor]=new THREE.MeshStandardMaterial({color:cor,roughness:.55,metalness:.12}));\n  const pas=new THREE.MeshStandardMaterial({color:\"#141619\",roughness:.45,metalness:.1});\n  const filhos=[...obj.children];\n  for(const m of filhos){\n    if(!m.isMesh)continue;\n    const cor=corDaPeca(m.name);\n    if(cor){m.material=mat(cor);m.castShadow=true;m.receiveShadow=true;modelo.add(m);continue}\n    separarPas(m.geometry,pas,modelo);\n  }\n  const cx=new THREE.Box3().setFromObject(modelo),c=cx.getCenter(new THREE.Vector3());\n  const E50=ESCALA*ESCALA_T50;\n  modelo.scale.setScalar(E50);\n  modelo.position.set(-c.x*E50,-cx.min.y*E50,-c.z*E50);\n  helices.forEach(h=>h.scale.setScalar(1/ESCALA_T50));\n  inclina.add(modelo);\n  cena.add(drone);\n  criarNevoa();\n  $(\"carregando\").remove();\n  construirCenario(cen);reiniciarVoo();abrirInicio();\n},undefined,erro=>{$(\"carregando\").textContent=\"Não foi possível carregar o modelo do T50: \"+erro});\n\n/* As pás de cada lado vêm num objeto só: 4 pás (2 rotores × coaxial).\n   Separa por lado (x) e por nível (y) e gira cada rotor no próprio cubo. */\nfunction separarPas(geo,material,destino){\n  const pos=geo.attributes.position,nor=geo.attributes.normal;\n  geo.computeBoundingBox();const yMeio=(geo.boundingBox.min.y+geo.boundingBox.max.y)/2;\n  const grupos={};\n  for(let i=0;i<pos.count;i+=3){\n    let cx=0,cy=0;for(let k=0;k<3;k++){cx+=pos.getX(i+k);cy+=pos.getY(i+k)}\n    const chave=(cx>0?\"d\":\"e\")+(cy/3>yMeio?\"c\":\"b\");\n    (grupos[chave]||(grupos[chave]={p:[],n:[]}));\n    for(let k=0;k<3;k++){\n      grupos[chave].p.push(pos.getX(i+k),pos.getY(i+k),pos.getZ(i+k));\n      if(nor)grupos[chave].n.push(nor.getX(i+k),nor.getY(i+k),nor.getZ(i+k));\n    }\n  }\n  for(const chave in grupos){\n    const g=new THREE.BufferGeometry();\n    g.setAttribute(\"position\",new THREE.Float32BufferAttribute(grupos[chave].p,3));\n    if(grupos[chave].n.length)g.setAttribute(\"normal\",new THREE.Float32BufferAttribute(grupos[chave].n,3));else g.computeVertexNormals();\n    g.computeBoundingBox();const c=g.boundingBox.getCenter(new THREE.Vector3());\n    g.translate(-c.x,-c.y,-c.z);\n    const m=new THREE.Mesh(g,material);m.castShadow=true;\n    const cubo=new THREE.Group();cubo.position.copy(c);cubo.add(m);\n    cubo.userData.sentido=(chave[0]===\"d\"?1:-1)*(chave[1]===\"c\"?1:-1);\n    destino.add(cubo);helices.push(cubo);\n  }\n}\n\n/* ===================================================================\n   CALDA\n   =================================================================== */\nconst NP=1000;let nevoa,nPos;const pv=[];\nfunction criarNevoa(){\n  const g=new THREE.BufferGeometry();nPos=new Float32Array(NP*3);\n  g.setAttribute(\"position\",new THREE.BufferAttribute(nPos,3));\n  const c=document.createElement(\"canvas\");c.width=c.height=64;const x=c.getContext(\"2d\");\n  const gr=x.createRadialGradient(32,32,0,32,32,32);gr.addColorStop(0,\"#fff\");gr.addColorStop(1,\"rgba(255,255,255,0)\");\n  x.fillStyle=gr;x.fillRect(0,0,64,64);\n  nevoa=new THREE.Points(g,new THREE.PointsMaterial({size:.45,map:new THREE.CanvasTexture(c),transparent:true,opacity:.17,depthWrite:false,color:\"#dcecf5\"}));\n  nevoa.frustumCulled=false;cena.add(nevoa);\n  for(let i=0;i<NP;i++)pv.push({x:0,y:-999,z:0,vx:0,vy:0,vz:0,vida:0});\n}\nlet proxP=0;\nfunction emitir(dt,ligado){\n  if(!nevoa)return;\n  if(ligado){\n    const n=Math.round(dt*900),d=drone.position,fx=Math.cos(V.yaw),fz=-Math.sin(V.yaw);\n    for(let k=0;k<n;k++){\n      const p=pv[proxP];proxP=(proxP+1)%NP;const lado=(Math.random()-.5)*larguraEfetiva()*.55;\n      p.x=d.x+fz*lado*.35;p.z=d.z-fx*lado*.35;p.y=d.y+.35;\n      p.vx=fz*lado*1.4+(Math.random()-.5)*.4;p.vz=-fx*lado*1.4+(Math.random()-.5)*.4;\n      p.vy=-2.3-Math.random()*1.2;p.vida=1.2+Math.random()*.5;\n    }\n  }\n  for(let i=0;i<NP;i++){\n    const p=pv[i];\n    if(p.vida>0){p.vida-=dt;p.x+=p.vx*dt;p.y+=p.vy*dt;p.z+=p.vz*dt;p.vx*=.96;p.vz*=.96;if(p.y<alt(p.x,p.z))p.vida=0}\n    nPos[i*3]=p.x;nPos[i*3+1]=p.vida>0?p.y:-999;nPos[i*3+2]=p.z;\n  }\n  nevoa.geometry.attributes.position.needsUpdate=true;\n}\n\n/* ===================================================================\n   OPERAÇÃO\n   =================================================================== */\nconst P={altura:3,vel:7,faixa:7.5,gota:300,vazao:15,rth:20,modo:\"facil\",terreno:\"planicie\",desvio:true,estab:true};\nlet rota=[];\nconst V={mult:1};\n\n/* ===================================================================\n   MAPA DO CAMPO E ROTA\n   =================================================================== */\nconst MARGEM_BORDA=2.5,MARGEM_OBS=3;\nconst MAPAS={};\nconst chaveMapa=id=>\"t50_mapa_\"+id;\nfunction mapaAtual(){\n  if(!(cen.id in MAPAS)){\n    let m=null;try{m=JSON.parse(localStorage.getItem(chaveMapa(cen.id)))}catch(e){}\n    MAPAS[cen.id]=m&&Array.isArray(m.limite)&&m.limite.length>=3?m:null;\n  }\n  return MAPAS[cen.id];\n}\nfunction salvarMapa(m){\n  MAPAS[cen.id]=m;\n  try{if(m)localStorage.setItem(chaveMapa(cen.id),JSON.stringify(m));else localStorage.removeItem(chaveMapa(cen.id))}catch(e){}\n}\nfunction mapaPronto(){\n  const T=TALHAO;\n  return {pronto:true,limite:[[T.x0,T.z0],[T.x0+T.larg,T.z0],[T.x0+T.larg,T.z0+T.prof],[T.x0,T.z0+T.prof]],obstaculos:[]};\n}\nconst areaPoligono=pts=>{let s=0;for(let i=0;i<pts.length;i++){const a=pts[i],b=pts[(i+1)%pts.length];s+=a[0]*b[1]-b[0]*a[1]}return Math.abs(s)/2};\nconst perimetro=(pts,fechado)=>{let s=0;for(let i=0;i+(fechado?0:1)<pts.length;i++){const a=pts[i],b=pts[(i+1)%pts.length];s+=Math.hypot(b[0]-a[0],b[1]-a[1])}return s};\nfunction envoltoria(pts){\n  const p=pts.map(q=>[q[0],q[1]]).sort((a,b)=>a[0]-b[0]||a[1]-b[1]);if(p.length<3)return p;\n  const cr=(o,a,b)=>(a[0]-o[0])*(b[1]-o[1])-(a[1]-o[1])*(b[0]-o[0]),lo=[],hi=[];\n  for(const q of p){while(lo.length>=2&&cr(lo[lo.length-2],lo[lo.length-1],q)<=0)lo.pop();lo.push(q)}\n  for(const q of p.slice().reverse()){while(hi.length>=2&&cr(hi[hi.length-2],hi[hi.length-1],q)<=0)hi.pop();hi.push(q)}\n  return lo.slice(0,-1).concat(hi.slice(0,-1));\n}\nconst areaComSinal=z=>{let s=0;for(let i=0;i<z.length;i++){const a=z[i],b=z[(i+1)%z.length];s+=a[0]*b[1]-b[0]*a[1]}return s/2};\n/* zona proibida de um obstáculo marcado: polígono convexo já com a margem */\nfunction zonaObstaculo(o){\n  if(o.tipo===\"circulo\"){const R=(o.r+MARGEM_OBS)/Math.cos(Math.PI/16),z=[];\n    for(let k=0;k<16;k++){const a=k/16*2*Math.PI;z.push([o.c[0]+Math.cos(a)*R,o.c[1]+Math.sin(a)*R])}return z}\n  const h=envoltoria(o.pts),n=h.length;if(n<3)return [];\n  const sg=areaComSinal(h)>0?1:-1;\n  /* normal para fora da aresta a→b */\n  const nor=(a,b)=>{const dx=b[0]-a[0],dz=b[1]-a[1],l=Math.hypot(dx,dz)||1;return [dz/l*sg,-dx/l*sg]};\n  return h.map((v,i)=>{\n    const n1=nor(h[(i-1+n)%n],v),n2=nor(v,h[(i+1)%n]);\n    let bx=n1[0]+n2[0],bz=n1[1]+n2[1];const l=Math.hypot(bx,bz)||1;bx/=l;bz/=l;\n    const k=Math.min(3,1/Math.max(.2,bx*n1[0]+bz*n1[1]))*MARGEM_OBS;\n    return [v[0]+bx*k,v[1]+bz*k];\n  });\n}\nfunction cortesEmX(pts,X){\n  const zs=[];\n  for(let i=0;i<pts.length;i++){const a=pts[i],b=pts[(i+1)%pts.length];\n    if((a[0]<=X&&b[0]>X)||(b[0]<=X&&a[0]>X))zs.push(a[1]+(X-a[0])*(b[1]-a[1])/(b[0]-a[0]))}\n  return zs.sort((a,b)=>a-b);\n}\n/* trecho a→b atravessa a zona convexa? devolve entrada/saída e as arestas */\nfunction cruzaZona(z,a,b){\n  const n=z.length,sg=areaComSinal(z)>0?1:-1,dx=b[0]-a[0],dz=b[1]-a[1];\n  let t0=0,t1=1,e0=-1,e1=-1;\n  for(let i=0;i<n;i++){\n    const p=z[i],q=z[(i+1)%n],nx=(q[1]-p[1])*sg,nz=-(q[0]-p[0])*sg;\n    const num=nx*(a[0]-p[0])+nz*(a[1]-p[1]),den=nx*dx+nz*dz;\n    if(Math.abs(den)<1e-9){if(num>-1e-6)return null;continue}\n    const t=-num/den;\n    /* ponta em cima da borda da zona (fim de faixa cortada) conta como entrada/saída */\n    if(den<0){if(t>t0||(e0<0&&t>=t0-1e-6)){t0=Math.max(t,0);e0=i}}else{if(t<t1||(e1<0&&t<=t1+1e-6)){t1=Math.min(t,1);e1=i}}\n    if(t0>t1)return null;\n  }\n  if((t1-t0)*Math.hypot(dx,dz)<.6||e0<0||e1<0)return null;\n  return {t0,t1,e0,e1};\n}\n/* caminho de a até b contornando as zonas; se o contorno sair do campo ou ficar longo demais,\n   passa por cima na altitude RTH (roteamento de conexão) */\nfunction contornar(a,b,zonas,limite,prof){\n  let melhor=null;\n  zonas.forEach(z=>{const c=cruzaZona(z,a,b);if(c&&(!melhor||c.t0<melhor.c.t0))melhor={z,c}});\n  if(!melhor)return [];\n  if(prof>6)return [{p:b.slice(),aplica:false,alto:true}];\n  const {z,c}=melhor,n=z.length,frente=[],tras=[];\n  for(let i=(c.e0+1)%n,k=0;k<n;i=(i+1)%n,k++){frente.push(z[i]);if(i===c.e1)break}\n  for(let i=c.e0,k=0;k<n;i=(i-1+n)%n,k++){if(i===c.e1)break;tras.push(z[i])}\n  const E=[a[0]+(b[0]-a[0])*c.t0,a[1]+(b[1]-a[1])*c.t0],X=[a[0]+(b[0]-a[0])*c.t1,a[1]+(b[1]-a[1])*c.t1];\n  const comp=l=>{let s=0,p=E;for(const q of l.concat([X])){s+=Math.hypot(q[0]-p[0],q[1]-p[1]);p=q}return s};\n  const cam=frente.length&&(comp(frente)<=comp(tras)||!tras.length)?frente:tras;\n  if(!cam.length)return [{p:b.slice(),aplica:false,alto:true}];\n  const xs=limite.map(p=>p[0]),zs=limite.map(p=>p[1]);\n  const fora=cam.some(q=>q[0]<Math.min(...xs)-12||q[0]>Math.max(...xs)+12||q[1]<Math.min(...zs)-12||q[1]>Math.max(...zs)+12);\n  if(fora||comp(cam)>Math.hypot(X[0]-E[0],X[1]-E[1])*3+40)return [{p:b.slice(),aplica:false,alto:true}];\n  return cam.map(q=>({p:q,aplica:false})).concat(contornar(cam[cam.length-1],b,zonas,limite,prof+1));\n}\nfunction gerarRota(){\n  rota=[];const M=mapaAtual();if(!M)return;\n  const lim=M.limite,zonas=M.obstaculos.map(zonaObstaculo).filter(z=>z.length>=3);\n  const xs=lim.map(p=>p[0]),minX=Math.min(...xs),maxX=Math.max(...xs);\n  let dir=1;\n  const empurra=(ini,fim)=>{\n    if(rota.length){\n      const ult=rota[rota.length-1].p;\n      for(const w of contornar(ult,ini,zonas,lim,0))rota.push(w);\n      const u=rota[rota.length-1].p;\n      if(Math.hypot(u[0]-ini[0],u[1]-ini[1])>.1)rota.push({p:ini,aplica:false});\n    } else rota.push({p:ini,aplica:false});\n    rota.push({p:fim,aplica:true});\n  };\n  for(let X=minX+MARGEM_BORDA+P.faixa/2;X<=maxX-MARGEM_BORDA+1e-6;X+=P.faixa){\n    const zs=cortesEmX(lim,X);let trechos=[];\n    for(let k=0;k+1<zs.length;k+=2){const a=zs[k]+MARGEM_BORDA,b=zs[k+1]-MARGEM_BORDA;if(b-a>1)trechos.push([a,b])}\n    for(const z of zonas){\n      const c=cortesEmX(z,X);if(c.length<2)continue;const za=c[0],zb=c[c.length-1];\n      trechos=trechos.flatMap(([a,b])=>{if(zb<=a||za>=b)return [[a,b]];const r=[];if(za-a>1)r.push([a,za]);if(b-zb>1)r.push([zb,b]);return r});\n    }\n    trechos.sort((p,q)=>p[0]-q[0]);\n    if(!trechos.length)continue;\n    if(dir>0)trechos.slice().reverse().forEach(([a,b])=>empurra([X,b],[X,a]));\n    else trechos.forEach(([a,b])=>empurra([X,a],[X,b]));\n    dir=-dir;\n  }\n}\n/* largura efetiva de pulverização. Manual do T50: 4 a 11 m a 3 m acima da cultura.\n   Aqui a gota define onde fica nessa faixa (gota fina cai no downwash, gota grossa é lançada mais longe\n   pelos aspersores centrífugos) e a altura abre ou fecha o leque. */\nfunction larguraEfetiva(){\n  const E=efetivo(),a3=4+(trava(P.gota,50,500)-50)/450*7;\n  return a3*trava(.45+.55*E.altura/3,.6,1.15);\n}\nfunction situacaoFaixa(){\n  const L=larguraEfetiva(),s=P.faixa,dif=L-s;\n  return {L,s,fecha:dif>=-.05,sobre:Math.max(0,dif),falha:Math.max(0,-dif),pctSobre:Math.max(0,dif)/s*100};\n}\n/* parâmetros efetivos: o desvio de obstáculos limita velocidade e altura */\nfunction efetivo(){\n  let vel=P.vel,altura=P.altura;\n  if(P.desvio){vel=Math.min(vel,T50.velMaxDesvio);altura=trava(altura,T50.altMinDesvio,T50.altMaxDesvio)}\n  else altura=Math.min(altura,15);   /* T50 sem o desvio multidirecional: ate 15 m */\n  return {vel,altura};\n}\nfunction reiniciarVoo(){\n  Object.assign(V,{estado:\"em solo\",i:0,bat:100,tan:T50.tanque,aplicado:0,calda:0,tempo:0,recargas:0,\n    v:0,vy:0,yaw:Math.PI/2,dirx:0,dirz:-1,ultimoObs:null,retomar:null,espera:0,extra:0,obsExtra:null,desvioLat:null,\n    antesPairar:null,obs:null,sondaT:0,sonda:null,freando:false,avisoBat:false,\n    vqx:0,vqz:0,noChao:false,desce:false,aguardaSubida:false,recuo:null,fase:null,extraPend:0,rodando:false,aplicando:false,vazaoAtual:0,referencia:0,motivo:null,\n    /* simulador (manual.js/app_rcplus.js): ajuste do acelerador, trechos pulados na\n       retomada pelos pontos 1/2, freio da pausa e o ponto de retorno escolhido */\n    xgAjuste:0,pulos:[],xgFreio:false,xgVolta:null,xgSobre:null});\n  limparCobertura();\n  gerarRota();\n  drone.position.set(BASE.x,alt(BASE.x,BASE.z),BASE.z);\n  drone.rotation.set(0,0,0);\n  V.referencia=alt(BASE.x,BASE.z);\n  fecharAlerta();for(const id of [\"queda\",\"fim\"])$(id).hidden=true;\n  for(const p of pv)p.vida=0;\n  $(\"bPausa\").textContent=\"Pausar\";\n}\n\n/* altura desejada. Montanhas olha mais à frente e sobe mais rápido que Planícies. */\nfunction alturaAlvo(agl){\n  const d=drone.position;\n  if(!P.estab)return V.referencia+agl+V.extra;\n  const fx=V.dirx,fz=V.dirz;\n  /* antecipa o terreno pelo tempo de reação: Montanhas olha mais à frente que Planícies */\n  const olhar=Math.max(1.5,V.v*(P.terreno===\"montanha\"?1.1:.5));\n  const chao=Math.max(alt(d.x,d.z),alt(d.x+fx*olhar,d.z+fz*olhar));\n  return chao+agl+V.extra;\n}\n\n/* radar: primeiro obstáculo na direção do voo (fio só de muito perto).\n   17/11/2026 (Eduardo: \"o drone desvia e não segue a linha gerada no controle, faz outra aleatória\"): seguindo a rota do DJI, o\n   radar olha AO LONGO da linha planejada (xgLinhaDoRadar = os próximos pontos dela, posta pelo passo) e não reto para além do\n   ponto em que a linha faz a curva. Antes, no fim de cada passada e no contorno de obstáculo marcado no controle, ele enxergava\n   o obstáculo que a linha já contornava, travava e inventava outro desvio. Sem linha (ida, volta, desvio em curso, voo manual,\n   telas do radar, XAG) olha reto, como sempre. É variável e não parâmetro porque o manual.js embrulha sondar(fx,fz). */\nlet xgLinhaDoRadar=null;\nfunction sondar(fx,fz){\n  const d=drone.position;\n  const perto=colisores.filter(c=>Math.hypot(c.cx-d.x,c.cz-d.z)<c.raio+T50.radarAlcance+4);\n  const q=new THREE.Vector3();\n  const linha=xgLinhaDoRadar&&xgLinhaDoRadar.length?xgLinhaDoRadar:null;\n  let ox=d.x,oz=d.z,ux=fx,uz=fz,antes=0,resto=linha?Math.hypot(linha[0][0]-d.x,linha[0][1]-d.z):Infinity,prox=1;\n  /* o radar do T50 tem campo de visão vertical de ±45°: perto, varre também acima e abaixo */\n  for(let k=1.5;k<=T50.radarAlcance;k+=1.5){\n    /* passa para os trechos seguintes da linha até o ponto que fica a k metros por ela */\n    while(linha&&k-antes>resto){\n      if(prox>=linha.length)return null;          /* a linha acaba antes: não há voo além dela */\n      const a=linha[prox-1],b=linha[prox],l=Math.hypot(b[0]-a[0],b[1]-a[1]);\n      antes+=resto;ox=a[0];oz=a[1];resto=l;prox++;\n      if(l>1e-6){ux=(b[0]-a[0])/l;uz=(b[1]-a[1])/l}\n    }\n    q.set(ox+ux*(k-antes),d.y+.3,oz+uz*(k-antes));\n    /* com a estabilização ligada o relevo é acompanhado, não é obstáculo */\n    if(!P.estab&&alt(q.x,q.z)+.9>q.y)return {d:k,c:{nome:\"o relevo\",tipo:\"relevo\",topo:alt(q.x,q.z)+2,cx:q.x,cz:q.z,raio:6,\n      dica:\"Com a Estabilização da altitude desligada, a altura é contada a partir da decolagem. O terreno subiu e a aeronave não.\"}};\n    const faixaV=k<=8?[0,-1.2,1.2]:[0];\n    for(const oy of faixaV){\n      q.y=d.y+.3+oy;\n      for(const c of perto){\n        if(V.desvioLat&&V.estado===\"aplicando\"&&c===V.desvioLat.obs)continue;     /* já está contornando este */\n        if(c.fio&&k>T50.alcanceFio)continue;\n        if(c.seca&&velHorizontal()>T50.velArvoreSeca)continue;   /* árvore seca: acima de 15 km/h o radar não a vê */\n        if(distColisor(c,q)<1.6)return {d:k,c};\n      }\n    }\n  }\n  return null;\n}\n\nfunction mostrarAlerta(titulo,texto,botoes,vermelho){\n  $(\"alTit\").textContent=titulo;$(\"alTxt\").textContent=texto;\n  $(\"alerta\").classList.toggle(\"vermelho\",!!vermelho);\n  $(\"alBts\").innerHTML=\"\";\n  (botoes||[]).forEach((b,i)=>{const el=document.createElement(\"button\");el.textContent=b.txt;if(i===0)el.className=\"pri\";\n    el.onclick=()=>{fecharAlerta();b.fn()};$(\"alBts\").appendChild(el)});\n  $(\"alBts\").hidden=!(botoes&&botoes.length);\n  $(\"alerta\").hidden=false;\n}\nfunction fecharAlerta(){$(\"alerta\").hidden=true}\n\nfunction iniciarRetorno(retomar){\n  V.retomar=retomar;V.estado=\"voltando\";V.extra=0;V.desce=false;V.obsExtra=null;V.desvioLat=null;V.xgSobre=null;\n  V.freando=false;V.sonda=null;V.aguardaSubida=false;V.recuo=null;V.fase=null;fecharAlerta();\n}\nconst pontoAtual=()=>({p:[drone.position.x,drone.position.z],i:V.i});\n\nfunction pairar(motivo,texto,botoes,vermelho){\n  if(V.estado!==\"pairando\")V.antesPairar=V.estado;\n  if(motivo!==\"Obstáculo detectado\")V.obs=null;\n  V.estado=\"pairando\";V.aplicando=false;\n  mostrarAlerta(motivo,texto,botoes,vermelho);\n}\n\n/* virada entre passadas (18/11/2026): velocidade no ponto da curva e freio com que ela chega lá.\n   Depois de ver no site (Eduardo, 18/11/2026: \"o drone precisa fazer as voltas mais suavemente e não dá pra notar muito visualmente a redução e\n   aceleração do drone, deixar isso mais suave\"): o freio de chegada caiu de 2,5 para 1,5 m/s² (a 36 km/h começa a frear uns 28 m antes, e não 17);\n   na rota a velocidade muda sem tranco (XG_AC_SUAVE = aceleração e freio máximos, XG_TRANCO = quanto a aceleração pode mudar por segundo); e o\n   giro da aeronave na virada ficou mais lento (XG_GIRO_SUAVE, era 4). */\nconst XG_VEL_CURVA=15/3.6,XG_FREIO_CURVA=1.5,XG_AC_SUAVE=1.9,XG_TRANCO=2.2,XG_GIRO_SUAVE=1.6;\n/* 18/11/2026 (Eduardo: \"a virada de volta ta estranha ainda do xag\"), pelo vídeo do controle em voo (IMG_5041.mov): o XAG quase\n   para no fim da passada (35 -> ~4 km/h em ~6 s), troca de faixa chegando a ~16 km/h, cai a ~9 e só então acelera (9 -> 36 em\n   ~4 s); a virada inteira leva de 12 a 16 s e o giro é lento. No simulador ele passava pelos cantos a 15 km/h girando 90 graus\n   em menos de 1 s (7 s no total). Estes valores só valem no voo do XAG (window.xgVooXag); o DJI continua como estava. */\nconst XG_VEL_CURVA_XAG=6/3.6,XG_VEL_LIGA_XAG=16/3.6,XG_GIRO_XAG=0.9,XG_FREIO_XAG=1.1;\n/* 19/11/2026 (Eduardo, com o vídeo do P60 virando a volta: \"os movimentos precisam ser suave, no simulador o drone vira a volta muito\n   seco\"; e antes: \"a volta ficou lenta de mais\"): no voo do XAG a virada deixa de ser dois cantos de 90° quase parando. A aeronave sai\n   da passada em ARCO, sem parar, gira o rumo junto com a curva, inclina para dentro e entra na passada seguinte ainda em curva (a\n   meia-volta inteira leva uns 4 s, como no vídeo). O raio é metade da distância entre as passadas; a velocidade na curva sai do raio\n   (aceleração lateral `lat`: 10 a 12 km/h com passadas de 6,5 a 8 m) e ela chega freando a `freio` m/s². Na troca de faixa pulveriza\n   o começo e o fim da curva e fecha no meio: ali a ponta da faixa chegaria a menos de `folga` m do limite da lavoura (a passada acaba\n   MARGEM_BORDA antes dele) e molharia fora; a nota cobra \"não aplicar fora do talhão\". Só no voo do XAG (window.xgVooXag); o canto\n   que não dá arco (raio menor que `rmin`, meia-volta no mesmo lugar, trecho alto, desvio) fica como era. V.xgArco só guarda números\n   (o V é gravado a cada 5 s). */\n/* 19/11/2026, depois de ver no site (Eduardo: \"o drone comeca liberar muito cedo pra liberar produto precisa deixar ele mais reto pra\n   comecar a pulverizar\"): na curva de ENTRADA da passada os bicos ficam fechados (antes abriam com uns 50 graus ainda por virar) e,\n   acabada a curva, ainda esperam `abre` s (V.xgFecha), o tempo de o nariz terminar de alinhar. O nariz passa a acompanhar a curva\n   mais de perto (`giro` 5, era 3: chegava uns 17 graus atrasado) e continua nesse ritmo por `giroApos` s depois dela (voltava ao\n   giro lento e levava 2 s para alinhar). Assim, quando o produto volta a sair, a aeronave está reta na passada (uns 4 m depois do\n   começo dela). A curva de saída continua como estava. */\n/* 19/11/2026 (Eduardo: \"deixa o xag de lado pq o p60 ficou bom quero que fac esse movimento suave nos outros modelos de drone\n   tambem\" e \"os desvio dos obstaculos tem que ser suaves como nesse das manobras deve funcionar para todos os modelos isso\"):\n   a curva em arco passa a valer em TODAS as aeronaves (DJI, EAVision, Ceres e os outros XAG), com os mesmos números do P60; os\n   nomes XG_ARCO_XAG / xgArcoXag ficaram. E vale em mais cantos:\n   - canto ABERTO da rota (10 a 45 graus, como o contorno do obstáculo marcado no controle): antes passava reto, com um bico no\n     caminho; agora faz a curva, com o raio que a velocidade pede (não freia se couber). No contorno de obstáculo (dois trechos\n     sem aplicação) a curva corta no máximo `corte` m para dentro do canto, para não comer a folga do obstáculo;\n   - DESVIO pelo radar (V.desvioLat com obstáculo): os três cantos do desvio (sai de lado, passa, volta para a linha) viram\n     curvas, com o nariz girando devagar (`giroDesvio`: ela sai parada, de lado, e o nariz não precisa virar tudo). A retomada\n     (V.desvioLat sem obstáculo, do manual.js e do app_rcplus.js) continua indo ao ponto exato.\n   No DJI o radar acompanha a linha planejada: durante a curva da rota essa linha é o próprio arco (xgArcoXag devolve `linha`),\n   senão ele olharia reto para fora da lavoura no meio da virada e travaria à toa. */\nconst XG_ARCO_XAG={lat:2.6,freio:1.5,rmax:9,rmin:1.5,vmin:1.6,giro:5,giroApos:1.2,rolo:2.4,folga:.75,abre:.25,corte:1,giroDesvio:1.8,desvioVel:1.4};\n/* p0 = o canto, p1 = o ponto seguinte, p2 = o depois dele (ou null); (px,pz) = onde a aeronave está; vCruz = velocidade de\n   cruzeiro; lin = comprimento do trecho que chega ao canto (0 = não se sabe); corte = quanto a curva pode entrar no canto (0 = livre) */\nfunction xgCantoXag(p0,p1,p2,px,pz,vCruz,lin,corte){\n  if(!p0||!p1)return null;\n  const ax=p0[0]-px,az=p0[1]-pz,la=Math.hypot(ax,az),bx=p1[0]-p0[0],bz=p1[1]-p0[1],lb=Math.hypot(bx,bz);\n  if(la<.2||lb<1)return null;\n  const c=(ax*bx+az*bz)/(la*lb);\n  if(c>.985||c<-.94)return null;   /* quase reto (menos de 10 graus) ou meia-volta no mesmo lugar (não dá arco) */\n  /* t = quanto antes do canto a curva começa: metade da ligação curta (a outra metade é da curva seguinte) */\n  const th=Math.acos(c),tg=Math.tan(th/2);\n  /* raio pedido: o que a velocidade de cruzeiro pede (curva aberta não freia), nunca menos que rmax; no contorno, o que o corte deixa */\n  let rAlvo=Math.max(XG_ARCO_XAG.rmax,vCruz*vCruz/XG_ARCO_XAG.lat);\n  if(corte>0)rAlvo=Math.min(rAlvo,corte/(1/Math.cos(th/2)-1));\n  let t=Math.min(lb<20&&p2?lb/2:lb*.45,rAlvo*tg);\n  if(lin>0)t=Math.min(t,lin/2);\n  return {la,lb,th,tg,t,ux:ax/la,uz:az/la,vx:bx/lb,vz:bz/lb};\n}\n/* 19/11/2026: o Eduardo mandou o registro de um voo real do P60 (16/11/2026, 22 viradas, 1 ponto por segundo; em\n   estudos/voo-real-p60-20261116) e, vista a comparação, respondeu \"Aplicar os três\". Valem só no voo do XAG (window.xgVooXag):\n   1. VIRADA: a curva em arco fica, mas com a velocidade do voo real. No meio de cada curva a aeronave passa a `vc` - medido: canto\n      de 63 graus a 7,7 km/h (vc63), de 118 graus a 4 km/h (vc118); o de 90 graus fica em 5,9 km/h - freando até lá a `freio` e\n      saindo a `acel`. No real: 28 -> 4,5 km/h em ~4 s, ligação a 10-13 km/h, volta a 28 em ~3 s; 11 a 12 s no total (a curva de\n      antes passava a 10 km/h e levava ~8 s).\n   2. BICOS: no voo real a pulverização não fecha na virada, só cai com a velocidade. Passa a valer a opção \"Pulverize durante a\n      mudança de faixa\" do aplicativo (P.xgMudanca, vinda do vinculo_xag.js): dos dois lados (padrão) = pulveriza a curva\n      inteira; somente bicos externos = idem, só o atomizador de fora da curva e meia vazão (V.xgSoLado); desligado = como estava\n      (fecha no meio, curva de entrada fechada, só abre reto). Com os bicos abertos a ponta da faixa passa do fim da passada.\n   3. DECOLAGEM E POUSO: sobe a `sobe` m/s (0 a 5 m em 4 a 5 s) e paira `pairaSai` s antes de sair; antes de descer paira\n      `pairaPousa` s e desce a `desce` m/s (o último metro já saía devagar). Antes: até 3 m/s subindo e 2,5 descendo, sem pausa. */\n/* 19/11/2026 (Eduardo, depois de testar): curvaVazao/curvaFaixa = quanto sobra da vazão e da faixa na troca de faixa com os bicos abertos;\n   apito = segundos apitando no chão antes de ligar as hélices; giroSai/giroAcel = giro ao sair da decolagem (rad/s e rad/s²) */\nconst XG_REAL_XAG={freio:1.8,acel:1.7,vc63:2.15,vc118:1.1,sobe:1.4,desce:1.5,pairaSai:2,pairaPousa:2.5,curvaVazao:.03,curvaFaixa:.7,apito:1,giroSai:1.2,giroAcel:2.4,jogaMax:4.3,abreAntes:.35};   /* jogaMax: metros que a calda cai para trás no começo da aceleração; abreAntes: a vazão volta quando falta este ângulo (rad) da curva de entrada */\nfunction xgArcoXag(w,d,E){\n  const X=XG_ARCO_XAG,vel=r=>trava(Math.sqrt(X.lat*r),X.vmin,Math.max(X.vmin,E.vel)),RX=window.xgVooXag?XG_REAL_XAG:null;\n  /* D = desvio de obstáculo pelo radar em curso; a chave diz de que canto é o arco guardado (na rota, o índice; no desvio, negativo) */\n  const D=V.desvioLat&&V.desvioLat.obs?V.desvioLat:null,chave=D?-D.pontos.length:V.i;\n  let A=V.xgArco;\n  if(A&&A.i!==chave)A=V.xgArco=null;\n  if(!A){\n    let p0,p1,p2=null,lin=0,corte=0;\n    if(D){const L=D.pontos.concat([w.p]);p0=L[0];p1=L[1];p2=L[2]||null}\n    else{\n      const s=rota[V.i+1],s2=rota[V.i+2],a0=rota[V.i-1];\n      if(!s||s.alto)return null;\n      p0=w.p;p1=s.p;p2=s2&&!s2.alto?s2.p:null;\n      if(a0)lin=Math.hypot(w.p[0]-a0.p[0],w.p[1]-a0.p[1]);\n      if(!w.aplica&&!s.aplica)corte=X.corte;   /* contorno de obstáculo marcado no controle */\n    }\n    const g=xgCantoXag(p0,p1,p2,d.x,d.z,E.vel,lin,corte);\n    if(!g)return null;\n    const tE=Math.min(g.la,g.t),r=tE/g.tg;\n    if(r<X.rmin)return null;\n    /* a curva seguinte (a entrada da passada) pode ser mais fechada: já chega na velocidade dela */\n    let v=vel(r);\n    const g2=g.lb<20&&p2?xgCantoXag(p1,p2,null,p0[0]+g.vx*g.lb/2,p0[1]+g.vz*g.lb/2,E.vel,g.lb,corte):null;\n    if(g2){const r2=Math.min(g2.la,g2.t)/g2.tg;if(r2>=X.rmin)v=Math.min(v,vel(r2))}\n    /* voo do XAG: velocidade no MEIO da curva pelo ângulo do canto (só cantos de mais de 45 graus e fora do desvio de obstáculo);\n       na entrada da curva ainda falta frear meia curva (2 x freio x r x th/2) */\n    const vc=RX&&!D&&g.th>.8?Math.min(v,trava(RX.vc63-(g.th*180/Math.PI-63)/55*(RX.vc63-RX.vc118),.9,2.6)):null,fr=vc===null?X.freio:RX.freio;\n    const vIni=vc===null?v:Math.min(v,Math.sqrt(vc*vc+fr*r*g.th));\n    if(g.la>g.t+.05)return {v:Math.sqrt((vIni-.25)*(vIni-.25)+2*fr*(g.la-g.t))};   /* +5 cm: na emenda das duas curvas não fica um passo sem curva (e sem bico) */\n    const sg=g.ux*g.vz-g.uz*g.vx>0?1:-1,cx=d.x-g.uz*sg*r,cz=d.z+g.ux*sg*r,ant=rota[V.i-1],prox=rota[V.i+1];\n    A=V.xgArco={i:chave,cx,cz,r,sg,th:g.th,a0:Math.atan2(d.z-cz,d.x-cx),f:0,v,ex:p0[0]+g.vx*tE,ez:p0[1]+g.vz*tE,vx:g.vx,vz:g.vz,\n      /* pulveriza na curva de saída da passada (1) e na de entrada da seguinte (2, só em troca de faixa: contorno de obstáculo, não);\n         px,pz = o canto e ox,oz = o lado de fora (para onde a passada acabaria), usados para fechar no meio da curva */\n      ap:D?0:(w.aplica?1:(prox&&prox.aplica&&ant&&ant.aplica&&g.la<20?2:0)),px:p0[0],pz:p0[1],ox:w.aplica?g.ux:-g.vx,oz:w.aplica?g.uz:-g.vz,g:D?X.giroDesvio:X.giro,vc};\n  }\n  let f=A.sg*(Math.atan2(d.z-A.cz,d.x-A.cx)-A.a0);\n  while(f>Math.PI)f-=2*Math.PI;while(f<-Math.PI)f+=2*Math.PI;\n  A.f=Math.max(A.f,f);\n  if(A.th-A.f<.03){V.xgArco=null;if(A.g!==X.giroDesvio)V.xgGiroResto=X.giroApos;if(A.ap===2&&!(window.xgVooXag&&P.xgMudanca!==\"off\"))V.xgFecha=X.abre;return {fim:true,v:A.v}}\n  /* a aeronave persegue um ponto um pouco à frente em cima do arco (depois do fim dele, na reta de saída) */\n  const fa=A.f+Math.max(.45,Math.min(.7,A.r*.2))/A.r;\n  const alvo=fa<A.th?[A.cx+A.r*Math.cos(A.a0+A.sg*fa),A.cz+A.r*Math.sin(A.a0+A.sg*fa)]:[A.ex+A.vx*(fa-A.th)*A.r,A.ez+A.vz*(fa-A.th)*A.r];\n  V.xgRol=A.sg*Math.atan(V.v*V.v/(A.r*9.81));\n  /* a ponta de fora da faixa (meia largura além da aeronave, para fora da curva): quanto ela passa do fim da passada */\n  const rx=d.x-A.cx,rz=d.z-A.cz,rl=Math.hypot(rx,rz)||1,meia=larguraEfetiva()/2;\n  const passa=(d.x+rx/rl*meia-A.px)*A.ox+(d.z+rz/rl*meia-A.pz)*A.oz;\n  /* o caminho que falta da curva, para o radar que acompanha a linha (DJI): o ponto perseguido, o resto do arco e o fim dele */\n  const linha=[alvo];\n  for(let q=fa+.35;q<A.th;q+=.35)linha.push([A.cx+A.r*Math.cos(A.a0+A.sg*q),A.cz+A.r*Math.sin(A.a0+A.sg*q)]);\n  if(fa<A.th)linha.push([A.ex,A.ez]);\n  /* velocidade ao longo da curva no voo do XAG: a mínima (A.vc) no meio, freando até lá e acelerando depois */\n  let vArco=A.v;\n  if(RX&&A.vc!=null){const s=A.r*Math.abs(A.f-A.th/2);vArco=Math.min(A.v,Math.sqrt(A.vc*A.vc+2*(A.f<A.th/2?RX.freio:RX.acel)*s))}\n  /* bicos na curva: sem a opção do aplicativo (outros modelos) ou com ela desligada, só a curva de SAÍDA pulveriza, até a ponta da\n     faixa chegar perto do limite, e na de entrada espera ficar reto; com ela ligada (XAG) pulveriza a troca de faixa inteira */\n  const mud=window.xgVooXag?(P.xgMudanca===\"off\"||P.xgMudanca===\"externos\"?P.xgMudanca:\"ambos\"):\"off\";\n  let aplica=A.ap===1&&passa<=MARGEM_BORDA-X.folga;\n  if(mud!==\"off\"&&A.ap>0){const abre=A.ap===2&&A.th-A.f<XG_REAL_XAG.abreAntes;if(abre)V.xgJoga=1;if(!aplica&&!abre)V.xgNaCurva=1;aplica=true;if(mud===\"externos\")V.xgSoLado=A.sg}   /* 19/11: a vazão só cai onde os bicos fechavam (pontas das faixas alinhadas) */   /* lado de fora da curva (lado > 0 = esquerda) */\n  return {v:vArco,alvo,linha,aplica};\n}\n/* 19/11/2026 (Eduardo, depois de ver no ar: \"quando a contagem inicia no caso no 1 deve apitar ai tem 2 e 3 quando apitar o badeco sai correndo\"):\n   o aplicativo do XAG chama isto quando a contagem regressiva da decolagem começa (xag_parametros.js → vinculo_xag.js). Conta o apito (o\n   sons_dji.js toca) e avisa o auxiliar (equipe.js). Decolando sem contagem, quem apita é o passo, 1 s antes de ligar as hélices. */\nfunction xgApitar(){V.xgApitoN=(V.xgApitoN||0)+1;V.xgApitoEm=performance.now();if(window.xgEquipe&&xgEquipe.apitou){try{xgEquipe.apitou()}catch(e){}}}\nfunction passo(dt){\n  const d=drone.position;V.xgRol=0;V.xgSoLado=0;\n  /* 19/11/2026 (Eduardo, P60: \"quando vira a volta reduz a vazao e isso precisa acontecer vizualmente e no chao tambem ... pintar menos o\n     chao e o efeito de agua quase sumir e a faixa tambem da uma reduzina\"): V.xgCurvaK vai de 0 a 1 na troca de faixa do XAG com os bicos\n     abertos; com ele caem a vazão (abaixo), a faixa (V.xgFaixaK, pulverizacao.js) e a névoa (graficos.js) */\n  V.xgCurvaK=(V.xgCurvaK||0)+((V.xgNaCurva?1:0)-(V.xgCurvaK||0))*Math.min(1,dt*8);V.xgNaCurva=0;V.xgFaixaK=1-(1-XG_REAL_XAG.curvaFaixa)*V.xgCurvaK;V.xgFluxo=1;\n  /* 19/11/2026 (Eduardo: \"quando o drone acelera ele joga o produto pra tras entao nao fica esse furo ali\"): aceleração ao longo do voo, alisada;\n     no voo do XAG, aplicando e acelerando, a calda cai V.xgTras metros para trás do bico (pulverizacao.js) e fecha o começo da passada */\n  V.xgAc=(V.xgAc||0)+((V.v-(V.xgVant==null?V.v:V.xgVant))/Math.max(dt,1e-3)-(V.xgAc||0))*Math.min(1,dt*4);V.xgVant=V.v;\n  if(V.xgJoga&&(V.estado!==\"aplicando\"||V.v>P.vel*.97||V.xgAc<-.4))V.xgJoga=0;   /* só na saída do giro (V.xgJoga, posto em xgArcoXag), até chegar à velocidade */\n  V.xgTras=V.xgJoga?XG_REAL_XAG.jogaMax*trava((P.vel-V.v)/Math.max(1,P.vel)*1.4,0,1):0;   /* maior saindo devagar do giro, some chegando à velocidade */\n  if(V.estado!==\"subindo\"){V.xgApitou=false;V.xgApito=0}if(V.xgSai>0)V.xgSai-=dt;\n  if(V.estado!==\"aplicando\")V.xgArco=null;if(V.xgGiroResto>0)V.xgGiroResto-=dt;if(V.xgFecha>0)V.xgFecha-=dt;\n  if(V.estado===\"caiu\"){quedaPasso(dt);return}\n  if(V.estado===\"em solo\"||V.estado===\"concluído\")return;\n  V.tempo+=dt;\n  if(V.estado===\"reabastecendo\"){\n    V.espera-=dt;if(V.espera<=0){V.tan=T50.tanque;V.bat=100;V.avisoBat=false;V.recargas++;V.estado=\"subindo\"}\n    return;\n  }\n  const E=efetivo();\n\n  /* 19/11/2026 (Eduardo, XAG: \"quando o drone vai decolar ele da um apito antes de ligar a helice ... o apito acontece no 1 segundo\"): mandada\n     decolar, a aeronave do XAG fica XG_REAL_XAG.apito (1 s) no chão, apitando e com as hélices paradas; só depois liga e sobe. V.xgApitoN conta\n     os apitos: o sons_dji.js toca e o auxiliar que estiver perto corre (equipe.js). */\n  if(window.xgVooXag&&V.estado===\"subindo\"&&d.y<=alt(d.x,d.z)+.05){\n    if(!V.xgApitou){V.xgApitou=true;if(performance.now()-(V.xgApitoEm||-1e9)<8000)V.xgApitoEm=-1e9;else{V.xgApito=XG_REAL_XAG.apito;xgApitar();V.xgApitoEm=-1e9}}   /* já apitou na contagem: liga direto */\n    if(V.xgApito>0){V.xgApito-=dt;V.vy=0;return}\n  }\n  let alvo=null,vDes=0,agl=E.altura,aplica=false,xgLinhaArco=null;\n  /* 23/10/2026, pedido do Eduardo (T25 em area dificil): na ida ao ponto inicial (comeco da tarefa ou volta depois de trocar a bateria)\n     a aeronave NAO sobe ate a altitude RTH para depois descer aos poucos: sobe so ate a altura programada, voa nela, alinha e comeca a\n     aplicar. A altitude RTH fica para o retorno e para os trechos de conexao altos (w.alto). */\n  if(V.estado===\"subindo\"){agl=E.altura}\n  else if(V.estado===\"indo\"){alvo=V.retomar.p;vDes=Math.min(10,Math.max(E.vel,6)*1.3);agl=E.altura}\n  else if(V.estado===\"descendo\"){agl=E.altura}\n  else if(V.estado===\"aplicando\"){\n    const w=rota[V.i];\n    if(!w){\n      if(P.modo===\"facil\")iniciarRetorno(null);\n      else pairar(\"Operação concluída\",\"\",[{txt:\"Retornar à base\",fn:()=>iniciarRetorno(null)}]);\n      return;\n    }\n    alvo=w.p;aplica=w.aplica;vDes=w.aplica?E.vel:Math.min(10,E.vel*1.2);\n    /* trecho de conexão na altitude RTH: sobe parado, cruza, desce parado */\n    if(w.alto){agl=P.rth;const falta=alturaAlvo(P.rth)-d.y;vDes=falta>1?0:Math.min(10,Math.max(E.vel,6)*1.3)}\n    /* para no ponto antes e depois de um trecho alto: não entra embaixo do obstáculo embalada */\n    if(w.alto||(rota[V.i+1]&&rota[V.i+1].alto))vDes=Math.min(vDes,Math.sqrt(2*T50.frenagem*Math.hypot(w.p[0]-d.x,w.p[1]-d.z))+.15);\n    else if(V.desce){vDes=0;if(Math.abs(alturaAlvo(E.altura)-d.y)<.6)V.desce=false}\n    /* 18/11/2026 (Eduardo: \"o drone precisa reduzir muito a velocidade na hora de virar a volta tipo chegar a uns 15 de\n       velocidade\"): antes de um ponto em que a rota vira (fim da passada, entrada da seguinte) a aeronave vem freando e\n       passa por ele a 15 km/h; a ligação curta entre duas passadas é feita nessa velocidade e, já na passada nova, ela\n       acelera de novo. Curva suave (contorno de obstáculo marcado no controle) não freia. */\n    /* 19/11/2026: no voo do XAG a virada é uma curva em arco (xgArcoXag, acima); o canto que não dá arco fica como era */\n    if(V.xgFecha>0)aplica=false;   /* acabou de entrar na passada: os bicos esperam o nariz alinhar (XG_ARCO_XAG.abre) */\n    const xgD=V.desvioLat&&V.desvioLat.obs?V.desvioLat:null;   /* desvio de obstáculo pelo radar: os cantos dele também viram curva */\n    const xgA=!w.alto&&!V.aguardaSubida&&!V.desce&&!V.xgSobre&&(xgD||(!V.desvioLat&&!(rota[V.i+1]&&rota[V.i+1].alto)))?xgArcoXag(w,d,E):null;\n    if(!xgA)V.xgArco=null;\n    if(xgA&&xgA.fim){if(xgD){xgD.pontos.shift();if(!xgD.pontos.length)V.desvioLat=null}else V.i++;return}\n    if(xgA){vDes=Math.min(vDes,xgA.v);if(xgA.alvo){alvo=xgA.alvo;aplica=xgA.aplica;xgLinhaArco=xgD?null:(xgA.linha||null)}}\n    else if(!V.desvioLat&&!w.alto){   /* 18/11/2026: vale também no XAG (Eduardo, no P60: \"as viradas de volta tá brusca\") */\n      const prox=rota[V.i+1],ant=rota[V.i-1],xgVc=window.xgVooXag?XG_VEL_CURVA_XAG:XG_VEL_CURVA,xgFr=window.xgVooXag?XG_FREIO_XAG:XG_FREIO_CURVA;\n      if(prox&&!prox.alto){\n        const ax=w.p[0]-d.x,az=w.p[1]-d.z,la=Math.hypot(ax,az),bx=prox.p[0]-w.p[0],bz=prox.p[1]-w.p[1],lb=Math.hypot(bx,bz);\n        /* mira um pouco abaixo dos 15 km/h: a velocidade suave chega atrasada em relação a esta conta */\n        if(la>.05&&lb>.05&&(ax*bx+az*bz)/(la*lb)<.7)vDes=Math.min(vDes,Math.sqrt((xgVc-.35)*(xgVc-.35)+2*xgFr*la));\n      }\n      if(!w.aplica&&ant&&Math.hypot(w.p[0]-ant.p[0],w.p[1]-ant.p[1])<20)vDes=Math.min(vDes,window.xgVooXag?XG_VEL_LIGA_XAG:XG_VEL_CURVA);\n    }\n    if(V.desvioLat){if(!(xgA&&xgA.alvo))alvo=V.desvioLat.pontos[0];aplica=false}\n    /* passando por cima (Pomar): no fio não pulveriza do ponto em que travou até\n       voltar à altura de trabalho do outro lado; lá ela para, desce e só então\n       segue reto na mesma linha. Na árvore passa pulverizando e desce andando. */\n    if(V.xgSobre){\n      if(V.xgSobre.fio)aplica=false;\n      if(V.xgSobre.passou){\n        if(V.xgSobre.fio)vDes=0;\n        if(Math.abs(alturaAlvo(E.altura)-d.y)<.6)V.xgSobre=null;\n      }\n    }\n    /* ponto repetido: já está nele */\n    if(!V.desvioLat&&!V.aguardaSubida&&!V.desce&&!w.alto&&Math.hypot(alvo[0]-d.x,alvo[1]-d.z)<.05){V.i++;return}\n  }\n  else if(V.estado===\"voltando\"){alvo=[BASE.x,BASE.z];agl=P.rth;\n    /* RTH: primeiro sobe até a altitude RTH, depois volta */\n    const falta=alturaAlvo(P.rth)-d.y;vDes=falta>1?0:Math.min(10,Math.max(E.vel,6)*1.3)}\n  else if(V.estado===\"pousando\"){agl=0}\n\n  if(alvo){\n    const dx=alvo[0]-d.x,dz=alvo[1]-d.z;\n    if(Math.hypot(dx,dz)>.3){\n      const yA=Math.atan2(-dz,dx);let dy=yA-V.yaw;\n      while(dy>Math.PI)dy-=2*Math.PI;while(dy<-Math.PI)dy+=2*Math.PI;\n      /* 19/11/2026 (Eduardo, P60: \"quando o drone sobe do ponto ele vira muito seco precisa ser mais suave\"): saindo da decolagem (XAG, V.xgSai)\n         o giro acelera e freia, no máximo a XG_REAL_XAG.giroSai, e a aeronave só anda depois de apontar para onde vai (segura a pausa) */\n      if(V.xgSai>0){\n        V.xgW=(V.xgW||0)+trava(trava(dy*2.2,-XG_REAL_XAG.giroSai,XG_REAL_XAG.giroSai)-(V.xgW||0),-XG_REAL_XAG.giroAcel*dt,XG_REAL_XAG.giroAcel*dt);\n        V.yaw+=trava(V.xgW*dt,-Math.abs(dy),Math.abs(dy));\n        if(Math.abs(dy)>.06)V.xgPausa=Math.max(V.xgPausa||0,.25);else if(!(V.xgPausa>0))V.xgSai=0;\n      }\n      else V.yaw+=dy*Math.min(1,dt*(V.estado===\"aplicando\"?(V.xgArco?V.xgArco.g||XG_ARCO_XAG.giro:V.xgGiroResto>0?XG_ARCO_XAG.giro:(window.xgVooXag?XG_GIRO_XAG:XG_GIRO_SUAVE)):4));\n    }\n  }\n\n  /* 19/11/2026, pelo voo real do P60: acabou de subir, paira antes de sair (V.xgPausa, posto onde o estado muda; o pouso usa a mesma espera) */\n  if(V.xgPausa>0){V.xgPausa-=dt;if(V.estado===\"indo\"||V.estado===\"aplicando\")vDes=0}\n  /* radar e desvio */\n  const move=[\"aplicando\",\"indo\",\"voltando\"].includes(V.estado);\n  /* durante a ré e a subida sobre o obstáculo o radar não manda frear de novo:\n     antes, o fio ainda à frente travava a frenagem e ela dava a ré duas vezes */\n  if(P.desvio&&move&&!V.aguardaSubida){\n    const dist0=alvo?Math.hypot(alvo[0]-d.x,alvo[1]-d.z):0;\n    const sx=alvo&&dist0>.01?(alvo[0]-d.x)/dist0:V.dirx,sz=alvo&&dist0>.01?(alvo[1]-d.z)/dist0:V.dirz;\n    V.sondaT-=dt;if(V.sondaT<=0){\n      /* seguindo a rota do controle, o radar acompanha a linha planejada (ver sondar). O trecho alto (passa por cima na\n         altitude RTH) fica de fora: nele a aeronave sobe parada antes de cruzar. */\n      let linha=null;\n      if(V.estado===\"aplicando\"&&!V.desvioLat&&!window.xgVooXag&&rota[V.i]&&(alvo===rota[V.i].p||xgLinhaArco)){\n        linha=xgLinhaArco||[alvo];   /* na curva em arco a linha é o próprio arco */\n        if(!rota[V.i].alto)for(let j=V.i+1,comp=dist0;j<rota.length&&comp<T50.radarAlcance&&!rota[j].alto;j++){\n          comp+=Math.hypot(rota[j].p[0]-rota[j-1].p[0],rota[j].p[1]-rota[j-1].p[1]);linha.push(rota[j].p)}\n      }\n      xgLinhaDoRadar=linha;\n      try{V.sonda=sondar(sx,sz)}finally{xgLinhaDoRadar=null}\n      V.sondaT=.05;if(V.sonda)V.ultimoObs=V.sonda.c}\n    if(V.sonda){\n      const ob=V.sonda.c;\n      /* Pomar com prioridade vertical: árvore não trava a aeronave, ela sobe por cima */\n      if(sobePorCima(ob)&&!(V.xgSobre&&V.xgSobre.obs===ob)&&V.sonda.d<=distanciaParaSubir(ob))passarPorCimaSemParar(ob);\n      /* freia para parar com 2,5 m entre a frente da hélice e o obstáculo */\n      const folga=V.sonda.d-(T50.distSeguranca+T50.raioHelice);\n      vDes=Math.min(vDes,Math.sqrt(2*T50.frenagem*Math.max(0,folga)));\n      if(V.xgSobre&&V.xgSobre.obs===ob&&!V.xgSobre.fio&&!V.aguardaSubida){\n        /* só chega ao obstáculo depois de ganhar a altura (sobe a 3 m/s) */\n        const falta=Math.max(.1,alturaAlvo(E.altura)-d.y);\n        vDes=Math.min(vDes,Math.max(0,folga)*3/falta);\n      } else {\n        const parada=V.v*V.v/(2*T50.frenagem);\n        if(folga<=parada+.4){vDes=0;V.freando=true}\n      }\n    }\n    /* frenagem travada: sem isso, ao desacelerar a distância de parada encolhe,\n       a condição deixa de valer e a aeronave volta a acelerar rastejando */\n    if(V.freando)vDes=0;\n    /* 19/11/2026 (desvio suave): ainda freando, já abaixo de `desvioVel` m/s (5 km/h), tenta o contorno lateral e sai andando, sem a\n       parada completa na frente do obstáculo. Sem lado livre (ou em Montanhas, que sobe por cima) segue freando até parar, como antes. */\n    if(V.freando&&V.v>=.15&&V.v<XG_ARCO_XAG.desvioVel&&V.estado===\"aplicando\"&&P.terreno!==\"montanha\"){\n      const oCedo=V.sonda?V.sonda.c:V.ultimoObs;\n      if(oCedo&&tentarDesvioAutomatico(oCedo)){V.freando=false;V.obs=oCedo;return}\n    }\n    if(V.freando&&V.v<.15){\n      V.freando=false;const o=V.sonda?V.sonda.c:V.ultimoObs;V.obs=o;\n      /* fio: no Pomar passa por cima; em Planícies/Acima da água tenta a lateral e,\n         como o fio atravessa a linha de voo, normalmente trava ali */\n      if(o&&(V.estado===\"aplicando\"||P.terreno===\"montanha\")&&tentarDesvioAutomatico(o))return;\n      const incl=Math.atan(Math.abs(alt(drone.position.x+V.dirx*6,drone.position.z+V.dirz*6)-alt(drone.position.x,drone.position.z))/6)*180/Math.PI;\n      const porque=o&&o.tipo===\"relevo\"?\" Com a Estabilização da altitude desligada, a altura é contada a partir da decolagem e o terreno à frente está mais alto que a aeronave.\"\n        :o&&o.fio?(P.terreno===\"montanha\"?\" O desvio de obstáculos está desligado, então a aeronave não passou por cima do fio.\"\n          :\" Em Planícies e Acima da água o desvio é só pela lateral. O fio atravessa a linha de voo e não deixa lado livre, então a aeronave trava e espera o operador. Para passar por cima automaticamente, use o cenário Colina/Pomar com prioridade de desvio vertical.\")\n        :(P.terreno!==\"montanha\"&&incl>10?\" Em encosta o modo Planícies pode falhar no desvio lateral — o manual recomenda Montanhas e pomares.\":\" O desvio automático não conseguiu contornar.\");\n      /* a explicação vai para o relatório (V.xgPorque), não para a tela */\n      V.xgPorque=\"O radar parou a aeronave antes de \"+(o?o.nome:\"um obstáculo\")+\".\"+porque;\n      pairar(\"Obstáculo detectado\",\"\",\n        [{txt:\"Subir e passar por cima\",fn:subirSobreObstaculo},{txt:\"Retornar à base\",fn:()=>iniciarRetorno(pontoAtual())}]);\n      return;\n    }\n  }\n\n  /* depois de mandar subir sobre um obstáculo, só avança quando já ganhou a altura */\n  /* 1) recua na mesma altura  2) sobe parado  3) só então segue a rota */\n  if(V.aguardaSubida){\n    alvo=V.recuo;aplica=false;\n    if(V.fase===\"recuo\"){vDes=1.5;if(Math.hypot(V.recuo[0]-d.x,V.recuo[1]-d.z)<.4){V.fase=\"subida\";V.extra=V.extraPend}}\n    else{vDes=0;if(Math.abs(alturaAlvo(agl)-d.y)<.4){V.aguardaSubida=false;V.recuo=null;V.fase=null}}\n  }\n\n  /* velocidade e posição */\n  /* rota do DJI sem nada mandando frear forte (radar, fio, trecho alto, passar por cima): a velocidade muda devagar e sem tranco.\n     Fora disso vale o de sempre (freio de 4 m/s² e arrancada de 2,5 m/s²). */\n  const xgSuave=V.estado===\"aplicando\"&&!V.freando&&!V.sonda&&!V.aguardaSubida&&!V.desce&&!V.xgSobre&&\n    !(rota[V.i]&&rota[V.i].alto)&&!(rota[V.i+1]&&rota[V.i+1].alto);\n  if(xgSuave){\n    const e=vDes-V.v,aDes=Math.sign(e)*Math.min(XG_AC_SUAVE,Math.sqrt(2*XG_TRANCO*Math.abs(e)));\n    V.xgAc=(V.xgAc||0)+trava(aDes-(V.xgAc||0),-XG_TRANCO*dt,XG_TRANCO*dt);\n    V.v+=V.xgAc*dt;\n  } else {V.xgAc=0;V.v+=trava(vDes-V.v,-T50.frenagem*dt,2.5*dt)}\n  if(V.v<0)V.v=0;\n  if(alvo&&V.v>0){\n    const dist=Math.hypot(alvo[0]-d.x,alvo[1]-d.z),passoH=Math.min(dist,V.v*dt),ax=d.x,az=d.z;\n    const ux=(alvo[0]-d.x)/(dist||1),uz=(alvo[1]-d.z)/(dist||1);\n    d.x+=ux*passoH;d.z+=uz*passoH;\n    if(!V.aguardaSubida){V.dirx=ux;V.dirz=uz}   /* recuando: a frente continua sendo a frente */\n    if(aplica&&V.tan>0){\n      const ha=passoH*P.faixa/10000;\n      /* a bomba entrega no máximo 16 L/min: acima disso a dose cai */\n      const pedido=ha*P.vazao*(V.xgSoLado?.5:1)*(1-(1-XG_REAL_XAG.curvaVazao)*(V.xgCurvaK||0)),teto=T50.vazaoMaxLmin/60*dt,litros=Math.min(pedido,teto,V.tan);   /* só um atomizador: meia vazão */\n      V.tan-=litros;V.calda+=litros;V.aplicado+=ha*(litros/Math.max(pedido,1e-9));\n      V.vazaoAtual=litros/dt*60;V.subdose=pedido>teto*1.02;\n      /* 19/11/2026 (Eduardo, vendo o vídeo: \"a nevua tava boa antes deixa como tava antes com vortex oque eu pedi é q quando o drone reduzir a\n         velocidade a nevua e o vortez somen ... somente durante a virada de volta do drone\"): na velocidade programada a névoa é a de sempre (1);\n         ela só some quando a aeronave reduz para virar (abaixo de 95% da velocidade vai caindo, a 60% já não há) e volta ao acelerar */\n      /* 19/11/2026, depois de ele ver no site: \"ta muito fraca essa nevua e eu ainda falei q quero da forma que era antes\" / \"mas quand vira a volta faz\n         igual como ta\". A regra acima (névoa caindo com a velocidade) foi RETIRADA: V.xgFluxo fica em 1 e a névoa só some dentro do giro\n         (V.xgCurvaK, no graficos.js). Não ligar a névoa à velocidade de novo. */\n      pintarFaixa(ax,az,d.x,d.z,larguraEfetiva(),V.i);\n    } else V.vazaoAtual=0;\n    if(dist-passoH<.05&&!V.aguardaSubida){\n      if(V.estado===\"aplicando\"){ if(V.desvioLat){V.desvioLat.pontos.shift();if(!V.desvioLat.pontos.length)V.desvioLat=null} else {if(rota[V.i]&&rota[V.i].alto)V.desce=true;V.i++} }\n      else if(V.estado===\"indo\"){V.estado=\"descendo\";V.i=V.retomar.i;V.retomar=null;V.v=0}\n      else if(V.estado===\"voltando\"){V.estado=\"pousando\";V.v=0;if(window.xgVooXag)V.xgPausa=XG_REAL_XAG.pairaPousa}\n    }\n    if(V.xgSobre){if(!V.xgSobre.passou&&!V.aguardaSubida&&passouObstaculo(V.xgSobre)){V.extra=0;V.obsExtra=null;V.xgSobre.passou=true}}\n    else if(V.obsExtra&&Math.hypot(d.x-V.obsExtra.cx,d.z-V.obsExtra.cz)>V.obsExtra.raio+14){V.extra=0;V.obsExtra=null}\n  } else V.vazaoAtual=0;\n\n  /* altura */\n  let yAlvo=V.estado===\"pousando\"?alt(d.x,d.z):alturaAlvo(agl);\n  if(V.estado===\"pousando\"&&V.xgPausa>0)yAlvo=d.y;   /* voo do XAG: paira antes de descer para pousar */\n  if(V.aguardaSubida&&V.fase===\"recuo\")yAlvo=V.yRecuo;   /* recua na mesma altura */\n  /* com o desvio ligado o radar vê o chão: não desce abaixo de 1,5 m */\n  if(P.desvio&&V.estado!==\"pousando\"){\n    const piso=alt(d.x,d.z)+1.5;\n    if(yAlvo<piso&&!P.estab&&[\"aplicando\",\"indo\",\"voltando\"].includes(V.estado)&&V.v>.2){\n      V.freando=true;V.ultimoObs={nome:\"o relevo\",tipo:\"relevo\",topo:alt(d.x,d.z)+3,cx:d.x,cz:d.z,raio:6};V.sonda=null;\n    }\n    yAlvo=Math.max(yAlvo,piso);\n  }\n  /* voo do XAG (voo real do P60): na decolagem sobe a 1,4 m/s e no pouso desce a 1,5 m/s; no resto do voo continua como era */\n  const xgTP=window.xgVooXag?XG_REAL_XAG:null,subida=xgTP&&V.estado===\"subindo\"?xgTP.sobe:3;\n  const vyDes=trava((yAlvo-d.y)*1.6,xgTP&&V.estado===\"pousando\"?-xgTP.desce:-2.5,subida);\n  V.vy+=trava(vyDes-V.vy,-6*dt,6*dt);d.y+=V.vy*dt;\n  if(V.estado===\"subindo\"&&Math.abs(yAlvo-d.y)<.3){V.estado=V.retomar?\"indo\":\"aplicando\";if(window.xgVooXag){V.xgPausa=XG_REAL_XAG.pairaSai;V.xgSai=8;V.xgW=0}}\n  if(V.estado===\"descendo\"&&Math.abs(yAlvo-d.y)<.3)V.estado=\"aplicando\";\n  if(V.estado===\"pousando\"&&d.y-alt(d.x,d.z)<.05){\n    d.y=alt(d.x,d.z);V.vy=0;\n    if(V.retomar){V.estado=\"reabastecendo\";V.espera=15}\n    else{V.estado=\"concluído\";V.rodando=false;mostrarFim()}\n  }\n\n  /* colisão */\n  /* no mesmo passo em que pousa o estado já virou \"reabastecendo\"/\"concluído\": o chão não conta */\n  const ignoraChao=[\"pousando\",\"reabastecendo\",\"concluído\",\"em solo\"].includes(V.estado)||(V.estado===\"subindo\"&&d.y-alt(d.x,d.z)<1);\n  if(!ignoraChao&&d.y<alt(d.x,d.z)+.25){\n    cair({nome:\"o relevo\",dica:(V.estado===\"indo\"||V.estado===\"voltando\")&&!window.xgVooXag\n      ?\"Na ida até o ponto de pulverização e na volta para a base a aeronave não acompanha o terreno: a altura é contada a partir do ponto de decolagem. O terreno subiu e a aeronave não.\"\n      :P.estab\n      ?\"O terreno subiu mais rápido do que a aeronave conseguiu acompanhar. Em encosta, use o terreno Montanhas e pomares e reduza a velocidade — o manual recomenda no máximo 6° de inclinação a 3 m/s.\"\n      :\"Com a Estabilização da altitude desligada, a altura é contada a partir do ponto de decolagem. O terreno subiu e a aeronave não.\"});\n    return;\n  }\n  const ponto=new THREE.Vector3(d.x,d.y+.4,d.z);\n  for(const c of colisores){\n    if(Math.hypot(c.cx-d.x,c.cz-d.z)>c.raio+3)continue;\n    if(distColisor(c,ponto)<1.3){cair(c);return}\n  }\n\n  /* bateria, tanque e ações automáticas */\n  const carga=V.tan/T50.tanque,autonomia=T50.autonomiaVazioMin-(T50.autonomiaVazioMin-T50.autonomiaCheioMin)*carga;\n  V.bat=Math.max(0,V.bat-dt/60*(100/autonomia));\n  if(V.estado===\"aplicando\"&&V.tan<=.05&&!P.xgMapeamento){\n    if(P.modo===\"facil\")iniciarRetorno(pontoAtual());\n    else pairar(\"Tanque de pulverização vazio\",\"Não há mais carga líquida. Aterrisse e reabasteça\",\n      [{txt:\"Retornar para reabastecer\",fn:()=>iniciarRetorno(pontoAtual())}]);\n  }\n  /* bateria fraca só age com a aeronave no ar e ainda trabalhando */\n  if(V.bat<=25&&!V.avisoBat&&[\"aplicando\",\"indo\",\"descendo\",\"subindo\",\"pairando\"].includes(V.estado)){\n    V.avisoBat=true;\n    if(P.modo===\"facil\")iniciarRetorno([\"aplicando\",\"pairando\",\"descendo\"].includes(V.estado)?pontoAtual():V.retomar);\n    else mostrarAlerta(\"Bateria fraca\",\"Bateria fraca. Retorne à base\",\n      [{txt:\"Retornar à base\",fn:()=>iniciarRetorno(pontoAtual())}],true);\n  }\n  if(V.bat<=0)cair({nome:\"falta de bateria\",dica:\"A bateria acabou no ar. No Modo padrão a bateria fraca só gera aviso — o operador precisa mandar a aeronave voltar.\"});\n  V.aplicando=aplica&&V.estado===\"aplicando\"&&V.v>.5&&V.tan>0;\n}\n\n/* Planícies e Acima da água desviam pela lateral; Montanhas desvia por cima */\nfunction tentarDesvioAutomatico(o){\n  const d=drone.position;\n  if(P.terreno===\"montanha\"){V.antesPairar=V.estado;subirSobreObstaculo();return true}\n  if(o.tipo===\"relevo\"||o.raio>8)return false;\n  const inclinacao=Math.atan(Math.abs(alt(d.x+V.dirx*6,d.z+V.dirz*6)-alt(d.x,d.z))/6)*180/Math.PI;\n  if(P.terreno!==\"montanha\"&&inclinacao>10)return false;\n  const fx=Math.cos(V.yaw),fz=-Math.sin(V.yaw),nx=-fz,nz=fx;\n  const afast=o.raio+T50.distSeguranca+T50.raioHelice+1;\n  /* contorna primeiro pelo lado em que a aeronave já está, para não cruzar na frente do obstáculo */\n  const lado=(d.x-o.cx)*nx+(d.z-o.cz)*nz,primeiro=lado<-.3?-1:1;\n  const lateralAtual=(d.x-o.cx)*nx+(d.z-o.cz)*nz;\n  const livre=q=>colisores.every(c=>c===o||Math.hypot(c.cx-q.x,c.cz-q.z)>c.raio+6||distColisor(c,q)>3);\n  const trechoLivre=(a,b)=>{const n=Math.ceil(Math.hypot(b[0]-a[0],b[1]-a[1])/1.5);\n    for(let k=0;k<=n;k++){const t=k/n;\n      const q=new THREE.Vector3(a[0]+(b[0]-a[0])*t,d.y+.3,a[1]+(b[1]-a[1])*t);\n      if(!livre(q)||distColisor(o,q)<T50.distSeguranca+T50.raioHelice)return false}\n    return true};\n  for(const s of [primeiro,-primeiro]){\n    const lado1=[d.x+nx*(afast*s-lateralAtual),d.z+nz*(afast*s-lateralAtual)];\n    const adiante=o.raio*2+T50.distSeguranca+2;\n    const lado2=[lado1[0]+fx*(Math.hypot(o.cx-d.x,o.cz-d.z)+adiante),lado1[1]+fz*(Math.hypot(o.cx-d.x,o.cz-d.z)+adiante)];\n    const depois=[lado2[0]+fx*14,lado2[1]+fz*14];\n    const aqui=[d.x,d.z];\n    if(trechoLivre(aqui,lado1)&&trechoLivre(lado1,lado2)&&trechoLivre(lado2,depois)){\n      /* 17/11/2026: passado o obstáculo, volta para a LINHA da rota (diagonal de 45°) e segue nela; antes ia do fim do\n         contorno direto para a ponta da passada, pulverizando numa diagonal fora da linha. Só na rota do DJI e quando a volta\n         cabe antes do fim do trecho; o XAG usa estes pontos do jeito dele (voo_xag.js). */\n      const pontos=[lado1,lado2],ao=Math.hypot(o.cx-d.x,o.cz-d.z)+adiante+Math.abs(afast*s-lateralAtual),w=rota[V.i];\n      if(!window.xgVooXag&&V.estado===\"aplicando\"&&w&&Math.hypot(w.p[0]-d.x,w.p[1]-d.z)>ao+1){\n        const volta=[d.x+fx*ao,d.z+fz*ao];\n        if(trechoLivre(lado2,volta))pontos.push(volta);\n      }\n      V.desvioLat={pontos,obs:o,p:lado2};V.sonda=null;V.sondaT=.3;\n      mostrarAlerta(\"Desviando pela lateral\",\"O radar detectou \"+o.nome+\" e a aeronave está contornando pela \"+(s>0?\"esquerda\":\"direita\")+\".\",null);\n      setTimeout(()=>{if($(\"alTit\").textContent===\"Desviando pela lateral\")fecharAlerta()},2500);\n      return true;\n    }\n  }\n  return false;\n}\nfunction subirSobreObstaculo(){\n  const o=V.obs,d=drone.position,E=efetivo();\n  let topo=o?(o.tipo===\"relevo\"?o.topo:topoColisor(o)):d.y+4;\n  /* fio: a rede sobe em direção aos postes, então vale o ponto mais alto dela nos arredores */\n  if(o&&o.fio)for(const c of colisores)if(c.nome===o.nome&&Math.hypot(c.cx-d.x,c.cz-d.z)<30)topo=Math.max(topo,topoColisor(c));\n  const base=P.estab?alt(d.x,d.z)+E.altura:V.referencia+E.altura;\n  V.extraPend=Math.max(V.extra,topo-base+3.5);V.fase=\"recuo\";V.yRecuo=d.y;\n  V.obsExtra=o&&o.fio?{cx:d.x,cz:d.z,raio:22}:(o&&o.cx!==undefined?o:{cx:d.x,cz:d.z,raio:4});V.aguardaSubida=true;\n  V.recuo=[d.x-V.dirx*5,d.z-V.dirz*5];   /* recua antes de subir, para não subir para dentro do fio */\n  V.xgSobre=marcarSobre(o);V.freando=false;\n  V.estado=V.antesPairar&&V.antesPairar!==\"pairando\"?V.antesPairar:\"aplicando\";\n  V.sonda=null;V.sondaT=.8;fecharAlerta();\n}\n/* Pomar com prioridade vertical (padrão): árvore e construção a aeronave passa\n   por cima sem parar e sem deixar de pulverizar. O fio não: nele ela trava,\n   dá ré e sobe (subirSobreObstaculo). */\nfunction sobePorCima(o){\n  return !!o&&!o.fio&&o.tipo!==\"relevo\"&&V.estado===\"aplicando\"&&P.terreno===\"montanha\"&&P.xgContornar!==false\n    &&!(typeof P.xgDesvioPref===\"number\"&&P.xgDesvioPref<50);\n}\nfunction extraSobre(o){\n  const d=drone.position,E=efetivo();\n  const base=P.estab?alt(d.x,d.z)+E.altura:V.referencia+E.altura;\n  return topoColisor(o)-base+3.5;\n}\n/* começa a subir só com a antecedência que a subida (~2,5 m/s) pede, e sempre\n   antes do ponto em que o radar mandaria frear */\nfunction distanciaParaSubir(o){\n  const h=Math.max(0,extraSobre(o)-V.extra);\n  return Math.max(4+V.v*h/2.5,T50.distSeguranca+T50.raioHelice+V.v*V.v/(2*T50.frenagem)+2);\n}\nfunction passarPorCimaSemParar(o){\n  V.extra=Math.max(V.extra,extraSobre(o));V.obsExtra=o;V.obs=o;V.ultimoObs=o;\n  V.xgSobre=marcarSobre(o);\n}\n/* onde termina a passagem por cima: 6 m (T50.distPosObstaculo) além do obstáculo.\n   Fio: distância à linha da rede no chão, com sinal (positiva do lado de cá). */\nfunction marcarSobre(o){\n  const d=drone.position,fx=V.dirx,fz=V.dirz;\n  if(o&&o.fio&&o.a&&o.b){\n    const l=Math.hypot(o.b.x-o.a.x,o.b.z-o.a.z)||1;\n    let nx=-(o.b.z-o.a.z)/l,nz=(o.b.x-o.a.x)/l;\n    if((d.x-o.a.x)*nx+(d.z-o.a.z)*nz<0){nx=-nx;nz=-nz}\n    return {fio:true,obs:o,ax:o.a.x,az:o.a.z,nx,nz,i0:V.i,cruzou:false,passou:false};\n  }\n  const c=o&&o.cx!==undefined?o:{cx:d.x+fx*4,cz:d.z+fz*4,raio:1};\n  return {fio:!!(o&&o.fio),obs:o,cx:c.cx,cz:c.cz,raio:c.raio||0,fx,fz,i0:V.i,passou:false};\n}\nfunction passouObstaculo(s){\n  const d=drone.position,alem=T50.distPosObstaculo;\n  if(s.ax!==undefined){\n    const lado=(d.x-s.ax)*s.nx+(d.z-s.az)*s.nz;\n    if(lado<0)s.cruzou=true;\n    /* rota que acaba antes do fio e vira: libera longe da rede depois da curva */\n    return Math.abs(lado)>=alem&&(s.cruzou||V.i>s.i0+1);\n  }\n  const frente=(d.x-s.cx)*s.fx+(d.z-s.cz)*s.fz;\n  return frente>=s.raio+alem||(V.i>s.i0&&Math.hypot(d.x-s.cx,d.z-s.cz)>s.raio+alem);\n}\n\nfunction cair(c){\n  V.estado=\"caiu\";V.rodando=true;V.motivo=c;V.aplicando=false;\n  V.vqx=Math.cos(V.yaw)*V.v*.6;V.vqz=-Math.sin(V.yaw)*V.v*.6;V.vy=Math.min(V.vy,0);\n  fecharAlerta();\n}\nfunction quedaPasso(dt){\n  if(V.noChao)return;\n  const d=drone.position;\n  V.vy-=9.8*dt;d.y+=V.vy*dt;d.x+=V.vqx*dt;d.z+=V.vqz*dt;V.vqx*=.985;V.vqz*=.985;\n  inclina.rotation.z+=dt*2.1;inclina.rotation.x+=dt*1.2;\n  const chao=alt(d.x,d.z);\n  if(d.y<=chao+.2){\n    d.y=chao+.2;V.noChao=true;\n    for(let k=0;k<160;k++){const p=pv[proxP];proxP=(proxP+1)%NP;\n      p.x=d.x;p.z=d.z;p.y=chao+.3;const a=Math.random()*6.283,s=1+Math.random()*3;\n      p.vx=Math.cos(a)*s;p.vz=Math.sin(a)*s;p.vy=1+Math.random()*2.5;p.vida=1.2}\n    nevoa.material.color.set(\"#8b7355\");\n    setTimeout(()=>{\n      $(\"qMotivo\").textContent=\"Bateu em \"+V.motivo.nome+\".\";\n      $(\"qLicao\").textContent=V.motivo.dica||\"\";\n      $(\"queda\").hidden=false;\n    },1100);\n  }\n}\n\n/* compara a pintura com o talhão de verdade */\nfunction coberturaReal(){\n  const T=TALHAO,ix0=(T.x0-PINT.x0)*COB_PX,iz0=(T.z0-PINT.z0)*COB_PX,ix1=ix0+T.larg*COB_PX,iz1=iz0+T.prof*COB_PX;\n  let dentro=0,tot=0,fora=0,dupla=0;\n  for(let y=0;y<COB_H;y++)for(let x=0;x<COB_W;x++){\n    const n=cobN[y*COB_W+x],noT=x>=ix0&&x<ix1&&y>=iz0&&y<iz1;\n    if(noT){tot++;if(n>0)dentro++;if(n>1)dupla++}else if(n>0)fora++;\n  }\n  return {pct:dentro/tot*100,sobrePct:dupla/tot*100,foraHa:fora/(COB_PX*COB_PX)/10000};\n}\nfunction mostrarFim(){\n  const areaT=TALHAO.larg*TALHAO.prof/10000,M=mapaAtual(),cob=coberturaReal();\n  let txt=(nomeOperador()?nomeOperador()+\", a\":\"A\")+\" aeronave pousou na base. \"+cen.nome+\".\";\n  const sf=situacaoFaixa();\n  if(!sf.fecha)txt+=\" As faixas não fecharam: espaçamento de \"+nf(sf.s,1)+\" m com largura efetiva de \"+nf(sf.L,1)+\" m deixou \"+nf(sf.falha,1)+\" m sem produto entre cada passada.\";\n  else if(sf.pctSobre>30)txt+=\" Sobreposição alta: \"+nf(sf.sobre,1)+\" m de cada faixa recebe dose dobrada. Dá para abrir o espaçamento.\";\n  if(cob.pct<90)txt+=\" Ficou \"+nf(100-cob.pct,0)+\"% do talhão sem aplicação\"+(M.obstaculos.length?\" — parte é a margem em volta dos obstáculos marcados; o resto,\":\" —\")+\" confira se os pontos de limite foram marcados bem nos cantos.\";\n  if(cob.foraHa>.1)txt+=\" \"+nf(cob.foraHa,2)+\" ha foram aplicados fora do talhão.\";\n  $(\"fTexto\").textContent=txt;\n  $(\"fGrade\").innerHTML=\n    '<div><span>Área aplicada</span><b>'+nf(V.aplicado,2)+' ha</b></div>'\n   +'<div><span>Área do talhão</span><b>'+nf(areaT,2)+' ha</b></div>'\n   +'<div><span>Área mapeada</span><b>'+nf(areaPoligono(M.limite)/10000,2)+' ha</b></div>'\n   +'<div><span>Cobertura do talhão</span><b>'+nf(cob.pct,0)+'%</b></div>'\n   +'<div><span>Sobreposição</span><b>'+nf(cob.sobrePct,0)+'%</b></div>'\n   +'<div><span>Largura efetiva / espaçamento</span><b>'+nf(larguraEfetiva(),1)+' / '+nf(P.faixa,1)+' m</b></div>'\n   +'<div><span>Calda usada</span><b>'+nf(V.calda,1)+' L</b></div>'\n   +'<div><span>Reabastecimentos</span><b>'+V.recargas+'</b></div>'\n   +'<div><span>Tempo de voo</span><b>'+mmss(V.tempo)+'</b></div>'\n   +'<div><span>Dose média</span><b>'+(V.aplicado>0?nf(V.calda/V.aplicado,1):\"0,0\")+' L/ha</b></div>';\n  $(\"fim\").hidden=false;\n}\n\n/* ===================================================================\n   HUD, RADAR E CÂMERA\n   =================================================================== */\nconst ROTULO={\"em solo\":\"Em solo\",subindo:\"Decolando\",indo:\"Roteamento de conexão\",descendo:\"Descendo para a faixa\",aplicando:\"Tarefa em andamento\",\n  voltando:\"Retorno à base (RTH)\",pousando:\"Pousando\",reabastecendo:\"Reabastecendo\",pairando:\"Voo estacionário\",caiu:\"Aeronave perdida\",\"concluído\":\"Concluído\"};\nfunction hud(){\n  const d=drone.position;\n  $(\"tEstado\").textContent=ROTULO[V.estado]||V.estado;\n  {const mp=P.modo===\"facil\"?\"Modo fácil\":\"Modo padrão\",ct=window.TPD_TRADUCOES||{},md=ct[mp]||[mp,mp],nm=ct[cen.nome]||[cen.nome,cen.nome],pt=mp+\" · Rota · \"+cen.nome;$(\"tModo\").textContent=window.XG_TR?XG_TR.reg(pt,md[0]+\" · Route · \"+nm[0],md[1]+\" · Ruta · \"+nm[1]):pt}\n  const cls=(el,c)=>{el.className=c||\"\"};\n  $(\"hBat\").textContent=nf(V.bat,0)+\"%\";cls($(\"hBat\"),V.bat<=15?\"cr\":V.bat<=25?\"al\":\"\");\n  $(\"hTan\").textContent=nf(V.tan,1)+\" L\";cls($(\"hTan\"),V.tan<3?\"cr\":V.tan<8?\"al\":\"\");\n  $(\"hVaz\").textContent=nf(V.vazaoAtual||0,1)+\" L/min\";cls($(\"hVaz\"),V.subdose&&V.aplicando?\"al\":\"\");\n  $(\"hVel\").textContent=nf(V.v,1)+\" m/s\";\n  $(\"hAgl\").textContent=nf(Math.max(0,d.y-alt(d.x,d.z)),1)+\" m\";\n  $(\"hApl\").textContent=nf(V.aplicado,2)+\" ha\";\n}\n\nconst rc=$(\"radar\"),rg=rc.getContext(\"2d\");\nfunction desenharRadar(){\n  const W=rc.width,H=rc.height,cx=W/2,cy=H/2,R=W*.36;\n  rg.clearRect(0,0,W,H);\n  rg.fillStyle=\"rgba(10,12,16,.72)\";rg.beginPath();rg.arc(cx,cy,R+26,0,7);rg.fill();\n  /* setores: obstáculos ao redor, relativos à frente da aeronave */\n  if(P.desvio&&V.estado!==\"em solo\"){\n    const d=drone.position,SET=16,melhor=new Array(SET).fill(Infinity);\n    for(const c of colisores){\n      const dxz=Math.hypot(c.cx-d.x,c.cz-d.z)-c.raio;\n      if(dxz>T50.radarAlcance)continue;\n      if(c.seca&&velHorizontal()>T50.velArvoreSeca)continue;\n      const lim=c.fio?T50.alcanceFio:T50.radarAlcance;\n      const p=new THREE.Vector3(d.x,d.y+.3,d.z),dist=distColisor(c,p);\n      if(dist>lim)continue;\n      if(c.tipo!==\"seg\"&&(d.y>c.y1+4))continue;\n      let ang=Math.atan2(-(c.cz-d.z),c.cx-d.x)-V.yaw;\n      if(c.tipo===\"seg\"){tmpA.subVectors(c.b,c.a);tmpB.subVectors(p,c.a);const t=trava(tmpB.dot(tmpA)/tmpA.lengthSq(),0,1);\n        tmpA.multiplyScalar(t).add(c.a);ang=Math.atan2(-(tmpA.z-d.z),tmpA.x-d.x)-V.yaw}\n      let s=Math.round(((ang%(2*Math.PI))+2*Math.PI)%(2*Math.PI)/(2*Math.PI)*SET)%SET;\n      melhor[s]=Math.min(melhor[s],dist);\n    }\n    for(let s=0;s<SET;s++){\n      if(melhor[s]===Infinity)continue;\n      const dist=melhor[s],cor=dist<6?\"#F04438\":dist<15?\"#F5A524\":\"#32D583\";\n      const a0=-Math.PI/2-(s+.42)*(2*Math.PI/SET),a1=-Math.PI/2-(s-.42)*(2*Math.PI/SET);\n      rg.strokeStyle=cor;rg.lineWidth=12;rg.beginPath();rg.arc(cx,cy,R+11,a0,a1);rg.stroke();\n      if(s===0||dist<6){rg.fillStyle=cor;rg.font=\"600 22px Roboto Mono, monospace\";rg.textAlign=\"center\";\n        const am=(a0+a1)/2;rg.fillText(nf(dist,0),cx+Math.cos(am)*(R-20),cy+Math.sin(am)*(R-20)+8)}\n    }\n  }\n  rg.strokeStyle=P.desvio?\"rgba(255,255,255,.35)\":\"#F04438\";rg.lineWidth=P.desvio?2:5;\n  rg.beginPath();rg.arc(cx,cy,R,0,7);rg.stroke();\n  rg.strokeStyle=\"rgba(255,255,255,.12)\";rg.lineWidth=1.5;rg.beginPath();rg.arc(cx,cy,R*.55,0,7);rg.stroke();\n  /* ponto de origem */\n  const d=drone.position,ah=Math.atan2(-(BASE.z-d.z),BASE.x-d.x)-V.yaw,dh=Math.hypot(BASE.x-d.x,BASE.z-d.z);\n  const rh=Math.min(R*.92,R*.2+dh/4);\n  rg.fillStyle=\"#F5A524\";rg.font=\"700 24px Roboto, sans-serif\";rg.textAlign=\"center\";\n  rg.fillText(\"H\",cx+Math.cos(-Math.PI/2-ah)*rh,cy+Math.sin(-Math.PI/2-ah)*rh+8);\n  /* aeronave apontando para cima */\n  rg.fillStyle=\"#fff\";rg.beginPath();rg.moveTo(cx,cy-18);rg.lineTo(cx+13,cy+14);rg.lineTo(cx,cy+7);rg.lineTo(cx-13,cy+14);rg.closePath();rg.fill();\n  /* barra vertical: distância ao chão */\n  const agl=Math.max(0,d.y-alt(d.x,d.z)),bx=18,by0=H*.2,by1=H*.8;\n  rg.fillStyle=\"rgba(255,255,255,.15)\";rg.fillRect(bx,by0,8,by1-by0);\n  const f=trava(agl/15,0,1);rg.fillStyle=agl<1.5?\"#F04438\":agl<2.5?\"#F5A524\":\"#32D583\";\n  rg.fillRect(bx,by1-(by1-by0)*f,8,(by1-by0)*f);\n  if(!P.desvio){rg.fillStyle=\"#F04438\";rg.font=\"600 18px Roboto, sans-serif\";rg.fillText(\"DESVIO OFF\",cx,H-8)}\n}\n\nlet seguir=true;const camPos=new THREE.Vector3(),camAlvo=new THREE.Vector3();\nfunction posCamera(instantaneo,dt){\n  if(modoMapa||telaInicial)return;\n  if(vista===\"operador\"){\n    const o=grupoOperador.position,d=drone.position;\n    let dx=d.x-o.x,dz=d.z-o.z;const l=Math.hypot(dx,dz);\n    if(l<.5){dx=Math.sin(grupoOperador.rotation.y);dz=Math.cos(grupoOperador.rotation.y)}else{dx/=l;dz/=l}\n    camPos.set(o.x-dx*1.45-dz*.7,o.y+1.68,o.z-dz*1.45+dx*.7);\n    camPos.y=Math.max(camPos.y,alt(camPos.x,camPos.z)+1.2);\n    /* olha para o drone, mas sem inclinar a ponto de o operador sair do quadro:\n       acima de ~12° o ombro some por baixo da tela */\n    const hz=Math.max(1,Math.hypot(d.x-camPos.x,d.z-camPos.z));\n    const subida=Math.min(d.y+.4-camPos.y,hz*Math.tan(12*Math.PI/180));\n    camAlvo.set(d.x,camPos.y+subida,d.z);\n    cam.fov=55;cam.updateProjectionMatrix();\n    if(instantaneo){cam.position.copy(camPos);orb.target.copy(camAlvo);return}\n    const k=1-Math.exp(-dt*4);cam.position.lerp(camPos,k);orb.target.lerp(camAlvo,Math.min(1,k*2));\n    return;\n  }\n  if(!seguir)return;\n  const d=drone.position,tx=-Math.cos(V.yaw),tz=Math.sin(V.yaw);\n  const oh=xgOrb.dist*Math.cos(xgOrb.el),oc=Math.cos(xgOrb.az)*oh,os=Math.sin(xgOrb.az)*oh;   /* órbita e zoom do aluno (xgOrb) */\n  camPos.set(d.x+tx*oc+tz*os,d.y+.5+xgOrb.dist*Math.sin(xgOrb.el),d.z+tz*oc-tx*os);\n  camPos.y=Math.max(camPos.y,alt(camPos.x,camPos.z)+1.6);\n  camAlvo.set(d.x,d.y+.5,d.z);\n  if(instantaneo){cam.position.copy(camPos);orb.target.copy(camAlvo);return}\n  if(xgOrb.mexendo||performance.now()<xgOrb.ate){   /* o aluno está girando ou dando zoom: a câmera é dele; só acompanha o deslocamento do drone */\n    cam.position.x+=camAlvo.x-orb.target.x;cam.position.y+=camAlvo.y-orb.target.y;cam.position.z+=camAlvo.z-orb.target.z;orb.target.copy(camAlvo);return}\n  const k=1-Math.exp(-dt*3.2*Math.max(1,V.mult));\n  cam.position.lerp(camPos,k);orb.target.lerp(camAlvo,Math.min(1,k*2.2));\n}\n\n/* ===================================================================\n   CONTROLES\n   =================================================================== */\n/* sem acelerar o tempo: o treino e sempre 1x (o botao fica escondido e sem efeito) */\n$(\"bVel\").onclick=()=>{V.mult=1};\n$(\"bPausa\").onclick=e=>{V.rodando=!V.rodando;e.target.textContent=V.rodando?\"Pausar\":\"Continuar\"};\n$(\"bRth\").onclick=()=>{\n  if([\"aplicando\",\"indo\",\"pairando\",\"subindo\",\"descendo\"].includes(V.estado)){\n    iniciarRetorno(V.estado===\"aplicando\"||V.estado===\"pairando\"?pontoAtual():V.retomar);V.rodando=true;\n  }else if(V.estado===\"manual\"&&drone.position.y-alt(drone.position.x,drone.position.z)>=.3){\n    /* 24/10/2026: voo manual no ar tambem volta (antes so a rota voltava): o mesmo do \"rth\" do app (app_rcplus.js).\n       Guarda o ponto de interrupcao e volta pela altitude RTH; no chao nao faz nada. */\n    if(typeof xgGravarInterrupcao===\"function\")xgGravarInterrupcao();\n    V.xgFreio=false;iniciarRetorno(V.retomar);V.rodando=true;fecharAlerta();\n  }\n};\n$(\"bCen\").onclick=()=>{V.rodando=false;$(\"bPausa\").textContent=\"Continuar\";abrirPainel()};\n$(\"qDenovo\").onclick=()=>{reiniciarVoo();decolar()};\n$(\"qConfig\").onclick=()=>{$(\"queda\").hidden=true;reiniciarVoo();abrirPainel()};\n$(\"fDenovo\").onclick=()=>{reiniciarVoo();decolar()};\n$(\"fCampos\").onclick=()=>{$(\"fim\").hidden=true;reiniciarVoo();abrirPainel()};\n\nfunction decolar(){\n  if(!rota.length){mostrarAlerta(\"Sem rota\",\"O mapa não gerou nenhuma faixa. Confira os pontos de limite e o espaçamento de rota.\",[{txt:\"Ok\",fn:()=>abrirPainel()}]);return}\n  V.retomar={p:rota[0].p,i:1};   /* sobe na altitude RTH e vai até o início da primeira faixa */\n  V.estado=\"subindo\";V.rodando=true;V.xgApitou=false;V.xgApito=0;$(\"bPausa\").textContent=\"Pausar\";\n}\n\n/* verificação automática antes da tarefa */\nfunction abrirVerificacao(){\n  const E=efetivo(),M=mapaAtual(),area=areaPoligono(M.limite)/10000,litros=area*P.vazao;\n  const ha_s=P.faixa*E.vel/10000,lmin=ha_s*P.vazao*60;\n  $(\"vCampo\").textContent=cen.nome+\" · \"+nf(area,2)+\" ha · \"+nf(litros,0)+\" L de calda previstos\";\n  const linhas=[\n    [\"Mapa\",(M.pronto?\"Pronto · \":\"\")+M.limite.length+\" pontos · \"+M.obstaculos.length+\" obstáculo\"+(M.obstaculos.length===1?\"\":\"s\"),M.pronto?\"al\":\"ok\"],\n    [\"Bateria\",\"100%\",\"ok\"],[\"Tanque de pulverização\",\"40,0 L\",\"ok\"],[\"RTK\",\"FIX\",\"ok\"],\n    [\"Altura acima das culturas\",nf(E.altura,1)+\" m\"+(E.altura!==P.altura?\" (limitada)\":\"\"),E.altura!==P.altura?\"al\":\"ok\"],\n    [\"Velocidade\",nf(E.vel,1)+\" m/s\"+(E.vel!==P.vel?\" (limitada)\":\"\"),E.vel!==P.vel?\"al\":\"ok\"],\n    [\"Vazão necessária\",nf(lmin,1)+\" L/min\",lmin>T50.vazaoMaxLmin?\"al\":\"ok\"],\n    (sf=>[\"Faixa de aplicação\",nf(sf.L,1)+\" m em \"+nf(sf.s,1)+\" m · \"+(sf.fecha?\"fecha\":\"falha de \"+nf(sf.falha,1)+\" m\"),sf.fecha?\"ok\":\"al\"])(situacaoFaixa()),\n    [\"Altitude RTH\",nf(P.rth,0)+\" m\",\"ok\"],\n    [\"Roteamento de conexão\",\"Direto\",\"ok\"],\n    [\"Desvio de obstáculos\",P.desvio?\"Ligado\":\"Desligado\",P.desvio?\"ok\":\"al\"],\n    [\"Terreno da tarefa\",{planicie:\"Planícies\",montanha:\"Montanhas e pomares\",agua:\"Acima da água\"}[P.terreno],\n      P.terreno===cen.terrenoSugerido?\"ok\":\"al\"],\n  ];\n  $(\"vLista\").innerHTML=linhas.map(l=>'<div class=\"check\"><span class=\"n\">'+l[0]+'</span><span class=\"r '+l[2]+'\">'+l[1]+'</span></div>').join(\"\")\n    +(lmin>T50.vazaoMaxLmin?'<p class=\"licao\" style=\"margin-top:8px\">A bomba do T50 entrega no máximo 16 L/min. Com essa combinação a dose real vai ficar abaixo de '+nf(P.vazao,0)+' L/ha. Reduza velocidade ou espaçamento.</p>':\"\");\n  $(\"vDesl\").value=0;$(\"verif\").hidden=false;\n}\n$(\"vDesl\").addEventListener(\"input\",e=>{\n  if(+e.target.value>=97){$(\"verif\").hidden=true;e.target.value=0;reiniciarVoo();decolar()}\n});\n$(\"vDesl\").addEventListener(\"change\",e=>{if(+e.target.value<97)e.target.value=0});\n$(\"vCancel\").onclick=()=>{$(\"verif\").hidden=true;abrirPainel()};\n\n/* painel de campos */\nfunction abrirPainel(){$(\"painel\").hidden=false;montarLista()}\nfunction atualizarMapaPainel(){\n  const M=mapaAtual(),el=$(\"mapaSt\"),n=M?M.obstaculos.length:0;\n  if(!M){el.className=\"mapaSt vazio\";el.textContent=\"Campo ainda não mapeado. Caminhe com o controle marcando os pontos, ou use o mapa pronto.\";}\n  else{el.className=\"mapaSt\";const ha=nf(areaPoligono(M.limite)/10000,2),pl=n===1?\"\":\"s\",pt=(M.pronto?\"Mapa pronto · \":\"Mapeado caminhando · \")+ha+\" ha · \"+M.limite.length+\" pontos de limite · \"+n+\" obstáculo\"+pl+\" marcado\"+pl;\n    el.textContent=window.XG_TR?XG_TR.reg(pt,(M.pronto?\"Ready-made map · \":\"Mapped by walking · \")+ha.replace(\",\",\".\")+\" ha · \"+M.limite.length+\" boundary points · \"+n+\" obstacle\"+pl+\" marked\",(M.pronto?\"Mapa listo · \":\"Mapeado caminando · \")+ha+\" ha · \"+M.limite.length+\" puntos de límite · \"+n+\" obstáculo\"+pl+\" marcado\"+pl):pt;}\n  $(\"bMapear\").textContent=M&&!M.pronto?\"Editar mapa caminhando\":\"Mapear caminhando\";\n  $(\"iniciar\").disabled=!M;\n}\nfunction montarLista(){\n  $(\"listaCen\").innerHTML=CENARIOS.map(c=>\n    '<button data-c=\"'+c.id+'\" aria-pressed=\"'+(c===cen)+'\"><span class=\"t\">'+c.nome\n    +' <span class=\"nv '+c.nivel[1]+'\">'+c.nivel[0]+'</span></span><span class=\"d\">'+c.desc+'</span></button>').join(\"\");\n  $(\"listaCen\").querySelectorAll(\"[data-c]\").forEach(b=>b.onclick=()=>{\n    const c=CENARIOS.find(x=>x.id===b.dataset.c);if(c===cen)return;\n    construirCenario(c);reiniciarVoo();posCamera(true,0);montarLista();\n  });\n  atualizarMapaPainel();\n}\nfunction segmento(id,chave,ajuda){\n  const botoes=$(id).querySelectorAll(\"button\");\n  const at=()=>{botoes.forEach(b=>b.setAttribute(\"aria-pressed\",b.dataset.v===P[chave]));if(ajuda)ajuda()};\n  botoes.forEach(b=>b.onclick=()=>{P[chave]=b.dataset.v;at()});at();\n}\n/* tela de início */\nlet telaInicial=true,angInicio=.6;\n/* o nome vem do cadastro do aluno (sessão do site); sem sessão, fica sem nome */\nconst nomeOperador=()=>{\n  try{const s=JSON.parse(localStorage.getItem(\"tpd_sessao\")||\"null\");return String((s&&s.aluno)||\"\").trim().slice(0,32)}catch(e){return \"\"}\n};\n{const o=$(\"olaOp\"),n=nomeOperador();\n if(n){const tx=\"Operador: \"+n.replace(/\\s+/g,\" \");o.textContent=window.XG_TR?XG_TR.reg(tx,\"Operator: \"+n.replace(/\\s+/g,\" \"),tx):tx;o.hidden=false}}\nfunction abrirInicio(){\n  telaInicial=true;V.rodando=false;\n  if(window.PAUSA_SIM) PAUSA_SIM.definirOperacao(false);\n  $(\"painel\").hidden=true;$(\"inicio\").hidden=false;document.body.classList.add(\"telaInicio\");\n  orb.enabled=false;fecharAlerta();\n}\nfunction comecar(){\n  telaInicial=false;$(\"inicio\").hidden=true;document.body.classList.remove(\"telaInicio\");\n  aplicarVista();posCamera(true,0);abrirPainel();\n  if(window.PAUSA_SIM) PAUSA_SIM.definirOperacao(true);\n}\n/* câmera girando devagar em volta da base: operador, drone e camionete */\nfunction orbitarInicio(dt){\n  angInicio+=dt*.045;\n  const cx=BASE.x-1,cz=BASE.z+4,y=alt(cx,cz);\n  cam.position.set(cx+Math.sin(angInicio)*21,y+4.2,cz+Math.cos(angInicio)*21);\n  cam.position.y=Math.max(cam.position.y,alt(cam.position.x,cam.position.z)+1.5);\n  cam.lookAt(cx-2.5,y+1.4,cz);\n}\n$(\"bComecar\").onclick=comecar;\n$(\"bInicio\").onclick=abrirInicio;\n$(\"bVoltarDrones\").onclick=function(){\n  /* o campo roda dentro do sim.html: quem troca de página é a janela de cima */\n  var alvo=\"/treinamento/conta/drones.html\";\n  try{window.top.location.href=alvo;}catch(e){location.href=alvo;}\n};\nsegmento(\"segModo\",\"modo\",()=>{$(\"ajModo\").textContent=P.modo===\"facil\"\n  ?\"A aeronave faz RTH sozinha quando o tanque esvazia, a bateria fica fraca ou a operação termina.\"\n  :\"Com tanque vazio ou operação concluída a aeronave fica em voo estacionário. Bateria fraca é só aviso — quem decide voltar é o operador.\"});\nsegmento(\"segTerreno\",\"terreno\",()=>{$(\"ajTerreno\").textContent={\n  planicie:\"Para áreas planas. Desvia de obstáculos pela lateral e para se não conseguir.\",\n  montanha:\"Para relevo ondulado e pomares. Desvia de obstáculos por cima. Em área plana pode subir demais perto de postes e árvores.\",\n  agua:\"Para voar sobre água. Desvia pela lateral.\"}[P.terreno]});\nconst liga=(id,chave)=>{$(id).onclick=()=>{P[chave]=!P[chave];$(id).setAttribute(\"aria-pressed\",P[chave])}};\nliga(\"tDesvio\",\"desvio\");liga(\"tEstab\",\"estab\");\nconst faixa=(id,out,chave,un,dec)=>{const el=$(id),o=$(out);\n  const at=()=>{P[chave]=parseFloat(el.value);o.textContent=nf(P[chave],dec)+\" \"+un};el.oninput=at;at()};\nfaixa(\"pAlt\",\"oAlt\",\"altura\",\"m\",1);faixa(\"pVel\",\"oVel\",\"vel\",\"m/s\",1);faixa(\"pFai\",\"oFai\",\"faixa\",\"m\",1);\nfaixa(\"pVaz\",\"oVaz\",\"vazao\",\"L/ha\",0);faixa(\"pRth\",\"oRth\",\"rth\",\"m\",0);faixa(\"pGota\",\"oGota\",\"gota\",\"μm\",0);\n/* diagrama: três passadas vistas de cima, com a largura efetiva de cada uma */\nfunction desenharFaixas(){\n  const cv=$(\"cFaixa\"),g=cv.getContext(\"2d\"),W=cv.width,H=cv.height,sf=situacaoFaixa();\n  const vista=Math.max(sf.s*3+sf.L,sf.s*4),esc=W/vista,x0=W/2-sf.s*esc;\n  g.clearRect(0,0,W,H);g.fillStyle=\"#6f5c43\";g.fillRect(0,0,W,H);\n  /* chão seco entre as faixas */\n  g.strokeStyle=\"rgba(0,0,0,.12)\";g.lineWidth=2;for(let x=0;x<W;x+=14){g.beginPath();g.moveTo(x,0);g.lineTo(x,H);g.stroke()}\n  for(let k=-1;k<=3;k++){\n    const cx=x0+k*sf.s*esc;\n    g.fillStyle=\"rgba(38,29,18,.42)\";g.fillRect(cx-sf.L/2*esc,0,sf.L*esc,H);\n    g.fillStyle=\"rgba(38,29,18,.38)\";g.fillRect(cx-sf.L*.275*esc,0,sf.L*.55*esc,H);\n  }\n  /* emendas: falha em vermelho, sobreposição em azul */\n  for(let k=-1;k<=2;k++){\n    const meio=x0+(k+.5)*sf.s*esc;\n    if(!sf.fecha){g.fillStyle=\"rgba(240,68,56,.55)\";g.fillRect(meio-sf.falha/2*esc,0,sf.falha*esc,H)}\n    else if(sf.sobre>.05){g.fillStyle=\"rgba(47,128,237,.35)\";g.fillRect(meio-sf.sobre/2*esc,0,sf.sobre*esc,H)}\n  }\n  g.setLineDash([12,10]);g.strokeStyle=\"rgba(255,255,255,.85)\";g.lineWidth=3;\n  for(let k=-1;k<=3;k++){const cx=x0+k*sf.s*esc;g.beginPath();g.moveTo(cx,0);g.lineTo(cx,H);g.stroke()}\n  g.setLineDash([]);\n  /* drone na passada do meio */\n  const dx=x0+sf.s*esc;g.fillStyle=\"#fff\";g.beginPath();g.moveTo(dx,H*.3);g.lineTo(dx+16,H*.62);g.lineTo(dx,H*.52);g.lineTo(dx-16,H*.62);g.closePath();g.fill();\n  const E=efetivo();\n  if(window.XG_TR){const en=(x,d)=>nf(x,d).replace(\",\",\".\"),a1=nf(sf.L,1),a2=nf(P.gota,0),a3=nf(E.altura,1);\n    XG_TR.reg(\"Largura efetiva ≈ \"+a1+\" m (gota \"+a2+\" μm a \"+a3+\" m).\",\"Effective width ≈ \"+en(sf.L,1)+\" m (droplet \"+a2+\" μm at \"+en(E.altura,1)+\" m).\",\"Ancho efectivo ≈ \"+a1+\" m (gota \"+a2+\" μm a \"+a3+\" m).\");\n    if(sf.fecha&&sf.sobre>.05){const s=nf(sf.sobre,1),t=sf.pctSobre>30;XG_TR.reg(\"com \"+s+\" m de sobreposição\"+(t?\" — alta, gasta produto e dobra a dose.\":\".\"),\"with \"+en(sf.sobre,1)+\" m of overlap\"+(t?\" — high, wastes product and doubles the dose.\":\".\"),\"con \"+s+\" m de solapamiento\"+(t?\" — alta, gasta producto y duplica la dosis.\":\".\"))}\n    if(!sf.fecha){const f=nf(sf.falha,1);XG_TR.reg(\": \"+f+\" m sem produto entre cada passada. Diminua o espaçamento, suba um pouco ou use gota maior.\",\": \"+en(sf.falha,1)+\" m without product between each pass. Reduce the spacing, climb a little or use a larger droplet.\",\": \"+f+\" m sin producto entre cada pasada. Reduce el espaciado, sube un poco o usa una gota mayor.\")}}\n  $(\"ajFaixa\").innerHTML=\"Largura efetiva ≈ \"+nf(sf.L,1)+\" m (gota \"+nf(P.gota,0)+\" μm a \"+nf(E.altura,1)+\" m). \"\n    +(sf.fecha\n      ?'<b class=\"ok\">As faixas fecham</b>'+(sf.sobre>.05?\" com \"+nf(sf.sobre,1)+\" m de sobreposição\"+(sf.pctSobre>30?\" — alta, gasta produto e dobra a dose.\":\".\"):\".\")\n      :'<b class=\"al\">As faixas não fecham</b>: '+nf(sf.falha,1)+\" m sem produto entre cada passada. Diminua o espaçamento, suba um pouco ou use gota maior.\");\n}\nfor(const id of [\"pAlt\",\"pFai\",\"pGota\",\"pVel\"])$(id).addEventListener(\"input\",desenharFaixas);\nfor(const id of [\"tDesvio\"])$(id).addEventListener(\"click\",desenharFaixas);\ndesenharFaixas();\n$(\"iniciar\").onclick=()=>{if(!mapaAtual())return;$(\"painel\").hidden=true;reiniciarVoo();abrirVerificacao()};\n$(\"bMapear\").onclick=()=>{$(\"painel\").hidden=true;entrarMapa()};\n$(\"bPronto\").onclick=()=>{salvarMapa(mapaPronto());desenharMapa3D();atualizarMapaPainel()};\nmontarLista();\n\n/* ===================================================================\n   MAPEAMENTO CAMINHANDO\n   =================================================================== */\nlet modoMapa=false,ME=null,histMapa=[],tipoMarca=\"limite\",fundoMapa=null;\nconst grupoMapa=new THREE.Group();cena.add(grupoMapa);\nconst andar={yaw:Math.PI,pitch:.32,dist:4.2,fase:0,amp:0,teclas:{},arrasta:null};\nconst COR_LIM=\"#32D583\",COR_OBS=\"#F04438\";\n\nfunction desenharMapa3D(){\n  for(const o of [...grupoMapa.children]){grupoMapa.remove(o);o.traverse(x=>{if(x.geometry)x.geometry.dispose();if(x.material)x.material.dispose()})}\n  const M=modoMapa?ME:mapaAtual();if(!M)return;\n  const linha=(pts,fechado,cor)=>{\n    if(pts.length<2)return;const v=[],seq=fechado?pts.concat([pts[0]]):pts;\n    for(let i=0;i+1<seq.length;i++){const a=seq[i],b=seq[i+1],n=Math.max(1,Math.ceil(Math.hypot(b[0]-a[0],b[1]-a[1])/2));\n      for(let k=0;k<n;k++){const x=a[0]+(b[0]-a[0])*k/n,z=a[1]+(b[1]-a[1])*k/n;v.push(new THREE.Vector3(x,alt(x,z)+.3,z))}}\n    const u=seq[seq.length-1];v.push(new THREE.Vector3(u[0],alt(u[0],u[1])+.3,u[1]));\n    grupoMapa.add(new THREE.Line(new THREE.BufferGeometry().setFromPoints(v),new THREE.LineBasicMaterial({color:cor})));\n  };\n  const pino=(p,cor)=>{\n    const g=new THREE.Group(),y=alt(p[0],p[1]);\n    const h=new THREE.Mesh(new THREE.CylinderGeometry(.025,.025,1.1,6),new THREE.MeshBasicMaterial({color:\"#e8eef0\"}));h.position.y=.55;\n    const b=new THREE.Mesh(new THREE.SphereGeometry(.13,12,8),new THREE.MeshBasicMaterial({color:cor}));b.position.y=1.15;\n    g.add(h,b);g.position.set(p[0],y,p[1]);grupoMapa.add(g);\n  };\n  linha(M.limite,M.limite.length>=3,COR_LIM);if(modoMapa)M.limite.forEach(p=>pino(p,COR_LIM));\n  for(const o of M.obstaculos){\n    if(o.tipo===\"circulo\"){const pts=[];for(let k=0;k<40;k++){const a=k/40*2*Math.PI;pts.push([o.c[0]+Math.cos(a)*o.r,o.c[1]+Math.sin(a)*o.r])}\n      linha(pts,true,COR_OBS);if(modoMapa)pino(o.c,COR_OBS)}\n    else{linha(o.pts,true,COR_OBS);if(modoMapa)o.pts.forEach(p=>pino(p,COR_OBS))}\n  }\n  if(modoMapa&&ME.obsAtual.length){linha(ME.obsAtual,false,\"#F5A524\");ME.obsAtual.forEach(p=>pino(p,\"#F5A524\"))}\n}\n\nfunction entrarMapa(){\n  modoMapa=true;V.rodando=false;\n  const M=mapaAtual();\n  ME=M&&!M.pronto?{limite:M.limite.map(p=>p.slice()),obstaculos:JSON.parse(JSON.stringify(M.obstaculos)),obsAtual:[]}:{limite:[],obstaculos:[],obsAtual:[]};\n  histMapa=[];\n  const ox=BASE.x-5,oz=BASE.z+5; /* fora do raio de bloqueio de 6 m */grupoOperador.position.set(ox,alt(ox,oz),oz);\n  andar.yaw=Math.PI;grupoOperador.rotation.y=andar.yaw;andar.pitch=.32;andar.dist=4.2;andar.amp=0;andar.teclas={};\n  orb.enabled=false;\n  for(const id of [\"topo\",\"radar\",\"bar\"])$(id).hidden=true;\n  $(\"mapaUi\").hidden=false;\n  let visto=false;try{visto=localStorage.getItem(\"t50_ajuda_mapa\")===\"1\"}catch(e){}\n  $(\"mAjuda\").hidden=visto;\n  aplicarVista();\n  definirTipo(\"limite\");desenharMapa3D();\n}\nfunction sairMapa(){\n  modoMapa=false;ME=null;andar.amp=0;\n  pose(0);\n  const ox=BASE.x-5,oz=BASE.z+5; /* fora do raio de bloqueio de 6 m */grupoOperador.position.set(ox,alt(ox,oz),oz);grupoOperador.rotation.y=Math.PI*.85+Math.PI;\n  orb.enabled=true;\n  for(const id of [\"topo\",\"radar\",\"bar\"])$(id).hidden=false;\n  $(\"mapaUi\").hidden=true;$(\"mFim\").hidden=true;fecharAlerta();\n  aplicarVista();\n  desenharMapa3D();posCamera(true,0);\n}\nfunction definirTipo(v){\n  if(ME&&v!==tipoMarca&&ME.obsAtual.length){\n    if(ME.obsAtual.length>=3)fecharObstaculo();else{guardar();ME.obsAtual=[]}\n  }\n  tipoMarca=v;\n  $(\"mTipo\").querySelectorAll(\"button\").forEach(b=>b.setAttribute(\"aria-pressed\",b.dataset.v===v));\n  $(\"mRaio\").hidden=v!==\"circulo\";$(\"mFechar\").hidden=v!==\"poligono\";\n  const TRd=(p,e,s)=>window.XG_TR?XG_TR.reg(p,e,s):p;\n  $(\"mDica\").textContent={\n    limite:\"Pare em cima de cada canto do talhão e marque. Siga a borda em ordem, sem cruzar o meio.\",\n    poligono:TRd(\"Caminhe em volta do obstáculo marcando pontos (no mínimo 3) e feche. A rota passa a \"+MARGEM_OBS+\" m dele.\",\"Walk around the obstacle marking points (at least 3) and close it. The route stays \"+MARGEM_OBS+\" m away from it.\",\"Camina alrededor del obstáculo marcando puntos (mínimo 3) y ciérralo. La ruta pasa a \"+MARGEM_OBS+\" m de él.\"),\n    circulo:TRd(\"Pare junto ao obstáculo, ajuste o raio para cobrir a copa ou a estrutura inteira e marque. A rota passa a \"+MARGEM_OBS+\" m além do raio.\",\"Stand next to the obstacle, adjust the radius to cover the whole canopy or structure and mark it. The route stays \"+MARGEM_OBS+\" m beyond the radius.\",\"Párate junto al obstáculo, ajusta el radio para cubrir toda la copa o la estructura y márcalo. La ruta pasa a \"+MARGEM_OBS+\" m más allá del radio.\")}[v];\n  if(ME)desenharMapa3D();\n}\nconst guardar=()=>{histMapa.push(JSON.stringify(ME));if(histMapa.length>200)histMapa.shift()};\nfunction marcarPonto(){\n  if(!modoMapa)return;\n  const o=grupoOperador.position,p=[Math.round(o.x*100)/100,Math.round(o.z*100)/100];\n  guardar();\n  if(tipoMarca===\"limite\")ME.limite.push(p);\n  else if(tipoMarca===\"poligono\")ME.obsAtual.push(p);\n  else ME.obstaculos.push({tipo:\"circulo\",c:p,r:+$(\"mRaioIn\").value});\n  desenharMapa3D();\n}\nfunction fecharObstaculo(){\n  if(ME.obsAtual.length<3){mostrarAlerta(\"Obstáculo incompleto\",\"Marque pelo menos 3 pontos em volta do obstáculo antes de fechar.\",[{txt:\"Ok\",fn:()=>{}}]);return}\n  guardar();ME.obstaculos.push({tipo:\"poligono\",pts:ME.obsAtual});ME.obsAtual=[];desenharMapa3D();\n}\nfunction desfazer(){if(histMapa.length){ME=JSON.parse(histMapa.pop());desenharMapa3D()}}\nfunction concluirMapa(){\n  if(ME.obsAtual.length>=3)fecharObstaculo();else ME.obsAtual=[];\n  if(ME.limite.length<3){mostrarAlerta(\"Faltam pontos de limite\",\"Marque pelo menos 3 pontos no contorno do talhão para fechar o campo.\",[{txt:\"Ok\",fn:()=>{}}]);return}\n  const m={limite:ME.limite.map(p=>p.slice()),obstaculos:JSON.parse(JSON.stringify(ME.obstaculos))};salvarMapa(m);\n  const area=areaPoligono(m.limite)/10000;\n  $(\"mFimTxt\").textContent=cen.nome+\". A rota vai ser gerada dentro do contorno marcado, afastada \"+nf(MARGEM_BORDA,1)+\" m da borda e \"+MARGEM_OBS+\" m dos obstáculos.\";\n  $(\"mFimGrade\").innerHTML='<div><span>Área</span><b>'+nf(area,2)+' ha</b></div>'\n    +'<div><span>Perímetro</span><b>'+nf(perimetro(m.limite,true),0)+' m</b></div>'\n    +'<div><span>Pontos de limite</span><b>'+m.limite.length+'</b></div>'\n    +'<div><span>Obstáculos</span><b>'+m.obstaculos.length+'</b></div>';\n  $(\"mFim\").hidden=false;\n}\n\n/* pernas: balanço procedural sobre a pose parada */\nfunction pose(fase){\n  const g=grupoOperador.children[0];if(!g||!g.userData.B)return;\n  const B=g.userData.B,R=g.userData.repouso,amp=andar.amp;\n  for(const n in R)B[n].quaternion.copy(R[n]);\n  if(amp<.01){g.userData.av.position.y=g.userData.avY;return}\n  grupoOperador.updateMatrixWorld(true);\n  const qf=g.getWorldQuaternion(new THREE.Quaternion());\n  const apontar=(osso,filho,dir)=>{\n    g.userData.av.updateMatrixWorld(true);\n    const a=new THREE.Vector3().setFromMatrixPosition(B[osso].matrixWorld),b=new THREE.Vector3().setFromMatrixPosition(B[filho].matrixWorld);\n    const alvo=new THREE.Vector3(...dir).normalize().applyQuaternion(qf);\n    const dq=new THREE.Quaternion().setFromUnitVectors(b.sub(a).normalize(),alvo);\n    const wq=B[osso].getWorldQuaternion(new THREE.Quaternion()),pq=B[osso].parent.getWorldQuaternion(new THREE.Quaternion());\n    B[osso].quaternion.copy(pq.invert().multiply(dq.multiply(wq)));\n  };\n  for(const [lado,f] of [[\"l\",fase],[\"r\",fase+Math.PI]]){\n    const a=amp*Math.sin(f),dobra=amp*1.5*Math.max(0,Math.cos(f));\n    apontar(\"thigh_\"+lado,\"calf_\"+lado,[0,-Math.cos(a),Math.sin(a)]);\n    apontar(\"calf_\"+lado,\"foot_\"+lado,[0,-Math.cos(a-dobra),Math.sin(a-dobra)]);\n  }\n}\n\nfunction bloqueiaCaminhada(x,z){\n  for(const c of colisores){\n    if(c.tipo===\"seg\"||Math.hypot(c.cx-x,c.cz-z)>c.raio+2)continue;\n    const chao=alt(c.cx,c.cz);\n    if(c.tipo===\"cil\"){\n      const r=c.tronco!==undefined?c.tronco+.25:(c.y0-chao<2?c.r+.3:-1),d=Math.hypot(x-c.x,z-c.z);\n      if(r>0&&d<r){const k=r/Math.max(.01,d);return [c.x+(x-c.x)*k,c.z+(z-c.z)*k]}\n    } else if(c.tipo===\"caixa\"){\n      const cs=Math.cos(-c.rot),sn=Math.sin(-c.rot),lx=(x-c.x)*cs-(z-c.z)*sn,lz=(x-c.x)*sn+(z-c.z)*cs;\n      const hx=c.sx/2-.2,hz=c.sz/2-.2;\n      if(Math.abs(lx)<hx&&Math.abs(lz)<hz){\n        let nx=lx,nz=lz;if(hx-Math.abs(lx)<hz-Math.abs(lz))nx=Math.sign(lx)*hx;else nz=Math.sign(lz)*hz;\n        const c2=Math.cos(c.rot),s2=Math.sin(c.rot);\n        return [c.x+nx*c2-nz*s2,c.z+nx*s2+nz*c2];\n      }\n    }\n  }\n  for(const a of acudes){const d=Math.hypot(x-a.x,z-a.z);if(d<a.r-1){const k=(a.r-1)/Math.max(.01,d);return [a.x+(x-a.x)*k,a.z+(z-a.z)*k]}}\n  return null;\n}\n\nfunction quadroMapa(dt){\n  const T=andar.teclas,o=grupoOperador.position;\n  const f=(T.KeyW||T.ArrowUp?1:0)-(T.KeyS||T.ArrowDown?1:0),l=(T.KeyD||T.ArrowRight?1:0)-(T.KeyA||T.ArrowLeft?1:0);\n  const correr=T.ShiftLeft||T.ShiftRight,vel=correr?4.5:1.6;\n  const fx=Math.sin(andar.yaw),fz=Math.cos(andar.yaw),rx=-Math.cos(andar.yaw),rz=Math.sin(andar.yaw);\n  let mx=fx*f+rx*l,mz=fz*f+rz*l;const n=Math.hypot(mx,mz);\n  if(n>0&&$(\"mFim\").hidden){\n    mx/=n;mz/=n;\n    let nx=o.x+mx*vel*dt,nz=o.z+mz*vel*dt;\n    const bl=bloqueiaCaminhada(nx,nz);if(bl){nx=bl[0];nz=bl[1]}\n    o.x=trava(nx,-600,600);o.z=trava(nz,-650,450);\n    let dy=Math.atan2(mx,mz)-grupoOperador.rotation.y;\n    while(dy>Math.PI)dy-=2*Math.PI;while(dy<-Math.PI)dy+=2*Math.PI;\n    grupoOperador.rotation.y+=dy*Math.min(1,dt*10);\n    andar.fase+=vel*dt/(correr?1.9:1.35)*Math.PI;\n    andar.amp+=((correr?.62:.42)-andar.amp)*Math.min(1,dt*6);\n  } else andar.amp+=(0-andar.amp)*Math.min(1,dt*8);\n  o.y=alt(o.x,o.z);\n  pose(andar.fase);\n  /* câmera em terceira pessoa */\n  const cp=Math.cos(andar.pitch),sp=Math.sin(andar.pitch);\n  cam.position.set(o.x-fx*andar.dist*cp,o.y+1.45+andar.dist*sp,o.z-fz*andar.dist*cp);\n  cam.position.y=Math.max(cam.position.y,alt(cam.position.x,cam.position.z)+.4);\n  cam.lookAt(o.x,o.y+1.45,o.z);\n  hudMapa();desenharMiniMapa();\n}\nfunction hudMapa(){\n  const o=grupoOperador.position;\n  $(\"mPts\").textContent=ME.limite.length;\n  $(\"mObs\").textContent=ME.obstaculos.length+(ME.obsAtual.length?\" +1\":\"\");\n  $(\"mArea\").textContent=nf(ME.limite.length>=3?areaPoligono(ME.limite)/10000:0,2)+\" ha\";\n  const ultObs=ME.obstaculos.length?ME.obstaculos[ME.obstaculos.length-1]:null;\n  const ult=tipoMarca===\"limite\"?ME.limite[ME.limite.length-1]:tipoMarca===\"poligono\"?ME.obsAtual[ME.obsAtual.length-1]:(ultObs&&ultObs.c);\n  $(\"mDist\").textContent=ult?nf(Math.hypot(o.x-ult[0],o.z-ult[1]),1)+\" m\":\"—\";\n  $(\"mRaioOut\").textContent=nf(+$(\"mRaioIn\").value,1)+\" m\";\n  $(\"mFechar\").disabled=ME.obsAtual.length<3;$(\"mDesfazer\").disabled=!histMapa.length;\n}\n\n/* tela do controle: mapa de satélite simplificado, norte para cima */\nconst mm=$(\"mMapa\"),mg=mm.getContext(\"2d\");\nconst MM={cx:0,cz:-85,esc:540/310};\nconst aTela=(x,z)=>[(x-MM.cx)*MM.esc+mm.width/2,(z-MM.cz)*MM.esc+mm.height/2];\nfunction montarFundoMapa(){\n  const c=document.createElement(\"canvas\");c.width=mm.width;c.height=mm.height;const g=c.getContext(\"2d\");\n  g.fillStyle=\"#4f5f37\";g.fillRect(0,0,c.width,c.height);\n  let s=3;const r=()=>(s=(s*1664525+1013904223)>>>0)/4294967296;\n  for(let i=0;i<500;i++){g.fillStyle=r()>.5?\"rgba(70,88,48,.5)\":\"rgba(95,110,64,.45)\";g.beginPath();g.arc(r()*c.width,r()*c.height,2+r()*9,0,7);g.fill()}\n  const T=TALHAO,[a0,b0]=aTela(T.x0,T.z0),[a1,b1]=aTela(T.x0+T.larg,T.z0+T.prof);\n  g.fillStyle=\"#7a6547\";g.fillRect(a0,b0,a1-a0,b1-b0);\n  g.strokeStyle=\"rgba(60,48,32,.55)\";g.lineWidth=1;for(let x=a0;x<a1;x+=2.2){g.beginPath();g.moveTo(x,b0);g.lineTo(x,b1);g.stroke()}\n  for(const a of acudes){const [x,y]=aTela(a.x,a.z);g.fillStyle=\"#35606c\";g.beginPath();g.arc(x,y,a.r*MM.esc,0,7);g.fill()}\n  for(const k of colisores){\n    if(k.tipo===\"seg\"){const [x1,y1]=aTela(k.a.x,k.a.z),[x2,y2]=aTela(k.b.x,k.b.z);g.strokeStyle=\"rgba(25,25,25,.6)\";g.lineWidth=1;g.beginPath();g.moveTo(x1,y1);g.lineTo(x2,y2);g.stroke()}\n    else if(k.tipo===\"caixa\"){const [x,y]=aTela(k.x,k.z);g.save();g.translate(x,y);g.rotate(-k.rot);g.fillStyle=\"#a3a7aa\";g.fillRect(-(k.sx-1)/2*MM.esc,-(k.sz-1)/2*MM.esc,(k.sx-1)*MM.esc,(k.sz-1)*MM.esc);g.restore()}\n    else{const [x,y]=aTela(k.x,k.z);g.fillStyle=k.tronco!==undefined?\"rgba(28,52,26,.95)\":\"#c9cdd0\";g.beginPath();g.arc(x,y,Math.max(2,k.r*MM.esc),0,7);g.fill()}\n  }\n  return c;\n}\nfunction desenharMiniMapa(){\n  if(!fundoMapa)fundoMapa=montarFundoMapa();\n  const W=mm.width,H=mm.height;mg.clearRect(0,0,W,H);\n  mg.drawImage(fundoMapa,0,0);\n  const poli=(pts,fechado,cor,preenche)=>{\n    if(!pts.length)return;mg.beginPath();pts.forEach((p,i)=>{const [x,y]=aTela(p[0],p[1]);i?mg.lineTo(x,y):mg.moveTo(x,y)});\n    if(fechado&&pts.length>=3){mg.closePath();if(preenche){mg.fillStyle=preenche;mg.fill()}}\n    mg.strokeStyle=cor;mg.lineWidth=3;mg.stroke();\n    for(const p of pts){const [x,y]=aTela(p[0],p[1]);mg.fillStyle=\"#fff\";mg.beginPath();mg.arc(x,y,5,0,7);mg.fill();mg.fillStyle=cor;mg.beginPath();mg.arc(x,y,3.2,0,7);mg.fill()}\n  };\n  poli(ME.limite,true,COR_LIM,\"rgba(50,213,131,.18)\");\n  for(const o of ME.obstaculos){\n    if(o.tipo===\"circulo\"){const [x,y]=aTela(o.c[0],o.c[1]);mg.fillStyle=\"rgba(240,68,56,.25)\";mg.strokeStyle=COR_OBS;mg.lineWidth=2.5;mg.beginPath();mg.arc(x,y,o.r*MM.esc,0,7);mg.fill();mg.stroke()}\n    else poli(o.pts,true,COR_OBS,\"rgba(240,68,56,.25)\");\n  }\n  poli(ME.obsAtual,false,\"#F5A524\");\n  const o=grupoOperador.position,[ox,oy]=aTela(o.x,o.z);\n  if(tipoMarca===\"circulo\"){mg.setLineDash([6,5]);mg.strokeStyle=\"#F5A524\";mg.lineWidth=2;mg.beginPath();mg.arc(ox,oy,+$(\"mRaioIn\").value*MM.esc,0,7);mg.stroke();mg.setLineDash([])}\n  {const [x,y]=aTela(BASE.x,BASE.z);mg.fillStyle=\"#F5A524\";mg.font=\"700 20px Roboto, sans-serif\";mg.textAlign=\"center\";mg.fillText(\"H\",x,y+7)}\n  mg.save();mg.translate(ox,oy);mg.rotate(-grupoOperador.rotation.y);\n  mg.fillStyle=\"rgba(47,128,237,.25)\";mg.beginPath();mg.arc(0,0,16,0,7);mg.fill();\n  mg.fillStyle=\"#2F80ED\";mg.strokeStyle=\"#fff\";mg.lineWidth=2.5;mg.beginPath();mg.moveTo(0,12);mg.lineTo(8,-8);mg.lineTo(0,-3);mg.lineTo(-8,-8);mg.closePath();mg.fill();mg.stroke();mg.restore();\n  mg.fillStyle=\"rgba(10,12,16,.7)\";mg.fillRect(W-44,10,34,34);mg.fillStyle=\"#fff\";mg.font=\"600 18px Roboto, sans-serif\";mg.textAlign=\"center\";mg.fillText(\"N\",W-27,34);\n}\n\n/* entradas do mapeamento */\n$(\"mTipo\").querySelectorAll(\"button\").forEach(b=>b.onclick=()=>{definirTipo(b.dataset.v);b.blur()});\n$(\"mMarcar\").onclick=e=>{marcarPonto();e.currentTarget.blur()};\n$(\"mFechar\").onclick=e=>{fecharObstaculo();e.currentTarget.blur()};\n$(\"mDesfazer\").onclick=e=>{desfazer();e.currentTarget.blur()};\n$(\"mLimpar\").onclick=e=>{e.currentTarget.blur();mostrarAlerta(\"Recomeçar o mapa?\",\"Todos os pontos marcados agora serão apagados.\",[{txt:\"Apagar pontos\",fn:()=>{guardar();ME.limite=[];ME.obstaculos=[];ME.obsAtual=[];desenharMapa3D()}},{txt:\"Cancelar\",fn:()=>{}}],true)};\n$(\"mSair\").onclick=()=>{sairMapa();abrirPainel()};\n$(\"mConcluir\").onclick=e=>{e.currentTarget.blur();concluirMapa()};\n$(\"mRaioIn\").addEventListener(\"change\",()=>$(\"mRaioIn\").blur());\n$(\"mAjOk\").onclick=()=>{$(\"mAjuda\").hidden=true;try{localStorage.setItem(\"t50_ajuda_mapa\",\"1\")}catch(e){}};\n$(\"mFimOp\").onclick=()=>{sairMapa();reiniciarVoo();abrirVerificacao()};\n$(\"mFimVolta\").onclick=()=>{$(\"mFim\").hidden=true;desenharMapa3D()};\n$(\"mFimCampos\").onclick=()=>{sairMapa();abrirPainel()};\naddEventListener(\"keydown\",e=>{\n  if(!modoMapa||!$(\"mFim\").hidden)return;\n  andar.teclas[e.code]=true;\n  if(e.code===\"Space\"){e.preventDefault();if(!e.repeat)marcarPonto()}\n  else if(e.code===\"Backspace\"){e.preventDefault();desfazer()}\n  else if(e.code===\"Enter\"){e.preventDefault();if(tipoMarca===\"poligono\")fecharObstaculo()}\n  else if(e.code===\"Digit1\")definirTipo(\"limite\");else if(e.code===\"Digit2\")definirTipo(\"poligono\");else if(e.code===\"Digit3\")definirTipo(\"circulo\");\n  if([\"ArrowUp\",\"ArrowDown\",\"ArrowLeft\",\"ArrowRight\"].includes(e.code))e.preventDefault();\n});\naddEventListener(\"keyup\",e=>{andar.teclas[e.code]=false;if(modoMapa&&e.code===\"Space\")e.preventDefault()});\naddEventListener(\"blur\",()=>{andar.teclas={}});\nrender.domElement.addEventListener(\"pointerdown\",e=>{if(!modoMapa)return;andar.arrasta={x:e.clientX,y:e.clientY};render.domElement.setPointerCapture(e.pointerId)});\nrender.domElement.addEventListener(\"pointermove\",e=>{\n  if(!modoMapa||!andar.arrasta)return;\n  andar.yaw-=(e.clientX-andar.arrasta.x)*.006;andar.pitch=trava(andar.pitch+(e.clientY-andar.arrasta.y)*.004,-.15,1.25);\n  andar.arrasta={x:e.clientX,y:e.clientY};\n});\naddEventListener(\"pointerup\",()=>{andar.arrasta=null});\nrender.domElement.addEventListener(\"wheel\",e=>{if(!modoMapa)return;e.preventDefault();andar.dist=trava(andar.dist*(e.deltaY>0?1.12:.89),1.8,30)},{passive:false});\n\n/* ===================================================================\n   VISÕES: DRONE, TELA DO CONTROLE (FPV) E OPERADOR\n   =================================================================== */\nlet vista=\"drone\";\nconst camFpv=new THREE.PerspectiveCamera(62,1.57,.3,2500);\n/* retângulo da tela dentro do desenho do RC Plus (viewBox 2000×1440) */\nconst RC={w:2000,h:1440,tx:398,ty:400,tw:1204,th:765};\nlet rcCaixa={x:0,y:0,w:0,h:0,sx:0,sy:0,sw:0,sh:0};\n\nfunction caminhoRet(x,y,w,h,r){return \"M\"+(x+r)+\",\"+y+\"H\"+(x+w-r)+\"Q\"+(x+w)+\",\"+y+\" \"+(x+w)+\",\"+(y+r)+\"V\"+(y+h-r)+\"Q\"+(x+w)+\",\"+(y+h)+\" \"+(x+w-r)+\",\"+(y+h)\n  +\"H\"+(x+r)+\"Q\"+x+\",\"+(y+h)+\" \"+x+\",\"+(y+h-r)+\"V\"+(y+r)+\"Q\"+x+\",\"+y+\" \"+(x+r)+\",\"+y+\"Z\"}\nfunction montarControleSvg(){\n  const buraco=caminhoRet(RC.tx,RC.ty,RC.tw,RC.th,16);\n  const corpo=\"M300,345H1700Q1765,345 1790,425L1905,565Q1948,615 1948,705V1335Q1948,1422 1862,1422H138Q52,1422 52,1335V705Q52,615 95,565L210,425Q235,345 300,345Z\";\n  const manche=(cx,cy)=>'<circle cx=\"'+cx+'\" cy=\"'+cy+'\" r=\"128\" fill=\"#34373b\" stroke=\"#6a6e73\" stroke-width=\"6\"/>'\n    +'<circle cx=\"'+cx+'\" cy=\"'+cy+'\" r=\"100\" fill=\"url(#gManche)\"/>'\n    +'<circle cx=\"'+cx+'\" cy=\"'+cy+'\" r=\"58\" fill=\"#1e2023\" stroke=\"#3b3e42\" stroke-width=\"4\"/>'\n    +'<circle cx=\"'+cx+'\" cy=\"'+cy+'\" r=\"38\" fill=\"none\" stroke=\"#45484c\" stroke-width=\"10\" stroke-dasharray=\"4 5\"/>';\n  const bt=(x,y,t)=>'<rect x=\"'+x+'\" y=\"'+y+'\" width=\"78\" height=\"50\" rx=\"11\" fill=\"#2c2e31\" stroke=\"#6d7075\" stroke-width=\"3\"/>'\n    +'<text x=\"'+(x+39)+'\" y=\"'+(y+34)+'\" text-anchor=\"middle\" font-size=\"26\" font-weight=\"700\" fill=\"#e9ecef\" font-family=\"Roboto,Arial\">'+t+'</text>';\n  const redondo=(cx,cy,r,miolo,cls,rot)=>'<g class=\"'+(cls||\"\")+'\"'+(rot?' role=\"button\" aria-label=\"'+rot+'\" tabindex=\"0\"':'')+'><circle cx=\"'+cx+'\" cy=\"'+cy+'\" r=\"'+r+'\" fill=\"#2a2c2f\" stroke=\"#72767b\" stroke-width=\"5\"/>'+miolo+'</g>';\n  let pontos=\"\";for(let i=0;i<9;i++){pontos+='<circle cx=\"'+(588+i*26)+'\" cy=\"1257\" r=\"5\" fill=\"#1f2124\"/><circle cx=\"'+(1202+i*26)+'\" cy=\"1257\" r=\"5\" fill=\"#1f2124\"/>'}\n  return '<svg viewBox=\"0 0 2000 1440\" preserveAspectRatio=\"none\" aria-hidden=\"false\">'\n   +'<defs><linearGradient id=\"gCorpo\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\"><stop offset=\"0\" stop-color=\"#686c71\"/><stop offset=\".55\" stop-color=\"#55595e\"/><stop offset=\"1\" stop-color=\"#43464a\"/></linearGradient>'\n   +'<radialGradient id=\"gManche\" cx=\".45\" cy=\".4\" r=\".7\"><stop offset=\"0\" stop-color=\"#3a3d41\"/><stop offset=\"1\" stop-color=\"#17191b\"/></radialGradient></defs>'\n   +'<rect x=\"318\" y=\"8\" width=\"88\" height=\"345\" rx=\"16\" fill=\"#2a2c2f\"/><rect x=\"1594\" y=\"8\" width=\"88\" height=\"345\" rx=\"16\" fill=\"#2a2c2f\"/>'\n   +'<circle cx=\"362\" cy=\"22\" r=\"6\" fill=\"#111\"/><circle cx=\"1638\" cy=\"22\" r=\"6\" fill=\"#111\"/>'\n   +'<path fill-rule=\"evenodd\" fill=\"url(#gCorpo)\" d=\"'+corpo+buraco+'\"/>'\n   +'<path fill-rule=\"evenodd\" fill=\"#3b3e42\" d=\"'+caminhoRet(378,382,1244,803,30)+buraco+'\"/>'\n   +'<rect x=\"640\" y=\"334\" width=\"170\" height=\"24\" rx=\"8\" fill=\"#4a4d51\"/><rect x=\"832\" y=\"334\" width=\"165\" height=\"24\" rx=\"8\" fill=\"#4a4d51\"/>'\n   +'<rect x=\"1003\" y=\"334\" width=\"165\" height=\"24\" rx=\"8\" fill=\"#4a4d51\"/><rect x=\"1184\" y=\"334\" width=\"170\" height=\"24\" rx=\"8\" fill=\"#4a4d51\"/>'\n   +manche(230,810)+manche(1770,810)\n   +redondo(322,610,36,'<path d=\"M300,590l44,40M344,590l-44,40\" stroke=\"#d6d9dc\" stroke-width=\"6\"/>')\n   +'<rect x=\"238\" y=\"508\" width=\"44\" height=\"34\" rx=\"8\" fill=\"#232527\"/>'\n   +'<rect x=\"1718\" y=\"528\" width=\"70\" height=\"30\" rx=\"10\" fill=\"#4a4d51\" transform=\"rotate(25 1753 543)\"/>'\n   +'<g class=\"rcbt\" id=\"rcPausa\" role=\"button\" aria-label=\"Pausa\" tabindex=\"0\"><circle cx=\"1845\" cy=\"614\" r=\"40\" fill=\"#e8642c\" stroke=\"#9e3f14\" stroke-width=\"5\"/><rect x=\"1830\" y=\"596\" width=\"9\" height=\"36\" fill=\"#fff\"/><rect x=\"1851\" y=\"596\" width=\"9\" height=\"36\" fill=\"#fff\"/></g>'\n   +bt(282,955,\"L1\")+bt(282,1025,\"L2\")+bt(282,1095,\"L3\")+bt(1642,955,\"R1\")+bt(1642,1025,\"R2\")+bt(1642,1095,\"R3\")\n   +redondo(188,1050,40,'<path d=\"M198,1030l-20,20l20,20\" fill=\"none\" stroke=\"#e9ecef\" stroke-width=\"8\" stroke-linecap=\"round\"/>')\n   +'<circle cx=\"1810\" cy=\"1050\" r=\"46\" fill=\"#1d1f22\" stroke=\"#5a5e63\" stroke-width=\"5\"/><circle cx=\"1810\" cy=\"1050\" r=\"26\" fill=\"#2c2f33\"/>'\n   +'<g class=\"rcbt\" id=\"rcRth\" role=\"button\" aria-label=\"Retorno à base\" tabindex=\"0\"><circle cx=\"320\" cy=\"1258\" r=\"46\" fill=\"#2a2c2f\" stroke=\"#72767b\" stroke-width=\"5\"/><text x=\"320\" y=\"1270\" text-anchor=\"middle\" font-size=\"40\" font-weight=\"700\" fill=\"#e9ecef\" font-family=\"Roboto,Arial\">H</text><path d=\"M290,1278q30,26 60,0\" fill=\"none\" stroke=\"#e9ecef\" stroke-width=\"6\"/></g>'\n   +redondo(1680,1258,46,'<path d=\"M1662,1240a28,28 0 1,0 36,0\" fill=\"none\" stroke=\"#e9ecef\" stroke-width=\"7\" stroke-linecap=\"round\"/><path d=\"M1680,1228v30\" stroke=\"#e9ecef\" stroke-width=\"7\" stroke-linecap=\"round\"/>')\n   +'<rect x=\"462\" y=\"1228\" width=\"1076\" height=\"194\" rx=\"14\" fill=\"#4b4e52\"/>'+pontos\n   +'<rect x=\"918\" y=\"1177\" width=\"12\" height=\"20\" rx=\"3\" fill=\"#2a2c2f\"/>'\n   +[980,1010,1040,1070].map(x=>'<rect x=\"'+x+'\" y=\"1177\" width=\"12\" height=\"20\" rx=\"3\" fill=\"#2a2c2f\"/>').join(\"\")\n   +'</svg>';\n}\n$(\"vCtrlRc\").innerHTML=montarControleSvg();\n\nfunction layoutControle(){\n  const W=innerWidth,H=innerHeight,livre=H-64;\n  let w=Math.min(W*.96,livre*RC.w/RC.h),h=w*RC.h/RC.w;\n  const x=(W-w)/2,y=Math.max(6,(livre-h)/2);\n  const sx=x+RC.tx/RC.w*w,sy=y+RC.ty/RC.h*h,sw=RC.tw/RC.w*w,sh=RC.th/RC.h*h;\n  rcCaixa={x,y,w,h,sx,sy,sw,sh};\n  Object.assign($(\"vCtrlRc\").style,{left:x+\"px\",top:y+\"px\",width:w+\"px\",height:h+\"px\"});\n  Object.assign($(\"tela\").style,{left:sx+\"px\",top:sy+\"px\",width:sw+\"px\",height:sh+\"px\",fontSize:Math.max(9,sw/64)+\"px\"});\n  const m=$(\"rMapa\");m.width=Math.round(sw*.3*devicePixelRatio);m.height=Math.round(sh*.34*devicePixelRatio);\n  camFpv.aspect=sw/sh;camFpv.updateProjectionMatrix();\n}\naddEventListener(\"resize\",layoutControle);layoutControle();\n\nfunction definirVista(v){\n  if(v===\"drone\"&&vista===\"drone\"){xgOrb.az=XG_ORB0.az;xgOrb.el=XG_ORB0.el;xgOrb.dist=XG_ORB0.dist}   /* \"Drone\" de novo: a câmera volta para trás dele */\n  vista=v;seguir=v===\"drone\";\n  $(\"vistas\").querySelectorAll(\"button\").forEach(b=>b.setAttribute(\"aria-pressed\",b.dataset.v===v));\n  if(v!==\"operador\"){cam.fov=55;cam.updateProjectionMatrix()}\n  aplicarVista();\n  posCamera(true,0);\n}\nfunction aplicarVista(){\n  const ctrl=vista===\"controle\"&&!modoMapa;\n  if(!modoMapa)orb.enabled=vista!==\"operador\";\n  $(\"vCtrl\").hidden=!ctrl;\n  if(!modoMapa){$(\"topo\").hidden=ctrl;$(\"radar\").hidden=ctrl}\n  $(\"vOpRot\").hidden=true;\n}\n$(\"vistas\").querySelectorAll(\"button\").forEach(b=>b.onclick=()=>{definirVista(b.dataset.v);b.blur()});\naddEventListener(\"keydown\",e=>{\n  if(modoMapa||e.target.tagName===\"INPUT\")return;\n  if(e.code===\"KeyC\"){const ord=[\"drone\",\"controle\",\"operador\",\"livre\"];definirVista(ord[(ord.indexOf(vista)+1)%ord.length])}\n});\n/* vista do operador sem zoom: é o que a pessoa enxerga de verdade, e o zoom tirava o operador da tela */\n\n/* botões do desenho: pausa (freia e para) e RTH */\nfunction pausarPeloControle(){\n  if(![\"aplicando\",\"indo\",\"voltando\",\"descendo\",\"subindo\"].includes(V.estado))return;\n  const antes=V.estado;\n  pairar(\"Pausado pelo controle\",\"A aeronave freou e está em voo estacionário. No T50 o botão de pausa interrompe a tarefa na hora.\",\n    [{txt:\"Continuar tarefa\",fn:()=>{V.estado=antes;fecharAlerta()}},{txt:\"Retornar à base\",fn:()=>iniciarRetorno(antes===\"aplicando\"?pontoAtual():V.retomar)}]);\n}\n$(\"rcPausa\").addEventListener(\"click\",pausarPeloControle);\n/* RTH do desenho (24/10/2026): como no aparelho, so SEGURAR 1,5 s inicia a volta (um toque curto nao faz nada). O circulo\n   fica laranja enquanto segura. O clique sem toque antes (controle 3D do Air 2S, via aoBotao) continua agindo na hora. */\n(function(){\n  const RTH_MS=1500,bt=$(\"rcRth\"),aro=bt.querySelector(\"circle\");\n  let rel=null,toque=false;\n  const cor=c=>{if(aro)aro.setAttribute(\"stroke\",c)};\n  const parar=()=>{clearTimeout(rel);rel=null;cor(\"#72767b\")};\n  const apertar=()=>{\n    if(rel!==null)return;\n    cor(\"#e8642c\");\n    rel=setTimeout(()=>{rel=null;cor(\"#72767b\");$(\"bRth\").click()},RTH_MS);\n  };\n  const soltou=()=>{parar();setTimeout(()=>{toque=false},400)};\n  bt.addEventListener(\"pointerdown\",e=>{\n    if(e.pointerType===\"mouse\"&&e.button!==0)return;\n    e.preventDefault();toque=true;\n    try{bt.setPointerCapture(e.pointerId)}catch(_){/* sem captura */}\n    apertar();\n  });\n  bt.addEventListener(\"pointerup\",soltou);\n  bt.addEventListener(\"pointercancel\",soltou);\n  bt.addEventListener(\"click\",()=>{if(!toque)$(\"bRth\").click()});\n  bt.addEventListener(\"keydown\",e=>{if(e.key===\"Enter\"||e.key===\" \"){e.preventDefault();if(!e.repeat)apertar()}});\n  bt.addEventListener(\"keyup\",e=>{if(e.key===\"Enter\"||e.key===\" \")parar()});\n  bt.addEventListener(\"blur\",parar);\n})();\n$(\"rcPausa\").addEventListener(\"keydown\",e=>{if(e.key===\"Enter\"||e.key===\" \"){e.preventDefault();$(\"rcPausa\").dispatchEvent(new Event(\"click\"))}});\n\n/* câmera FPV do nariz do T50, levemente inclinada para baixo */\nfunction atualizarFpv(){\n  const d=drone.position,fx=Math.cos(V.yaw),fz=-Math.sin(V.yaw);\n  camFpv.position.set(d.x+fx*1.25,d.y+.25,d.z+fz*1.25);\n  camFpv.up.set(0,1,0);\n  camFpv.lookAt(d.x+fx*12,d.y+.25-4.2,d.z+fz*12);\n  camFpv.rotateZ(-inclina.rotation.z*.3);\n}\n\n/* app dentro da tela do controle */\nconst tm=$(\"rMapa\"),tg=tm.getContext(\"2d\");\nfunction hudControle(){\n  const d=drone.position,E=efetivo();\n  $(\"rEstado\").textContent=ROTULO[V.estado]||V.estado;\n  $(\"rModo\").textContent=(P.modo===\"facil\"?\"Modo fácil\":\"Modo padrão\")+\" · Rota\";\n  $(\"rBat\").textContent=nf(V.bat,0)+\"%\";$(\"rBat\").className=V.bat<=15?\"cr\":V.bat<=25?\"al\":\"\";\n  $(\"rTan\").textContent=nf(V.tan,1)+\" L\";$(\"rTan\").className=V.tan<3?\"cr\":V.tan<8?\"al\":\"\";\n  $(\"rAgl\").textContent=nf(Math.max(0,d.y-alt(d.x,d.z)),1)+\" m\";\n  $(\"rVel\").textContent=nf(V.v,1)+\" m/s\";\n  $(\"rVaz\").textContent=nf(V.vazaoAtual||0,1)+\" L/min\";\n  $(\"rApl\").textContent=nf(V.aplicado,2)+\" ha\";\n  $(\"rFai\").textContent=nf(larguraEfetiva(),1)+\" / \"+nf(P.faixa,1)+\" m\";\n  $(\"rDist\").textContent=nf(Math.hypot(d.x-BASE.x,d.z-BASE.z),0)+\" m\";\n  const o=V.sonda&&P.desvio?V.sonda:null;\n  $(\"rObs\").hidden=!o;if(o)$(\"rObs\").textContent=\"Obstáculo à frente · \"+nf(Math.max(0,o.d-T50.raioHelice),1)+\" m\";\n  $(\"rDesvio\").hidden=P.desvio;\n  /* mapa pequeno: contorno, faixas feitas e aeronave */\n  const M=mapaAtual(),W=tm.width,H=tm.height;tg.clearRect(0,0,W,H);\n  tg.fillStyle=\"rgba(28,40,24,.92)\";tg.fillRect(0,0,W,H);\n  if(!M)return;\n  const xs=M.limite.map(p=>p[0]).concat([BASE.x]),zs=M.limite.map(p=>p[1]).concat([BASE.z]);\n  const x0=Math.min(...xs)-12,x1=Math.max(...xs)+12,z0=Math.min(...zs)-12,z1=Math.max(...zs)+12;\n  const esc=Math.min(W/(x1-x0),H/(z1-z0)),ox=(W-(x1-x0)*esc)/2,oz=(H-(z1-z0)*esc)/2;\n  const T=(x,z)=>[ox+(x-x0)*esc,oz+(z-z0)*esc];\n  tg.beginPath();M.limite.forEach((p,i)=>{const [a,b]=T(p[0],p[1]);i?tg.lineTo(a,b):tg.moveTo(a,b)});tg.closePath();\n  tg.fillStyle=\"rgba(122,101,71,.85)\";tg.fill();tg.strokeStyle=\"#32D583\";tg.lineWidth=Math.max(1.5,W/200);tg.stroke();\n  for(const ob of M.obstaculos){tg.fillStyle=\"rgba(240,68,56,.55)\";tg.beginPath();\n    if(ob.tipo===\"circulo\"){const [a,b]=T(ob.c[0],ob.c[1]);tg.arc(a,b,ob.r*esc,0,7)}\n    else ob.pts.forEach((p,i)=>{const [a,b]=T(p[0],p[1]);i?tg.lineTo(a,b):tg.moveTo(a,b)});\n    tg.fill()}\n  tg.lineWidth=Math.max(1,W/320);\n  for(let i=1;i<rota.length;i++){\n    const a=rota[i-1].p,b=rota[i].p;if(!rota[i].aplica)continue;\n    const [ax,ay]=T(a[0],a[1]),[bx,by]=T(b[0],b[1]);\n    tg.strokeStyle=i<V.i?\"#32D583\":\"rgba(255,255,255,.55)\";tg.beginPath();tg.moveTo(ax,ay);tg.lineTo(bx,by);tg.stroke();\n  }\n  {const [a,b]=T(BASE.x,BASE.z);tg.fillStyle=\"#F5A524\";tg.font=\"700 \"+Math.round(W/16)+\"px Roboto,Arial\";tg.textAlign=\"center\";tg.fillText(\"H\",a,b+W/45)}\n  const [px,py]=T(d.x,d.z),s=W/28;\n  tg.save();tg.translate(px,py);tg.rotate(-V.yaw+Math.PI/2);\n  tg.fillStyle=\"#fff\";tg.strokeStyle=\"#2F80ED\";tg.lineWidth=W/150;\n  tg.beginPath();tg.moveTo(0,-s);tg.lineTo(s*.7,s*.8);tg.lineTo(0,s*.35);tg.lineTo(-s*.7,s*.8);tg.closePath();tg.fill();tg.stroke();tg.restore();\n}\n\nfunction renderControle(){\n  const c=rcCaixa,H=innerHeight;\n  atualizarFpv();\n  render.setClearColor(\"#0d0f12\",1);render.clear();\n  render.setScissorTest(true);\n  render.setScissor(c.sx,H-c.sy-c.sh,c.sw,c.sh);render.setViewport(c.sx,H-c.sy-c.sh,c.sw,c.sh);\n  render.render(cena,camFpv);\n  render.setScissorTest(false);render.setViewport(0,0,innerWidth,innerHeight);\n  hudControle();\n}\n\n/* visão do operador: o avatar vira para o drone e a câmera olha por cima do ombro dele */\nfunction mirarOperador(){\n  /* a inclinação já vem limitada em posCamera para o operador continuar no quadro */\n  cam.lookAt(orb.target);\n  cam.updateMatrixWorld();\n}\nconst vtmp=new THREE.Vector3();\nfunction acompanharDrone(dt){\n  if(modoMapa||!grupoOperador.children.length)return;\n  const o=grupoOperador.position,d=drone.position;\n  const alvo=Math.atan2(d.x-o.x,d.z-o.z);\n  if(Math.hypot(d.x-o.x,d.z-o.z)>1.5){\n    let dy=alvo-grupoOperador.rotation.y;while(dy>Math.PI)dy-=2*Math.PI;while(dy<-Math.PI)dy+=2*Math.PI;\n    grupoOperador.rotation.y+=dy*Math.min(1,dt*2.5);\n  }\n}\n\n/* ===================================================================\n   LAÇO\n   =================================================================== */\nlet ant=performance.now();\nfunction quadro(t,frame){\n  if(window.PAUSA_SIM && PAUSA_SIM.pausado){ant=t;return;}\n  if(window.xgVR)window.xgVR.antesQuadro(t,frame);\n  /* dentro do sim.html o campo pode abrir antes da moldura ter o tamanho\n     final (300x150) e o aviso de resize se perder: confere a cada quadro */\n  if(!render.xr.isPresenting&&(render.domElement.clientWidth!==innerWidth||render.domElement.clientHeight!==innerHeight)){\n    cam.aspect=innerWidth/innerHeight;cam.updateProjectionMatrix();render.setSize(innerWidth,innerHeight)}\n  const dtr=Math.min(.05,(t-ant)/1000);ant=t;\n  if(inclina.children.length){\n    if(V.rodando){\n      let resta=dtr*V.mult;\n      while(resta>1e-4){const dt=Math.min(1/60,resta);passo(dt);resta-=dt;if(V.estado===\"caiu\"&&V.noChao)break}\n      emitir(dtr,V.aplicando);\n    } else emitir(dtr,false);\n    const gira=V.rodando&&![\"reabastecendo\",\"concluído\",\"em solo\"].includes(V.estado)&&!(V.estado===\"caiu\"&&V.noChao)&&!(V.xgApito>0);\n    for(const h of helices)h.rotation.y+=h.userData.sentido*dtr*52*(gira?1:0);\n    if(V.estado!==\"caiu\"){\n      drone.rotation.y=V.yaw+Math.PI/2;\n      /* 19/11/2026: na curva em arco do XAG a aeronave inclina para dentro (V.xgRol, de xgArcoXag); fora dela volta ao nível */\n      V.xgRolA=(V.xgRolA||0)+((V.rodando?V.xgRol||0:0)-(V.xgRolA||0))*Math.min(1,dtr*XG_ARCO_XAG.rolo);\n      inclina.rotation.set(Math.min(.14,V.v*.018),0,Math.abs(V.xgRolA)<1e-4?0:V.xgRolA);\n    }\n    if(!(window.xgVR&&xgVR.ativo))posCamera(false,dtr);\n    const d=drone.position;\n    sol.position.set(d.x+40,d.y+70,d.z+30);sol.target.position.copy(d);\n    hud();desenharRadar();\n  }\n  if(window.xgVR&&xgVR.ativo){\n    xgVR.camera();\n  } else if(modoMapa){\n    quadroMapa(dtr);\n    const o=grupoOperador.position;sol.position.set(o.x+40,o.y+70,o.z+30);sol.target.position.copy(o);\n  } else {\n    /* no operador a câmera olha para cima, para o drone: o OrbitControls não deixa (trava o ângulo e sobe a câmera) */\n    if(telaInicial)orbitarInicio(dtr);else if(vista===\"operador\")mirarOperador();else orb.update();\n    acompanharDrone(dtr);\n  }\n  if(window.xgVR&&xgVR.ativo)xgVR.renderizar();\n  else if(!modoMapa&&vista===\"controle\")renderControle();\n  else render.render(cena,cam);\n}\nrender.setAnimationLoop((t,frame)=>quadro(t,frame));\naddEventListener(\"resize\",()=>{if(render.xr.isPresenting)return;cam.aspect=innerWidth/innerHeight;cam.updateProjectionMatrix();render.setSize(innerWidth,innerHeight)});\n</script>\n<script src=\"../js/campo/vr_campo.js?v=367614663b71\"></script>\n<script src=\"../js/campo/vento_opcao.js?v=628db5d4e166\"></script>\n<script src=\"../js/campo/veiculo_fisica.js?v=d9b1c300f374\"></script>\n<script src=\"../js/campo/veiculo.js?v=6c1f010fc0b3\"></script>\n<script src=\"../js/campo/graficos.js?v=9455828cbd12\"></script>\n<script src=\"../js/campo/destruicao.js?v=e198772bcfba\"></script>\n"
