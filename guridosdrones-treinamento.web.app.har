            "text": "/* ==========================================================================\n   SESSAO DO ALUNO\n\n   Nesta fase nao existe servidor: o codigo de turma e a chave de entrada e o\n   progresso fica no proprio aparelho do aluno (localStorage).\n\n   O dia em que entrar o login de verdade (Supabase), so estas quatro funcoes\n   mudam - `entrar`, `atual`, `sair` e `salvarProgresso`. O resto do sistema\n   nao precisa saber de onde veio a resposta.\n\n   Aviso honesto, para nao se enganar depois: codigo conferido no navegador\n   filtra quem nao tem o codigo, nao impede quem sabe abrir o console. O que\n   protege de verdade e o login no servidor.\n   ========================================================================== */\n\nwindow.SESSAO = (function () {\n  \"use strict\";\n\n  var CHAVE = \"tpd_sessao\";\n  var CHAVE_PROGRESSO = \"tpd_progresso\";\n\n  var C = window.TREINAMENTO || {};\n\n  function guardar(chave, valor) {\n    try {\n      localStorage.setItem(chave, JSON.stringify(valor));\n      return true;\n    } catch (e) {\n      return false;   // aba anônima, armazenamento bloqueado\n    }\n  }\n\n  function ler(chave) {\n    try {\n      var bruto = localStorage.getItem(chave);\n      return bruto ? JSON.parse(bruto) : null;\n    } catch (e) {\n      return null;\n    }\n  }\n\n  function normalizar(codigo) {\n    return String(codigo || \"\")\n      .trim()\n      .toUpperCase()\n      .replace(/\\s+/g, \"\")\n      .normalize(\"NFD\").replace(/[̀-ͯ]/g, \"\");\n  }\n\n  function turmaPorCodigo(codigo) {\n    var alvo = normalizar(codigo);\n    if (!alvo) return null;\n\n    var achada = (C.turmas || []).filter(function (t) {\n      return normalizar(t.codigo) === alvo;\n    })[0];\n\n    if (achada) return achada;\n\n    // Enquanto `entradaLivre` estiver ligada, qualquer código abre uma turma\n    // solta com tudo que a licença tem. Serve para você montar e testar.\n    if (C.entradaLivre) {\n      return {\n        codigo: alvo,\n        nome: \"Turma \" + alvo,\n        marcas: (C.licenca || {}).marcas || [],\n        cenarios: ((C.cenarios || []).map(function (c) { return c.id; })),\n        livre: true,\n      };\n    }\n\n    return null;\n  }\n\n  function licencaVencida() {\n    var validade = ((C.licenca || {}).validade || \"\").trim();\n    if (!validade) return false;\n    var limite = new Date(validade + \"T23:59:59\");\n    return !isNaN(limite.getTime()) && new Date() > limite;\n  }\n\n  /* --------------------------------------------------------------- publico */\n\n  return {\n\n    /* Devolve { ok, erro, sessao }. Nunca lanca excecao: a tela so mostra\n       a mensagem do campo `erro`. */\n    entrar: function (codigo, nomeAluno) {\n      if (licencaVencida()) {\n        return { ok: false, erro: \"A licença desta empresa venceu. Fale com quem te passou o código.\" };\n      }\n\n      var turma = turmaPorCodigo(codigo);\n      if (!turma) {\n        return { ok: false, erro: \"Código não encontrado. Confira com quem te passou.\" };\n      }\n\n      var marcas = (turma.marcas || []).filter(function (id) {\n        var m = (window.MARCAS || {})[id];\n        return m && m.pronta;\n      });\n\n      if (!marcas.length) {\n        return { ok: false, erro: \"Esta turma está sem marca de drone liberada. Fale com a empresa.\" };\n      }\n\n      var sessao = {\n        codigo: turma.codigo,\n        turma: turma.nome,\n        aluno: String(nomeAluno || \"\").trim(),\n        marcas: marcas,\n        cenarios: turma.cenarios || [],\n        entrouEm: new Date().toISOString(),\n        livre: !!turma.livre,\n      };\n\n      guardar(CHAVE, sessao);\n      return { ok: true, sessao: sessao };\n    },\n\n    /* O cadastro do aluno, as horas e o certificado ficam na area do\n       aluno (treinamento/conta/contas.js), que grava a sessao do\n       simulador com origem \"conta\". Aqui fica so a entrada por codigo\n       de turma. */\n\n    atual: function () {\n      return ler(CHAVE);\n    },\n\n    sair: function () {\n      try { localStorage.removeItem(CHAVE); } catch (e) { /* ignora */ }\n    },\n\n    /* Progresso por marca + modelo + cenario: { \"dji/t50/plano\": {etapa: nota} } */\n    progresso: function () {\n      return ler(CHAVE_PROGRESSO) || {};\n    },\n\n    salvarProgresso: function (chaveTreino, etapa, dados) {\n      var tudo = ler(CHAVE_PROGRESSO) || {};\n      if (!tudo[chaveTreino]) tudo[chaveTreino] = {};\n      tudo[chaveTreino][etapa] = Object.assign(\n        { em: new Date().toISOString() },\n        dados || {}\n      );\n      guardar(CHAVE_PROGRESSO, tudo);\n      return tudo;\n    },\n\n    /* Manda para o login quem chegou sem sessao. Nao cria sessao sozinha:\n       a porta do treinamento e treinamento/conta/index.html (login). */\n    exigir: function (paginaDeEntrada) {\n      var s = ler(CHAVE);\n      if (!s) {\n        window.location.href = paginaDeEntrada || \"../entrar.html\";\n        return null;\n      }\n      return s;\n    },\n  };\n})();\n"
          },
          "redirectURL": "",
