          "content": {
            "size": 30655,
            "mimeType": "application/javascript",
            "text": "/* Traducoes EN/ES dos textos NOVOS do simulador (25/10/2026): camionete dirigivel, vento, controles e atalhos, botoes e nomes dos mapas novos.\n   O catalogo do site (js/idiomas/catalogo.js) e uma pagina de Hosting; este arquivo vai junto com o simulador e SOMA as entradas ao mesmo catalogo\n   (window.TPD_TRADUCOES), que o idiomas.js usa para traduzir o texto que aparece na tela. Sem tradutor carregado, nada muda (fica em portugues). */\n(function () {\n  \"use strict\";\n  var D = {\n    /* ---- camionete dirigivel (veiculo.js) ---- */\n    \"Escolher onde colocar o drone\": [\"Choose where to put the drone\", \"Elegir dónde colocar el dron\"],\n    \"Voltar à tela inicial\": [\"Back to the start screen\", \"Volver a la pantalla inicial\"],\n    \"Tela inicial\": [\"Start screen\", \"Pantalla inicial\"],\n    \"Colocar o drone aqui\": [\"Put the drone here\", \"Colocar el dron aquí\"],\n    \"Voltar a dirigir\": [\"Back to driving\", \"Volver a conducir\"],\n    \"Ré assistida: ligada\": [\"Assisted reverse: on\", \"Marcha atrás asistida: activada\"],\n    \"Ré assistida: desligada\": [\"Assisted reverse: off\", \"Marcha atrás asistida: desactivada\"],\n    \"Ré assistida ligada\": [\"Assisted reverse on\", \"Marcha atrás asistida activada\"],\n    \"Ré assistida desligada\": [\"Assisted reverse off\", \"Marcha atrás asistida desactivada\"],\n    \"A carretinha está dobrando demais: siga em frente para desfazer.\": [\"The trailer is jackknifing: drive forward to straighten it.\", \"El remolque se está doblando demasiado: avanza para enderezarlo.\"],\n    \"Leve a camionete até onde quer decolar.\": [\"Drive the truck to where you want to take off.\", \"Lleva la camioneta hasta donde quieres despegar.\"],\n    \"Pronto. Clique em “Escolher onde colocar o drone”.\": [\"Ready. Click “Choose where to put the drone”.\", \"Listo. Haz clic en «Elegir dónde colocar el dron».\"],\n    \"Endireite a carretinha para continuar.\": [\"Straighten the trailer to continue.\", \"Endereza el remolque para continuar.\"],\n    \"Terreno inclinado: pare em um lugar mais plano.\": [\"Sloped ground: stop in a flatter spot.\", \"Terreno inclinado: detente en un lugar más plano.\"],\n    \"Perto demais do veículo: o drone não decola a menos de 6 m de um obstáculo. Afaste o círculo.\": [\"Too close to the vehicle: the drone will not take off within 6 m of an obstacle. Move the circle away.\", \"Demasiado cerca del vehículo: el dron no despega a menos de 6 m de un obstáculo. Aleja el círculo.\"],\n    \"Há obstáculo a menos de 6 m do círculo: o drone não decolaria aqui.\": [\"There is an obstacle within 6 m of the circle: the drone would not take off here.\", \"Hay un obstáculo a menos de 6 m del círculo: el dron no despegaría aquí.\"],\n    \"Chão plano e livre: clique para colocar o drone aqui.\": [\"Flat, clear ground: click to put the drone here.\", \"Suelo plano y libre: haz clic para colocar el dron aquí.\"],\n    \"O círculo ficou fora da área do mapa.\": [\"The circle is outside the map area.\", \"El círculo quedó fuera del área del mapa.\"],\n    \"Perto demais da água.\": [\"Too close to the water.\", \"Demasiado cerca del agua.\"],\n    \"Tem obstáculo dentro do círculo.\": [\"There is an obstacle inside the circle.\", \"Hay un obstáculo dentro del círculo.\"],\n    \"Declive forte demais para a camionete.\": [\"Slope too steep for the truck.\", \"Pendiente demasiado fuerte para la camioneta.\"],\n    \"A camionete ainda não carregou. Espere um instante e tente de novo.\": [\"The truck has not loaded yet. Wait a moment and try again.\", \"La camioneta todavía no cargó. Espera un instante e inténtalo de nuevo.\"],\n    \"Volante para a esquerda\": [\"Steer left\", \"Girar a la izquierda\"],\n    \"Volante para a direita\": [\"Steer right\", \"Girar a la derecha\"],\n    \"Acelerar\": [\"Accelerate\", \"Acelerar\"],\n    \"Ré ou freio\": [\"Reverse or brake\", \"Marcha atrás o freno\"],\n    \"Freio de mão\": [\"Handbrake\", \"Freno de mano\"],\n    \"Volante ◀︎ ▶︎ · ▲ acelera · ▼ ré e freio\": [\"Steering ◀︎ ▶︎ · ▲ accelerate · ▼ reverse and brake\", \"Volante ◀︎ ▶︎ · ▲ acelera · ▼ marcha atrás y freno\"],\n    \"Analógico esquerdo: volante · RT acelera · LT ré\": [\"Left stick: steering · RT accelerates · LT reverses\", \"Analógico izquierdo: volante · RT acelera · LT marcha atrás\"],\n    \"W/S ou setas: acelera e ré · A/D: volante · Espaço freia\": [\"W/S or arrows: accelerate and reverse · A/D: steering · Space brakes\", \"W/S o flechas: acelera y marcha atrás · A/D: volante · Espacio frena\"],\n    \"Ponto de decolagem\": [\"Takeoff point\", \"Punto de despegue\"],\n    \"Eu levo a camionete\": [\"I'll drive the truck\", \"Yo llevo la camioneta\"],\n    \"O ponto de decolagem é o que o mapa traz: camionete, carretinha e equipe já estão no lugar.\": [\"The takeoff point is the one the map provides: truck, trailer and crew are already in place.\", \"El punto de despegue es el que trae el mapa: camioneta, remolque y equipo ya están en su lugar.\"],\n\n    /* ---- vento na tela inicial (vento_opcao.js) e painel de clima (meteorologia.js) ---- */\n    \"Vento\": [\"Wind\", \"Viento\"],\n    \"Força do vento\": [\"Wind strength\", \"Fuerza del viento\"],\n    \"Direção do vento\": [\"Wind direction\", \"Dirección del viento\"],\n    \"Sorteada\": [\"Random\", \"Aleatoria\"],\n    \"Calmo\": [\"Calm\", \"Calmo\"],\n    \"Fraco\": [\"Light\", \"Débil\"],\n    \"Moderado\": [\"Moderate\", \"Moderado\"],\n    \"Forte\": [\"Strong\", \"Fuerte\"],\n    \"Fixa\": [\"Fixed\", \"Fija\"],\n    \"Muda durante a operação\": [\"Changes during the operation\", \"Cambia durante la operación\"],\n    \"Personalizar\": [\"Customize\", \"Personalizar\"],\n    \"Personalizar o vento\": [\"Customize the wind\", \"Personalizar el viento\"],\n    \"Editar variações\": [\"Edit variations\", \"Editar variaciones\"],\n    \"Concluir\": [\"Done\", \"Listo\"],\n    \"rajadas\": [\"gusts\", \"ráfagas\"],\n    \"Você monta o vento: até 5 variações, cada uma com direção, vento constante e rajadas, e o tempo em que ela começa.\": [\"You build the wind: up to 5 variations, each with a direction, constant wind and gusts, and the time when it starts.\", \"Tú armas el viento: hasta 5 variaciones, cada una con dirección, viento constante y ráfagas, y el tiempo en que empieza.\"],\n    \"Variação\": [\"Variation\", \"Variación\"],\n    \"começa no início\": [\"starts at the beginning\", \"empieza al inicio\"],\n    \"depois de\": [\"after\", \"después de\"],\n    \"começa aos\": [\"starts at\", \"empieza a los\"],\n    \"Direção (de onde vem)\": [\"Direction (where it comes from)\", \"Dirección (de dónde viene)\"],\n    \"Vento constante (km/h)\": [\"Constant wind (km/h)\", \"Viento constante (km/h)\"],\n    \"Rajadas (km/h)\": [\"Gusts (km/h)\", \"Ráfagas (km/h)\"],\n    \"Norte (N)\": [\"North (N)\", \"Norte (N)\"],\n    \"Nordeste (NE)\": [\"Northeast (NE)\", \"Noreste (NE)\"],\n    \"Leste (L)\": [\"East (E)\", \"Este (E)\"],\n    \"Sudeste (SE)\": [\"Southeast (SE)\", \"Sureste (SE)\"],\n    \"Sul (S)\": [\"South (S)\", \"Sur (S)\"],\n    \"Sudoeste (SO)\": [\"Southwest (SW)\", \"Suroeste (SO)\"],\n    \"Oeste (O)\": [\"West (W)\", \"Oeste (O)\"],\n    \"Noroeste (NO)\": [\"Northwest (NW)\", \"Noroeste (NO)\"],\n    \"Remover variação\": [\"Remove variation\", \"Quitar variación\"],\n    \"Adicionar variação\": [\"Add variation\", \"Añadir variación\"],\n    \"Até 5 variações. O tempo conta a partir do começo da operação. A mudança de uma variação para a outra é gradual (em até 2 minutos), nunca de repente.\": [\"Up to 5 variations. Time counts from the start of the operation. The change from one variation to the next is gradual (within up to 2 minutes), never sudden.\", \"Hasta 5 variaciones. El tiempo cuenta desde el inicio de la operación. El cambio de una variación a la siguiente es gradual (en hasta 2 minutos), nunca de repente.\"],\n    \"Força sorteada a cada sessão (de 3 a 16 km/h), como antes.\": [\"Strength drawn at random each session (3 to 16 km/h), as before.\", \"Fuerza sorteada en cada sesión (de 3 a 16 km/h), como antes.\"],\n    \"Calmo: cerca de 3 km/h, com rajadas leves. Bom para pulverizar.\": [\"Calm: about 3 km/h, with light gusts. Good for spraying.\", \"Calmo: cerca de 3 km/h, con ráfagas leves. Bueno para pulverizar.\"],\n    \"Fraco: cerca de 8 km/h, com rajadas. Dá para pulverizar com cuidado.\": [\"Light: about 8 km/h, with gusts. You can spray, with care.\", \"Débil: cerca de 8 km/h, con ráfagas. Se puede pulverizar con cuidado.\"],\n    \"Moderado: cerca de 14 km/h, com rajadas. A deriva é grande: o produto sai da faixa.\": [\"Moderate: about 14 km/h, with gusts. Drift is large: the product leaves the swath.\", \"Moderado: cerca de 14 km/h, con ráfagas. La deriva es grande: el producto sale de la franja.\"],\n    \"Forte: cerca de 21 km/h, com rajadas. Acima do limite seguro para pulverizar: a aeronave é empurrada.\": [\"Strong: about 21 km/h, with gusts. Above the safe limit for spraying: the aircraft is pushed.\", \"Fuerte: cerca de 21 km/h, con ráfagas. Por encima del límite seguro para pulverizar: la aeronave es empujada.\"],\n    \"Direção fixa durante a operação.\": [\"Fixed direction during the operation.\", \"Dirección fija durante la operación.\"],\n    \"A direção do vento muda durante a operação, com viradas de 25° a 75°, devagar, como no campo.\": [\"The wind direction changes during the operation, with slow shifts of 25° to 75°, as in the field.\", \"La dirección del viento cambia durante la operación, con giros lentos de 25° a 75°, como en el campo.\"],\n    \"Afeta a aplicação\": [\"Affects the application\", \"Afecta la aplicación\"],\n    \"O vento leva as gotas, empurra a aeronave e o painel de clima fica na tela.\": [\"Wind carries the droplets, pushes the aircraft and the weather panel stays on screen.\", \"El viento arrastra las gotas, empuja la aeronave y el panel del clima queda en pantalla.\"],\n    \"Sem vento: o produto cai direto, a aeronave não é empurrada e o painel de clima fica escondido.\": [\"No wind: the product falls straight down, the aircraft is not pushed and the weather panel is hidden.\", \"Sin viento: el producto cae directo, la aeronave no es empujada y el panel del clima queda oculto.\"],\n    \"Condições meteorológicas simuladas\": [\"Simulated weather conditions\", \"Condiciones meteorológicas simuladas\"],\n    \"A seta aponta para onde o vento leva o produto, em relação à câmera\": [\"The arrow points to where the wind carries the product, relative to the camera\", \"La flecha apunta hacia donde el viento lleva el producto, respecto a la cámara\"],\n\n    /* ---- tela inicial do simulador (campo/index.html) ---- */\n    \"‹ Voltar à escolha do drone\": [\"‹ Back to drone selection\", \"‹ Volver a la selección de dron\"],\n    \"Treinamento de operador\": [\"Operator training\", \"Entrenamiento de operador\"],\n    \"Mapeie o campo caminhando com o controle, configure a tarefa e acompanhe a aplicação pela câmera do drone, pela tela do controle ou ao lado do operador.\": [\"Map the field by walking with the controller, set up the task and follow the application through the drone camera, the controller screen or beside the operator.\", \"Mapea el campo caminando con el control, configura la tarea y sigue la aplicación por la cámara del dron, por la pantalla del control o junto al operador.\"],\n    \"Como jogar\": [\"How to play\", \"Cómo jugar\"],\n    \"Escolha um campo e faça o mapa caminhando: marque os cantos do talhão e os obstáculos.\": [\"Choose a field and map it by walking: mark the corners of the field and the obstacles.\", \"Elige un campo y haz el mapa caminando: marca las esquinas de la parcela y los obstáculos.\"],\n    \"Ajuste altura, velocidade, gota e espaçamento até as faixas fecharem.\": [\"Adjust height, speed, droplet and spacing until the swaths close.\", \"Ajusta altura, velocidad, gota y espaciado hasta que las franjas cierren.\"],\n    \"Inicie a operação, deslize para decolar e acompanhe pelas visões Drone, Controle ou Operador.\": [\"Start the operation, slide to take off and follow through the Drone, Controller or Operator views.\", \"Inicia la operación, desliza para despegar y sigue por las vistas Dron, Control u Operador.\"],\n    \"No fim, confira a cobertura do talhão, a sobreposição e o que mudar na próxima.\": [\"At the end, check the field coverage, the overlap and what to change next time.\", \"Al final, revisa la cobertura de la parcela, el solapamiento y qué cambiar la próxima vez.\"],\n\n    /* ---- painel de clima (meteorologia.js) ---- */\n    \"Vento para\": [\"Wind toward\", \"Viento hacia\"],\n    \"Rajada · 30 s\": [\"Gust · 30 s\", \"Ráfaga · 30 s\"],\n    \"Temperatura\": [\"Temperature\", \"Temperatura\"],\n    \"Umidade\": [\"Humidity\", \"Humedad\"],\n    \"Para onde o vento leva o produto\": [\"Where the wind carries the product\", \"Hacia dónde el viento lleva el producto\"],\n    \"Pico dos últimos 30 segundos simulados\": [\"Peak of the last 30 simulated seconds\", \"Pico de los últimos 30 segundos simulados\"],\n\n    /* ---- tela \"Campos\": mapa, modo, tarefa e detecção ---- */\n    \"Agras T50 · treinamento de operador\": [\"Agras T50 · operator training\", \"Agras T50 · entrenamiento de operador\"],\n    \"Coxilha com rede de baixa\": [\"Rolling hill with low-voltage line\", \"Loma con línea de baja tensión\"],\n    \"Encosta com rede na coxilha\": [\"Hillside with power line on the hill\", \"Ladera con línea eléctrica en la loma\"],\n    \"Fácil\": [\"Easy\", \"Fácil\"],\n    \"Difícil\": [\"Hard\", \"Difícil\"],\n    \"4 ha em relevo suave. Uma rede de baixa tensão cruza o talhão na diagonal e há uma árvore isolada e uma árvore seca no meio das linhas.\": [\"4 ha on gentle terrain. A low-voltage line crosses the field diagonally and there is an isolated tree and a dead tree among the rows.\", \"4 ha en relieve suave. Una línea de baja tensión cruza la parcela en diagonal y hay un árbol aislado y un árbol seco en medio de las hileras.\"],\n    \"O talhão desce até um açude. Capão de mata invadindo a lateral, eucaliptos no fim das linhas e uma torre de internet dentro da área.\": [\"The field slopes down to a pond. A patch of forest encroaches on the side, eucalyptus trees stand at the end of the rows and an internet tower sits inside the area.\", \"La parcela baja hasta un estanque. Un monte de bosque invade el costado, hay eucaliptos al final de las hileras y una torre de internet dentro del área.\"],\n    \"Declive de 16° com uma coxilha no meio do talhão. A rede de média tensão passa só 3 m acima do chão bem em cima da coxilha.\": [\"16° slope with a rolling hill in the middle of the field. The medium-voltage line passes only 3 m above the ground right over the hill.\", \"Declive de 16° con una loma en medio de la parcela. La línea de media tensión pasa a solo 3 m del suelo justo sobre la loma.\"],\n    \"Mapa do campo\": [\"Field map\", \"Mapa del campo\"],\n    \"Campo ainda não mapeado. Caminhe com o controle marcando os pontos, ou use o mapa pronto.\": [\"Field not mapped yet. Walk with the controller marking the points, or use the ready-made map.\", \"Campo aún sin mapear. Camina con el control marcando los puntos, o usa el mapa listo.\"],\n    \"Mapear caminhando\": [\"Map by walking\", \"Mapear caminando\"],\n    \"Editar mapa caminhando\": [\"Edit walked map\", \"Editar mapa caminado\"],\n    \"Usar mapa pronto\": [\"Use ready-made map\", \"Usar mapa listo\"],\n    \"O mapa pronto tem só o contorno do talhão, sem obstáculos marcados. Quem desvia é o radar.\": [\"The ready-made map has only the field outline, with no obstacles marked. The radar does the avoiding.\", \"El mapa listo tiene solo el contorno de la parcela, sin obstáculos marcados. Quien esquiva es el radar.\"],\n    \"Modo do aplicativo\": [\"App mode\", \"Modo de la aplicación\"],\n    \"Modo fácil\": [\"Easy mode\", \"Modo fácil\"],\n    \"Modo padrão\": [\"Standard mode\", \"Modo estándar\"],\n    \"A aeronave faz RTH sozinha quando o tanque esvazia, a bateria fica fraca ou a operação termina.\": [\"The aircraft returns home by itself when the tank empties, the battery runs low or the operation ends.\", \"La aeronave hace RTH sola cuando el tanque se vacía, la batería está baja o la operación termina.\"],\n    \"Com tanque vazio ou operação concluída a aeronave fica em voo estacionário. Bateria fraca é só aviso — quem decide voltar é o operador.\": [\"With an empty tank or a completed operation the aircraft hovers. A low battery is only a warning — the operator decides when to return.\", \"Con el tanque vacío o la operación concluida la aeronave queda en vuelo estacionario. Batería baja es solo un aviso: quien decide volver es el operador.\"],\n    \"Configurações de tarefa\": [\"Task settings\", \"Configuración de la tarea\"],\n    \"As faixas fecham\": [\"The swaths close\", \"Las franjas cierran\"],\n    \"As faixas não fecham\": [\"The swaths do not close\", \"Las franjas no cierran\"],\n    \"Modo fácil · Rota\": [\"Easy mode · Route\", \"Modo fácil · Ruta\"],\n    \"Modo padrão · Rota\": [\"Standard mode · Route\", \"Modo estándar · Ruta\"],\n    \"Volume de pulverização\": [\"Spray volume\", \"Volumen de pulverización\"],\n    \"Tamanho da gota\": [\"Droplet size\", \"Tamaño de gota\"],\n    \"Configurações de detecção\": [\"Detection settings\", \"Configuración de detección\"],\n    \"Montanhas e pomares\": [\"Mountains and orchards\", \"Montañas y huertos\"],\n    \"Para áreas planas. Desvia de obstáculos pela lateral e para se não conseguir.\": [\"For flat areas. Avoids obstacles by going around the side and stops if it cannot.\", \"Para áreas planas. Esquiva los obstáculos por el costado y se detiene si no puede.\"],\n    \"Para relevo ondulado e pomares. Desvia de obstáculos por cima. Em área plana pode subir demais perto de postes e árvores.\": [\"For rolling terrain and orchards. Avoids obstacles by going over them. On flat ground it may climb too much near poles and trees.\", \"Para relieve ondulado y huertos. Esquiva los obstáculos por arriba. En área plana puede subir demasiado cerca de postes y árboles.\"],\n    \"Para voar sobre água. Desvia pela lateral.\": [\"For flying over water. Avoids by going around the side.\", \"Para volar sobre agua. Esquiva por el costado.\"],\n    \"Com ele ligado, a velocidade fica limitada a 10 m/s e a altura acima das culturas entre 2,5 e 8 m.\": [\"With it on, speed is limited to 10 m/s and height above the crops to between 2.5 and 8 m.\", \"Con él activado, la velocidad queda limitada a 10 m/s y la altura sobre el cultivo entre 2,5 y 8 m.\"],\n    \"Acompanha o terreno pelo radar. Desligada, a altura é contada a partir do ponto de decolagem.\": [\"Follows the terrain using the radar. When off, height is counted from the takeoff point.\", \"Sigue el terreno con el radar. Desactivada, la altura se cuenta desde el punto de despegue.\"],\n\n    /* ---- mapeamento caminhando ---- */\n    \"Mapeamento com controle remoto\": [\"Mapping with remote controller\", \"Mapeo con control remoto\"],\n    \"RC Plus · RTK do controle\": [\"RC Plus · controller RTK\", \"RC Plus · RTK del control\"],\n    \"Pontos limite\": [\"Boundary points\", \"Puntos de límite\"],\n    \"Último ponto\": [\"Last point\", \"Último punto\"],\n    \"Caminhe e marque o campo\": [\"Walk and mark the field\", \"Camina y marca el campo\"],\n    \"Com o RTK do controle em FIX, vá até cada canto do talhão e marque um ponto de limite. Depois marque os obstáculos: contornando (polígono) ou só no centro com um raio.\": [\"With the controller RTK in FIX, go to each corner of the field and mark a boundary point. Then mark the obstacles: outlining them (polygon) or only at the center with a radius.\", \"Con el RTK del control en FIX, ve hasta cada esquina de la parcela y marca un punto de límite. Después marca los obstáculos: bordeándolos (polígono) o solo en el centro con un radio.\"],\n    \"caminha ·\": [\"walks ·\", \"camina ·\"],\n    \"corre · arraste o mouse para olhar · roda do mouse afasta\": [\"runs · drag the mouse to look around · mouse wheel zooms out\", \"corre · arrastra el mouse para mirar · la rueda del mouse aleja\"],\n    \"marca ponto ·\": [\"marks point ·\", \"marca punto ·\"],\n    \"desfaz ·\": [\"undoes ·\", \"deshace ·\"],\n    \"fecha obstáculo ·\": [\"closes obstacle ·\", \"cierra obstáculo ·\"],\n    \"tipo de ponto\": [\"point type\", \"tipo de punto\"],\n    \"Entendi\": [\"Got it\", \"Entendido\"],\n    \"Obstáculo\": [\"Obstacle\", \"Obstáculo\"],\n    \"Obstáculo circular\": [\"Circular obstacle\", \"Obstáculo circular\"],\n    \"Raio\": [\"Radius\", \"Radio\"],\n    \"Fechar obstáculo\": [\"Close obstacle\", \"Cerrar obstáculo\"],\n    \"Desfazer\": [\"Undo\", \"Deshacer\"],\n    \"Recomeçar\": [\"Start over\", \"Empezar de nuevo\"],\n    \"Concluir mapa\": [\"Finish map\", \"Terminar mapa\"],\n    \"Mapa salvo\": [\"Map saved\", \"Mapa guardado\"],\n    \"Continuar mapeando\": [\"Keep mapping\", \"Seguir mapeando\"],\n    \"Voltar aos campos\": [\"Back to fields\", \"Volver a los campos\"],\n    \"Pare em cima de cada canto do talhão e marque. Siga a borda em ordem, sem cruzar o meio.\": [\"Stand on top of each corner of the field and mark it. Follow the edge in order, without crossing the middle.\", \"Párate sobre cada esquina de la parcela y márcala. Sigue el borde en orden, sin cruzar por el medio.\"],\n\n    /* ---- durante e depois da operacao ---- */\n    \"Em solo\": [\"On the ground\", \"En tierra\"],\n    \"DESVIO DE OBSTÁCULOS DESLIGADO\": [\"OBSTACLE AVOIDANCE OFF\", \"EVASIÓN DE OBSTÁCULOS DESACTIVADA\"],\n    \"Faixa / espaç.\": [\"Swath / spacing\", \"Franja / espaciado\"],\n    \"Aplicado\": [\"Applied\", \"Aplicado\"],\n    \"Deslize para decolar\": [\"Slide to take off\", \"Desliza para despegar\"],\n    \"Tentar de novo\": [\"Try again\", \"Intentar de nuevo\"],\n    \"Mudar configuração\": [\"Change settings\", \"Cambiar configuración\"],\n    \"Voar de novo\": [\"Fly again\", \"Volar de nuevo\"],\n    \"⌨ Teclas\": [\"⌨ Keys\", \"⌨ Teclas\"],\n    \"⚙ Botões\": [\"⚙ Buttons\", \"⚙ Botones\"],\n    \"VR indisponível neste navegador\": [\"VR unavailable in this browser\", \"VR no disponible en este navegador\"],\n    \"Configurar os botões e analógicos do Quest\": [\"Set the Quest buttons and thumbsticks\", \"Configurar los botones y analógicos del Quest\"],\n    \"Indicador de radar\": [\"Radar indicator\", \"Indicador de radar\"],\n    \"Retorno à base\": [\"Return to home\", \"Regreso a la base\"],\n    \"Manche esquerdo\": [\"Left stick\", \"Palanca izquierda\"],\n    \"Manche direito\": [\"Right stick\", \"Palanca derecha\"],\n    \"Mapa da tarefa\": [\"Task map\", \"Mapa de la tarea\"],\n    \"Mapa do controle\": [\"Controller map\", \"Mapa del control\"],\n    \"Faixas de aplicação lado a lado\": [\"Application swaths side by side\", \"Franjas de aplicación lado a lado\"],\n\n    /* ---- botoes de terreno e nomes dos mapas novos ---- */\n    \"Coxilha\": [\"Rolling hill\", \"Loma suave\"],\n    \"Baixada do açude\": [\"Pond lowland\", \"Bajo del estanque\"],\n    \"Encosta\": [\"Hillside\", \"Ladera\"],\n    \"Pivô e talhões planos\": [\"Pivot and flat fields\", \"Pivote y parcelas planas\"],\n    \"Terraços no morro\": [\"Terraces on the hill\", \"Terrazas en el cerro\"],\n    \"Várzea com rio\": [\"Floodplain with river\", \"Vega con río\"],\n    \"Sede da fazenda e açude\": [\"Farm headquarters and pond\", \"Casco de la finca y estanque\"],\n    \"Povoado rural\": [\"Rural village\", \"Poblado rural\"],\n    \"Talhão cercado de mato\": [\"Field surrounded by brush\", \"Parcela rodeada de maleza\"],\n    \"Pastagem com árvores secas e verdes\": [\"Pasture with dead and live trees\", \"Pastizal con árboles secos y verdes\"],\n\n    /* ---- teclas e atalhos do controle virtual (teclado_rc.js) ---- */\n    \"RTH (segurar 1,5 s)\": [\"RTH (hold 1.5 s)\", \"RTH (mantener 1,5 s)\"],\n    \"Teclas do controle virtual\": [\"Virtual controller keys\", \"Teclas del control virtual\"],\n    \"Configurar as teclas de cada botão do controle\": [\"Set the keys for each controller button\", \"Configurar las teclas de cada botón del control\"],\n    \"Toque em uma tecla da lista e aperte a tecla nova no teclado. Esc cancela. A troca vale neste navegador.\": [\"Click a key in the list and press the new key on the keyboard. Esc cancels. The change applies to this browser.\", \"Toca una tecla de la lista y pulsa la nueva tecla en el teclado. Esc cancela. El cambio vale para este navegador.\"],\n    \"Voltar ao padrão\": [\"Restore defaults\", \"Restablecer valores\"],\n    \"App do controle\": [\"Controller app\", \"App del control\"],\n    \"Espaço\": [\"Space\", \"Espacio\"],\n    \"Girar para a esquerda\": [\"Turn left\", \"Girar a la izquierda\"],\n    \"Girar para a direita\": [\"Turn right\", \"Girar a la derecha\"],\n    \"Trás\": [\"Back\", \"Atrás\"],\n    \"Botão de pulverização\": [\"Spray button\", \"Botón de pulverización\"],\n    \"Roda esquerda: mais vazão\": [\"Left wheel: more flow\", \"Rueda izquierda: más caudal\"],\n    \"Roda esquerda: menos vazão\": [\"Left wheel: less flow\", \"Rueda izquierda: menos caudal\"],\n    \"Roda direita: câmera para cima\": [\"Right wheel: camera up\", \"Rueda derecha: cámara hacia arriba\"],\n    \"Roda direita: câmera para baixo\": [\"Right wheel: camera down\", \"Rueda derecha: cámara hacia abajo\"],\n    \"Botões de trás\": [\"Rear buttons\", \"Botones traseros\"],\n    \"R1 (resumo da tarefa)\": [\"R1 (task summary)\", \"R1 (resumen de la tarea)\"],\n    \"Botões de cima\": [\"Top buttons\", \"Botones superiores\"],\n    \"FPV / mapa\": [\"FPV / map\", \"FPV / mapa\"],\n    \"Botão 5D\": [\"5D button\", \"Botón 5D\"],\n    \"5D para cima\": [\"5D up\", \"5D arriba\"],\n    \"5D para baixo\": [\"5D down\", \"5D abajo\"],\n    \"5D para a esquerda\": [\"5D left\", \"5D izquierda\"],\n    \"5D para a direita\": [\"5D right\", \"5D derecha\"],\n    \"Roda do gimbal: câmera para cima\": [\"Gimbal wheel: camera up\", \"Rueda del gimbal: cámara hacia arriba\"],\n    \"Roda do gimbal: câmera para baixo\": [\"Gimbal wheel: camera down\", \"Rueda del gimbal: cámara hacia abajo\"],\n    \"Tirar foto / gravar vídeo\": [\"Take photo / record video\", \"Tomar foto / grabar video\"],\n    \"Trocar foto / vídeo\": [\"Switch photo / video\", \"Cambiar foto / video\"],\n    \"Fn: câmera para baixo / para a frente\": [\"Fn: camera down / forward\", \"Fn: cámara hacia abajo / hacia adelante\"],\n    \"Modo de voo C / N / S\": [\"Flight mode C / N / S\", \"Modo de vuelo C / N / S\"],\n\n    /* ---- controles do Meta Quest (teclado_rc.js) ---- */\n    \"Controles e atalhos do Meta Quest\": [\"Meta Quest controls and shortcuts\", \"Controles y atajos del Meta Quest\"],\n    \"Controles do Meta Quest\": [\"Meta Quest controls\", \"Controles del Meta Quest\"],\n    \"Gatilho do indicador: apontar e pressionar botões ou segurar um manche do RC. Também dá para encostar a ponta do controle num botão do RC para apertar.\": [\"Index trigger: point and press buttons or hold an RC stick. You can also touch the tip of the controller to an RC button to press it.\", \"Gatillo del índice: apunta y presiona botones o sujeta un joystick del RC. También puedes tocar un botón del RC con la punta del control para presionarlo.\"],\n    \"Gatilho lateral: segure a carcaça do RC para levantar, abaixar e reposicionar.\": [\"Side trigger: grab the RC body to raise, lower and reposition it.\", \"Gatillo lateral: sujeta la carcasa del RC para subirlo, bajarlo y reposicionarlo.\"],\n    \"Energia do RC: toque, solte e mantenha o segundo toque por 1,5 segundo.\": [\"RC power: tap, release, then hold the second tap for 1.5 seconds.\", \"Encendido del RC: toca, suelta y mantén el segundo toque durante 1,5 segundos.\"],\n    \"Sair do VR: aperte o botão escolhido abaixo (X, se não mudar). O botão Meta continua pertencendo ao sistema.\": [\"Exit VR: press the button chosen below (X, if you do not change it). The Meta button still belongs to the system.\", \"Salir de VR: pulsa el botón elegido abajo (X, si no lo cambias). El botón Meta sigue perteneciendo al sistema.\"],\n    \"Analógicos (com o RC nas duas mãos)\": [\"Thumbsticks (with the RC in both hands)\", \"Palancas analógicas (con el RC en ambas manos)\"],\n    \"Manche esquerdo do RC (subir/descer e girar)\": [\"RC left stick (up/down and turn)\", \"Palanca izquierda del RC (subir/bajar y girar)\"],\n    \"Manche direito do RC (frente/trás e lados)\": [\"RC right stick (forward/back and sideways)\", \"Palanca derecha del RC (adelante/atrás y lados)\"],\n    \"Não usar\": [\"Do not use\", \"No usar\"],\n    \"Analógico esquerdo\": [\"Left thumbstick\", \"Analógico izquierdo\"],\n    \"Analógico direito\": [\"Right thumbstick\", \"Analógico derecho\"],\n    \"Atalhos para os botões do RC Plus\": [\"Shortcuts for the RC Plus buttons\", \"Atajos para los botones del RC Plus\"],\n    \"Sair do VR\": [\"Exit VR\", \"Salir de VR\"],\n    \"Apertar analógico esquerdo\": [\"Press left thumbstick\", \"Pulsar analógico izquierdo\"],\n    \"Apertar analógico direito\": [\"Press right thumbstick\", \"Pulsar analógico derecho\"],\n    \"Gatilhos e laterais ficam para apertar e segurar o RC. Os botões Menu (≡) e Meta pertencem aos óculos e não podem ser usados pelo site.\": [\"Triggers and grips are for pressing and holding the RC. The Menu (≡) and Meta buttons belong to the headset and cannot be used by the site.\", \"Los gatillos y los laterales sirven para presionar y sujetar el RC. Los botones Menú (≡) y Meta pertenecen a las gafas y el sitio no puede usarlos.\"]\n  };\n\n  /* nomes de obstaculos que a camionete pode bater (\"Bateu em ...\") */\n  var NOMES = {\n    \"o limite do mapa\": [\"the map boundary\", \"el límite del mapa\"], \"a água\": [\"the water\", \"el agua\"], \"o relevo\": [\"the terrain\", \"el relieve\"],\n    \"um obstáculo\": [\"an obstacle\", \"un obstáculo\"], \"o silo\": [\"the silo\", \"el silo\"], \"o poste\": [\"the pole\", \"el poste\"], \"a palmeira\": [\"the palm tree\", \"la palmera\"],\n    \"a camionete\": [\"the truck\", \"la camioneta\"], \"a bomba de diesel\": [\"the diesel pump\", \"la bomba de diésel\"], \"a bananeira\": [\"the banana tree\", \"la bananera\"],\n    \"o boi\": [\"the steer\", \"el novillo\"], \"o badeco\": [\"the helper\", \"el ayudante\"], \"a árvore\": [\"the tree\", \"el árbol\"], \"a árvore seca\": [\"the dead tree\", \"el árbol seco\"],\n    \"o tronco seco (palito)\": [\"the dead trunk\", \"el tronco seco\"], \"o galpão\": [\"the shed\", \"el galpón\"], \"as árvores do mapa\": [\"the trees on the map\", \"los árboles del mapa\"]\n  };\n\n  function catalogo() { return window.TPD_TRADUCOES || null; }\n  function somar() {\n    var c = catalogo();\n    if (!c) return false;\n    Object.keys(D).forEach(function (k) { if (!Object.prototype.hasOwnProperty.call(c, k)) c[k] = D[k]; });\n    return true;\n  }\n  /* a pagina que vem depois do catalogo: soma agora; se o tradutor ja desenhou a tela em outro idioma, refaz */\n  if (somar() && window.TPD_IDIOMAS && window.TPD_IDIOMAS.atual() !== \"pt\") { try { window.TPD_IDIOMAS.traduzir(); } catch (e) { /* segue */ } }\n\n  window.XG_TR = {\n    /* registra uma frase montada com numeros (a chave e o texto em portugues ja pronto) e devolve o proprio texto */\n    reg: function (pt, en, es) { var c = catalogo(); if (c && !Object.prototype.hasOwnProperty.call(c, pt)) c[pt] = [en, es]; return pt; },\n    /* nome de obstaculo (\"o poste\") no idioma i (0 = ingles, 1 = espanhol); desconhecido volta em portugues */\n    nome: function (n, i) { return NOMES[n] ? NOMES[n][i] : n; }\n  };\n})();\n"
